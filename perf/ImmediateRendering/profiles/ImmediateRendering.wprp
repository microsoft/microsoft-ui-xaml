<?xml version="1.0" encoding="utf-8"?>
<!--
  WPR profiles for the immediate-rendering comparative runs (docs\design-notes\immediate-rendering-backends-test-plan.md).

    wpr -start ImmediateRendering.wprp!Timing -filemode   W1-W4, S1, R1*, E1: CPU sampling + CSwitch, frame/paint markers.
    wpr -start ImmediateRendering.wprp!Memory -filemode   M1-M8: adds the XAML profiler provider (DComp surface memory,
                                                          graphics resource lifetime) and VirtualAlloc / reference set.
    wpr -start ImmediateRendering.wprp!Gpu    -filemode   W3, W5: DxgKrnl DMA packets, VidMm allocations, DWM.

  Timing runs deliberately exclude Microsoft-Windows-XAML-Profiler, which is verbose and would perturb frame timing.
  The analyzer only needs Microsoft-WinUI-RenderingBackend, Microsoft-WinUI-RenderBench and kernel process start; the
  other providers are for drill-down in WPA.
-->
<WindowsPerformanceRecorder Version="1.0" Author="Microsoft Corporation" Copyright="Microsoft Corporation" Company="Microsoft Corporation">
  <Profiles>
    <SystemCollector Id="SystemCollector_IR" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </SystemCollector>

    <EventCollector Id="EventCollector_IR" Name="ImmediateRenderingCollector">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </EventCollector>

    <SystemProvider Id="SystemProvider_IR_Base">
      <Keywords>
        <Keyword Value="CpuConfig" />
        <Keyword Value="Loader" />
        <Keyword Value="ProcessThread" />
      </Keywords>
    </SystemProvider>

    <SystemProvider Id="SystemProvider_IR_Timing" Base="SystemProvider_IR_Base">
      <Keywords Operation="Add">
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>

    <SystemProvider Id="SystemProvider_IR_Memory" Base="SystemProvider_IR_Base">
      <Keywords Operation="Add">
        <Keyword Value="Memory" />
        <Keyword Value="MemoryInfo" />
        <Keyword Value="MemoryInfoWS" />
        <Keyword Value="VirtualAllocation" />
        <Keyword Value="ReferenceSet" />
        <Keyword Value="VAMap" />
        <Keyword Value="Session" />
        <!-- Required by ReferenceSet. -->
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
        <Keyword Value="Filename" />
      </Keywords>
      <Stacks>
        <Stack Value="VirtualAllocation" />
      </Stacks>
    </SystemProvider>

    <SystemProvider Id="SystemProvider_IR_Gpu" Base="SystemProvider_IR_Base">
      <Keywords Operation="Add">
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
      </Keywords>
    </SystemProvider>

    <!-- Native seam: BackendSelected, DeviceInfo, FrameBegin/End, RenderWalkStats, Paint*, ResourceInventory, DeviceLost (WARNING). -->
    <EventProvider Id="EventProvider_RenderingBackend" Name="d18ce99c-dd66-5390-18da-068546739801" Level="5" NonPagedMemory="true">
      <Keywords>
        <Keyword Value="0xF" />
      </Keywords>
    </EventProvider>

    <!-- Harness: Microsoft-WinUI-RenderBench (RunStarted, Phase*, SceneReady, InputInjected, MemorySample, ...). -->
    <EventProvider Id="EventProvider_RenderBench" Name="114b4a9f-4cba-5c88-a321-355d52c822e6" Level="5" NonPagedMemory="true" />

    <!-- Microsoft-Windows-XAML-Profiler: DCompSurfaceMemoryChanged, GraphicsResourceCreated/Destroyed (Composition M6). -->
    <EventProvider Id="EventProvider_XamlProfiler" Name="a1b2c3d4-e5f6-4a5b-9c8d-7e6f5a4b3c2d" Level="5" NonPagedMemory="true" />

    <EventProvider Id="EventProvider_KernelProcess" Name="Microsoft-Windows-Kernel-Process" Level="4" NonPagedMemory="true">
      <Keywords>
        <!-- WINEVENT_KEYWORD_PROCESS -->
        <Keyword Value="0x10" />
      </Keywords>
    </EventProvider>

    <EventProvider Id="EventProvider_DxgKrnl_Base" Name="Microsoft-Windows-DxgKrnl" Level="4" NonPagedMemory="true">
      <Keywords>
        <!-- Base: present and flip events. -->
        <Keyword Value="0x1" />
      </Keywords>
    </EventProvider>

    <EventProvider Id="EventProvider_DxgKrnl_Detailed" Name="Microsoft-Windows-DxgKrnl" Level="5" NonPagedMemory="true">
      <Keywords>
        <!-- Base | Profiler (DMA packets, GPU queue) | Resource | Memory (VidMm allocations). -->
        <Keyword Value="0xC3" />
      </Keywords>
    </EventProvider>

    <EventProvider Id="EventProvider_DwmCore" Name="Microsoft-Windows-Dwm-Core" Level="4" NonPagedMemory="true" />

    <Profile Id="Timing.Verbose.File" Name="Timing" Description="RenderBench timing: CPU, frames, paint" DetailLevel="Verbose" LoggingMode="File">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_IR">
          <SystemProviderId Value="SystemProvider_IR_Timing" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_IR">
          <EventProviders>
            <EventProviderId Value="EventProvider_RenderingBackend" />
            <EventProviderId Value="EventProvider_RenderBench" />
            <EventProviderId Value="EventProvider_KernelProcess" />
            <EventProviderId Value="EventProvider_DxgKrnl_Base" />
            <EventProviderId Value="EventProvider_DwmCore" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>

    <Profile Id="Memory.Verbose.File" Name="Memory" Description="RenderBench memory: commit, surfaces, graphics resources" DetailLevel="Verbose" LoggingMode="File">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_IR">
          <SystemProviderId Value="SystemProvider_IR_Memory" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_IR">
          <EventProviders>
            <EventProviderId Value="EventProvider_RenderingBackend" />
            <EventProviderId Value="EventProvider_RenderBench" />
            <EventProviderId Value="EventProvider_KernelProcess" />
            <EventProviderId Value="EventProvider_XamlProfiler" />
            <EventProviderId Value="EventProvider_DxgKrnl_Base" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>

    <Profile Id="Gpu.Verbose.File" Name="Gpu" Description="RenderBench GPU: DMA packets, VidMm, DWM" DetailLevel="Verbose" LoggingMode="File">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_IR">
          <SystemProviderId Value="SystemProvider_IR_Gpu" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_IR">
          <EventProviders>
            <EventProviderId Value="EventProvider_RenderingBackend" />
            <EventProviderId Value="EventProvider_RenderBench" />
            <EventProviderId Value="EventProvider_KernelProcess" />
            <EventProviderId Value="EventProvider_DxgKrnl_Detailed" />
            <EventProviderId Value="EventProvider_DwmCore" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
