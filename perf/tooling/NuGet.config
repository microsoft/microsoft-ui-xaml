<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <clear />
    <add key="globalPackagesFolder" value="packages" />
    <add key="repositoryPath" value="packages" />
  </config>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSources>
    <!-- For more info, see https://docs.nuget.org/consume/nuget-config-file -->
    <clear />

    <!-- DON'T ADD NEW FEEDS TO THIS LIST -->
    <!-- Instead set the feed as an upstream of this feed, or push the required nupkg to this feed. -->
    <!-- See this page for info on nuget upstream sources: https://docs.microsoft.com/en-us/azure/devops/artifacts/concepts/upstream-sources -->
    <add key="WinUI.Dependencies" value="%WinUILKGDependenciesFeedUri%" />

    <!--
      A local directory (inside perf\tooling) for testing nupkg files without pushing to
      a remote feed. The path is relative to THIS NuGet.config, so it resolves to
      perf\tooling\packagestore and keeps working when this folder is copied or zipped on
      its own. Do NOT use "..\..\packagestore" (escapes a tooling-only zip) or
      "\packagestore" (a leading slash means the drive root, e.g. C:\packagestore).
    -->
    <add key="packagestore" value="packagestore" />
  </packageSources>
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
</configuration>
