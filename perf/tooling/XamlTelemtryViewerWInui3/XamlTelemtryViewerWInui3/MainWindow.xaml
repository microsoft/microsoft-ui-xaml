<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XamlTelemtryViewerWInui3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XamlTelemtryViewerWInui3"
    xmlns:converters="using:XamlTelemtryViewerWInui3.Converters"
    xmlns:models="using:XamlTelemtryViewerWInui3.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ETL Trace Viewer">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <!-- Single source of truth for grid column widths, shared by the header and
                 every (virtualized) data row so a header drag resizes both together. -->
            <models:ColumnWidths x:Key="SharedColumnWidths" />
            <converters:GuidToLowercaseConverter x:Key="GuidToLowercaseConverter" />
            <converters:TimestampConverter x:Key="TimestampConverter" />
            <Style x:Key="NoHoverButtonStyle" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter 
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NoHoverComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBg}" />
                <Setter Property="Foreground" Value="#EEEEEE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorder}" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="False" />
                <Setter Property="ScrollViewer.IsHorizontalRailEnabled" Value="False" />
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <CarouselPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Background"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                Foreground="{TemplateBinding Foreground}"
                                                VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                          Foreground="{TemplateBinding Foreground}"
                                          Text="&#xE70D;"
                                          FontFamily="Segoe MDL2 Assets"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="11" />
                                <Popup x:Name="Popup"
                                      IsLightDismissEnabled="True"
                                      IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="{ThemeResource ComboBoxDropDownBackground}"
                                           BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}"
                                           BorderThickness="1"
                                           Padding="0">
                                        <ScrollViewer x:Name="ScrollViewer"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                    VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar with two rows -->
        <Border Grid.Row="0"
                Background="{ThemeResource SurfaceBg}"
                Padding="12"
                BorderBrush="{ThemeResource AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 1: Controls -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ETL trace file:" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppText}" />

                    <Button Content="Select trace file..."
                            Click="SelectTraceFileButton_Click"
                            Padding="12,6"
                            MinWidth="130"
                            Background="{ThemeResource SurfaceBg}"
                            Foreground="{ThemeResource AppText}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppBorder}"
                            Style="{StaticResource NoHoverButtonStyle}" />

                    <TextBlock Text="{Binding TraceFilePath}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource SubText}"
                               MinWidth="200"
                               MaxWidth="350" />
                </StackPanel>

                <!-- Right controls -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Filters..."
                            Click="FiltersButton_Click"
                            Padding="12,6"
                            MinWidth="80"
                            Background="{ThemeResource SurfaceBg}"
                            Foreground="{ThemeResource AppText}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppBorder}"
                            Style="{StaticResource NoHoverButtonStyle}" />

                    <Button Content="📊 Timeline"
                            Click="TimelineButton_Click"
                            Padding="12,6"
                            MinWidth="80"
                            Background="{ThemeResource SurfaceBg}"
                            Foreground="{ThemeResource AppText}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppBorder}"
                            Style="{StaticResource NoHoverButtonStyle}" />

                    <Button Content="Load trace"
                            Click="LoadTraceButton_Click"
                            Padding="12,6"
                            MinWidth="80"
                            Background="{ThemeResource SurfaceBg}"
                            Foreground="{ThemeResource AppText}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource AppBorder}"
                            Style="{StaticResource NoHoverButtonStyle}" />
                </StackPanel>

                <!-- Row 2: Status message and Progress -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Spacing="4">
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,8,0,0"
                               Foreground="{ThemeResource SubText}"
                               FontSize="12" />
                    <ProgressBar Value="{Binding ProgressValue}" 
                                 Maximum="1.0"
                                 Height="4"
                                 Background="{ThemeResource LaneBg}"
                                 Foreground="#FF0066CC"
                                 Visibility="{Binding IsLoading}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Trace tabs (one per loaded trace; selecting one shows its events below) -->
        <TabView Grid.Row="1"
                 x:Name="TraceTabs"
                 TabItemsSource="{Binding Tabs}"
                 SelectedIndex="{Binding SelectedTraceIndex, Mode=TwoWay}"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent"
                 TabCloseRequested="TraceTabs_TabCloseRequested"
                 Background="{ThemeResource SurfaceBg}"
                 Padding="0">
            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem Header="{Binding Label}" IsClosable="True" />
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Main Content Area with DataGrid -->
        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + Data Rows: one ScrollViewer so header and rows scroll horizontally together -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Auto">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                    <!-- Header Row (sticks to top while scrolling vertically) -->
                    <Border Background="{ThemeResource PanelBg}"
                            BorderBrush="{ThemeResource AppBorder}"
                            BorderThickness="0,0,0,1"
                            Canvas.ZIndex="1">
                        <Grid x:Name="HeaderGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Timestamp, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding ProviderGuid, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding ProcessName, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding ProcessId, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding ProviderName, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding EventName, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding Level, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding Opcode, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding ThreadId, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding Payload, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" MinWidth="350" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Timestamp" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="1" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="2" Text="ProviderGuid" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="3" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="4" Text="Process" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="5" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="6" Text="PID" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="7" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="8" Text="Provider" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="9" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="10" Text="Event" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="11" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="12" Text="Level" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="13" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="14" Text="Opcode" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="15" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="16" Text="TID" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                            <Border Grid.Column="17" Background="{ThemeResource LaneBg}" VerticalAlignment="Stretch" />
                            <TextBlock Grid.Column="18" Text="Payload" Padding="8,8" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
                        </Grid>
                    </Border>

                    <ItemsRepeater ItemsSource="{Binding PagedEvents}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Timestamp, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding ProviderGuid, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding ProcessName, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding ProcessId, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding ProviderName, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding EventName, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding Level, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding Opcode, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding ThreadId, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="{Binding Payload, Source={StaticResource SharedColumnWidths}, Mode=OneWay}" MinWidth="350" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, Converter={StaticResource TimestampConverter}}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ProviderGuid, Converter={StaticResource GuidToLowercaseConverter}}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="3" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ProcessName}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="5" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="6" Text="{Binding ProcessId}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="7" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="8" Text="{Binding ProviderName}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="9" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="10" Text="{Binding EventName}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="11" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="12" Text="{Binding Level}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="13" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="14" Text="{Binding Opcode}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="15" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="16" Text="{Binding ThreadId}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="17" Background="{ThemeResource LaneBg}" />
                                    <TextBlock Grid.Column="18" Text="{Binding PayloadText}" Padding="8,6" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagination Bar -->
            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource AppBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="12,8"
                    Background="{ThemeResource SurfaceBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Previous"
                                Click="PreviousButton_Click"
                                Width="70"
                                Padding="8,6"
                                Background="{ThemeResource SurfaceBg}"
                                Foreground="{ThemeResource AppText}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource AppBorder}"
                                Style="{StaticResource NoHoverButtonStyle}" />
                        <Button Content="Next"
                                Click="NextButton_Click"
                                Width="70"
                                Padding="8,6"
                                Background="{ThemeResource SurfaceBg}"
                                Foreground="{ThemeResource AppText}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource AppBorder}"
                                Style="{StaticResource NoHoverButtonStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Page" Foreground="{ThemeResource SubText}" />
                        <TextBlock Text="{Binding CurrentPage}" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        <TextBlock Text="of" Foreground="{ThemeResource SubText}" />
                        <TextBlock Text="{Binding TotalPages}" FontWeight="SemiBold" Foreground="#EEEEEE" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="Page size:" Foreground="{ThemeResource SubText}" />
                        <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                  SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                  Width="80"
                                  Background="{ThemeResource SurfaceBg}"
                                  Foreground="#EEEEEE"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource AppBorder}"
                                  Style="{StaticResource NoHoverComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" 
                                Orientation="Horizontal" 
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Filtered:" Foreground="{ThemeResource SubText}" />
                        <TextBlock Text="{Binding FilteredCount}" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        <TextBlock Text="•" Foreground="#888888" />
                        <TextBlock Text="Total:" Foreground="{ThemeResource SubText}" />
                        <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold" Foreground="#EEEEEE" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


