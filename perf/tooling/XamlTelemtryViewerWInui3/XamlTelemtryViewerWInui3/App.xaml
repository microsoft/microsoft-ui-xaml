<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="XamlTelemtryViewerWInui3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XamlTelemtryViewerWInui3"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <SolidColorBrush x:Key="AppBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="PanelBg" Color="#252526" />
                    <SolidColorBrush x:Key="SurfaceBg" Color="#2D2D30" />
                    <SolidColorBrush x:Key="LaneBg" Color="#3E3E42" />
                    <SolidColorBrush x:Key="LaneBg2" Color="#2A2A2E" />
                    <SolidColorBrush x:Key="DividerBg" Color="#3E3E42" />
                    <SolidColorBrush x:Key="AppText" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="SubText" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="AppBorder" Color="#45454A" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
