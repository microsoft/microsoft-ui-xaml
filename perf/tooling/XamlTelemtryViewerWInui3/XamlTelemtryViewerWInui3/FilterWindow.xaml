<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XamlTelemtryViewerWInui3.FilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XamlTelemtryViewerWInui3"
    xmlns:models="using:XamlTelemtryViewerWInui3.Models"
    xmlns:helpers="using:XamlTelemtryViewerWInui3.Helpers"
    xmlns:converters="using:XamlTelemtryViewerWInui3.Converters"
    Title="Filter Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="NoHoverButtonStyle" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter 
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SimpleComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <converters:GuidToLowercaseConverter x:Key="GuidToLowercaseConverter" />
            <converters:FilterJoinConverter x:Key="FilterJoinConverter" />
            <converters:FilterFieldConverter x:Key="FilterFieldConverter" />
            <converters:FilterOperatorConverter x:Key="FilterOperatorConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12" Background="{ThemeResource AppBg}">
            <Button Content="Add Group" Padding="12,6" MinWidth="100" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding AddGroupCommand}" />
            <Button Content="Remove Group" Padding="12,6" MinWidth="110" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding RemoveGroupCommand}" />
            <Button Content="Add Condition" Padding="12,6" MinWidth="120" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding AddConditionCommand}" />
            <Button Content="Remove Condition" Padding="12,6" MinWidth="140" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding RemoveConditionCommand}" />
            <Button Content="Clear All" Padding="12,6" MinWidth="90" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding ClearAllCommand}" />
        </StackPanel>

        <!-- Groups list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{ThemeResource AppBg}" Margin="0,0,0,12">
            <ItemsRepeater x:Name="GroupsRepeater" ItemsSource="{Binding Filter.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <DataTemplate>
                    <Border BorderBrush="{ThemeResource AppBorder}" BorderThickness="2" CornerRadius="2" Padding="12" Background="{ThemeResource AppBg}">
                        <StackPanel Spacing="12">
                            <!-- Group header row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left: Enabled checkbox and label -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="Enabled" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                                
                                <!-- Center: Join with previous dropdown -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <TextBlock Text="Join with previous:" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" FontSize="14" />
                                    <ComboBox Width="110" SelectedValue="{Binding JoinWithPrevious, Mode=TwoWay, Converter={StaticResource FilterJoinConverter}}" SelectedValuePath="Content" BorderBrush="{ThemeResource AppBorder}" Foreground="{ThemeResource AppText}" Background="{ThemeResource AppBg}" Style="{StaticResource SimpleComboBoxStyle}">
                                        <ComboBoxItem Content="And" />
                                        <ComboBoxItem Content="Or" />
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Right: Filter Group label -->
                                <TextBlock Grid.Column="2" Text="Filter Group" FontWeight="Bold" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" FontSize="14" HorizontalAlignment="Right" Margin="12,0" />
                            </Grid>

                            <!-- Table border -->
                            <Border BorderBrush="{ThemeResource AppBorder}" BorderThickness="1" Background="{ThemeResource AppBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="45" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- On checkbox header -->
                                    <Border Grid.Column="0" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,1" Background="{ThemeResource PanelBg}">
                                        <TextBlock Text="On" FontWeight="Bold" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,1" Background="{ThemeResource PanelBg}">
                                        <TextBlock Text="Join" FontWeight="Bold" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,1" Background="{ThemeResource PanelBg}">
                                        <TextBlock Text="Field" FontWeight="Bold" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" Padding="8,0" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,1" Background="{ThemeResource PanelBg}">
                                        <TextBlock Text="Op" FontWeight="Bold" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="4" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0" Background="{ThemeResource PanelBg}">
                                        <TextBlock Text="Value" FontWeight="Bold" Foreground="{ThemeResource AppText}" VerticalAlignment="Center" Padding="8,0" />
                                    </Border>

                                    <!-- Data rows -->
                                    <ItemsRepeater Grid.Row="1" Grid.ColumnSpan="5" ItemsSource="{Binding Conditions}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="0" />
                                        </ItemsRepeater.Layout>
                                        <DataTemplate>
                                            <Grid MinHeight="45">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" MinWidth="150" />
                                                </Grid.ColumnDefinitions>

                                                <!-- On checkbox -->
                                                <Border Grid.Column="0" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,0" Padding="8">
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>

                                                <!-- Join dropdown -->
                                                <Border Grid.Column="1" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,0" Padding="4">
                                                    <ComboBox Name="JoinCombo" SelectedValue="{Binding JoinWithPrevious, Mode=TwoWay, Converter={StaticResource FilterJoinConverter}}" SelectedValuePath="Content" BorderBrush="{ThemeResource AppBorder}" Foreground="{ThemeResource AppText}" Background="{ThemeResource AppBg}" Style="{StaticResource SimpleComboBoxStyle}">
                                                        <ComboBoxItem Content="And" />
                                                        <ComboBoxItem Content="Or" />
                                                    </ComboBox>
                                                </Border>

                                                <!-- Field dropdown -->
                                                <Border Grid.Column="2" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,0" Padding="4">
                                                    <ComboBox Name="FieldCombo" SelectedValue="{Binding Field, Mode=TwoWay, Converter={StaticResource FilterFieldConverter}}" SelectedValuePath="Content" BorderBrush="{ThemeResource AppBorder}" Foreground="{ThemeResource AppText}" Background="{ThemeResource AppBg}" Style="{StaticResource SimpleComboBoxStyle}">
                                                        <ComboBoxItem Content="ProcessName" />
                                                        <ComboBoxItem Content="ProcessId" />
                                                        <ComboBoxItem Content="ProviderName" />
                                                        <ComboBoxItem Content="EventName" />
                                                        <ComboBoxItem Content="Level" />
                                                        <ComboBoxItem Content="Opcode" />
                                                        <ComboBoxItem Content="ThreadId" />
                                                        <ComboBoxItem Content="Payload" />
                                                    </ComboBox>
                                                </Border>

                                                <!-- Op dropdown -->
                                                <Border Grid.Column="3" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0,0,1,0" Padding="4">
                                                    <ComboBox Name="OpCombo" SelectedValue="{Binding Operator, Mode=TwoWay, Converter={StaticResource FilterOperatorConverter}}" SelectedValuePath="Content" BorderBrush="{ThemeResource AppBorder}" Foreground="{ThemeResource AppText}" Background="{ThemeResource AppBg}" Style="{StaticResource SimpleComboBoxStyle}">
                                                        <ComboBoxItem Content="Contains" />
                                                        <ComboBoxItem Content="Equals" />
                                                        <ComboBoxItem Content="StartsWith" />
                                                        <ComboBoxItem Content="EndsWith" />
                                                    </ComboBox>
                                                </Border>

                                                <!-- Value textbox -->
                                                <Border Grid.Column="4" BorderBrush="{ThemeResource AppBorder}" BorderThickness="0" Padding="4">
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="Enter value" BorderBrush="{ThemeResource AppBorder}" Foreground="{ThemeResource AppText}" Background="{ThemeResource AppBg}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Query text box area -->
        <StackPanel Grid.Row="2" Spacing="4" Background="{ThemeResource AppBg}" Margin="0,8,0,0">
            <TextBlock Text="Query Text (edit and click Parse to update filters from text):" FontWeight="SemiBold" Foreground="{ThemeResource AppText}" />
            <TextBox x:Name="QueryTextBox" Text="{Binding QueryText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" MaxHeight="120" FontFamily="Consolas" Foreground="{ThemeResource AppText}" Background="{ThemeResource AppBg}" BorderBrush="{ThemeResource AppBorder}" />
        </StackPanel>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0" Background="{ThemeResource AppBg}">
            <Button Content="Parse Query Text" Padding="14,6" MinWidth="140" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Click="ParseQueryTextButton_Click" />
            <Button Content="Refresh Text" Padding="14,6" MinWidth="120" Background="{ThemeResource AppBg}" Foreground="{ThemeResource AppText}" BorderThickness="1" BorderBrush="{ThemeResource AppBorder}" Style="{StaticResource NoHoverButtonStyle}" Click="RefreshTextButton_Click" />
            <Button Content="Apply" Padding="14,6" MinWidth="100" Background="#4CAF50" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Style="{StaticResource NoHoverButtonStyle}" Click="ApplyButton_Click" />
        </StackPanel>
    </Grid>

</Window>

