<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputPath>bin\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Performance.SDK is pinned to 1.2.x because WPA (current version)
      bundles SDK runtime 1.2.0 and refuses to install .ptix files built against
      SDK 1.3.x with: "This plugin depends on SDK version 1.3.0, which is
      incompatible with the current SDK version (1.2.0)". Bump these to 1.3.x
      only after WPA itself updates.
    -->
    <PackageReference Include="Microsoft.Performance.SDK" Version="1.2.16" />
    <PackageReference Include="Microsoft.Performance.SDK.Runtime" Version="1.2.16" />
    <PackageReference Include="Microsoft.Windows.EventTracing.Processing.All" Version="1.12.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XamlTimeline\XamlTimeline.csproj" />
  </ItemGroup>

</Project>
