<Page
    x:Class="XAMLPerf.ScrollingApp.CS.MUX.VerticalListViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XAMLPerf.ScrollingApp.CS.MUX"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ItemTemplate" x:DataType="local:Item">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <StackPanel Width="400" Orientation="Vertical">
                        <TextBlock Text="{x:Bind Animal}" FontSize="18" FontStyle="Italic" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind CountryOrRegion}" Margin="2" />
                    </StackPanel>
                    <TextBlock Width="100" Text="{x:Bind Sightings}" VerticalAlignment="Center" />
                    <TextBlock Width="50" Text="{x:Bind Count, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10">
        <ListView x:Name="listView"
                  IsTabStop="True"
                  ItemClick="listView_ItemClick"
                  IsItemClickEnabled="True"
                  ItemsSource="{x:Bind Items}"
                  ItemTemplate="{StaticResource ItemTemplate}"/>
    </Grid>
</Page>
