<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="XamlProfiler" Tag="XamlProfiler">
  <Profiles>

    <!-- Event Collector -->
    <EventCollector Id="EC_XamlProfiler" Name="XamlProfiler Event Collector">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </EventCollector>

    <!-- XAML Profiler TraceLogging provider ("Microsoft-Windows-XAML-Profiler").
         0x7 = XamlTree | CompTree | WucTree; see XamlProfilerKeywords in XamlProfilerTracing.h for the other groups. -->
    <EventProvider Id="EP_XamlProfiler" Name="26f28a5c-7d30-54c5-40f4-fff6d3beda7d" Level="5">
      <Keywords>
        <Keyword Value="0x7" />
      </Keywords>
    </EventProvider>

    <!-- Microsoft-Windows-XAML. Its ElementSetNameInfo event (213) carries the x:Name that ElementEnteredTree
         doesn't, and ElementCreatedInfo (61) marks new elements; both are in the Detailed keyword (0x1). The
         wider mask also records the provider's other events for reference. -->
    <EventProvider Id="EP_MicrosoftWindowsXaml" Name="531A35AB-63CE-4BCF-AA98-F88C7A89E455" Level="5">
      <Keywords>
        <Keyword Value="0xFFFF" />
      </Keywords>
    </EventProvider>

    <!-- Profile: Verbose -->
    <Profile Id="XamlProfiler.Verbose.File" Name="XamlProfiler" Description="XAML Profiler tree-tracking events"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <EventCollectorId Value="EC_XamlProfiler">
          <EventProviders>
            <EventProviderId Value="EP_XamlProfiler" />
            <EventProviderId Value="EP_MicrosoftWindowsXaml" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>

  </Profiles>
</WindowsPerformanceRecorder>
