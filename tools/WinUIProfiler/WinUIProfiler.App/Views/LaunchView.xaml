<UserControl
    x:Class="WinUIProfiler.App.Views.LaunchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIProfiler.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="0,8,0,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="EditButton" x:Uid="EditMarkers" Click="Edit_Click" />
            <Button x:Name="ReloadButton" x:Uid="ReloadMarkers" Grid.Column="1" Click="Reload_Click" />
            <TextBlock x:Name="ConfigSummary" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="LaunchSummary" Grid.Row="1" TextTrimming="CharacterEllipsis" />
        <InfoBar x:Name="ConfigError" Grid.Row="2" Severity="Warning" IsClosable="False" />
        <InfoBar x:Name="ReadError" x:Uid="LaunchReadError" Grid.Row="3" Severity="Error" IsClosable="False" />
        <InfoBar x:Name="NotesBar" Grid.Row="4" Severity="Informational" IsClosable="False" />
        <Grid Grid.Row="5" Padding="12,0,24,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="MilestoneHeaderLabel" Style="{StaticResource HeaderTextStyle}" />
            <TextBlock Grid.Column="1" x:Uid="MilestoneHeaderTime" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
            <TextBlock Grid.Column="2" x:Uid="MilestoneHeaderSincePrevious" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" x:Uid="MilestoneHeaderTimeline" Style="{StaticResource HeaderTextStyle}" />
            <TextBlock Grid.Column="4" x:Uid="MilestoneHeaderEvent" Style="{StaticResource HeaderTextStyle}" />
            <TextBlock Grid.Column="5" x:Uid="MilestoneHeaderThread" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
            <TextBlock Grid.Column="6" x:Uid="MilestoneHeaderCount" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
        </Grid>
        <ListView x:Name="MilestoneList" x:Uid="MilestoneList" Grid.Row="6" SelectionMode="None"
                  ItemsSource="{x:Bind Milestones}" ItemContainerStyle="{StaticResource CompactItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LaunchMilestoneRow">
                    <Grid ColumnSpacing="12" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Label}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Time}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SincePrevious}" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- The waterfall: the track is the whole timeline, and the bar runs from the milestone before to this one.
                             LaunchView.TrackWidth is this column's width. -->
                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Rectangle Height="10" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Margin="{x:Bind BarMargin}"
                                       Width="{x:Bind BarWidth}" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <TextBlock Grid.Column="4" Text="{x:Bind Event}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Event}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Thread}" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind Count}" VerticalAlignment="Center" TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="NotReachedText" Grid.Row="7" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
    </Grid>
</UserControl>
