<UserControl
    x:Class="WinUIProfiler.App.Views.SnapshotCompositionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinUIProfiler.App.Views">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="Status" x:Uid="SnapshotCompositionStatus" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="Scope" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="SnapshotCompositionEvidenceScope" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="SourcePath" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock x:Name="NativeSummary" x:Uid="SnapshotCompositionNativeSummary"
                       TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" />
            <TextBlock x:Name="WinUISummary" x:Uid="SnapshotCompositionWinUISummary"
                       TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Mode" x:Uid="SnapshotCompositionMode" SelectedIndex="0"
                      SelectionChanged="Filter_Changed" VerticalAlignment="Center">
                <ComboBoxItem x:Uid="SnapshotCompositionNativeMode" />
                <ComboBoxItem x:Uid="SnapshotCompositionWinUIMode" />
            </ComboBox>
            <TextBox x:Name="Search" x:Uid="SnapshotCompositionSearch" Grid.Column="1"
                     TextChanged="Search_Changed" VerticalAlignment="Center" />
            <CheckBox x:Name="ReleasedOnly" x:Uid="SnapshotCompositionReleasedOnly" Grid.Column="2"
                      Click="ReleasedOnly_Click" VerticalAlignment="Center" />
            <Button x:Name="Refresh" x:Uid="SnapshotCompositionRefresh" Grid.Column="3"
                    Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="SnapshotCompositionNameColumn" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="SnapshotCompositionIdColumn" Grid.Column="1" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="SnapshotCompositionCreationColumn" Grid.Column="2" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="SnapshotCompositionReleaseColumn" Grid.Column="3" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Uid="SnapshotCompositionEvidenceColumn" Grid.Column="4" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <Grid Grid.Row="4">
            <ListView x:Name="Lifetimes" x:Uid="SnapshotCompositionLifetimes" MaxHeight="220"
                      SelectionChanged="Lifetimes_SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:SnapshotCompositionDisplayRow">
                        <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.Name="{x:Bind Description, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label, Mode=OneTime}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}" />
                            <TextBlock Text="{x:Bind NativeId, Mode=OneTime}" Grid.Column="1" />
                            <TextBlock Text="{x:Bind Created, Mode=OneTime}" Grid.Column="2" />
                            <TextBlock Text="{x:Bind Released, Mode=OneTime}" Grid.Column="3" />
                            <TextBlock Text="{x:Bind Evidence, Mode=OneTime}" Grid.Column="4" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Empty" x:Uid="SnapshotCompositionEmpty" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
        <Expander Grid.Row="5" x:Uid="SnapshotCompositionDetailsHeading" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="Details" x:Uid="SnapshotCompositionLifetimeDetails" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
