<UserControl
    x:Class="WinUIProfiler.App.Views.CpuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:WinUIProfiler.App.Views">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- The tree's rows stretch, so their numbers line up at the right however deep the function is. -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="TreeItemTemplate" x:DataType="controls:TreeViewNode">
            <Grid ColumnSpacing="8" Margin="0,0,8,0" Opacity="{x:Bind ((local:CpuTreeLabel)Content).Opacity}"
                  ToolTipService.ToolTip="{x:Bind ((local:CpuTreeLabel)Content).ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ((local:CpuTreeLabel)Content).Function}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind ((local:CpuTreeLabel)Content).Total}" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{x:Bind ((local:CpuTreeLabel)Content).Self}" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{x:Bind ((local:CpuTreeLabel)Content).Ms}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="0,8,0,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="OpenSessionFile" Click="Open_Click" />
            <TextBlock x:Name="FileSummary" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ComboBox x:Name="ThreadFilter" x:Uid="CpuViewThreads" Grid.Column="2" MinWidth="240" IsEnabled="False" />
            <Button x:Name="RefreshButton" x:Uid="CpuViewRefresh" Grid.Column="3" Click="Refresh_Click" IsEnabled="False" />
        </Grid>
        <InfoBar x:Name="ReadError" x:Uid="FramesReadError" Grid.Row="1" Severity="Error" IsClosable="False" />
        <InfoBar x:Name="Notice" Grid.Row="2" Severity="Informational" IsClosable="False" />
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" x:Uid="CpuViewSearch" TextChanged="SearchBox_TextChanged" />
                    <ComboBox x:Name="SortOrder" x:Uid="CpuViewSort" Grid.Column="1" MinWidth="136">
                        <ComboBoxItem x:Uid="CpuViewSortSelf" />
                        <ComboBoxItem x:Uid="CpuViewSortTotal" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="1" Padding="12,0,24,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="CpuViewHeaderSelf" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="1" x:Uid="CpuViewHeaderTotal" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" x:Uid="CpuViewHeaderFunction" Style="{StaticResource HeaderTextStyle}" />
                </Grid>
                <ListView x:Name="FunctionList" x:Uid="CpuViewFunctions" Grid.Row="2" SelectionMode="Single"
                          ItemContainerStyle="{StaticResource CompactItemStyle}" SelectionChanged="FunctionList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CpuFunctionRow">
                            <Grid ColumnSpacing="8" Margin="0,0,12,0" Opacity="{x:Bind Opacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Self}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Total}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Function}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ToolTip}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="4" Padding="16,0,0,0" BorderThickness="1,0,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="TreeMode" x:Uid="CpuViewTreeMode" Margin="0,0,0,4" MinWidth="280">
                    <ComboBoxItem x:Uid="CpuViewTopDown" />
                    <ComboBoxItem x:Uid="CpuViewCallers" />
                    <ComboBoxItem x:Uid="CpuViewCallees" />
                </ComboBox>
                <TextBlock x:Name="TreePrompt" x:Uid="CpuViewSelectFunction" Grid.Row="1" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Grid.Row="2" Padding="12,0,20,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="CpuViewHeaderFunction" Style="{StaticResource HeaderTextStyle}" />
                    <TextBlock Grid.Column="1" x:Uid="CpuViewHeaderTotal" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" x:Uid="CpuViewHeaderSelf" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" x:Uid="CpuViewHeaderMs" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                </Grid>
                <TreeView x:Name="CallTree" x:Uid="CpuViewCallTree" Grid.Row="3" SelectionMode="Single" CanDragItems="False"
                          CanReorderItems="False" ItemTemplate="{StaticResource TreeItemTemplate}"
                          ItemContainerStyle="{StaticResource TreeItemStyle}" Expanding="CallTree_Expanding" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
