<UserControl
    x:Class="WinUIProfiler.App.Views.LiveMetricChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12">
        <Grid RowSpacing="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentValue" HorizontalAlignment="Right" FontWeight="SemiBold" />
            </Grid>
            <TextBlock Grid.Row="1" x:Name="MaximumValue" Style="{ThemeResource CaptionTextBlockStyle}" />
            <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Canvas x:Name="Plot" SizeChanged="Plot_SizeChanged" />
            </Border>
            <Grid Grid.Row="3">
                <TextBlock x:Uid="LiveChartEarlier" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Uid="LiveChartNow" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
            <TextBlock Grid.Row="4" x:Name="SourceStatus" x:Uid="LiveChartWaiting"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="UnavailableLabel" x:Uid="LiveChartUnavailable" Visibility="Collapsed" />
            <TextBlock x:Name="WaitingLabel" x:Uid="LiveChartWaiting" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
