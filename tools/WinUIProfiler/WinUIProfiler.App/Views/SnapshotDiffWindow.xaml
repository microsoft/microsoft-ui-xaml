<Window
    x:Class="WinUIProfiler.App.Views.SnapshotDiffWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinUIProfiler.App.Views">
    <Grid x:Name="Root" Padding="20" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="DiffTableTemplate" x:DataType="views:SnapshotDiffTableRow">
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Change}" />
                    <TextBlock Text="{x:Bind Label}" Grid.Column="1" TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind Label}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Uid="SnapshotDiffHeading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="BeforeIdentity" x:Uid="SnapshotDiffBeforeIdentity" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="AfterIdentity" x:Uid="SnapshotDiffAfterIdentity" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ProgressRing x:Name="Loading" x:Uid="SnapshotDiffLoading" IsActive="True" Width="28" Height="28" />
            <InfoBar x:Name="LoadError" x:Uid="SnapshotDiffError" Severity="Error" IsClosable="False" />
        </Grid>
        <Grid x:Name="Viewer" Grid.Row="2" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="2*" MinHeight="160" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Uid="SnapshotDiffOpenTrees" Click="OpenTrees_Click" />
                <TextBlock x:Name="NoDifferences" x:Uid="SnapshotDiffNoDifferences" VerticalAlignment="Center"
                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="SnapshotXamlHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="XamlSummary" x:Uid="SnapshotDiffXamlSummary" Grid.Row="1" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SnapshotDiffAddedRemovedHeading" Grid.Row="2"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid Grid.Row="3" ColumnSpacing="12" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SnapshotDiffTableChange" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="SnapshotDiffTableNode" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ListView x:Name="XamlChanges" x:Uid="SnapshotDiffXamlChanges" Grid.Row="4"
                              SelectionMode="Single" HorizontalContentAlignment="Stretch"
                              IsItemClickEnabled="True" ItemClick="ChangesTable_ItemClick"
                              ItemTemplate="{StaticResource DiffTableTemplate}" />
                    <TextBlock x:Name="XamlNoAddedRemoved" x:Uid="SnapshotDiffNoAddedRemoved" Grid.Row="4"
                               Margin="12,4" Visibility="Collapsed" IsHitTestVisible="False"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="SnapshotCompositionHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="CompositionSummary" x:Uid="SnapshotDiffCompositionSummary" Grid.Row="1" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SnapshotDiffAddedRemovedHeading" Grid.Row="2"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid Grid.Row="3" ColumnSpacing="12" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SnapshotDiffTableChange" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="SnapshotDiffTableNode" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <ListView x:Name="CompositionChanges" x:Uid="SnapshotDiffCompositionChanges" Grid.Row="4"
                              SelectionMode="Single" HorizontalContentAlignment="Stretch"
                              IsItemClickEnabled="True" ItemClick="ChangesTable_ItemClick"
                              ItemTemplate="{StaticResource DiffTableTemplate}" />
                    <TextBlock x:Name="CompositionNoAddedRemoved" x:Uid="SnapshotDiffNoAddedRemoved" Grid.Row="4"
                               Margin="12,4" Visibility="Collapsed" IsHitTestVisible="False"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </Grid>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <views:SnapshotResourceView x:Name="ResourceSnapshot" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
