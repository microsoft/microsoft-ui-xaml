<Window
    x:Class="WinUIProfiler.App.Views.SnapshotDiffWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:WinUIProfiler.App.Views">
    <Grid x:Name="Root" Padding="20" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="SnapshotDiffAddedBrush" ResourceKey="SystemFillColorSuccessBrush" />
                        <StaticResource x:Key="SnapshotDiffRemovedBrush" ResourceKey="SystemFillColorCriticalBrush" />
                        <StaticResource x:Key="SnapshotDiffEditedBrush" ResourceKey="SystemFillColorCautionBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <StaticResource x:Key="SnapshotDiffAddedBrush" ResourceKey="SystemFillColorSuccessBrush" />
                        <StaticResource x:Key="SnapshotDiffRemovedBrush" ResourceKey="SystemFillColorCriticalBrush" />
                        <StaticResource x:Key="SnapshotDiffEditedBrush" ResourceKey="SystemFillColorCautionBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="SnapshotDiffAddedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="SnapshotDiffRemovedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="SnapshotDiffEditedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <DataTemplate x:Key="DiffTreeTemplate" x:DataType="controls:TreeViewNode">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Height="12" VerticalAlignment="Center"
                                   Fill="{ThemeResource SnapshotDiffAddedBrush}"
                                   Visibility="{x:Bind ((views:SnapshotDiffTreeItem)Content).AddedVisibility}" />
                        <Rectangle Height="12" VerticalAlignment="Center"
                                   Fill="{ThemeResource SnapshotDiffRemovedBrush}"
                                   Visibility="{x:Bind ((views:SnapshotDiffTreeItem)Content).RemovedVisibility}" />
                        <Rectangle Height="12" VerticalAlignment="Center"
                                   Fill="{ThemeResource SnapshotDiffEditedBrush}"
                                   Visibility="{x:Bind ((views:SnapshotDiffTreeItem)Content).EditedVisibility}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Uid="SnapshotDiffCorrelatedNode" FontSize="12" Glyph="&#xE71B;"
                                      Visibility="{x:Bind ((views:SnapshotDiffTreeItem)Content).MatchVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ((views:SnapshotDiffTreeItem)Content).Label}"
                                       ToolTipService.ToolTip="{x:Bind ((views:SnapshotDiffTreeItem)Content).Label}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Uid="SnapshotDiffHeading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="BeforeIdentity" x:Uid="SnapshotDiffBeforeIdentity" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="AfterIdentity" x:Uid="SnapshotDiffAfterIdentity" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="SnapshotDiffScope" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ProgressRing x:Name="Loading" x:Uid="SnapshotDiffLoading" IsActive="True" Width="28" Height="28" />
            <InfoBar x:Name="LoadError" x:Uid="SnapshotDiffError" Severity="Error" IsClosable="False" />
        </Grid>
        <Grid x:Name="Viewer" Grid.Row="2" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="ChangesOnly" x:Uid="SnapshotDiffChangesOnly" IsChecked="True"
                          Click="ChangesOnly_Click" />
                <TextBlock x:Name="NoDifferences" x:Uid="SnapshotDiffNoDifferences" VerticalAlignment="Center"
                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="SnapshotXamlHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="XamlSummary" x:Uid="SnapshotDiffXamlSummary" Grid.Row="1" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="XamlExpandAll" x:Uid="SnapshotXamlExpandAll" Click="ExpandAll_Click" />
                        <Button x:Name="XamlCollapseAll" x:Uid="SnapshotXamlCollapseAll" Click="CollapseAll_Click" />
                    </StackPanel>
                    <TreeView x:Name="XamlTree" x:Uid="SnapshotXamlTree" Grid.Row="3"
                              SelectionMode="Single" CanDragItems="False" CanReorderItems="False"
                              ItemTemplate="{StaticResource DiffTreeTemplate}"
                              Expanding="Tree_Expanding" SelectionChanged="Tree_SelectionChanged"
                              ItemInvoked="Tree_ItemInvoked" DoubleTapped="XamlTree_DoubleTapped" />
                </Grid>
                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="SnapshotCompositionHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="CompositionSummary" x:Uid="SnapshotDiffCompositionSummary" Grid.Row="1" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CompositionExpandAll" x:Uid="SnapshotCompositionExpandAll" Click="ExpandAll_Click" />
                        <Button x:Name="CompositionCollapseAll" x:Uid="SnapshotCompositionCollapseAll" Click="CollapseAll_Click" />
                    </StackPanel>
                    <TreeView x:Name="CompositionTree" x:Uid="SnapshotCompositionTree" Grid.Row="3"
                              SelectionMode="Single" CanDragItems="False" CanReorderItems="False"
                              ItemTemplate="{StaticResource DiffTreeTemplate}"
                              Expanding="Tree_Expanding" SelectionChanged="Tree_SelectionChanged"
                              ItemInvoked="Tree_ItemInvoked" DoubleTapped="CompositionTree_DoubleTapped" />
                </Grid>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SelectionSummary" x:Uid="SnapshotDiffSelection" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="BeforeLocation" x:Uid="SnapshotDiffBeforeLocation" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="AfterLocation" x:Uid="SnapshotDiffAfterLocation" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="MappingStatus" x:Uid="SnapshotDiffMappingStatus"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox x:Name="Matches" x:Uid="SnapshotDiffMatches"
                              HorizontalAlignment="Stretch" SelectionChanged="Matches_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="views:SnapshotDiffMatchItem">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="SnapshotDiffProperty" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SnapshotDiffBeforeValue" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SnapshotDiffAfterValue" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <ListView x:Name="PropertyChanges" x:Uid="SnapshotDiffPropertyValues" Grid.Row="1"
                          SelectionMode="None" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:SnapshotDiffPropertyRow">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind Before}" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind After}" Grid.Column="2" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
