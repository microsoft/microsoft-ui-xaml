<UserControl
    x:Class="WinUIProfiler.App.Views.SnapshotResourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinUIProfiler.App.Views">
    <Expander x:Uid="SnapshotResourceHeading" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" IsExpanded="True">
        <StackPanel Spacing="6">
            <TextBlock x:Name="Status" x:Uid="SnapshotResourceStatus" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="Scope" x:Uid="SnapshotResourceScope" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid ColumnSpacing="12" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition x:Name="BeforeColumn" Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DeltaColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="SnapshotResourceMetric" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="BeforeHeader" x:Uid="SnapshotResourceBefore" Grid.Column="1" />
                <TextBlock x:Name="AfterHeader" Grid.Column="2" />
                <TextBlock x:Name="DeltaHeader" x:Uid="SnapshotResourceDelta" Grid.Column="3" />
            </Grid>
            <ListView x:Name="Values" x:Uid="SnapshotResourceValues" MaxHeight="160"
                      SelectionMode="None" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:SnapshotResourceDisplayRow">
                        <Grid ColumnSpacing="12" Padding="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="{x:Bind ComparisonWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{x:Bind ComparisonWidth}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Metric}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Before}" Grid.Column="1" Visibility="{x:Bind ComparisonVisibility}"
                                       IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind After}" Grid.Column="2" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Delta}" Grid.Column="3" Visibility="{x:Bind ComparisonVisibility}"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Expander>
</UserControl>
