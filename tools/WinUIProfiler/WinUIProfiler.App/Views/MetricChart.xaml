<UserControl
    x:Class="WinUIProfiler.App.Views.MetricChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinUIProfiler.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SeriesBrush0" Color="#0078D4" />
                    <SolidColorBrush x:Key="SeriesBrush1" Color="#B35B00" />
                    <SolidColorBrush x:Key="SeriesBrush2" Color="#107C10" />
                    <x:Double x:Key="GridOpacity">0.15</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SeriesBrush0" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SeriesBrush1" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SeriesBrush2" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <x:Double x:Key="GridOpacity">0.7</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="AxisScale" Grid.Row="1" Style="{ThemeResource CaptionTextBlockStyle}" />
            <Grid x:Name="Plot" Grid.Row="2" SizeChanged="Plot_SizeChanged">
                <Grid Opacity="{ThemeResource GridOpacity}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="4" BorderThickness="0,1"
                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>
                <ItemsControl x:Name="Paths" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:MetricChartSeries">
                            <Path Data="{x:Bind Geometry}" Stroke="{x:Bind Stroke}" StrokeThickness="2"
                                  StrokeDashArray="{x:Bind Dashes}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Grid.Row="3">
                <TextBlock x:Name="WindowStart" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="WindowEnd" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock x:Name="EmptyState" TextWrapping="Wrap" />
                <ItemsControl x:Name="Legend">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:MetricChartSeries">
                            <TextBlock Text="{x:Bind Label}" Foreground="{x:Bind Stroke}"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
