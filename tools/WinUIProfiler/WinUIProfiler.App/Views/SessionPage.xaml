<Page
    x:Class="WinUIProfiler.App.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinUIProfiler.App.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Heading" Style="{ThemeResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" x:Uid="SnapshotViewer" AutomationProperties.AutomationId="SnapshotViewer"
                    Click="SnapshotViewer_Click" VerticalAlignment="Center" />
        </Grid>
        <InfoBar Grid.Row="1" x:Uid="AppScope" IsOpen="True" IsClosable="False" Severity="Informational" />
        <TabView Grid.Row="2" IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False">
            <TabViewItem x:Uid="LiveMetricsTab" AutomationProperties.AutomationId="ProcessMetricsTab" IsClosable="False">
                <ScrollViewer AutomationProperties.AutomationId="ProcessMetricsScroll"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <Grid Padding="0,8,12,8" RowSpacing="8" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" x:Uid="NoProcess" TextWrapping="Wrap" />
                        <views:LiveMetricChart Grid.Row="1" x:Uid="LiveCpuChart" />
                        <views:LiveMetricChart Grid.Row="1" Grid.Column="1" x:Uid="LiveGpuChart" />
                        <views:LiveMetricChart Grid.Row="2" x:Uid="LiveWorkingSetChart" />
                        <views:LiveMetricChart Grid.Row="2" Grid.Column="1" x:Uid="LivePrivateWorkingSetChart" />
                        <views:LiveMetricChart Grid.Row="3" x:Uid="LiveCommitChart" />
                    </Grid>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem x:Uid="SavedSessionTab" AutomationProperties.AutomationId="SavedSessionTab" IsClosable="False">
                <Grid Padding="0,8,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="NoSession" TextWrapping="Wrap" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="SessionPath" IsEnabled="False" />
                        <Button Grid.Column="1" x:Uid="Open" AutomationProperties.AutomationId="OpenSession"
                                IsEnabled="False" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SessionId" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" x:Uid="ProcessId" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="2" x:Uid="RecordedState" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    </Grid>
                    <ListView Grid.Row="3" x:Uid="Metrics" IsEnabled="False" />
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
