<ContentDialog
    x:Class="WinUIProfiler.App.Views.TargetPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinUIProfiler.App.ViewModels"
    IsPrimaryButtonEnabled="{x:Bind Model.CanSelect, Mode=OneWay}">
    <ContentDialog.Resources>
        <DataTemplate x:Key="TargetTemplate" x:DataType="models:TargetCandidate">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>
    <StackPanel Spacing="8">
        <TextBox x:Name="Search" x:Uid="TargetSearch" TextChanged="Search_TextChanged" />
        <Button x:Uid="TargetRefresh" IsEnabled="{x:Bind Model.CanRefresh, Mode=OneWay}" Click="Refresh_Click" />
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
        <ListView x:Uid="TargetList" Height="350" SelectionMode="Single"
                  ItemsSource="{x:Bind Model.Candidates, Mode=OneWay}"
                  SelectedItem="{x:Bind Model.Selected, Mode=TwoWay}"
                  ItemTemplate="{StaticResource TargetTemplate}" />
    </StackPanel>
</ContentDialog>
