<UserControl
    x:Class="WinUIProfiler.App.Views.FramesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIProfiler.App.Views"
    xmlns:vm="using:WinUIProfiler.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- A tint shows while its row isn't hovered or selected. -->
        <Style x:Key="RegionTickItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource CompactItemStyle}">
            <Setter Property="Background" Value="{ThemeResource RegionTickRowBackground}" />
        </Style>
        <Style x:Key="RegionItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource CompactItemStyle}">
            <Setter Property="Background" Value="{ThemeResource RegionRowBackground}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="NonTickItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource CompactItemStyle}">
            <Setter Property="Background" Value="{ThemeResource NonTickRowBackground}" />
        </Style>
        <local:FrameItemStyleSelector x:Key="FrameItemStyles" TickStyle="{StaticResource CompactItemStyle}"
                                      RegionTickStyle="{StaticResource RegionTickItemStyle}"
                                      RegionStyle="{StaticResource RegionItemStyle}" NonTickStyle="{StaticResource NonTickItemStyle}" />
        <Style x:Key="AccentBarStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="18" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendSwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="TickTemplate" x:DataType="vm:FrameRow">
            <Grid ColumnSpacing="8" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Number, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Start, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Rectangle Width="{x:Bind BarWidth, Mode=OneWay}" Height="8" RadiusX="1" RadiusY="1"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind Tick, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Visibility="{x:Bind SlowVisibility, Mode=OneWay}"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
                <FontIcon Grid.Column="3" Glyph="&#xE73E;" FontSize="12" Visibility="{x:Bind DrewVisibility, Mode=OneWay}"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Xaml, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{x:Bind Composition, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="{x:Bind Other, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RegionTemplate" x:DataType="vm:InterestingRowItem">
            <Grid ColumnSpacing="8" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Style="{StaticResource AccentBarStyle}" Fill="{ThemeResource RegionAccent}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NonTickTemplate" x:DataType="vm:InterestingRowItem">
            <Grid ColumnSpacing="8" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Style="{StaticResource AccentBarStyle}" Fill="{ThemeResource NonTickAccent}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontStyle="Italic" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <local:FrameItemTemplateSelector x:Key="FrameItemTemplates" TickTemplate="{StaticResource TickTemplate}"
                                         RegionTemplate="{StaticResource RegionTemplate}"
                                         NonTickTemplate="{StaticResource NonTickTemplate}" />
    </UserControl.Resources>
    <Grid Padding="0,8,0,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" x:Uid="OpenSessionFile" Click="Open_Click" />
            <TextBlock x:Name="FileSummary" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="LaunchSummary" Grid.Row="1" Style="{StaticResource HeaderTextStyle}" />
        <InfoBar x:Name="ReadError" x:Uid="FramesReadError" Grid.Row="2" Severity="Error" IsClosable="False" />
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="FramesShowLabel" VerticalAlignment="Center" />
                    <ComboBox x:Name="ShowFilter" x:Uid="FramesShow" MinWidth="220">
                        <ComboBoxItem x:Uid="FramesShowAll" />
                        <ComboBoxItem x:Uid="FramesShowInteresting" />
                        <ComboBoxItem x:Uid="FramesShowSlow" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource RegionRowBackground}"
                                BorderBrush="{ThemeResource RegionAccent}" />
                        <TextBlock x:Uid="LegendRegion" Style="{StaticResource HeaderTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource RegionTickRowBackground}"
                                BorderThickness="0" />
                        <TextBlock x:Uid="LegendRegionTick" Style="{StaticResource HeaderTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource NonTickRowBackground}"
                                BorderBrush="{ThemeResource NonTickAccent}" />
                        <TextBlock x:Uid="LegendNonTick" Style="{StaticResource HeaderTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Uid="LegendSlow" Style="{StaticResource HeaderTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" Padding="12,0,24,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="144" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="FramesHeaderNumber" Style="{StaticResource HeaderTextStyle}" />
                    <TextBlock Grid.Column="1" x:Uid="FramesHeaderStart" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" x:Uid="FramesHeaderTick" Style="{StaticResource HeaderTextStyle}" />
                    <TextBlock Grid.Column="3" x:Uid="FramesHeaderDrew" Style="{StaticResource HeaderTextStyle}" TextAlignment="Center" />
                    <TextBlock Grid.Column="4" x:Uid="FramesHeaderXaml" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" x:Uid="FramesHeaderComposition" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="6" x:Uid="FramesHeaderOther" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                </Grid>
                <ListView x:Name="FrameList" x:Uid="FrameList" Grid.Row="3" SelectionMode="Single"
                          ItemTemplateSelector="{StaticResource FrameItemTemplates}"
                          ItemContainerStyleSelector="{StaticResource FrameItemStyles}"
                          SelectionChanged="FrameList_SelectionChanged" />
                <TextBlock x:Name="EmptyText" Grid.Row="3" Margin="12,8" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8" Padding="16,0,0,0" BorderThickness="1,0,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The interesting rows in the selected region of interest. -->
                <Border x:Name="RegionPanel" Padding="12,8" CornerRadius="4" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Rectangle Style="{StaticResource AccentBarStyle}" Height="14" Fill="{ThemeResource RegionAccent}" />
                            <TextBlock x:Uid="RegionRowsHeader" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="InterestingHeaderStart" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                            <TextBlock Grid.Column="1" x:Uid="InterestingHeaderDuration" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" x:Uid="InterestingHeaderFrame" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" x:Uid="InterestingHeaderType" Style="{StaticResource HeaderTextStyle}" />
                        </Grid>
                        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RegionRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InterestingRowItem">
                                        <Grid ColumnSpacing="8" MinHeight="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Start}" VerticalAlignment="Center" TextAlignment="Right" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Duration}" VerticalAlignment="Center" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Frame}" VerticalAlignment="Center" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="Buckets" x:Uid="Buckets" SelectionChanged="Buckets_SelectionChanged">
                        <SelectorBarItem x:Uid="BucketAll" IsSelected="True" />
                        <SelectorBarItem x:Uid="BucketXaml" Tag="Xaml" />
                        <SelectorBarItem x:Uid="BucketComposition" Tag="Composition" />
                        <SelectorBarItem x:Uid="BucketOther" Tag="Other" />
                    </SelectorBar>
                    <TextBox x:Name="FilterBox" x:Uid="FilterBox" Grid.Column="1" VerticalAlignment="Center"
                             TextChanged="FilterBox_TextChanged" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="EventList" x:Uid="EventList" SelectionMode="Single"
                              ItemsSource="{x:Bind Events}" ItemContainerStyle="{StaticResource CompactItemStyle}"
                              SelectionChanged="EventList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FrameEventRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Fields}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Grid.Column="1" Padding="12,8" CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="EventDetails" x:Uid="EventDetails" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                            </ScrollViewer>
                            <!-- Outside the scrolling fields, so the links stay in view. The links scroll in a bounded area, so
                                 an event with many, such as a cleared parent's children, leaves room for the fields. -->
                            <StackPanel x:Name="ObjectLinksPanel" Grid.Row="1" Visibility="Collapsed">
                                <TextBlock x:Uid="ObjectLinksHeader" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ObjectLinks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ObjectLink">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ElementBadgeStyle}" Visibility="{x:Bind IsElement}">
                                                        <TextBlock Text="{x:Bind KindText}" Style="{StaticResource ElementBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource VisualBadgeStyle}" Visibility="{x:Bind IsVisual}">
                                                        <TextBlock Text="{x:Bind KindText}" Style="{StaticResource VisualBadgeTextStyle}" />
                                                    </Border>
                                                    <HyperlinkButton Grid.Column="1" Tag="{x:Bind Mention}" Padding="0,2" Click="ObjectLink_Click"
                                                                     AutomationProperties.Name="{x:Bind AccessibleName}">
                                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </HyperlinkButton>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FrameTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" />
                    <Button x:Name="PreviousButton" x:Uid="PreviousEvents" Grid.Column="1" Click="Previous_Click" IsEnabled="False" />
                    <TextBlock x:Name="Position" Grid.Column="2" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" x:Uid="NextEvents" Grid.Column="3" Click="Next_Click" IsEnabled="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
