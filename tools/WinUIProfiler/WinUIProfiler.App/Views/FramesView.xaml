<UserControl
    x:Class="WinUIProfiler.App.Views.FramesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIProfiler.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="0,8,0,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" x:Uid="OpenSessionFile" Click="Open_Click" />
            <TextBlock x:Name="FileSummary" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="LaunchSummary" Grid.Row="1" Style="{StaticResource HeaderTextStyle}" />
        <InfoBar x:Name="ReadError" x:Uid="FramesReadError" Grid.Row="2" Severity="Error" IsClosable="False" />
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="564" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,0,24,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="FramesHeaderNumber" Style="{StaticResource HeaderTextStyle}" />
                    <TextBlock Grid.Column="1" x:Uid="FramesHeaderDrawnAt" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" x:Uid="FramesHeaderDraw" Style="{StaticResource HeaderTextStyle}" />
                    <TextBlock Grid.Column="3" x:Uid="FramesHeaderXaml" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" x:Uid="FramesHeaderComposition" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" x:Uid="FramesHeaderOther" Style="{StaticResource HeaderTextStyle}" TextAlignment="Right" />
                </Grid>
                <ListView x:Name="FrameList" x:Uid="FrameList" Grid.Row="1" SelectionMode="Single"
                          ItemsSource="{x:Bind Frames}" ItemContainerStyle="{StaticResource CompactItemStyle}"
                          SelectionChanged="FrameList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FrameRow">
                            <Grid ColumnSpacing="8" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number, Mode=OneWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DrawnAt, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Rectangle Width="{x:Bind BarWidth, Mode=OneWay}" Height="8"
                                               Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind Draw, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Visibility="{x:Bind SlowVisibility, Mode=OneWay}"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind Xaml, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Composition, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Other, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="Buckets" x:Uid="Buckets" SelectionChanged="Buckets_SelectionChanged">
                        <SelectorBarItem x:Uid="BucketAll" IsSelected="True" />
                        <SelectorBarItem x:Uid="BucketXaml" Tag="Xaml" />
                        <SelectorBarItem x:Uid="BucketComposition" Tag="Composition" />
                        <SelectorBarItem x:Uid="BucketOther" Tag="Other" />
                    </SelectorBar>
                    <TextBox x:Name="FilterBox" x:Uid="FilterBox" Grid.Column="1" VerticalAlignment="Center"
                             TextChanged="FilterBox_TextChanged" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="EventList" x:Uid="EventList" SelectionMode="Single"
                              ItemsSource="{x:Bind Events}" ItemContainerStyle="{StaticResource CompactItemStyle}"
                              SelectionChanged="EventList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FrameEventRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" VerticalAlignment="Center" TextAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Fields}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Grid.Column="1" Padding="12,8" CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="EventDetails" x:Uid="EventDetails" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FrameTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" />
                    <Button x:Name="PreviousButton" x:Uid="PreviousEvents" Grid.Column="1" Click="Previous_Click" IsEnabled="False" />
                    <TextBlock x:Name="Position" Grid.Column="2" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" x:Uid="NextEvents" Grid.Column="3" Click="Next_Click" IsEnabled="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
