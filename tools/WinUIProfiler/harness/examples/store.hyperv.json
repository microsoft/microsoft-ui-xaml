{
  "$schema": "../config.schema.json",
  "schemaVersion": 2,
  "name": "store-hyperv",
  "harness": {
    "artifactsRoot": "../.artifacts"
  },
  "repositories": {
    "app": {
      "path": "C:\\Repos\\YourApp",
      "remoteUrl": "https://github.com/YOUR-ORG/YOUR-APP.git",
      "branch": "user/your-alias/profiler_harness",
      "baseRef": "HEAD",
      "allowDirty": false
    },
    "profiler": {
      "path": "C:\\Repos\\microsoft-ui-xaml",
      "remoteUrl": "https://github.com/microsoft/microsoft-ui-xaml.git",
      "branch": "user/your-alias/profiler_harness",
      "baseRef": "main",
      "allowDirty": true
    }
  },
  "target": {
    "kind": "hyperv",
    "stageRoot": "C:\\WinUIProfilerHarness",
    "vmId": "11111111-1111-1111-1111-111111111111",
    "guestMachineGuid": "22222222-2222-2222-2222-222222222222",
    "guestComputerName": "REPLACE-GUEST-NAME",
    "checkpointName": "ProfilerHarness-Clean-GuestSetup",
    "hyperv": {
      "name": "WinUIProfilerHarness",
      "userNameEnvironmentVariable": "PROFILER_HARNESS_VM_USER",
      "passwordEnvironmentVariable": "PROFILER_HARNESS_VM_PASSWORD"
    }
  },
  "agents": {
    "default": "agency"
  },
  "application": {
    "resetScript": "throw 'Configure and review an application-specific scenario reset in the guest before capture; no reset is supplied by this example.'",
    "buildCommands": [
      {
        "scope": "guest",
        "file": "pwsh",
        "arguments": [
          "-NoLogo",
          "-NoProfile",
          "-File",
          "{harnessRoot}\\scripts\\Ensure-DotNetSdk.ps1",
          "-RepoRoot",
          "{appRepo}"
        ],
        "workingDirectory": "{appRepo}",
        "timeoutSeconds": 1800
      },
      {
        "scope": "guest",
        "file": "pwsh",
        "arguments": [
          "-NoLogo",
          "-NoProfile",
          "-File",
          "{appRepo}\\.github\\skills\\store-naot-build\\scripts\\Build-NativeAot.ps1",
          "-RepoRoot",
          "{appRepo}",
          "-BuildOnly",
          "-TargetFramework",
          "net10.0-windows10.0.28000.0"
        ],
        "workingDirectory": "{appRepo}",
        "timeoutSeconds": 7200
      }
    ],
    "deployCommands": {
      "hyperv": [
        {
          "scope": "guest",
          "file": "pwsh",
          "arguments": [
            "-NoLogo",
            "-NoProfile",
            "-File",
            "{harnessRoot}\\scripts\\Prepare-StorePayload.ps1",
            "-RepoRoot",
            "{appRepo}",
            "-OutputRoot",
            "{artifactsRoot}\\payloads\\store-hyperv",
            "-StorePackageScript",
            "{harnessRoot}\\scripts\\StorePackage.ps1"
          ],
          "workingDirectory": "{appRepo}",
          "timeoutSeconds": 1800
        }
      ],
      "ixp": []
    },
    "payloadPath": "{artifactsRoot}\\payloads\\store-hyperv",
    "targetInstallScripts": {
      "hyperv": "& '{targetAppRoot}\\StorePackage.ps1' -Action Deploy -RepoRoot '{targetAppRoot}' -StatePath '{stageRoot}\\state\\store-original-package.json' -AllowMissingOriginalPackage | ConvertTo-Json -Depth 10"
    },
    "launch": {
      "kind": "packaged",
      "target": "Microsoft.WindowsStore_8wekyb3d8bbwe!App",
      "arguments": "",
      "workingDirectory": null
    }
  },
  "profiler": {
    "configuration": "Release",
    "platform": "x64",
    "buildTimeoutSeconds": 7200
  },
  "profiling": {
    "firstFrameTimeoutSeconds": 90,
    "scenarioTimeoutSeconds": 240,
    "settleMilliseconds": 3000,
    "frameBudgetMilliseconds": 16.7
  },
  "automation": {
    "scenarioPath": "store-search-netflix-safe.json"
  },
  "optimization": {
    "maxAttempts": 5,
    "samplesPerVersion": 3,
    "primaryMetric": "p95DrawMilliseconds",
    "direction": "lower",
    "minimumImprovementPercent": 5
  }
}
