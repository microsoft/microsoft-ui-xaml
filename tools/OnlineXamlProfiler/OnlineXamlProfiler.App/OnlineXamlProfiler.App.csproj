<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64;x86</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKMLAutoInitialize>false</WindowsAppSDKMLAutoInitialize>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(OnlineXamlWinAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(OnlineXamlBuildToolsVersion)" />
    <ProjectReference Include="..\OnlineXamlProfiler.Windows\OnlineXamlProfiler.Windows.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TapPlatform>$(Platform)</TapPlatform>
    <TapPlatform Condition="'$(Platform)' == 'x86'">Win32</TapPlatform>
    <NativeOutputDirectory>$(MSBuildThisFileDirectory)..\artifacts\bin\OnlineXamlProfilerTap\$(TapPlatform)\$(Configuration)\</NativeOutputDirectory>
    <TapOutput>$(NativeOutputDirectory)OnlineXamlProfilerTap.dll</TapOutput>
    <InjectorOutput>$(NativeOutputDirectory)OnlineXamlProfiler.Injector.exe</InjectorOutput>
  </PropertyGroup>
  <Target Name="CopyOnlineTap" AfterTargets="Build">
    <Error Condition="!Exists('$(TapOutput)')" Text="Build OnlineXamlProfilerTap for $(TapPlatform)|$(Configuration) first, or use build.ps1." />
    <Error Condition="!Exists('$(InjectorOutput)')" Text="Build OnlineXamlProfiler.Injector with the TAP, or use build.ps1." />
    <Copy SourceFiles="$(TapOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(InjectorOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
