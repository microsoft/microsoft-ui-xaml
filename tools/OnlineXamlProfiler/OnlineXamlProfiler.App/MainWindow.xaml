<Window
    x:Class="OnlineXamlProfiler.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:OnlineXamlProfiler.App">
    <Grid Padding="16" RowSpacing="12">
        <Grid.Resources>
            <DataTemplate x:Key="NodeTemplate" x:DataType="controls:TreeViewNode">
                <TextBlock Text="{x:Bind local:MainWindow.NodeLabel(Content)}" />
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="Executable" Text="{x:Bind ViewModel.Executable, Mode=TwoWay}" />
            <TextBox Grid.Column="1" x:Uid="Arguments" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay}" />
            <Button Grid.Column="2" x:Uid="LaunchExe" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.LaunchExeCommand}" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="Aumid" Text="{x:Bind ViewModel.Aumid, Mode=TwoWay}" />
            <Button Grid.Column="1" x:Uid="LaunchPackage" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.LaunchPackageCommand}" />
            <TextBox Grid.Column="2" x:Uid="ProcessId" Text="{x:Bind ViewModel.ProcessId, Mode=TwoWay}" />
            <Button Grid.Column="3" x:Uid="Attach" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AttachCommand}" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="TapPath" Text="{x:Bind ViewModel.TapPath, Mode=TwoWay}" />
            <Button Grid.Column="1" x:Uid="Capture" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.CaptureCommand}" />
            <Button Grid.Column="2" x:Uid="Disconnect" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.DisconnectCommand}" />
            <Button Grid.Column="3" x:Uid="Cancel" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.CancelCommand}" />
            <ComboBox Grid.Column="4" x:Uid="Snapshots" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                ItemsSource="{x:Bind ViewModel.Snapshots}" DisplayMemberPath="Label"
                SelectedItem="{x:Bind ViewModel.SelectedSnapshot, Mode=TwoWay}" />
            <Button x:Name="ExpandAllButton" Grid.Column="5" x:Uid="ExpandAll" VerticalAlignment="Bottom"
                IsEnabled="False" Click="ExpandAll_Click" />
        </Grid>
        <StackPanel Grid.Row="3" Spacing="4">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" IsTextSelectionEnabled="True" />
            <InfoBar x:Uid="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Uid="XamlHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TreeView x:Name="XamlTree" x:Uid="XamlTree" Grid.Row="1"
                    ItemTemplate="{StaticResource NodeTemplate}" CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                    SelectionMode="Single" SelectionChanged="Tree_SelectionChanged" />
            </Grid>
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Uid="CompHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TreeView x:Name="CompTree" x:Uid="CompTree" Grid.Row="1"
                    ItemTemplate="{StaticResource NodeTemplate}" CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                    SelectionMode="Single" SelectionChanged="Tree_SelectionChanged" />
            </Grid>
            <Grid Grid.Column="2" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Uid="VisualHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TreeView x:Name="VisualTree" x:Uid="VisualTree" Grid.Row="1"
                    ItemTemplate="{StaticResource NodeTemplate}" CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                    SelectionMode="Single" SelectionChanged="Tree_SelectionChanged" />
            </Grid>
        </Grid>
        <Grid Grid.Row="5" RowSpacing="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Uid="PropertiesHeading" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button x:Uid="LinkXaml" Tag="1" Click="Link_Click" />
                <Button x:Uid="LinkComp" Tag="2" Click="Link_Click" />
                <Button x:Uid="LinkVisual" Tag="3" Click="Link_Click" />
            </StackPanel>
            <ListView Grid.Row="1" x:Uid="Properties" ItemsSource="{x:Bind ViewModel.Properties}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PropertyRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
