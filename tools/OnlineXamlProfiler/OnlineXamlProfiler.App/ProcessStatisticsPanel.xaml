<UserControl
    x:Class="OnlineXamlProfiler.App.ProcessStatisticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="GraphPrimary" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="GraphSecondary" Color="{ThemeResource SystemBaseHighColor}" />
        <SolidColorBrush x:Key="GraphGrid" Color="{ThemeResource SystemBaseLowColor}" />
    </UserControl.Resources>
    <Expander x:Uid="StatisticsPanel" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="6">
            <TextBlock x:Name="SamplingStatus" AutomationProperties.AutomationId="StatisticsStatus"
                TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="RamGraphTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="RamValue" AutomationProperties.AutomationId="RamStatistics" TextWrapping="Wrap" />
                        <TextBlock x:Name="RamPeak" FontSize="12" TextWrapping="Wrap" />
                        <Canvas x:Name="RamGraph" Height="60" SizeChanged="Graph_SizeChanged" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="RamScale" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="CommitGraphTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="CommitValue" AutomationProperties.AutomationId="CommitStatistics" TextWrapping="Wrap" />
                        <TextBlock x:Name="CommitPeak" FontSize="12" TextWrapping="Wrap" />
                        <Canvas x:Name="CommitGraph" Height="60" SizeChanged="Graph_SizeChanged" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="CommitScale" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="GpuMemoryGraphTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuMemoryValue" AutomationProperties.AutomationId="GpuMemoryStatistics" TextWrapping="Wrap" />
                        <TextBlock x:Name="GpuMemoryPeak" FontSize="12" TextWrapping="Wrap" />
                        <Canvas x:Name="GpuMemoryGraph" Height="60" SizeChanged="Graph_SizeChanged" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="GpuMemoryScale" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8">
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="GpuEngineGraphTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuEngineValue" AutomationProperties.AutomationId="GpuEngineStatistics" TextWrapping="Wrap" />
                        <TextBlock x:Name="GpuEngineName" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Canvas x:Name="GpuEngineGraph" Height="60" SizeChanged="Graph_SizeChanged" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="GpuEngineScale" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="CounterDiagnostic" AutomationProperties.AutomationId="StatisticsDiagnostic"
                TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="SnapshotReading" AutomationProperties.AutomationId="SnapshotStatistics"
                TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="StatisticsCaption" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Expander>
</UserControl>
