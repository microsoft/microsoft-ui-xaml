<Project>
  <Target Name="WriteSharedTestProjectionInputs" AfterTargets="Build"
          Condition="'$(UseCsWinRT3)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SharedTestProjectionReference Include="@(ReferencePathWithRefAssemblies)"
                                  Condition="'%(Filename)' != 'WinRT.Runtime'">
      </_SharedTestProjectionReference>
      <_SharedTestProjectionImplementation Include="@(ReferencePath)"
                                  Condition="'%(Filename)' != 'WinRT.Runtime'">
      </_SharedTestProjectionImplementation>
      <_SharedTestProjectionReference Include="$(CsWinRTRuntimeImplementationAssemblyPath)" />
      <_SharedTestProjectionImplementation Include="$(CsWinRTRuntimeImplementationAssemblyPath);$(TargetPath)" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)SharedTestProjections.references.txt"
                      Lines="@(_SharedTestProjectionReference->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)SharedTestProjections.implementations.txt"
                      Lines="@(_SharedTestProjectionImplementation->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Read the exact inputs of the completed build without invoking reference resolution/compilation again. -->
  <Target Name="GetSharedTestProjectionInputs" Returns="@(_SharedTestProjectionInput)"
          KeepDuplicateOutputs="true" Condition="'$(UseCsWinRT3)' == 'true'">
    <Error Condition="!Exists('$(IntermediateOutputPath)SharedTestProjections.references.txt') or !Exists('$(IntermediateOutputPath)SharedTestProjections.implementations.txt')"
           Text="Build $(MSBuildProjectName) before generating shared TAEF projections." />
    <ReadLinesFromFile File="$(IntermediateOutputPath)SharedTestProjections.references.txt">
      <Output TaskParameter="Lines" ItemName="_SharedTestProjectionReference" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(IntermediateOutputPath)SharedTestProjections.implementations.txt">
      <Output TaskParameter="Lines" ItemName="_SharedTestProjectionImplementation" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_SharedTestProjectionInput Include="@(_SharedTestProjectionReference)">
        <Kind>Reference</Kind>
      </_SharedTestProjectionInput>
      <_SharedTestProjectionInput Include="@(_SharedTestProjectionImplementation)">
        <Kind>Implementation</Kind>
      </_SharedTestProjectionInput>
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Private.Infrastructure.Hosting.HostingHelpers'">
      <_SharedTestProjectionInput Include="$(TargetPath)">
        <Kind>Anchor</Kind>
      </_SharedTestProjectionInput>
      <_SharedTestProjectionInput Include="$(OutDir)WinRT.Projection.dll;$(OutDir)WinRT.Component.dll;$(OutDir)WinRT.Sdk.Projection.dll">
        <Kind>Sidecar</Kind>
      </_SharedTestProjectionInput>
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'MUXControls.Test'">
      <_SharedTestProjectionInput Include="$(TargetPath)">
        <Kind>SdkAnchor</Kind>
      </_SharedTestProjectionInput>
      <_SharedTestProjectionInput Include="$(OutDir)WinRT.Sdk.Projection.dll">
        <Kind>SdkSidecar</Kind>
      </_SharedTestProjectionInput>
    </ItemGroup>
  </Target>
</Project>
