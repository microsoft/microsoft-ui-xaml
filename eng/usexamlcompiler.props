<Project>
  <PropertyGroup>
    <EnableTypeInfoReflection>false</EnableTypeInfoReflection>
    <TargetPlatformMinVersion Condition="'$(TargetPlatformMinVersion)' == ''">$(TargetPlatformVersion)</TargetPlatformMinVersion>
    <!-- Mimic src\XamlCompiler\Targets\Microsoft.UI.Xaml.Markup.Compiler.interop.targets, but using the in-repo copy of the package -->
    <XamlCompilerOutDir Condition=" '$(XamlCompilerOutDir)' == '' ">$(ToolsPackageLocation)\</XamlCompilerOutDir>
    <GenXbfPath>$(ArtifactsBinRoot)GenXbf</GenXbfPath>
    <XamlCompilerTaskPath>$(XamlCompilerOutDir)Microsoft.UI.Xaml.Markup.Compiler.Tasks.dll</XamlCompilerTaskPath>
    <!--
      Always the x64 compiler, whatever the flavor and the machine: like the GenXbf.dll it loads (GenXbfPath, built for x64 only by
      eng\BuildGenXbfForMSBuild), it must match the architecture of the compiler process.
    -->
    <XamlCompilerNativeExePath>$(XamlCompilerOutDir)win-x64\XamlCompiler.exe</XamlCompilerNativeExePath>
    <XamlCompilerPropsAndTargetsDirectory>$(BuildTargetsPackageLocation)\</XamlCompilerPropsAndTargetsDirectory>
  </PropertyGroup>
  
  <Target Name="EnsureCompilerExists" BeforeTargets="Build" Condition="'$(SkipXamlCompilerProjectReferences)' == 'true'">
    <Error Condition="!Exists('$(XamlCompilerTaskPath)')"
        Text="$(XamlCompilerTaskPath) does not exist, which is needed to compile XAML.  Please build $(ProjectRoot)src\XamlCompiler\Tasks\Microsoft.UI.Xaml.Markup.Compiler.Tasks.csproj before building $(MSBuildProjectName)$(MSBuildProjectExtension)." />
    <Error Condition="!Exists('$(XamlCompilerNativeExePath)')"
        Text="$(XamlCompilerNativeExePath) does not exist, which is needed to compile XAML.  Please build $(ProjectRoot)src\XamlCompiler\Tasks\Microsoft.UI.Xaml.Markup.Compiler.Tasks.csproj before building $(MSBuildProjectName)$(MSBuildProjectExtension)." />
  </Target>

  <Import Project="$(XamlCompilerPropsAndTargetsDirectory)Microsoft.UI.Xaml.Markup.Compiler.props" Condition="'$(ExcludeRestorePackageImports)'!='true'"/>
</Project>