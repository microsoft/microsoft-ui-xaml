  <!--
    The native compiler of each flavor: always win-x64, which also runs the XAML compiler of the repo's own builds whatever the
    flavor (like eng\BuildGenXbfForMSBuild always builds the x64 GenXbf.dll it loads), plus win-arm64 in arm64 flavors. The package
    has them under tools\win-<rid>, next to the tasks that run them (tools\Microsoft.UI.Xaml.Markup.Compiler.Tasks.dll); the
    pipeline only keeps the binary of the flavor's architecture in its packaging artifact, like for GenXbf.dll.
  -->
  <ItemGroup Condition=" '$(RuntimeIdentifier)' == '' ">
    <_NativeXamlCompilerRid Include="win-x64" />
    <_NativeXamlCompilerRid Include="win-arm64" Condition="'$(_BuildArch)' == 'arm64'" />
    <_NativeXamlCompilerRid Update="@(_NativeXamlCompilerRid)" PublishedPath="$(_NativeXamlCompilerDir)%(Identity)\$(TargetName).exe" PackageLocation="$(ToolsPackageLocation)\%(Identity)" />
    <PackageContent Include="@(_NativeXamlCompilerRid->'%(PublishedPath)')" />
  </ItemGroup>
  <!--
    PublishAot only takes effect on publish, which needs a RuntimeIdentifier, so build the native binaries through nested publishes
    of the current target framework. This runs before the binplace targets, which pick up the native binaries and their symbols.
    The native binaries are always optimized: without it (Debug flavors), ILC generates code that makes XAML compilation several
    times slower, and every build of the repository with XAML runs it. The IL build (XamlCompiler.dll) is the one to debug.
  -->
  <Target Name="PublishNativeXamlCompiler"
          AfterTargets="Build"
          BeforeTargets="AddBinplaceItems"
          Condition=" '$(RuntimeIdentifier)' == '' ">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="TargetFramework=$(TargetFramework);RuntimeIdentifier=%(_NativeXamlCompilerRid.Identity);OutDir=$(_NativeXamlCompilerDir)%(_NativeXamlCompilerRid.Identity)\build\;PublishDir=$(_NativeXamlCompilerDir)%(_NativeXamlCompilerRid.Identity)\;_IsPublishing=true;Optimize=true" />
    <ItemGroup>
      <BinplaceItem Include="$(_NativeXamlCompilerDir)%(_NativeXamlCompilerRid.Identity)\$(TargetName).exe">
        <Destination>$(TargetDestination)\%(_NativeXamlCompilerRid.Identity)</Destination>
      </BinplaceItem>
      <BinplaceItem Include="$(_NativeXamlCompilerDir)%(_NativeXamlCompilerRid.Identity)\$(TargetName).pdb" Condition="Exists('$(_NativeXamlCompilerDir)%(_NativeXamlCompilerRid.Identity)\$(TargetName).pdb')">
        <Destination>$(SymbolsBinDir)\%(_NativeXamlCompilerRid.Identity)</Destination>
      </BinplaceItem>
    </ItemGroup>
  </Target>
  <!-- Referencing a .NET Standard project includes a reference to System.Xaml, which conflicts with our private System.Xaml.  Remove the auto-included reference here -->
  <Target Name="RemoveSystemXamlReference" BeforeTargets="ResolveAssemblyReferences">
