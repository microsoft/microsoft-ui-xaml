<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Microsoft.UI.Xaml.Markup.Compiler</RootNamespace>
    <AssemblyName>XamlCompiler</AssemblyName>
    <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
    <!-- Each target framework gets its own output and binplace folder, since they produce same-named files -->
    <OutDir>$(OutDir)$(TargetFramework)\</OutDir>
    <TargetDestination>$(MarkupCompilerDestinationPath).Executable\$(TargetFramework)</TargetDestination>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);0419;1570;1572;1573;1574;1591;3021;0618;0672;0436;0108;SYSLIB0003;SYSLIB0005;SYSLIB0012;SYSLIB0019;SYSLIB0021;CA2002;CA1060;CA1063;CA2229;CA1001;CA1033;CA1416;CA2101;CA2213;CA2231</NoWarn>
    <!-- USE_CLR_V4 is only for the LMR code -->
    <DefineConstants>$(DefineConstants);USE_CLR_V4;NET40PLUS;Debug;SYSTEM_XAML</DefineConstants>
    <BuildTasksDir>$(MSBuildThisFileDirectory)..\BuildTasks\</BuildTasksDir>
    <SystemXamlPathRoot>$(BuildTasksDir)System.Xaml</SystemXamlPathRoot>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <WarningsAsErrors>false</WarningsAsErrors>
  </PropertyGroup>
  <!--
    The net8.0 build is launched via the dotnet host running MSBuild (see Microsoft.UI.Xaml.Markup.Compiler.interop.targets),
    so it is framework-dependent with no apphost, and rolls forward to whatever newer runtime that host has.
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <SymbolsBinDir>$(ProductSymbolsBinplacePath)\Executable\$(TargetFramework)</SymbolsBinDir>
    <UseAppHost>false</UseAppHost>
    <RollForward>Major</RollForward>
    <!-- Don't require the latest .NET 8 patch (eng\sdkconfig.targets pins packs to it); any 8.0+ runtime is fine -->
    <RuntimeFrameworkVersion>8.0.0</RuntimeFrameworkVersion>
    <!-- Legacy formatter-serialization members in the shared System.Xaml/LMR/ANTLR sources; same suppressions as the net8.0 task build -->
    <NoWarn>$(NoWarn);SYSLIB0050;SYSLIB0051;CA2235</NoWarn>
  </PropertyGroup>
  <!--
    The net10.0 build is published as a Native AOT, self-contained binary (XamlCompiler.exe), so it can be launched
    directly by the MSBuild task without any requirement on the host (.NET SDK, DOTNET_HOST_PATH, MSBuild flavor).
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <SymbolsBinDir>$(ProductSymbolsBinplacePath)\Executable\$(TargetFramework)</SymbolsBinDir>
    <PublishAot>true</PublishAot>
    <!-- Link both GC modes (the MSBuild task selects one through the 'DOTNET_gcServer' variable of the compiler process, see GetXamlCompilerGCMode) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Run CsWin32 as a build task rather than as a source generator: https://microsoft.github.io/CsWin32/docs/getting-started.html -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <!-- Only the runtime pack of the RID that is published is needed, not those of the other frameworks (ASP.NET Core, Windows Desktop) -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- Misc NativeAOT options to save size and maximize speed -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!--
      Enable CFG (Control Flow Guard), to make the resulting native binary more resilient to some exploit types.
      Also see: https://learn.microsoft.com/en-us/dotnet/core/deploying/native-aot/security#control-flow-guard.
      And: https://learn.microsoft.com/en-us/windows/win32/secbp/control-flow-guard#how-does-cfg-really-work.
    -->
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <!--
      Disables data dehydration (which is re-hydrated at startup otherwise).
      Small launch performance improvement, and a small memory use reduction as well.
    -->
    <IlcDehydrate>false</IlcDehydrate>
    <NoWarn>$(NoWarn);SYSLIB0050;SYSLIB0051;CA2235</NoWarn>
    <!-- Each flavor produces the native compiler for its own architecture; the package merges them (see eng\packaging.targets) -->
    <_NativeXamlCompilerRid Condition="'$(_BuildArch)' == 'amd64'">win-x64</_NativeXamlCompilerRid>
    <_NativeXamlCompilerRid Condition="'$(_BuildArch)' == 'arm64'">win-arm64</_NativeXamlCompilerRid>
    <_NativeXamlCompilerDir>$(OutDir)native\$(_NativeXamlCompilerRid)\</_NativeXamlCompilerDir>
    <!-- The IL-only output of this TFM isn't deployed, only the native binary published below is -->
    <BinplaceOutputAssemblies>false</BinplaceOutputAssemblies>
    <!-- Required by the source-generated COM/P/Invoke interop used for XBF generation (see NativeMethods.NativeAot.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Regression guard: this build has no trim/AOT/single-file warning at all, neither from the analyzers nor from ILC, so keep any
      new one an error even when warnings in general aren't (e.g. /p:TreatWarningsAsErrors=false). Reflection over the types of the
      compiled projects goes through LmrReflection (see LmrTypeBase and KnownRuntimeTypes), and the runtime-only parts of the shared
      sources are compiled out (see NativeAotUnsupported). The analyzer IDs are the ones this build had to fix.
    -->
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2055;IL2057;IL2060;IL2067;IL2070;IL2072;IL2073;IL2075;IL2080;IL2085;IL2092;IL2093;IL2094;IL2111;IL3000;IL3001;IL3002;IL3003;IL3050;IL3051;CA1420</WarningsAsErrors>
  </PropertyGroup>
