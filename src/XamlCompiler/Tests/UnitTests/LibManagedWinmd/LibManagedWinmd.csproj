<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <PropertyGroup>
    <TargetFramework>$(DotNetCoreTargetFrameworkMoniker)</TargetFramework>
    <TargetPlatformMinVersion>$(WindowsAppSdkTargetPlatformVersion)</TargetPlatformMinVersion>
    <RootNamespace>LibManagedWinmd</RootNamespace>
    <AssemblyName>LibManagedWinmd</AssemblyName>
    <!-- Authored as a C#/WinRT component so that the build produces both LibManagedWinmd.dll and
         LibManagedWinmd.winmd. The unit tests consume the .winmd to cover the compiler's winmd
         metadata resolution path (TestHelper.LibManagedWinmdName). -->
    <CsWinRTComponent>true</CsWinRTComponent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <ProjectReference Include="..\..\..\..\projection\Microsoft.WinUI.csproj">
      <ReferenceOutputAssembly>True</ReferenceOutputAssembly>
      <ExcludeAssets>All</ExcludeAssets>
    </ProjectReference>
    <Reference Include="$(NugetPackageDirectory)\$(LiftedIXPTransportPackageName)\$(IxpTransportPackageVersion)\lib\net6.0-windows$(CurrentLiftedIXPTargetPlatformVersion)\Microsoft.InteractiveExperiences.Projection.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- C#/WinRT's authoring source generator resolves the Windows Runtime types this component's
         public API exposes (Microsoft.UI.Xaml.Controls.Control) from Windows metadata rather than
         from the projection assembly. Point it at the winmds this repo builds, so that the project
         keeps the minimal dependency set of a unit-test library instead of taking the Windows App
         SDK package. -->
    <CsWinRTAuthoringWinMDs Include="$(WinMDPackageLocation)\*.winmd" />
  </ItemGroup>
</Project>