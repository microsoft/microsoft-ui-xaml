<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'" />
  <PropertyGroup Condition="'$(Configuration)' == 'Release'" />
  <PropertyGroup>
    <DebugSymbols>true</DebugSymbols>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ProjectGuid>{6AC93711-0481-4941-A6B8-5C456D24A31F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <UseVSVersion>true</UseVSVersion>
    <RootNamespace>UnitTests</RootNamespace>
    <AssemblyName>UnitTests</AssemblyName>
    <SccProjectName>SAK</SccProjectName>
    <SccLocalPath>SAK</SccLocalPath>
    <SccAuxPath>SAK</SccAuxPath>
    <SccProvider>SAK</SccProvider>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <DefineConstants>DO_NOT_USE_GENXBF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" />
    <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework" />
    <Reference Include="System" />
    <Reference Include="System.Windows" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <CodeAnalysisDependentAssemblyPaths Condition=" '$(VS100COMNTOOLS)' != '' " Include="$(VS100COMNTOOLS)..\IDE\PrivateAssemblies">
      <Visible>False</Visible>
    </CodeAnalysisDependentAssemblyPaths>
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <!-- The codegen-to-masters mapping CodegenTests reads. Staged next to the test assembly so the
         codegen tests also work from a test payload, where there is no enlistment to read it from. -->
    <None Include="CodegenTargets.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="XbfGeneratorTests.cs" />
    <Compile Include="CodegenTests.cs" />
    <Compile Include="ConditionalsTests.cs" />
    <Compile Include="BindPathParserTests.cs" />
    <Compile Include="CodeCoverage.cs" />
    <Compile Include="CodeGeneratorProjectContext.cs" />
    <Compile Include="CodeGeneratorTests.cs" />
    <Compile Include="HarvesterTests.cs" />
    <Compile Include="KnownBugs.cs" />
    <Compile Include="MultipleViewTests.cs" />
    <Compile Include="StaticResourceTests.cs" />
    <Compile Include="TestHelper.cs" />
    <Compile Include="TestRunSetup.cs" />
    <Compile Include="SchemaTests.cs" />
    <Compile Include="TypeCollectorTests.cs" />
    <Compile Include="UnitTests.cs" />
    <Compile Include="NameTests.cs" />
    <Compile Include="ValidatorTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- These three are never compiled against; the tests feed them to the XAML compiler under test
         as on-disk metadata (TestHelper.GetUserAssemblyPath resolves them by file name next to the
         test assembly). They are therefore consumed as build outputs, exactly as MergedWinMD and
         GenXbf are below. SkipGetTargetFrameworkProperties is required because they are SDK-style
         net8.0 projects while this test project is net472 - a compile-time reference would be
         invalid, but a file dependency is not. -->
    <ProjectReference Include="LibManagedDll\LibManagedDll.csproj">
      <Project>{5D3B1E5D-9995-4FBE-88E9-2A36B2970307}</Project>
      <Name>LibManagedDll</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="LibManagedDllSatellite\LibManagedDllSatellite.csproj">
      <Project>{0CA38FA1-0403-4576-9EDF-7B1E81F60857}</Project>
      <Name>LibManagedDllSatellite</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="LibManagedWinmd\LibManagedWinmd.csproj">
      <Project>{9E20EC9E-B908-4245-87EA-C642ECDF843C}</Project>
      <Name>LibManagedWinmd</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <!-- TODO: mult-targeting mismatch causing build error:
    MSB4057: The target "GetTargetPathWithTargetPlatformMoniker" does not exist in the project.
    <ProjectReference Include="..\..\BuildTasks\Microsoft.UI.Xaml.Markup.Compiler.csproj">
      <Project>{fedfeea3-0e03-4798-bc77-a70ba8659a09}</Project>
      <Name>Microsoft.UI.Xaml.Markup.Compiler</Name>
    </ProjectReference> -->
    <ProjectReference Include="XamlCompilerProxies\XamlCompilerProxies.csproj">
      <Project>{f292fa71-2b98-4ccf-9f2e-5f21936d3715}</Project>
      <Name>XamlCompilerProxies</Name>
      <!-- Tests/Directory.Build.props defaults ProjectReference Private=false for non-exe projects.
           This test library loads Win8Xaml.CompilerProxies at runtime, so it must be copied
           alongside UnitTests.dll or every test fails in TestHelper's constructor. -->
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\..\..\MergedWinMD\MergedWinMD.vcxproj">
      <Project>{52b2ed64-1cfc-401b-8c5b-6d1e1deadf98}</Project>
      <Name>MergedWinMD</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="..\..\..\..\dxaml\xcp\tools\GenXbfDLL\GenXbf.vcxproj">
      <Project>{42577057-854d-443d-ab59-f4e44c8f5207}</Project>
      <Name>GenXbf</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{82A7F48D-3B50-4B1E-B82E-3ADA8210C358}" />
  </ItemGroup>
  <!--Note: these must be imported after the OutputPath is set-->
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <ItemGroup>
    <TestMasters Include="..\..\TestMasters\**\*" InProject="false" />
  </ItemGroup>
  <Target Name="BeforeBuild" BeforeTargets="Build">
    <ItemGroup>
      <FileWrites Include="@(TestMasters->'$(OutDir)TestMasters\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
  <Target Name="AfterBuild" AfterTargets="Build" Inputs="@(TestMasters)" Outputs="@(TestMasters->'$(OutDir)TestMasters\%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(TestMasters)" DestinationFolder="$(OutDir)TestMasters\%(RecursiveDir)" ContinueOnError="false" />
  </Target>
  <!-- Copy pre-built native artifacts (GenXbf.dll, compiler DLL) to the test output directory.
       These are produced by the main repo build (build.cmd) and must exist before running tests. -->
  <Target Name="CopyPrebuiltArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <GenXbfSourceDir>$(ProjectRoot)BuildOutput\bin\GenXBF\x64\</GenXbfSourceDir>
      <!-- Use ArtifactsBinDir from the repo build system, or derive platform/config from MSBuild properties -->
      <CompilerSourceDir Condition="'$(ArtifactsBinDir)' != ''">$(ArtifactsBinDir)Product\Microsoft.UI.Xaml.Markup.Compiler\net472\</CompilerSourceDir>

      <!-- When building standalone, derive platform/config from MSBuild properties (mirrors eng/configuration.props) -->
      <_FallbackPlatform Condition="'$(Platform)' == 'x64'">amd64</_FallbackPlatform>
      <_FallbackPlatform Condition="'$(Platform)' == 'Win32'">x86</_FallbackPlatform>
      <_FallbackPlatform Condition="'$(Platform)' == 'ARM64'">arm64</_FallbackPlatform>
      <_FallbackPlatform Condition="'$(Platform)' == 'AnyCPU'">amd64</_FallbackPlatform>
      <_FallbackPlatform Condition="'$(_FallbackPlatform)' == ''">amd64</_FallbackPlatform>

      <_FallbackConfig Condition="'$(Configuration)' == 'Release'">fre</_FallbackConfig>
      <_FallbackConfig Condition="'$(_FallbackConfig)' == ''">chk</_FallbackConfig>

      <CompilerSourceDir Condition="'$(CompilerSourceDir)' == '' or !Exists('$(CompilerSourceDir)')">$(ProjectRoot)BuildOutput\bin\$(_FallbackPlatform)$(_FallbackConfig)\Product\Microsoft.UI.Xaml.Markup.Compiler\net472\</CompilerSourceDir>
      <ProductDir Condition="'$(ArtifactsBinDir)' != ''">$(ArtifactsBinDir)Product\</ProductDir>
      <ProductDir Condition="'$(ProductDir)' == '' or !Exists('$(ProductDir)')">$(ProjectRoot)BuildOutput\bin\$(_FallbackPlatform)$(_FallbackConfig)\Product\</ProductDir>
    </PropertyGroup>
    <Copy SourceFiles="$(GenXbfSourceDir)GenXbf.dll" DestinationFolder="$(OutDir)" ContinueOnError="true" Condition="Exists('$(GenXbfSourceDir)GenXbf.dll')" />
    <Copy SourceFiles="$(CompilerSourceDir)Microsoft.UI.Xaml.Markup.Compiler.dll" DestinationFolder="$(OutDir)" ContinueOnError="true" Condition="Exists('$(CompilerSourceDir)Microsoft.UI.Xaml.Markup.Compiler.dll')" />
    <!-- The compiler DLL alone is not loadable: it needs its net472 dependency closure
         (System.Collections.Immutable, System.Reflection.Metadata, Microsoft.Build.*, ...).
         $(ToolsPackageLocation) is the product build's packaging folder, defined in eng/packaging.props,
         and is the only place that closure is staged. -->
    <ItemGroup>
      <_XamlCompilerToolDependencies Include="$(ToolsPackageLocation)\net472\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlCompilerToolDependencies)" DestinationFolder="$(OutDir)" ContinueOnError="true" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProductDir)Microsoft.UI.Xaml.winmd" DestinationFolder="$(OutDir)" ContinueOnError="true" Condition="Exists('$(ProductDir)Microsoft.UI.Xaml.winmd')" />
    <Copy SourceFiles="$(ProductDir)Microsoft.UI.winmd" DestinationFolder="$(OutDir)" ContinueOnError="true" Condition="Exists('$(ProductDir)Microsoft.UI.winmd')" />
    <Copy SourceFiles="$(ProductDir)Microsoft.UI.dll" DestinationFolder="$(OutDir)" ContinueOnError="true" Condition="Exists('$(ProductDir)Microsoft.UI.dll')" />
    <Copy SourceFiles="$(ProductDir)Microsoft.ui.xaml.dll" DestinationFolder="$(OutDir)" ContinueOnError="true" Condition="Exists('$(ProductDir)Microsoft.ui.xaml.dll')" />

    <!-- LibManagedDll is an SDK-style net8.0/WinAppSDK assembly, so the "user types" the tests
         feed to the compiler now reference the C#/WinRT projection closure - Microsoft.WinUI,
         Microsoft.Windows.SDK.NET, WinRT.Runtime and Microsoft.InteractiveExperiences.Projection -
         rather than raw winmds, and its BCL closure is .NET 8 rather than .NET Framework. The
         compiler's type universe can only resolve assemblies it has been handed, so both sets are
         staged here and loaded by TestHelper. This mirrors what MSBuild hands the real CompileXaml
         task on @(ReferencePath): CompileXamlInternal.SortReferenceAssemblies already treats
         microsoft.winui.dll as a load-by-default reference alongside the winmds.
         Nothing is hard-coded: every path below is derived from the repo's own version properties. -->
    <PropertyGroup>
      <ProjectionReferencesDir>$(OutDir)ProjectionReferences\</ProjectionReferencesDir>
      <FrameworkReferencesDir>$(OutDir)FrameworkReferences\</FrameworkReferencesDir>
      <!-- Same expression eng\sdkconfig.targets uses to pin the SDK.NET targeting pack. -->
      <_SdkNetRefPackVersion>$(WindowsTargetPlatformVersion.TrimEnd('0'))$(MicrosoftWindowsSDKNetRefPackVersionSuffixOverride)</_SdkNetRefPackVersion>
      <_SdkNetRefPackDir>$(NugetPackageDirectory)\microsoft.windows.sdk.net.ref\$(_SdkNetRefPackVersion)\lib\net6.0\</_SdkNetRefPackDir>
      <!-- Same expression LibManagedDll.csproj uses for its own IXP reference. -->
      <_IxpProjectionDir>$(LiftedIXPPackagePath)\lib\net6.0-windows$(CurrentLiftedIXPTargetPlatformVersion)\</_IxpProjectionDir>
      <!-- $(Net8TargetingPackVersion) is the same pin eng\sdkconfig.targets applies to every .NET 8 pack. -->
      <_NetCoreRefPackDir>$(NugetPackageDirectory)\microsoft.netcore.app.ref\$(Net8TargetingPackVersion)\ref\net8.0\</_NetCoreRefPackDir>
    </PropertyGroup>
    <ItemGroup>
      <_ManagedProjectionReference Include="$(ProductDir)Microsoft.WinUI.dll" />
      <_ManagedProjectionReference Include="$(_SdkNetRefPackDir)Microsoft.Windows.SDK.NET.dll" />
      <_ManagedProjectionReference Include="$(_SdkNetRefPackDir)WinRT.Runtime.dll" />
      <_ManagedProjectionReference Include="$(_IxpProjectionDir)Microsoft.InteractiveExperiences.Projection.dll" />
      <_NetCoreFrameworkReference Include="$(_NetCoreRefPackDir)*.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_ManagedProjectionReference.FullPath)')"
           Text="Managed projection reference not found: %(_ManagedProjectionReference.FullPath). The unit tests cannot resolve LibManagedDll's type closure without it." />
    <Error Condition="'@(_NetCoreFrameworkReference)' == ''"
           Text="No .NET 8 reference assemblies found under '$(_NetCoreRefPackDir)'. The unit tests cannot resolve a net8.0 user assembly's type closure without them." />
    <Copy SourceFiles="@(_ManagedProjectionReference)" DestinationFolder="$(ProjectionReferencesDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NetCoreFrameworkReference)" DestinationFolder="$(FrameworkReferencesDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>