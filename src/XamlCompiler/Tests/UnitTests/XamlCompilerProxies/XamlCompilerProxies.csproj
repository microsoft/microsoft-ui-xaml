<!--
  Reflection-based proxies over the internal types of the XAML compiler (XamlCompiler.dll, see ProxyHelper), used by
  ..\XamlCompilerUnitTests.csproj. See ..\README.md.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Win8Xaml.CompilerProxies</AssemblyName>
    <RootNamespace>Win8Xaml.CompilerProxies</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="15.8.166" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="15.8.166" />
  </ItemGroup>
  <Import Project="BuildKnownVersions.targets" />
</Project>
