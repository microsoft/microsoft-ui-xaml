<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <!-- Compile these projects with the XAML compiler built from this repo, not the prebuilt one
             carried in the Microsoft.WindowsAppSDK.WinUI package. Without this, the XAML compiler's
             own regression suite silently tests a stale binary: every generated file compared against
             TestMasters would come from the package rather than from the source being changed.

             This has to be set before the parent Directory.Build.props is imported, because that is
             where eng\usexamlcompiler.props is conditionally imported from. That file repoints
             XamlCompilerPropsAndTargetsDirectory at the local build's packaging staging folder, which
             the WinUI package's own Microsoft.WinUI.props then honors, so both the compiler task and
             its .props/.targets come from this enlistment.

             SkipXamlCompilerProjectReferences enables the EnsureCompilerExists check, which reports a
             clear "build the compiler first" error instead of a confusing task-not-found failure. -->
        <UseXamlCompiler Condition="'$(UseXamlCompiler)' == ''">true</UseXamlCompiler>
        <!-- Except for packaging projects. The WinUI package deliberately skips the XAML compiler
             props for .wapproj (see the '$(MSBuildProjectExtension)'!='.wapproj' condition on the
             import in Microsoft.WinUI.props), because a packaging project has no XAML of its own.
             eng\usexamlcompiler.targets has no such exclusion, so opting a .wapproj in gives it the
             compiler targets without the compiler props, and the build then fails with
             "MSB4057: The target XamlPreCompile does not exist in the project". -->
        <UseXamlCompiler Condition="'$(MSBuildProjectExtension)' == '.wapproj'">false</UseXamlCompiler>
        <SkipXamlCompilerProjectReferences Condition="'$(SkipXamlCompilerProjectReferences)' == ''">true</SkipXamlCompilerProjectReferences>
    </PropertyGroup>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
        
    <PropertyGroup>
        <CommonFilesPath>$(MSBuildThisFileDirectory)Common\</CommonFilesPath>
        <AdHocApp>true</AdHocApp>
        <GenerateProjectSpecificOutputFolder>true</GenerateProjectSpecificOutputFolder>
        <UseLocalSDK>true</UseLocalSDK>
        <!-- Suppress WinMDExp warnings WME0010 since the Microsoft.UI.Xaml.Markup.IXamlMetadataProvider GetXamlType method is automatically renamed -->
        <WinMdExpNoWarn>0010;$(WinMdExpNoWarn)</WinMdExpNoWarn>
    </PropertyGroup>
    
    <PropertyGroup Condition="$(MSBuildProjectExtension)=='.csproj'">
        <RuntimeIdentifiers>win-x86; win-x64; win-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <ProjectReference>
            <!-- By default,
                     don't copy project reference output to the output directory
                     of the current project unless this is an exe. -->
            <Private>false</Private>
            <Private Condition="'$(ConfigurationType)' == 'Application' or '$(OutputType)'=='winexe' or '$(OutputType)'=='exe' or '$(OutputType)'=='appcontainerexe'">true</Private>
        </ProjectReference>
        <Reference>
            <!-- By default,
                     don't copy reference output to the output directory
                     of the current project unless this is an exe. -->
            <Private>false</Private>
            <Private Condition="'$(ConfigurationType)' == 'Application' or '$(OutputType)'=='winexe' or '$(OutputType)'=='exe' or '$(OutputType)'=='appcontainerexe'">true</Private>
        </Reference>
    </ItemDefinitionGroup>

    <PropertyGroup>
         <!-- Our obj/bin paths get long enough to the point they break signtool.exe in the SDK ( APPX1204 file not found errors).
              Trim some of the extraneous common path to a more managable one.
         -->
        <OutDir>$(OutDir.Replace("src\XamlCompiler\Tests\RegressionProjects", "CompilerTests"))</OutDir>        
        <IntDir>$(IntDir.Replace("src\XamlCompiler\Tests\RegressionProjects", "CompilerTests"))</IntDir>
        <BaseIntermediateOutputPath>$(BaseIntermediateOutputPath.Replace("src\XamlCompiler\Tests\RegressionProjects", "CompilerTests"))</BaseIntermediateOutputPath>
        <IntermediateOutputPath>$(IntermediateOutputPath.Replace("src\XamlCompiler\Tests\RegressionProjects", "CompilerTests"))</IntermediateOutputPath>
        <!-- eng\folderpaths.props derives GeneratedFilesDir from BaseIntermediateOutputPath before this
             file is evaluated, so it has to be trimmed here as well. Without this, a project's XAML
             codegen lands in a different tree from its own intermediates. -->
        <GeneratedFilesDir>$(GeneratedFilesDir.Replace("src\XamlCompiler\Tests\RegressionProjects", "CompilerTests"))</GeneratedFilesDir>
        <!-- Opt-in for the case of two projects sharing one directory, which would otherwise share one
             generated-files directory and overwrite each other's codegen (MSB8028). A project cannot
             simply set GeneratedFilesDir itself: for a .vcxproj this file is imported by
             Microsoft.Cpp.Default.props, i.e. *after* the project's Globals group, so folderpaths.props
             overwrites anything the project set. Setting the subdirectory name instead survives. -->
        <GeneratedFilesDir Condition="'$(GeneratedFilesSubdirectory)' != ''">$(BaseIntermediateOutputPath)$(GeneratedFilesSubdirectory)\generated\</GeneratedFilesDir>
        <!-- Such projects also need their own object directory, or they overwrite each other's
             .obj files; see AppPreamble.vcxproj, which sets IntDir from the same property once
             Microsoft.Cpp.props has defined it. -->
    </PropertyGroup>

    <PropertyGroup>
        <!-- The codegen-to-masters path contract: every XAML compiler generated file, in every
             language, is written to $(GeneratedFilesDir), and Tests\UnitTests\CodegenTargets.txt maps
             that location to the baseline under TestMasters. CodegenTests.DiffCodegen and
             copynewmasters.cmd both read that manifest, so all three stay in agreement.

             C++ projects already default XamlGeneratedOutputPath to GeneratedFilesDir. Managed
             projects default it to IntermediateOutputPath instead, which carries the target framework
             and runtime identifier and so changes path on every TFM bump; point them at the same
             configuration-independent directory the native projects use. -->
        <XamlGeneratedOutputPath>$(GeneratedFilesDir)</XamlGeneratedOutputPath>
    </PropertyGroup>
</Project>