<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <Import Project="$(CommonFilesPath)AppPreamble.csproj" />

  <PropertyGroup>
    <RootNamespace>AppCS</RootNamespace>
    <AssemblyName>LinkedMdAppCS</AssemblyName>
  </PropertyGroup>
  
  <ItemGroup>
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The managed half of the linked-metadata scenario. LinkedMdSubControlsCS (SubControlsCS)
         flows in transitively, mirroring the native half below: MainPage.xaml.cs asserts that
         ControlsCS.A/.B and SubControlsCS.S/.T all resolve through the app's metadata provider. -->
    <ProjectReference Include="..\LinkedMdControlsCS\LinkedMdControlsCS.csproj" />
    <!-- The C++/WinRT controls are consumed through their C#/WinRT projection assembly. A .NET 5+
         project cannot reference a .winmd directly (NETSDK1130); the projection project owns that
         reference and keeps the native component building and copy-local. The sub-controls
         projection flows in transitively, which is what this test requires - MainPage.xaml.cs
         asserts that LinkedMDSubControlsCppWinRT.S and .T resolve through the app's metadata. -->
    <ProjectReference Include="..\LinkedMDControlsCppWinRT.Projection\LinkedMDControlsCppWinRT.Projection.csproj" />
  </ItemGroup>

</Project>
