<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <Import Project="$(CommonFilesPath)ClassLibraryPreamble.csproj" />

  <PropertyGroup>
    <!-- Generate the C#/WinRT projection for this component's namespace only. -->
    <CSWinRTIncludes>LinkedMDSubControlsCppWinRT</CSWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplies LinkedMDSubControlsCppWinRT.winmd as a cswinrt input. CsWinRT's
         CsWinRTRemoveWinMDReferences target moves it out of the C# reference set, which is
         what keeps .NET 5+ consumers from hitting NETSDK1130. -->
    <ProjectReference Include="..\LinkedMDSubControlsCppWinRT\LinkedMDSubControlsCppWinRT.vcxproj">
      <Project>{329ccba9-8ed1-462d-a2d4-c887087fd816}</Project>
      <Name>LinkedMDSubControlsCppWinRT</Name>
      <!-- The winmd is an implementation detail of this projection. Without PrivateAssets it flows
           transitively to managed consumers, which then fail with NETSDK1130. -->
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
