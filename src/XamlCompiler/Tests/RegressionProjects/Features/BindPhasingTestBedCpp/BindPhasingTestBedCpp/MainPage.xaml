<Page
    x:Class="BindPhasingTestBedCpp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BindPhasingTestBedCpp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <GridView x:Name="myGridView"
                  Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
                  ContainerContentChanging="MyGridView_ContainerContentChanging">           
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:MyItem">
                    <StackPanel Height="100" 
                                Width="100" 
                                Background="Blue">
                        <Rectangle x:Name="placeholderRectangle" 
                                   Fill="Red" />
                        <TextBlock x:Name="titleTextBlock" 
                                   Text="{x:Bind Title}" 
                                   x:Phase="1"
                                   Foreground="Yellow"/>
                        <TextBlock x:Name="title2TextBlock" 
                                   Text="{x:Bind Title, FallbackValue=foo}" 
                                   x:Phase="2"
                                   Foreground="Yellow"/>
                        <TextBlock x:Name="subtitleTextBlock" 
                                   Text="{x:Bind Subtitle}" 
                                   x:Phase="1"
                                   Foreground="Aqua"/>
                        <TextBlock x:Name="ImageUrlTextBlock" 
                                   Text="{x:Bind Info.ImageUrl}" 
                                   x:Phase="4"
                                   Foreground="Aqua"/>
                        <TextBlock x:Name="Caption" 
                                   Text="{x:Bind Info.Caption}" 
                                   x:Phase="4"
                                   Foreground="Aqua"/>
                        <TextBlock x:Name="OtherCaption"
                                    Text="{x:Bind OtherInfo.Caption}"
                                    x:Phase="6"
                                    Foreground="Green"/>
                        <TextBlock x:Name="descriptionTextBlock" 
                                   Text="{x:Bind Description, Mode=OneWay}" 
                                   x:Phase="3"
                                   Foreground="Gray"/>
                        <TextBlock x:Name="DPTextBlock"
                                   Text="{x:Bind DPOnMyItem, Mode=OneWay}"
                                   x:Phase="7" />
                        <TextBlock x:Name="deferedTextBlock" 
                                   Text="{x:Bind Subtitle}" 
                                   x:DeferLoadStrategy="Lazy"
                                   />
                        <TextBlock x:Name="deferedAndPhasedTextBlock" 
                                   Text="{x:Bind Subtitle}" 
                                   x:DeferLoadStrategy="Lazy"
                                   x:Phase="19"
                                   />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
