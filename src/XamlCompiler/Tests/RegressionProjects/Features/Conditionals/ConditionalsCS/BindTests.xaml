<UserControl
    x:Class="Conditionals.BindTests"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Conditionals"
    xmlns:v1="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypePresent(ConditionalControls.V1Type)"
    xmlns:v2="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypePresent(ConditionalControls.V2Type)"
    xmlns:v3="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypePresent(ConditionalControls.V3Type)"
    xmlns:notv3="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsTypeNotPresent(ConditionalControls.V3Type)"
    xmlns:cc="using:ConditionalControls"
    xmlns:cc1="using:ConditionalControls?IsTypePresent(ConditionalControls.V1Type)"
    xmlns:notcc1="using:ConditionalControls?IsTypeNotPresent(ConditionalControls.V1Type)"
    xmlns:cc2="using:ConditionalControls?IsTypePresent(ConditionalControls.V2Type)"
    xmlns:notcc2="using:ConditionalControls?IsTypeNotPresent(ConditionalControls.V2Type)"
    xmlns:cc3="using:ConditionalControls?IsTypePresent(ConditionalControls.V3Type)"    
    xmlns:notcc3="using:ConditionalControls?IsTypeNotPresent(ConditionalControls.V3Type)"
    Tag="123"
    >

    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="Basic Bindings" Padding="0, 20, 0, 0"/>
                
                <TextBlock Style="{StaticResource Note}" Text="Binding to versioned element Bindings"/>
                <v3:TextBlock Text="You should not see this, it's a V3 tag" x:Name="v3TextBlock"/>
                <TextBlock v3:Text="{x:Bind v3TextBlock.Text}"/>

                <StackPanel Orientation="Horizontal">
                    <v1:TextBlock v2:Text="{x:Bind Model.Org.NullProperty, Mode=OneWay, FallbackValue='you should not see this', TargetNullValue='Target null value'}" />
                    <v1:TextBlock v2:Text="{x:Bind Model.Org.NullEmployee.FirstName, Mode=OneWay, FallbackValue='Fallback value', TargetNullValue='ou should not see this'}" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>
                
                    <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource Note}" Text="Fn Binding to V2 prop" HorizontalAlignment="Left"/>
                    <v1:TextBox Grid.Column="0" Grid.Row="1" v2:Text="{x:Bind V2Property.ToString(), Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource Note}" Text="Fn Binding to V3 prop" HorizontalAlignment="Left"/>
                    <v1:TextBox Grid.Column="1" Grid.Row="1" v3:Text="{x:Bind V3Property.ToString(), Mode=OneWay}" notv3:Text="only works in V3" />
                    <TextBlock Grid.Column="2" Grid.Row="0" Style="{StaticResource Note}" Text="Fn Binding to V3 fn" HorizontalAlignment="Left"/>
                    <v1:TextBox Grid.Column="2" Grid.Row="1" v3:Text="{x:Bind Model.Org.EmployeeOfTheMonth.GetNameV3(), Mode=OneWay, FallbackValue='No employees'}" notv3:Text="only works in V3" />
                </Grid>
                
                <TextBlock Style="{StaticResource Note}" Text="Event Binding" Padding="0, 20, 0, 0"/>
                <cc1:Button1 cc2:Click="{x:Bind Click_V2}" Caption="Click binding on V2 Property"/>
                <TextBlock Text="n/a" x:Name="clickV2results"></TextBlock>
                <cc1:Button1 cc3:Click="{x:Bind Click_V3}" Caption="Click binding on V3 Property" x:Name="aButton"/>
                <TextBlock Text="n/a" x:Name="clickV3results"></TextBlock>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <cc1:Button1 cc1:Click="{x:Bind Model.Org.Hire1}" Caption="New Hire V1"/>
                        <cc1:Button1 cc2:Click="{x:Bind Model.Org.Hire2}" Caption="V2"/>
                        <cc1:Button1 cc3:Click="{x:Bind Model.Org.Hire3}" Caption="V3"/>
                        <cc1:Button1 cc1:Click="{x:Bind Model.Org.Fire}" Caption="Fire" x:Load="{x:Bind cc:Organization.IsNonEmpty(Model.Org.Employees), Mode=OneWay}" x:Name="fire"/>                        
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="V1 count:" Padding="0, 0, 5, 0"/>
                        <cc1:TextBlock1 Text="{x:Bind Model.Org.Employees.ItemCount, Mode=OneWay}"/>
                        <TextBlock Text="V3 count:" Padding="0, 0, 5, 0"/>
                        <cc1:TextBlock1 cc3:Text="{x:Bind Model.Org.EmployeesV3.ItemCount, Mode=OneWay}"/>
                    </StackPanel>
                    <ListView HorizontalAlignment="Left" ItemsSource="{x:Bind Model.Org.Employees, Mode=OneWay}" Width="400" Height="120">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="cc:IEmployee">
                                <StackPanel Orientation="Horizontal">
                                    <cc1:TextBlock1 Text="{x:Bind FirstName}" Width="70"/>
                                    <cc1:TextBlock1 Text="{x:Bind OfficeNumber1.ToString()}"/>
                                    <cc1:TextBlock1 cc2:Text="{x:Bind OfficeNumber2.ToString()}" x:Phase="2"/>
                                    <cc1:TextBlock1 cc3:Text="{x:Bind OfficeNumber3.ToString()}" x:Phase="3"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="TwoWay Binding" Padding="0, 20, 0, 0"/>

                <TextBlock Style="{StaticResource Note}" Text="V1 to V2: they should update each other"/>
                <StackPanel Orientation="Horizontal">            
                    <v1:TextBox Text="{x:Bind V2Property, Mode=TwoWay, FallbackValue=Foo, TargetNullValue=Bar}" />
                    <v1:TextBox v2:Text="{x:Bind V2Property, Mode=TwoWay, FallbackValue=Foo, TargetNullValue=Bar}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Note}" Text="V1 to V2: they should update each other"/>
                <StackPanel Orientation="Horizontal">
                    <v1:TextBox v2:Text="{x:Bind V2Property, Mode=TwoWay, FallbackValue=Foo, TargetNullValue=Bar}" />
                    <v1:TextBox v3:Text="{x:Bind V2Property, Mode=TwoWay, FallbackValue=Foo, TargetNullValue=Bar}" notv3:Text="will only update in V3" />
                </StackPanel>

            </StackPanel>        
        </Grid>
    </ScrollViewer>
</UserControl>
