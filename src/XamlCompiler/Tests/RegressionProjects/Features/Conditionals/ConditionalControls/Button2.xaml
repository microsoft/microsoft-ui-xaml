<UserControl
    x:Class="ConditionalControls.Button2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConditionalControls"
    >
    <Button Click="Button_Click">
        <StackPanel Orientation="Horizontal" Padding="5, 0, 5, 0">
            <Rectangle Fill="Gray" Width="4" Height="20"/>
            <TextBlock Text="{x:Bind Text}" x:Name="textBlock" Padding="5, 0, 0, 0"/>
        </StackPanel>
    </Button>

</UserControl>
