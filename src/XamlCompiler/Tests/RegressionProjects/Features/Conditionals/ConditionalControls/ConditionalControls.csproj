<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <Import Project="$(CommonFilesPath)RuntimeComponentPreamble.csproj" />

  <PropertyGroup>
    <!-- This standalone codegen target uses the distinct ConditionalControlsV2 assembly and root
         namespace. Keep the ConditionalControls project name because CodegenTargets.txt and the
         generated provider baselines are keyed by it. -->
    <RootNamespace>ConditionalControlsV2</RootNamespace>
    <AssemblyName>ConditionalControlsV2</AssemblyName>
  </PropertyGroup>

  <!--
    Nothing has a ProjectReference to this project, so a reference search alone makes it look unused.
    It is not: it is a codegen baseline target. See Tests\UnitTests\CodegenTargets.txt and
    CodegenTests.Codegen_ConditionalControls, with masters under
    TestMasters\RegressionProjects\<chk|fre>\Features\Conditionals\ConditionalControls. Its
    XamlTypeInfo.g.cs baseline differs from ConditionalsModel's, so the two cover different
    generated output.
  -->

</Project>