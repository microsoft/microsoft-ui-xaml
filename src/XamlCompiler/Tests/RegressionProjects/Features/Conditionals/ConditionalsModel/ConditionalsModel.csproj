<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <Import Project="$(CommonFilesPath)RuntimeComponentPreamble.csproj" />

  <PropertyGroup>
    <!--
      This project builds to assembly identity 'ConditionalControls', not 'ConditionalsModel'. The
      sibling project Features\Conditionals\ConditionalControls builds to the *same* identity; the
      two are variants of one logical component. This one adds the model types (Employee,
      Organization, Collections, Model) and uses a generic internal Test.EnsureVersion<T>; the
      sibling uses a public non-generic Test.EnsureVersion(Type).

      Nothing references both, so nothing mis-resolves - but two files named ConditionalControls.winmd
      exist under BuildOutput. When inspecting metadata, note that *this* project's output is the one
      consumed by ConditionalsCS and ConditionalsCppWinRT; the sibling's is reached only by its
      codegen baseline test.

      Neither project can simply be deleted or renamed: each is its own DiffCodegen target with its
      own baselines (Tests\UnitTests\CodegenTargets.txt), and the generated XamlTypeInfo provider
      type name embeds the *project* name - ConditionalsModel_XamlTypeInfo - so renaming this project
      invalidates the masters of every consumer as well as its own.
    -->
    <RootNamespace>ConditionalControls</RootNamespace>
    <AssemblyName>ConditionalControls</AssemblyName>
    <DefineConstants>$(DefineConstants);CSWINRT_1642</DefineConstants>
  </PropertyGroup>
</Project>