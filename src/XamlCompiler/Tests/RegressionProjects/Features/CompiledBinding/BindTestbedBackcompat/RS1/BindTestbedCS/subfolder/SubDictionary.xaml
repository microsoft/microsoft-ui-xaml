<ResourceDictionary
    x:Class ="BindTestbed.subfolder.SubDictionary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:BindTestbedModel"
    xmlns:local="using:BindTestbed.subfolder">

    <DataTemplate x:Key="FullNameTemplateInSubfolderRDFile" x:DataType="model:IEmployee">
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Image Source="../Assets/Icon.png" Width="20" Height="20" />
                <TextBlock Text="{x:Bind Name}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--<Style TargetType="TextBlock" x:Key="BoundStyle">
    <Setter Property="FontFamily" Value="{x:Bind font}" />
</Style>-->

</ResourceDictionary>
