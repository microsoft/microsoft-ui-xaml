<UserControl
    x:Class="BindTestbed.ListAndTemplateTests"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BindTestbed"
    xmlns:Subfolder="using:BindTestbed.subfolder"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:model="using:BindTestbedModel"
    Background="Maroon"
    Tag="This is a tag">

    <UserControl.Resources>

        <ResourceDictionary>
            <DataTemplate x:DataType="model:IEmployee" x:Key="FullNameTemplateInSameFile">
                <Grid>
                    <TextBlock Text="{x:Bind Name}"/>
                </Grid>
            </DataTemplate>

            <ResourceDictionary.MergedDictionaries>
                <local:Templates/>
                <Subfolder:SubDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" >
        <ScrollViewer>
            <StackPanel Margin="30">
                <!-- This is a regression test for a case that was conflicting with Name inside the data template below -->
                <TextBlock x:Name="LastName"/>
                <TextBlock Style="{StaticResource Note}"><Run>Listview - template inline</Run></TextBlock>
                <ListView Width="200" ItemsSource="{x:Bind Model.Employees}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:IEmployee">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Bind Name}"/>
                                <TextBlock Text="{x:Bind LastName}" Margin="20,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Style="{StaticResource Note}"><Run>Listview - template in same file</Run></TextBlock>
                <ListView Width="200" MaxHeight="400" ItemTemplate="{StaticResource FullNameTemplateInSameFile}" ItemsSource="{x:Bind Model.Employees, Mode=OneWay}" x:Name="FirstListView" SelectionMode="Single"/>

                <TextBlock Style="{StaticResource Note}"><Run>Listview - template in a resource dictionary</Run></TextBlock>
                <ListView Width="200" MaxHeight="400" ItemTemplate="{StaticResource FullNameTemplateInRDFile}" ItemsSource="{x:Bind Model.Employees, Mode=OneWay}" SelectedIndex="{x:Bind FirstListView.SelectedIndex}" SelectionMode="Single"/>

                <TextBlock Style="{StaticResource Note}"><Run>Listview - template with a user control</Run></TextBlock>
                <ListView Width="200" MaxHeight="400" ItemTemplate="{StaticResource TemplateWithUserControl}" ItemsSource="{x:Bind Model.ManagerProp.ReportsOC, Mode=OneWay}"/>

                <TextBlock Style="{StaticResource Note}"><Run>Listview - template in a sub folder</Run></TextBlock>
                <ListView Width="200" MaxHeight="400" ItemTemplate="{StaticResource FullNameTemplateInSubfolderRDFile}" ItemsSource="{x:Bind Model.Employees, Mode=OneWay}"/>

                <TextBlock Style="{StaticResource Note}"><Run>Button using template as ContentTemplate</Run></TextBlock>
                <Button ContentTemplate="{StaticResource FullNameTemplateInRDFile}" x:Name="someButton"/>

                <TextBlock Style="{StaticResource Note}"><Run>Button using template with valuetype data root</Run></TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="extractionPointButton" Content="{x:Bind Model.ExtractionPoint}">
                        <Button.ContentTemplate>
                            <DataTemplate x:DataType="model:Location">
                                <StackPanel>
                                    <TextBlock><Run>Latitude: </Run><Run Text="{x:Bind Coords.Latitude}"></Run>
                                        <Run>Longitiude: </Run><Run Text="{x:Bind Coords.Longitude}"></Run>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="{x:Bind Model.IntPropNoINPC}">
                        <Button.ContentTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <StackPanel>
                                    <TextBlock><Run>Lonely Number: </Run><Run Text="{x:Bind}"></Run></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <TextBlock Text="List bindings, with templates from different sources" Style="{StaticResource Section}"/>
                <StackPanel Orientation="Horizontal" MaxHeight="400">
                    <ListView Width="200" MaxHeight="400" ItemTemplate="{StaticResource FullNameTemplateInSameFile}" ItemsSource="{x:Bind Model.ManagerProp.ReportsOC, Mode=OneWay}"/>
                    <ListView Width="200" MaxHeight="400" ItemTemplate="{StaticResource FullNameTemplateInRDFile}" ItemsSource="{x:Bind Model.ManagerProp.ReportsOC, Mode=OneWay}"/>
                    <ListView Width="200" MaxHeight="400" ItemsSource="{x:Bind Model.ManagerProp.ReportsOC, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:IEmployee">
                                <Grid>
                                    <TextBlock Text="{x:Bind Name}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ModelCX.ObservableVectorOfStrings[0], Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button Click="UpdateValuesClick" >Update Values</Button>
                    <Button Click="ResetValuesClick" >Reset Values</Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>