<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <TargetFramework>$(DotNetCoreTargetFrameworkMoniker)</TargetFramework>
    <TargetPlatformMinVersion>$(WindowsAppSdkTargetPlatformVersion)</TargetPlatformMinVersion>
    <RootNamespace>BindTestbedModel</RootNamespace>
    <RuntimeIdentifiers>win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
    <DefineConstants>DESKTOP;USING_CSWINRT</DefineConstants>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <AssemblyName>BindTestbedModel</AssemblyName>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- update the Windows API version to reflect your TargetFramework -->
    <CsWinRTWindowsMetadata>10.0.19041.0</CsWinRTWindowsMetadata>
    <CsWinRTComponent>true</CsWinRTComponent>
    <CsWinRTEnableLogging>true</CsWinRTEnableLogging>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GeneratedFilesDir Condition="'$(GeneratedFilesDir)'==''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Generated Files'))</GeneratedFilesDir>
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(MicrosoftCsWinRTPackageVersion)" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  
  <!--Temporary workaround to address https://github.com/microsoft/CsWinRT/issues/1156 -->
  <Target Name="CsWinRTUpdatePreferredPackages" BeforeTargets="_HandlePackageFileConflicts" AfterTargets="ResolveTargetingPackAssets">
    <PropertyGroup>
      <PackageConflictPreferredPackages>Microsoft.Windows.CsWinRT;$(PackageConflictPreferredPackages)</PackageConflictPreferredPackages>
    </PropertyGroup>
  </Target>

</Project>