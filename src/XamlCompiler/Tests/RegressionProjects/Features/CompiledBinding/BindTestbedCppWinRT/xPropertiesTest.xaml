<UserControl
    x:Class="BindTestbed.xPropertiesTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BindTestbed"
    xmlns:model="using:BindTestbedModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <!--
        x:Property is not usable from C++ at all, so the whole x:Properties block below is
        commented out and the two properties it would have generated are declared in
        BindTestbed.idl and implemented in xPropertiesTest.h instead.  Two separate limitations
        stack up here:

        1. Carried forward from the C++/CX original (removed with the rest of the C++/CX
           projects in this change): complex and multiline x:Property default values are not
           supported in C++ because the CodeDomProvider on which x:Property's default-value
           emission is implemented was deprecated in VS2017.  Only simple string DefaultValue
           attributes work there.

        2. New for C++/WinRT: the C++/WinRT code generator has no x:Properties support of any
           kind.  CSharpPagePass1/2, VisualBasicPagePass1/2 and MoComCppPagePass1/2 all emit an
           InitializeXProperties() method from Model.XProperties; CppWinRT_PagePass1/2 have no
           equivalent, so not even the simple string form generates anything here.

        <x:Properties>
            <x:Property Name="TestStr" Type="x:String" DefaultValue="default value" />
            <x:Property Name="TestComplexDefaultValue" Type="model:Circle">
                <model:Circle Diameter="300" TestStringProperty="test string prop default\ttab"/>
            </x:Property>
            <x:Property Name="TestMultilineDefaultValue" Type="Button">
                <Button>
                    hello world!
                </Button>
            </x:Property>
            <x:Property Name="TestCreateFromString" Type="model:Diameter" DefaultValue="400" />
        </x:Properties>
    -->
    <Grid>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Style="{StaticResource Note}">TestStr test: this should display 'default value'</TextBlock>
                <TextBlock Text="{x:Bind TestStr}" x:Name="testText0"/>

                <TextBlock Style="{StaticResource Note}">TestCreateFromString test: this should display 400</TextBlock>
                <TextBlock Text="{x:Bind TestCreateFromString.Width}" x:Name="testText3"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
