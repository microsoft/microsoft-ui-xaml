  <PropertyGroup Label="Globals">
    <ProjectGuid>{07ccfce0-4301-40fc-b6dd-cf0149636529}</ProjectGuid>
    <ProjectName>BindTestbedCppWinRT</ProjectName>
    <RootNamespace>BindTestbed</RootNamespace>
    <!--
      Win32 desktop app model. AppContainerApplication=false is what makes the produced
      binary a desktop app; the AppContainer ("WinUI 3 in UWP") app model is not supported.
      ApplicationType selects the C++ toolset flavor that provides WinRT metadata, XAML and
      MSIX support - it is required by every C++/WinRT XAML project in this repo and does
      not by itself imply an app container.
    -->
    <AppContainerApplication>false</AppContainerApplication>
    <DesktopCompatible>true</DesktopCompatible>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>

    <!--
      This project has runtime classes in sub-namespaces (BindTestbed.subfolder.SubDictionary and
      BindTestbed.NamedRootsPage.NamedPageRootWithCompiledBindingUserChild). C++/WinRT names the
      component headers it generates for those two ways: with -prefix (the package default) it
      flattens the sub-namespace into the file name - subfolder.SubDictionary.g.h - and without it
      it mirrors the namespace as a directory - subfolder\SubDictionary.g.h.

      The XAML compiler always uses the directory form for the files it generates (it writes
      subfolder\SubDictionary.xaml.g.h into the same generated folder), so leaving prefixes on makes
      the two generators disagree inside one directory and the hand-written headers, which include
      "subfolder/SubDictionary.g.h", cannot find their base class. controls\CppWinRT.props turns
      prefixes off for the product code for the same reason.
    -->
    <CppWinRTUsePrefixes>false</CppWinRTUsePrefixes>
  </PropertyGroup>

