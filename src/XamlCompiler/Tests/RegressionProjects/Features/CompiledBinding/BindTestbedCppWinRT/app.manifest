<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity name="BindTestbed" version="1.0.0.0" type="win32" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- The subprocess tests launch without MSIX identity. Activate the C# model through
       its app-local CLR host instead of requiring machine/package registration. -->
  <file name="WinRT.Host.dll">
    <activatableClass xmlns="urn:schemas-microsoft-com:winrt.v1"
                      name="BindTestbedModel.DataModel" threadingModel="both" />
    <activatableClass xmlns="urn:schemas-microsoft-com:winrt.v1"
                      name="BindTestbedModel.DOModel" threadingModel="both" />
    <activatableClass xmlns="urn:schemas-microsoft-com:winrt.v1"
                      name="BindTestbedModel.FakeSettings" threadingModel="both" />
  </file>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
