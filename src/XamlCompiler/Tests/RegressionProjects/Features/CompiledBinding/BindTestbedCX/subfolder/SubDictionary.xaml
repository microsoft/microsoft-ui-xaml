<ResourceDictionary
    x:Class="BindTestbedCX.subfolder.SubDictionary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BindTestbedCX.subfolder"
    xmlns:parent="using:BindTestbedCX"
    xmlns:model="using:BindTestbedModel">

    <DataTemplate x:DataType="model:IEmployee" x:Key="FullNameTemplateInSubfolderRDFile">
        <Grid>
            <Image Source="../Assets/Icon.png" Width="20" Height="20" />
            <TextBlock Text="{x:Bind Name}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
