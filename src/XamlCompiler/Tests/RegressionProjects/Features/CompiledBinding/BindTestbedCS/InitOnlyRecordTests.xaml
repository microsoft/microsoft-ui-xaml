<UserControl
    x:Class="BindTestbed.InitOnlyRecordTests"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BindTestbed">

    <StackPanel>
        <!-- Generated C# bindings are nested in this control and can access its private setter. -->
        <TextBox Text="{x:Bind PrivateSetText, Mode=TwoWay}"/>
        <ItemsRepeater ItemsSource="{x:Bind BlogPosts}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:BlogPost">
                    <TextBlock Text="{x:Bind Title}"/>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
