    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BindTestbedModel\BindTestbedModel.csproj" />
  </ItemGroup>

</Project>
