<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{48e9166b-84bf-4d4e-9caa-8ec56ac4305f}</ProjectGuid>
    <ProjectName>StaticControlsLib</ProjectName>
    <RootNamespace>StaticControlsLib</RootNamespace>
    <TestProjectConfigurationType>StaticLibrary</TestProjectConfigurationType>
    <!--
      Win32 desktop app model. AppContainerApplication=false is what makes the produced
      binary a desktop app; the AppContainer ("WinUI 3 in UWP") app model is not supported.
      ApplicationType selects the C++ toolset flavor that provides WinRT metadata, XAML and
      MSIX support - it is required by every C++/WinRT XAML project in this repo and does
      not by itself imply an app container.
    -->
    <AppContainerApplication>false</AppContainerApplication>
    <DesktopCompatible>true</DesktopCompatible>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(CommonFilesPath)RuntimeComponentPreamble.vcxproj" />
  <ItemGroup>
