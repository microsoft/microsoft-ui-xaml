<local:MainPageBase
    x:Class="Simple.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Simple"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- Named strings cover resource and property-element connections, including empty defaults. -->
    <Page.Resources>
        <x:String x:Name="NamedResourceString">Resource value</x:String>
        <x:String x:Key="emptyString" x:Name="NamedEmptyString"></x:String>
        <!-- Primitive Type Property CodeGen -->
        <!-- Short Form -->
        <local:PropBag x:Name="propertyBagObject" StringProp="StringValue" IntProp="32" DoubleProp="22.22" BooleanProp="False"/>
        <!-- Long Form -->
        <local:PropBag x:Name="propertyBagObjectSecond">
            <local:PropBag.StringProp>
                <x:String>StringValue</x:String>
            </local:PropBag.StringProp>
            <local:PropBag.IntProp>
                <x:Int32>32</x:Int32>
            </local:PropBag.IntProp>
            <local:PropBag.DoubleProp>
                <x:Double>22.22</x:Double>
            </local:PropBag.DoubleProp>
            <local:PropBag.BooleanProp>
                <x:Boolean>False</x:Boolean>
            </local:PropBag.BooleanProp>
        </local:PropBag>
    </Page.Resources>

    <Grid x:Name="MainGrid" Background="{StaticResource CppWinRTSimpleMainGridWhiteColor}">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="NamedStringTextBlock">
                <TextBlock.Text><x:String x:Name="NamedInlineString">Inline value</x:String></TextBlock.Text>
            </TextBlock>
            <TextBlock x:Name="EmptyStringTextBlock">
                <TextBlock.Text><x:String x:Name="NamedEmptyInlineString"></x:String></TextBlock.Text>
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <!-- Element Name CodeGen -->
                <Button x:Name="Button1">Button 1</Button>
                <Button Name="Button2">Button 2</Button>
                <!-- Event CodeGen -->
                <Button Click="ClickHandler" Tapped="TappedHandler">Don't Click Me</Button>
                <Button Click="EventHandlerOnBase">Event Handler On Base</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock>
                        <Run>Page name: </Run>
                        <Run Text="{x:Bind PageName}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:MainPageBase>
