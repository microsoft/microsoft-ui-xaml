<Application
    x:Class="Simple.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Simple">
    <!-- Provide distinct backgrounds for the normal and incremental-build runtime checks. -->
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="CppWinRTSimpleMainGridWhiteColor">White</SolidColorBrush>
            <SolidColorBrush x:Key="CppWinRTSimpleMainGridBlackColor">Black</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
