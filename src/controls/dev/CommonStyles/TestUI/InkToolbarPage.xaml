<Page
    x:Class="MUXControlsTestApp.InkToolbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="12" RowSpacing="8" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Horizontal toolbar with the default tool set (pens + eraser + ruler). -->
        <InkToolbar x:Name="InkToolbar"
                    Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Left"
                    TargetInkCanvas="{x:Bind inkCanvas}"/>

        <!-- Status readout so the new events are observable during manual testing. -->
        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="StatusText" Text="Ready"/>
            <TextBlock Text="Open a pen flyout to see the Colors and Size labels. Click the ruler to toggle the stencil."
                       TextWrapping="Wrap" MaxWidth="260" FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <!-- The drawing surface. -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <InkCanvas x:Name="inkCanvas" Height="400"/>
        </Border>
    </Grid>
</Page>
