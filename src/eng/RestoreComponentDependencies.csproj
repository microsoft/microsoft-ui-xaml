<Project Sdk="Microsoft.NET.Sdk">
  <!-- Restores upstream component packages (FrameworkUdk, WinUIDetails, Foundation/IXP transport) at the eng/Versions.props versions into the packages folder. -->
  <PropertyGroup>
    <TargetFramework>uap10.0</TargetFramework>
    <TargetPlatformMinVersion>$(WindowsTargetPlatformMinVersion)</TargetPlatformMinVersion>

    <Copyright>Copyright (c) Microsoft Corporation. All rights reserved.</Copyright>
    <AssemblyTitle>WinUI.RestoreComponentDependencies</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.FrameworkUdk" Version="[$(FrameworkUdkPackageVersion)]"/>
    <PackageReference Include="Microsoft.Internal.WinUIDetails" Version="$(WinUIDetailsNugetVersion)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(IsInternalWinUIBuild)' != 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" version="$(FoundationTransportPackageVersion)"/>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" version="$(IxpTransportPackageVersion)"/>
  </ItemGroup>
  <ItemGroup Condition="'$(IsInternalWinUIBuild)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation.TransportPackage" version="$(FoundationTransportPackageVersion)"/>
    <PackageReference Include="Microsoft.ProjectReunion.InteractiveExperiences.TransportPackage" version="$(IxpTransportPackageVersion)"/>
  </ItemGroup>
</Project>
