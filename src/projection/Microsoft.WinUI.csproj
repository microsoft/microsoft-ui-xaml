<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />

  <!-- Importing because this project generates the interop assembly -->
  <Import Project="$(ProjectRoot)eng\winui-version.props" />

  <PropertyGroup>
    <TargetPlatformMinVersion>$(WindowsTargetPlatformMinVersion)</TargetPlatformMinVersion>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <Copyright>Copyright (c) Microsoft Corporation. All rights reserved.</Copyright>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(ProjectRoot)eng\key.snk</AssemblyOriginatorKeyFile>
    <AssemblyTitle>Microsoft.WinUI v$(Version)</AssemblyTitle>
    <AssemblyTitle Condition="'$(ProductPrereleaseTag)'!=''">$(AssemblyTitle)-$(ProductPrereleaseTag)</AssemblyTitle>

    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup Condition="!$(_IsCsWinRTv3)">
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection.dll">
      <HintPath>$(LiftedMRTLibPath)\$(TargetFramework)\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="$(_IsCsWinRTv3)">
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection.dll">
      <HintPath>$(LiftedMRTPackagePath)\ref\$(TargetFramework)\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <CSWinRTIncludes>$(WinUI_CSWinRTIncludes)</CSWinRTIncludes>
    <CSWinRTExcludes>$(WinUI_CSWinRTExcludes)</CSWinRTExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Condition="'$(IsInternalWinUIBuild)' == 'true'" Include="Microsoft.SourceLink.AzureRepos.Git" PrivateAssets="All" />
    <ProjectReference Include="..\..\MergedWinMD\MergedWinMD.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <CsWinRTInputs Include="$(PkgMicrosoft_Internal_WinUIDetails)\lib\uap10.0\Microsoft.UI.Text.winmd" />
    <CsWinRTInputs Include="$(LiftedMRTWinmdPath)\Microsoft.Windows.ApplicationModel.Resources.winmd" />
  </ItemGroup>

  <!-- CsWinRT 3.0 generates reference projections rather than implementation assemblies.
       Exclude the hand-written type forwarders. -->
  <ItemGroup Condition="$(_IsCsWinRTv3)">
    <Compile Remove="CoreWebView2TypeForwarders.cs" />
    <Compile Remove="WindowsUITypeForwarders.cs" />
  </ItemGroup>

  <!-- Add the generated cswinrt interop assembly to the nuget -->
  <ItemGroup Condition="'$(TargetFramework)' != ''">
    <PackageContent Include="$(OutDir)$(TargetName).dll" PackageLocation="$(CSWinRTInteropAssemblyPackageLocation)" />
  </ItemGroup>

  <!-- CsWinRT 3.0 reference projection: ref assembly goes in ref/<tfm>/ folder -->
  <ItemGroup Condition="$(_IsCsWinRTv3)">
    <PackageContent Include="$(OutDir)ref\$(TargetName).dll" PackageLocation="$(CSWinRTRefAssemblyPackageLocation)" />
  </ItemGroup>
</Project>
