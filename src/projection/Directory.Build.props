<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Suppress generated-code, experimental API, and obsolete API warnings. -->
    <NoWarn>0108,0618,0628,8305</NoWarn>
    <LangVersion>preview</LangVersion>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Build both CsWinRT 2.x and 3.0 projections. -->
    <TargetFrameworks>$(WindowsAppSdkTargetFrameworkMoniker);$(WindowsAppSdkTargetFrameworkMoniker_v3)</TargetFrameworks>

    <!-- Load WebView2's WinRT metadata for projection generation. -->
    <WebView2UseWinRT>true</WebView2UseWinRT>

    <!-- Reference WebView2's CsWinRT projection during compilation. -->
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <PropertyGroup Condition="$(_IsCsWinRTv3)">
    <WindowsSdkPackageVersion>$(WindowsAppSdkWindowsSdkPackageVersion_v3)</WindowsSdkPackageVersion>
    <MicrosoftWindowsSDKNetRefPackVersionSuffixOverride></MicrosoftWindowsSDKNetRefPackVersionSuffixOverride>
    <CsWinRTGenerateReferenceProjection>true</CsWinRTGenerateReferenceProjection>
    <!-- Transport packages still contain win10-specific native assets. -->
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <!-- Separate per-TFM outputs to prevent collisions. -->
  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <OutputPath>$(BaseOutputPath)$(TargetFramework)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <CSWinRTInteropAssemblyPackageLocation>$(PackageOutputLocation)\lib\$(TargetFramework)</CSWinRTInteropAssemblyPackageLocation>
    <CSWinRTRefAssemblyPackageLocation>$(PackageOutputLocation)\ref\$(TargetFramework)</CSWinRTRefAssemblyPackageLocation>
  </PropertyGroup>

  <!-- Both TFMs compile, but only the projection selected by UseCsWinRT3 is copied to the shared test directory. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' and (('$(UseCsWinRT3)' != 'true' and $(TargetFramework.StartsWith('net10'))) or ('$(UseCsWinRT3)' == 'true' and !$(TargetFramework.StartsWith('net10'))))">
    <BinplaceOutputAssemblies>false</BinplaceOutputAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT"/>
    <PackageReference Include="$(LiftedIXPTransportPackageName)"/>
    <PackageReference Include="Microsoft.Internal.WinUIDetails" ExcludeAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Windows.CsWinRT" VersionOverride="$(MicrosoftCsWinRTPackageVersion)" PrivateAssets="all" Condition="!$(_IsCsWinRTv3)" />
    <PackageReference Update="Microsoft.Windows.CsWinRT" VersionOverride="$(MicrosoftCsWinRTv3PackageVersion)" PrivateAssets="all" Condition="$(_IsCsWinRTv3)" />
  </ItemGroup>

  <!-- Private types are selected by the input WinMDs, not these filters.
       Consumers needing private metadata should reference src\projection\private\Microsoft.WinUI.csproj. -->
  <PropertyGroup>
   <WinUI_CSWinRTIncludes>
      Microsoft.UI.Private;
      Microsoft.UI.Text;
      Microsoft.UI.Xaml;
    </WinUI_CSWinRTIncludes>

    <!-- Include AttributeName definitions from SDK 19041 for the 17763 target. -->
    <WinUI_CSWinRTIncludes>
      $(WinUI_CSWinRTIncludes);
      Windows.Foundation.Metadata.AttributeNameAttribute;
      Windows.Foundation.Metadata.AttributeName;
    </WinUI_CSWinRTIncludes>

  </PropertyGroup>
</Project>
