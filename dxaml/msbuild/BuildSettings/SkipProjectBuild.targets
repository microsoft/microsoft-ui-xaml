<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--
      Marker so other targets can tell that this file was actually imported. It is only imported
      from Microsoft.UI.Xaml.Build.targets, which SDK-style projects do not import, so SkipProject
      silently does nothing there. See ValidateSkipProjectIsHonored in the root Directory.Build.targets.
    -->
    <PropertyGroup>
        <SkipProjectBuildImported>true</SkipProjectBuildImported>
    </PropertyGroup>

    <Target Name="Build">
        <Warning Code="XAMLSKIP001" Text="Skipping project $(MSBuildProjectFile) due to TestCode=$(TestCode) and BuildTestCode=$(BuildTestCode)" Condition="'$(TestCode)'!='' and '$(BuildTestCode)'=='false'"/>
        <Warning Code="XAMLSKIP002" Text="Skipping project $(MSBuildProjectFile) due to SkipProject=$(SkipProject) and BuildAll=$(BuildAll)" Condition="'$(SkipProject)'=='true' and '$(BuildAll)'!='true'"/>
    </Target>

    <Target Name="Midl"/>
    <Target Name="Sign"/>
    <Target Name="Binplace"/>
    <Target Name="CoreCompile"/>
    <Target Name="ResolveProjectReferences"/>
    <Target Name="_GenerateRestoreProjectPathWalk"/>
    <Target Name="_ComposedMetadata"/>
    <Target Name="GetTargetPath"/>
    <Target Name="GetNativeManifest"/>
    <Target Name="UnpackPackages"/>

    <ItemGroup>
      <WinMDFullPath Remove="@(WinMDFullPath)" />
    </ItemGroup>
</Project>