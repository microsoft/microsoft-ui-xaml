<!-- Minimal ContentDialog style used to verify which template ApplyTemplate expands. -->
<Style TargetType="ContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ContentDialog">
                <Grid>
                    <Grid x:Name="PART_VerifyThisTemplateWasUsed" />
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
