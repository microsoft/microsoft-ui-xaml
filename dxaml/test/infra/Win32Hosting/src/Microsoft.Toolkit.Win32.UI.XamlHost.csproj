<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <PropertyGroup>
    <TargetFramework>$(DotNetCoreTargetFrameworkMoniker)</TargetFramework>
    <RootNamespace>Microsoft.Toolkit.Win32.UI.XamlHost</RootNamespace>
    <UseWPF>true</UseWPF>
    <WebView2UseWinRT>true</WebView2UseWinRT>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
  </ItemGroup>

  <!-- Merged WinUI generation needs the Resources reference projection, which does not flow transitively. -->
  <ItemGroup Condition="'$(UseCsWinRT3)'=='true'">
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection.dll">
      <HintPath>$(LiftedMRTPackagePath)\ref\$(TargetFramework)\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ProjectRoot)\src\projection\private\Microsoft.WinUI.csproj" SetTargetFramework="TargetFramework=$(WinUIProjectionConsumerTFM)" />
  </ItemGroup>
</Project>
