<Project ToolsVersion="15.0"
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <TargetFramework>$(DotNetCoreTargetFrameworkMoniker)</TargetFramework>
    <Platforms>x64;x86;ARM64</Platforms>
    <WebView2UseWinRT>true</WebView2UseWinRT>
  </PropertyGroup>

  <PropertyGroup>
    <TargetDestination>$(TestBinplaceDestinationPath)</TargetDestination>
    <TestCode>true</TestCode>
  </PropertyGroup>

  <!-- The aggregate owns sidecars; TAEF loads these consumers as ordinary managed libraries. -->
  <PropertyGroup Condition="'$(UseCsWinRT3)'=='true' and '$(MSBuildProjectName)' != 'Microsoft.UI.Xaml.Tests.Managed.Common'">
    <CsWinRTGenerateInteropAssembly>false</CsWinRTGenerateInteropAssembly>
    <OutputType>Library</OutputType>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(XamlSourcePath)\test\managed\common\AssemblySetup.cs" />
    <Compile Include="$(ProjectRoot)test\SharedTestProjections\CsWinRT3Bootstrap.cs"
             Condition="'$(UseCsWinRT3)' == 'true' and '$(MSBuildProjectName)' != 'Microsoft.UI.Xaml.Tests.Managed.Common'" />
  </ItemGroup>

  <Import Project="taef.managed.props"/>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(MicrosoftCsWinRTPackageVersion)" Condition="!$(TargetFramework.StartsWith('net11.0'))" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(MicrosoftCsWinRTv3PackageVersion)" Condition="$(TargetFramework.StartsWith('net11.0'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ProjectRoot)\src\projection\private\Microsoft.WinUI.csproj" SetTargetFramework="TargetFramework=$(WinUIProjectionConsumerTFM)" />
    <ProjectReference Include="$(InfraTestPath)\client\cswinrt\Private.Infrastructure.CsWinRT.csproj" Private="False" />
    <ProjectReference Include="$(XamlSourcePath)\test\managed\common\Microsoft.UI.Xaml.Tests.Managed.Common.csproj" Private="False" />
  </ItemGroup>

  <!-- Merged WinUI generation needs the Resources reference projection, which does not flow transitively. -->
  <ItemGroup Condition="'$(UseCsWinRT3)'=='true'">
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection.dll">
      <HintPath>$(LiftedMRTPackagePath)\ref\$(TargetFramework)\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- SharedTestProjections owns the deployed sidecars; retain runtime forwarders and test resources. -->
  <Target Name="BinplaceCsWinRT3MergedProjection"
          AfterTargets="AddBinplaceItems"
          BeforeTargets="Binplace"
          Condition="'$(UseCsWinRT3)'=='true' and '$(MSBuildProjectName)' != 'Microsoft.UI.Xaml.Tests.Managed.Common'">
    <ItemGroup>
      <!-- Include the WebView2 runtime forwarder when present. -->
      <BinplaceItem Include="$(OutDir)Microsoft.Web.WebView2.Core.Projection.dll" Condition="Exists('$(OutDir)Microsoft.Web.WebView2.Core.Projection.dll')">
        <Destination>$(TargetDestination)</Destination>
      </BinplaceItem>
      <!-- Deploy Foundation's runtime projections from lib, not its compile-time references from ref. -->
      <BinplaceItem Include="$(LiftedMRTLibPath)\$(WindowsAppSdkTargetFrameworkMoniker_v3)\*.Projection.dll">
        <Destination>$(TargetDestination)</Destination>
      </BinplaceItem>
      <!-- Keep the test DLL and resources in the same folder. Omit .deps.json/.runtimeconfig.json:
           TAEF uses directory probing, and .deps.json can cause duplicate assembly loads. -->
      <BinplaceItem Include="$(OutDir)$(TargetName).dll" Condition="Exists('$(OutDir)$(TargetName).dll')">
        <Destination>$(TargetDestination)</Destination>
      </BinplaceItem>
      <BinplaceItem Include="$(OutDir)$(TargetName).pri" Condition="Exists('$(OutDir)$(TargetName).pri')">
        <Destination>$(TargetDestination)</Destination>
      </BinplaceItem>
    </ItemGroup>
  </Target>
</Project>
