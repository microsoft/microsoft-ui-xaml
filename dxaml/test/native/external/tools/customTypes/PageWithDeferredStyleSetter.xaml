<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tests.Tools.Shared">
    <Grid x:Name="root">
        <Grid.Resources>
            <Style x:Key="DeferredStyle" TargetType="Button">
                <Setter Property="Tag">
                    <Setter.Value>
                        <local:CustomUserControl CustomInt="37" />
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Button x:Name="testButton" Tag="Local override" Style="{StaticResource DeferredStyle}" />
    </Grid>
</Page>
