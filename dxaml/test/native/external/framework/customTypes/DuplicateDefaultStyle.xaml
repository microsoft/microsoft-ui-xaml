<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tests.Native.External.Framework">
    <Style TargetType="local:DefaultStyleControl">
        <Setter Property="local:CustomControl.AttachedTag">
            <Setter.Value>
                <!-- This Style should never be used: the later AttachedTag setter takes precedence. -->
                <Style TargetType="Control">
                    <Setter Property="Width" Value="13" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="local:CustomControl.AttachedTag">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Width" Value="37" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DeferredCustomObjectStyle" TargetType="Control">
        <Setter Property="local:CustomControl.AttachedTag">
            <Setter.Value>
                <local:CustomObject />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MissingResourceStyle" TargetType="Control">
        <Setter Property="local:CustomControl.AttachedTag" Value="{StaticResource MissingSetterResource}" />
    </Style>
    <Style x:Key="DerivedMissingResourceStyle" TargetType="Control" BasedOn="{StaticResource MissingResourceStyle}" />
</ResourceDictionary>
