import "XamlOM.WinUI.idl";

cpp_quote("#define XAMLDIAGTAP_UWPSURFACECONNECTED L\"Test.XamlDiag.UwpSurfaceConnection\"")

// Interfaces.

[
    object,
    uuid(7776037b-cbbe-4de1-ad6f-0dbf1d5817b4),
    pointer_default(unique)
]
interface IXamlDiagnosticsTestHooks : IUnknown
{
    HRESULT UnregisterInstance(InstanceHandle handle);
    HRESULT TryGetDispatcherQueueForObject(InstanceHandle obj, IInspectable** queue); 
};

typedef struct XamlGraphicsResourceCounterSnapshot
{
    UINT32 Reserved;
    WCHAR Name[64];
    UINT64 TotalCreated;
    UINT64 TotalDestroyed;
    UINT64 LiveCount;
} XamlGraphicsResourceCounterSnapshot;

const UINT32 XamlMemorySnapshotResourceCapacity = 32;

typedef struct XamlMemorySnapshot
{
    UINT64 AllocCount;
    UINT64 AllocSize;
    INT64 AllocatedMemory;
    UINT64 OutstandingAllocCount;
    UINT64 OutstandingAllocSize;
    XamlGraphicsResourceCounterSnapshot Resources[XamlMemorySnapshotResourceCapacity];
} XamlMemorySnapshot;

[
    object,
    uuid(e4663afc-ea1a-4b94-8c21-56e938403965),
    pointer_default(unique)
]
interface IXamlDiagnostics3 : IUnknown
{
    HRESULT GetMemorySnapshot([out] XamlMemorySnapshot* snapshot);
};

