  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalOptions>$([System.String]::Copy('%(AdditionalOptions)').Replace('/Zc:noexceptTypes-', '/Zc:noexceptTypes'))</AdditionalOptions>
