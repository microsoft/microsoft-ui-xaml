    <ProjectIncludeDirectories>$(ProjectIncludeDirectories);$(MSBuildThisFileDirectory);$(MuxControlsPath)\dev\TableView;$(MuxControlsPath)\dev\Telemetry;$(MuxControlsPath)\dev\inc;$(XcpPath)\inc;$(TempDir);</ProjectIncludeDirectories>
