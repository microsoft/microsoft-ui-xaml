<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FullscreenPixelLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Issue 12138 - Fullscreen Pixel Lab">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnFullscreenKey" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKey" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- A deliberately bright test surface makes an uncovered physical pixel visible. -->
        <Border Background="#00FF80" AutomationProperties.Name="Top edge test strip" />
        <Grid x:Name="DragRegion" Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Margin="24,0" VerticalAlignment="Center" Text="Issue 12138 - Fullscreen Pixel Lab" />
        </Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32" Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Text="Does XAML reach the top?" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="RuntimeText" AutomationProperties.AutomationId="RuntimeLabel" TextWrapping="Wrap" />
                <TextBlock Text="Enter fullscreen with Window.ExtendsContentIntoTitleBar enabled. The green strip should touch the screen's top row. A top offset of 1 physical pixel reproduces the bug."
                           TextWrapping="Wrap" />
                <Border Padding="20" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="OffsetText" AutomationProperties.AutomationId="TopOffset"
                                   Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultText" AutomationProperties.AutomationId="MeasurementResult" TextWrapping="Wrap" />
                        <TextBlock x:Name="StateText" AutomationProperties.AutomationId="WindowState" TextWrapping="Wrap" />
                        <TextBlock x:Name="GeometryText" AutomationProperties.AutomationId="Geometry"
                                   FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
                <ToggleSwitch x:Name="ExtendToggle" Header="Window.ExtendsContentIntoTitleBar"
                              AutomationProperties.AutomationId="ExtendTitleBar"
                              IsOn="True" Toggled="OnExtendToggled" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="EnterButton" Content="Enter fullscreen (F11)" Click="OnEnterFullscreen"
                            AutomationProperties.AutomationId="EnterFullscreen" />
                    <Button x:Name="ExitButton" Content="Exit fullscreen (Esc)" Click="OnExitFullscreen"
                            AutomationProperties.AutomationId="ExitFullscreen" />
                </StackPanel>
                <TextBlock Text="The offset is measured from the real DesktopChildSiteBridge HWND to the top-level client origin, in physical pixels. No gap is drawn or simulated. In a normal restored window, a 1 px offset with the custom title bar enabled is expected."
                           TextWrapping="Wrap" />
                <InfoBar x:Name="MeasurementError" Severity="Error" IsClosable="False"
                         Title="Measurement unavailable" AutomationProperties.AutomationId="MeasurementError" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
