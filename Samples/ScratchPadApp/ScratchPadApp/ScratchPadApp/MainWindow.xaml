<Window
    x:Class="ScratchPadApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScratchPadApp"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="8" Padding="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Ink surface: InkToolbar over a full-size InkCanvas -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:InkToolbar x:Name="Toolbar" Grid.Row="0" Margin="0,0,0,6" />
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="White">
                <controls:InkCanvas x:Name="InkSurface" />
            </Border>
        </Grid>

        <!-- Perf / compositor panel -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock Text="WinUI3 Inking Perf Harness" FontSize="20" FontWeight="Bold" />

                <!-- Compositor path configuration -->
                <TextBlock Text="Compositor path" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="CompositorModeCombo" Width="140" SelectionChanged="OnCompositorModeChanged">
                        <ComboBoxItem Content="auto" />
                        <ComboBoxItem Content="lifted" />
                        <ComboBoxItem Content="system" />
                    </ComboBox>
                    <Button x:Name="RestartButton" Content="Restart to apply" Click="OnRestartClick" />
                </StackPanel>
                <TextBlock x:Name="CompositorPathText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                           Text="active path: (draw a stroke, then Refresh)" />

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ResetButton" Content="Reset stats" Click="OnResetClick" />
                    <Button x:Name="ExportButton" Content="Export CSV" Click="OnExportClick" />
                    <Button x:Name="ClearButton" Content="Clear ink" Click="OnClearClick" />
                    <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
                </StackPanel>

                <!-- DIAGNOSTIC: isolate whether the InkToolbar is what blocks inking. Off = raw InkCanvas
                     (like the app that inked here); On = toolbar drives the presenter. -->
                <ToggleSwitch x:Name="ToolbarConnectToggle" Header="Connect InkToolbar to canvas"
                              OnContent="Connected" OffContent="Detached (raw canvas)" Toggled="OnToolbarConnectToggled" />
                <Button x:Name="TestStrokeButton" Content="Add test stroke (no input)" Click="OnAddTestStrokeClick" />

                <ToggleSwitch x:Name="FrameCaptureToggle" Header="Capture frame cadence (FPS)"
                              OnContent="On" OffContent="Off" Toggled="OnFrameCaptureToggled" />

                <TextBlock Text="Startup" FontWeight="SemiBold" />
                <TextBlock x:Name="StartupText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                <TextBlock Text="Last stroke" FontWeight="SemiBold" />
                <TextBlock x:Name="StrokeText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                <TextBlock Text="Aggregate (all strokes)" FontWeight="SemiBold" />
                <TextBlock x:Name="AggregateText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                <TextBlock Text="Frame cadence" FontWeight="SemiBold" />
                <TextBlock x:Name="FrameText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                <TextBlock Text="Memory" FontWeight="SemiBold" />
                <TextBlock x:Name="MemoryText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                <!-- Events added in this PR: StrokesErased + InkStrokeInput + InkUnprocessedInput.
                     Draw to see StrokeInput + StrokesCollected; erase with the eraser tool for
                     StrokesErased; flip the toggle to route input to UnprocessedInput instead. -->
                <TextBlock Text="Input events (this PR)" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="UnprocessedModeToggle" Header="Route input to UnprocessedInput (Mode=None)"
                              OnContent="Unprocessed" OffContent="Inking" Toggled="OnUnprocessedModeToggled" />
                <TextBlock x:Name="EventCountText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                           Text="draw / erase to see events..." />
                <TextBlock x:Name="EventLogText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           FontFamily="Consolas" FontSize="11" />

                <TextBlock Text="Log" FontWeight="SemiBold" />
                <TextBlock x:Name="LogText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           FontFamily="Consolas" FontSize="11" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


