<Page
    x:Class="SystemComponentExperiment.CSharp.CompositionScenarioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="16" Spacing="12">
        <TextBlock
            Text="Compositor and visual creation"
            Style="{StaticResource TitleTextBlockStyle}"
            AutomationProperties.HeadingLevel="Level1" />
        <Button
            Content="Run scenario"
            Click="RunScenario_Click"
            AutomationProperties.Name="Run Composition scenario" />
        <Border x:Name="VisualHost" Width="160" Height="160" Background="Gray" />
        <TextBlock x:Name="ResultText" AutomationProperties.Name="Scenario result" />
    </StackPanel>
</Page>
