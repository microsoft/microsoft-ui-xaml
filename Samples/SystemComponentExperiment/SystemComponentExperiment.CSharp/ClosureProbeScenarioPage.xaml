<Page
    x:Class="SystemComponentExperiment.CSharp.ClosureProbeScenarioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="16" Spacing="12">
        <TextBlock
            Text="WUC closure metadata and activation probes"
            Style="{StaticResource TitleTextBlockStyle}"
            AutomationProperties.HeadingLevel="Level1" />
        <Button
            Content="Run probes"
            Click="RunProbes_Click"
            AutomationProperties.Name="Run WUC closure probes" />
        <TextBox
            x:Name="ResultText"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="240"
            AutomationProperties.Name="Scenario result" />
    </StackPanel>
</Page>
