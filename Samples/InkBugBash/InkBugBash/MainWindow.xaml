<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InkBugBash.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Window is not a FrameworkElement in WinUI 3, so app resources live on the root grid. -->
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="SectionIntro" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Padding="18,14"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Spacing="2">
                <TextBlock Text="WinUI 3 Ink Bug Bash"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource SectionIntro}" Margin="0"
                           Text="Draw on the white canvas with a pen, mouse or touch. Change one setting at a time in the panel on the right, then draw again and check the result. The status bar at the bottom reports what the control actually did." />
            </StackPanel>
        </Border>

        <!-- ===== Body: canvas on the left, settings on the right ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Canvas column -->
            <Grid Grid.Column="0" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="InkToolbar" Style="{StaticResource SectionTitle}" />
                        <!-- The toolbar is created in code so it can be re-targeted and re-parented at runtime. -->
                        <StackPanel x:Name="ToolbarHost" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="{ThemeResource InkCanvasBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <ScrollViewer x:Name="CanvasScroll"
                                  ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4"
                                  HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="CanvasHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Polyline x:Name="LassoPath"
                                      Stroke="DodgerBlue" StrokeThickness="2"
                                      StrokeDashArray="4,3"
                                      Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Settings column -->
            <ScrollViewer Grid.Column="1" Padding="0,18,18,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 1. Toolbar -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1 · Toolbar layout" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionIntro}"
                                       Text="Everything here changes the InkToolbar shown above the canvas." />

                            <TextBlock Text="Buttons to show" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="InitialControlsBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="PensOnly" />
                                <ComboBoxItem Content="AllExceptPens" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="InkToolbar only reads this while it builds its buttons, so the app creates a fresh toolbar when you change it. Your other toolbar settings are re-applied." />

                            <TextBlock Text="Flyout placement" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FlyoutPlacementBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="Top" />
                                <ComboBoxItem Content="Bottom" />
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Then click a pen button to open its flyout and check which side it opens on." />

                            <TextBlock Text="Orientation" Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch x:Name="VerticalToolbar" MinWidth="0"
                                          OffContent="Horizontal" OnContent="Vertical" />

                            <TextBlock Text="Eraser flyout" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="ClearAllVisible" Content="Show &quot;Clear all ink&quot; in eraser flyout" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Input -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2 · Input" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionIntro}"
                                       Text="Which devices the canvas listens to and how it treats them. The status bar shows the live device, pressure and tilt." />

                            <TextBlock Text="Accepted devices" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="PenInput" Content="Pen" />
                            <CheckBox x:Name="MouseInput" Content="Mouse" />
                            <CheckBox x:Name="TouchInput" Content="Touch" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Clear one and that device must stop drawing entirely." />

                            <TextBlock Text="Master switch" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="InputEnabled" Content="Canvas accepts input" />

                            <TextBlock Text="What the pen does" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                                <ComboBoxItem Content="None - lasso select" />
                                <ComboBoxItem Content="Inking - draw" />
                                <ComboBoxItem Content="Erasing - erase" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Pick None, then drag a loop around some ink to select it (see section 3)." />

                            <TextBlock Text="Right button / barrel drag" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RightDragBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="LeaveUnprocessed" />
                                <ComboBoxItem Content="AllowProcessing" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="How a right-mouse or pen-barrel drag is treated. LeaveUnprocessed: the drag is NOT turned into ink (use it for lasso/gestures). AllowProcessing: the drag draws ink like the pen tip. Test with a right-mouse drag on the canvas." />

                            <TextBlock Text="Pen hardware buttons" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="BarrelButton" Content="Barrel button erases" />
                            <CheckBox x:Name="EraserTip" Content="Eraser tip erases" />

                            <TextBlock Text="High contrast ink" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="HcBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="UseSystemColorsWhenNecessary" />
                                <ComboBoxItem Content="UseSystemColors" />
                                <ComboBoxItem Content="UseOriginalColors" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Only has a visible effect while Windows high contrast is switched on." />
                        </StackPanel>
                    </Border>

                    <!-- 4. Selection -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3 · Selection" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionIntro}"
                                       Text="Selected ink is framed by a blue dashed box. The status bar gives the stroke count and the box size." />

                            <TextBlock Text="Lasso select (simple)" Style="{StaticResource FieldLabel}" />
                            <ToggleButton x:Name="LassoToggle" HorizontalAlignment="Stretch"
                                          Content="Turn on lasso select" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Draw a few strokes, turn this on, then drag a loop around them to select. Turn it off to draw again. (This just switches the pen to None - the manual way is in section 2.)" />

                            <TextBlock Text="Freehand lasso" Style="{StaticResource FieldLabel}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="1. Draw a few strokes.  2. Set &quot;What the pen does&quot; in section 2 to None.  3. Drag a loop around the ink. A blue dashed line follows the pointer and the selected strokes are framed on release. A stroke is only picked up when all of it is inside the loop, so loop wide. Drawing is off while you are in lasso mode." />

                            <TextBlock Text="Then act on the selection" Style="{StaticResource FieldLabel}" />
                            <Button Content="Select every stroke" x:Name="SelectAllBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: one box around ALL the ink, and a count equal to every stroke on the canvas." />

                            <Button Content="Select with a diagonal line" x:Name="SelectWithLineBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: only the strokes the line passes through are selected. Unlike the lasso, a stroke counts if the line merely crosses it." />

                            <Button Content="Move selection right and down" x:Name="MoveSelectedBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: the selected ink and the box both jump 20 pixels right and down together. Unselected ink must not move." />

                            <Button Content="Delete selection" x:Name="DeleteSelectedBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: only the framed ink disappears, the box goes away, and the status bar reports how many strokes are left." />

                            <Button Content="Copy selection" x:Name="CopyBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: nothing visible changes - the ink just goes to the clipboard." />

                            <Button Content="Paste" x:Name="PasteBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Expect: a second copy of the copied ink appears near the top-left. If you never pressed Copy, it says the clipboard has no ink." />
                        </StackPanel>
                    </Border>

                    <!-- 5. Strokes and canvas -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="4 · Strokes, files and canvas size" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionIntro}"
                                       Text="Round-trip ink through disk and push the canvas with lots of strokes." />

                            <Button Content="Save ink as…" x:Name="SaveBtn" Style="{StaticResource ActionButton}" />
                            <Button Content="Save ink as a GIF…" x:Name="SaveGifBtn" Style="{StaticResource ActionButton}" />
                            <Button Content="Open a saved ink file…" x:Name="LoadBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                                       Text="Each button opens a normal Windows file dialog, so you pick the folder and name yourself. Expect: save, then Clear the canvas, then open the same file - the ink must come back exactly as it was. The full path of the last file is shown below and in the status bar." />
                            <TextBlock x:Name="LastFileText" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       IsTextSelectionEnabled="True"
                                       Text="No file saved or opened yet." />

                            <Button Content="Add 500 random strokes (stress)" x:Name="StressBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: 500 strokes appear at once and the canvas still scrolls, zooms and draws smoothly." />

                            <Button Content="Add one stroke" x:Name="AddOneBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: one wavy stroke appears at a random spot, added in code rather than by drawing." />

                            <Button Content="Look up a stroke by id" x:Name="GetByIdBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: the status bar reports the id and says it was found. Nothing changes on the canvas." />

                            <Button Content="Clear the canvas" x:Name="ClearBtn" Style="{StaticResource ActionButton}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Expect: all ink goes and the stroke count drops to 0." />

                            <TextBlock Text="Canvas size" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SizeBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                                <ComboBoxItem Content="Fit the window" />
                                <ComboBoxItem Content="1600 x 1200 (scrolls)" />
                                <ComboBoxItem Content="4000 x 3000 (scrolls)" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Scroll and zoom the canvas, then draw - the stroke must land under the pen tip." />
                        </StackPanel>
                    </Border>

                    <!-- 6. Custom drying -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="5 · Custom drying" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionIntro}"
                                       Text="Normally the control draws your finished ink. Custom drying hands each finished stroke to the app instead, and the app has to draw it. To make that handover obvious, this app redraws it in PINK." />

                            <TextBlock Text="What you should see" Style="{StaticResource FieldLabel}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="While the pen is down the stroke is your pen colour, because the control is still drawing it live. The instant you lift the pen it turns pink - that is the app redrawing it. Nothing should flicker, jump or disappear. A stroke vanishing on pen-up is a bug." />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Also expected in this mode: erasing does nothing, and selection, save, load and the stroke buttons are unavailable, because the ink belongs to the app rather than the control. Clear still works." />

                            <TextBlock x:Name="DryingText" Style="{StaticResource Hint}" Margin="0"
                                       Text="Default drying: the control renders dry ink." />
                            <Button x:Name="DryingButton" Content="Restart in custom drying mode"
                                    Style="{StaticResource ActionButton}" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The mode can only be chosen at start-up, so the app restarts itself." />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Padding="18,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Spacing="3">
                <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Ready." />
                <TextBlock x:Name="EventText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No input yet - touch the canvas with a pen, mouse or finger." />
            </StackPanel>
        </Border>

    </Grid>
</Window>
