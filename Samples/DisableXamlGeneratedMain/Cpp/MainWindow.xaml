<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DisableXamlGeneratedMainCpp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DisableXamlGeneratedMainCpp"
    xmlns:helpers="using:AppTestAutomationHelpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DisableXamlGeneratedMainCpp"
    mc:Ignorable="d">

    <Grid Loaded="OnRootLoaded">
        <StackPanel Orientation="Vertical">
            <TextBlock AutomationProperties.Name="MainWindowTextBlock" Text="MainWindow" />
            <TextBlock x:Name="entryPointTextBlock" AutomationProperties.Name="EntryPointTextBlock" />
            <helpers:TestAutomationHelpersPanel/>
        </StackPanel>
    </Grid>
</Window>
