<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InkA11yLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InkA11yLab"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ink accessibility lab"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1" />

        <!-- Every control is named so a screen reader and the UIA report both have something to say. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">

                <TextBlock Text="Input:" VerticalAlignment="Center" FontWeight="SemiBold" />
                <CheckBox x:Name="PenInput" Content="Pen" IsChecked="True"
                          AutomationProperties.Name="Accept pen input"
                          AutomationProperties.AutomationId="PenInput"
                          Checked="OnInputDevicesChanged" Unchecked="OnInputDevicesChanged" />
                <CheckBox x:Name="MouseInput" Content="Mouse" IsChecked="True"
                          AutomationProperties.Name="Accept mouse input"
                          AutomationProperties.AutomationId="MouseInput"
                          Checked="OnInputDevicesChanged" Unchecked="OnInputDevicesChanged" />
                <CheckBox x:Name="TouchInput" Content="Touch" IsChecked="True"
                          AutomationProperties.Name="Accept touch input"
                          AutomationProperties.AutomationId="TouchInput"
                          Checked="OnInputDevicesChanged" Unchecked="OnInputDevicesChanged" />

                <Border Width="1" Background="Gray" Margin="4,2" AutomationProperties.AccessibilityView="Raw" />

                <ToggleSwitch x:Name="VerticalToolbars" MinWidth="0"
                              AutomationProperties.Name="Toolbar orientation"
                              AutomationProperties.AutomationId="VerticalToolbars"
                              OffContent="Horizontal" OnContent="Vertical"
                              Toggled="OnOrientationToggled" />

                <TextBlock Text="High contrast ink:" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="HighContrastMode" MinWidth="230" SelectedIndex="0"
                          AutomationProperties.Name="Ink high contrast adjustment"
                          AutomationProperties.AutomationId="HighContrastMode"
                          SelectionChanged="OnHighContrastModeChanged">
                    <ComboBoxItem Content="UseSystemColorsWhenNecessary" />
                    <ComboBoxItem Content="UseSystemColors" />
                    <ComboBoxItem Content="UseOriginalColors" />
                </ComboBox>

                <Border Width="1" Background="Gray" Margin="4,2" AutomationProperties.AccessibilityView="Raw" />

                <CheckBox x:Name="CustomDrying" Content="Custom drying"
                          AutomationProperties.Name="Use app rendered dry ink"
                          AutomationProperties.AutomationId="CustomDrying"
                          Checked="OnCustomDryingChanged" Unchecked="OnCustomDryingChanged" />

                <CheckBox x:Name="OverlayRepro" Content="Overlay toolbar on canvas"
                          AutomationProperties.Name="Overlay toolbar on the canvas, known airspace bug"
                          AutomationProperties.AutomationId="OverlayRepro"
                          Checked="OnOverlayReproChanged" Unchecked="OnOverlayReproChanged" />

                <Button Content="Clear" Click="OnClear"
                        AutomationProperties.Name="Clear both surfaces"
                        AutomationProperties.AutomationId="ClearBoth" />

                <Button x:Name="RunReport" Content="Run accessibility report" Click="OnRunReport"
                        AutomationProperties.Name="Run accessibility report"
                        AutomationProperties.AutomationId="RunReport" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Drawing surface"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level2" />

            <controls:InkToolbar x:Name="ToolbarA" Grid.Row="1"
                                 InitialControls="All"
                                 TargetInkCanvas="{x:Bind CanvasA}"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.Name="Ink toolbar"
                                 AutomationProperties.AutomationId="ToolbarA" />

            <ScrollViewer x:Name="ScrollA" Grid.Row="2"
                          ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4"
                          HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Scroll area for the drawing surface"
                          AutomationProperties.AutomationId="ScrollA">
                <Grid Background="{ThemeResource InkCanvasBackgroundBrush}" BorderBrush="#D0D0D0" BorderThickness="1">
                    <controls:InkCanvas x:Name="CanvasA" Width="1600" Height="1200"
                                        AutomationProperties.Name="Drawing surface"
                                        AutomationProperties.AutomationId="CanvasA" />
                    <!-- Custom drying renders app-owned dry strokes here. -->
                    <Canvas x:Name="DryCanvasA" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />

                    <!-- Airspace repro: the ink surface composes above XAML, so these buttons are
                         neither drawn above the ink nor clickable where they overlap. -->
                    <controls:InkToolbar x:Name="ToolbarB"
                                         InitialControls="All"
                                         TargetInkCanvas="{x:Bind CanvasA}"
                                         Visibility="Collapsed"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="24"
                                         AutomationProperties.Name="Overlaid ink toolbar"
                                         AutomationProperties.AutomationId="ToolbarB" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="4" Padding="8">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText" Grid.Row="0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Status"
                           AutomationProperties.AutomationId="StatusText"
                           Text="Ready." />

                <ScrollViewer Grid.Row="1" Height="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReportText" FontFamily="Consolas" FontSize="12"
                               TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                               AutomationProperties.Name="Accessibility report"
                               AutomationProperties.AutomationId="ReportText" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
