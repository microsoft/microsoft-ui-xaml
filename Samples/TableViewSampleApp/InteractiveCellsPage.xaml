<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.InteractiveCellsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Interactive cells (expandable in every column)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="Every column hosts an interactive Expander (some embed an editable TextBox), plus a 'Width' column whose Slider grows an inner bar to change the cell's width live. The dropdown sets ALL columns to the same width mode: Auto sizes each column to its widest realized cell and re-sizes when you drag the Slider or expand a row; Star divides the viewport so content wraps/clips; Pixel fixes every column."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="All columns width:" VerticalAlignment="Center"/>
            <ComboBox x:Name="WidthCombo" SelectionChanged="Width_Changed">
                <ComboBoxItem Content="Auto" IsSelected="True"/>
                <ComboBoxItem Content="Star"/>
                <ComboBoxItem Content="Pixel 200"/>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <tv:TableView x:Name="Table"/>
        </Border>
    </Grid>
</Page>
