<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.SelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Row selection (single)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="Click a row, or move with Up/Down/Home/End/PageUp/PageDown — selection follows the keyboard cursor. Space selects the focused row without moving. Watch the 'SelectionChanged fired Nx' counter: 'Insert above selected' must NOT increment it (the same item stays selected, only its index shifts), while 'Remove selected' must increment it once as the selection clears. Toggle SelectionMode to None to see selection cleared and every gesture become a no-op."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="SelectionMode:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModeCombo" SelectionChanged="Mode_Changed">
                <ComboBoxItem Content="Single" IsSelected="True"/>
                <ComboBoxItem Content="None"/>
            </ComboBox>

            <Button Content="Select index 0" Click="SelectFirst_Click"/>
            <Button Content="Select last" Click="SelectLast_Click"/>
            <Button Content="Deselect all" Click="DeselectAll_Click"/>
            <Button Content="Insert above selected" Click="InsertAbove_Click"/>
            <Button Content="Remove selected" Click="RemoveSelected_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <tv:TableView x:Name="Table" SelectionMode="Single" SelectionChanged="Table_SelectionChanged"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
</Page>
