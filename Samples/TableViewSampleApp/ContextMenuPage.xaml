<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.ContextMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Page.Resources>
        <!-- A cell that owns its menu. XAML opens this ContextFlyout and marks ContextRequested
             handled, so the page-level handler never runs for this column. -->
        <DataTemplate x:Key="NotesCell">
            <TextBlock Text="{Binding Notes}" VerticalAlignment="Center" Margin="8,0">
                <TextBlock.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Flag note" Click="OnNoteFlag"/>
                        <MenuFlyoutItem Text="Clear note" Click="OnNoteClear"/>
                    </MenuFlyout>
                </TextBlock.ContextFlyout>
            </TextBlock>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Context menus" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="TableView has no context-menu API: an app builds one from the standard ContextRequested event. Right-click (or press Shift+F10 / the Menu key) on a cell for the row menu, on a column header for the header menu, and on the Notes column for a menu the cell template declares itself."/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <tabular:TableView x:Name="Table" ContextRequested="OnTableContextRequested"/>
        </Border>

        <TextBlock x:Name="Status" Grid.Row="2" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
    </Grid>
</Page>
