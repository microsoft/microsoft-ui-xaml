<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TableViewSampleApp.Controls.CodeBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CodeKeywordBrush" Color="#0000FF"/>
                    <SolidColorBrush x:Key="CodeStringBrush" Color="#A31515"/>
                    <SolidColorBrush x:Key="CodeCommentBrush" Color="#008000"/>
                    <SolidColorBrush x:Key="CodeTypeBrush" Color="#1F7A8C"/>
                    <SolidColorBrush x:Key="CodeElementBrush" Color="#800000"/>
                    <SolidColorBrush x:Key="CodeAttributeBrush" Color="#C50000"/>
                    <SolidColorBrush x:Key="CodeAttributeValueBrush" Color="#0000FF"/>
                    <SolidColorBrush x:Key="CodePunctuationBrush" Color="#0000FF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CodeKeywordBrush" Color="#569CD6"/>
                    <SolidColorBrush x:Key="CodeStringBrush" Color="#CE9178"/>
                    <SolidColorBrush x:Key="CodeCommentBrush" Color="#6A9955"/>
                    <SolidColorBrush x:Key="CodeTypeBrush" Color="#4EC9B0"/>
                    <SolidColorBrush x:Key="CodeElementBrush" Color="#569CD6"/>
                    <SolidColorBrush x:Key="CodeAttributeBrush" Color="#9CDCFE"/>
                    <SolidColorBrush x:Key="CodeAttributeValueBrush" Color="#CE9178"/>
                    <SolidColorBrush x:Key="CodePunctuationBrush" Color="#A0A0A0"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CodeKeywordBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
                    <SolidColorBrush x:Key="CodeStringBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="CodeCommentBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="CodeTypeBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
                    <SolidColorBrush x:Key="CodeElementBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
                    <SolidColorBrush x:Key="CodeAttributeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CodeAttributeValueBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="CodePunctuationBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The framework resolves these per theme (including Contrast themes); the highlighter
                 paints its runs with their Foreground. -->
            <StackPanel x:Name="Palette" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Foreground="{ThemeResource CodeKeywordBrush}"/>
                <TextBlock Foreground="{ThemeResource CodeStringBrush}"/>
                <TextBlock Foreground="{ThemeResource CodeCommentBrush}"/>
                <TextBlock Foreground="{ThemeResource CodeTypeBrush}"/>
                <TextBlock Foreground="{ThemeResource CodeElementBrush}"/>
                <TextBlock Foreground="{ThemeResource CodeAttributeBrush}"/>
                <TextBlock Foreground="{ThemeResource CodeAttributeValueBrush}"/>
                <TextBlock Foreground="{ThemeResource CodePunctuationBrush}"/>
            </StackPanel>

            <Grid Grid.Row="0" Padding="12,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CaptionText"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    AutomationProperties.HeadingLevel="Level3"
                    VerticalAlignment="Center"/>
                <ContentPresenter
                    x:Name="HeaderPresenter"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"/>
                <Button
                    x:Name="CopyButton"
                    Grid.Column="1"
                    Click="OnCopyClick"
                    AutomationProperties.AutomationId="CopyCodeButton"
                    AutomationProperties.Name="Copy code"
                    Style="{ThemeResource SubtleButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="CopyText" Text="Copy" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Capped by CodeMaxHeight; SamplePresenter lifts the cap because its own Source scroller
                 is already bounded, so there is only one vertical scroller. -->
            <ScrollViewer
                x:Name="CodeScroller"
                Grid.Row="1"
                MaxHeight="360"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                IsTabStop="True"
                UseSystemFocusVisuals="True"
                AutomationProperties.Name="Code">
                <RichTextBlock
                    x:Name="CodeText"
                    Padding="14,12"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
