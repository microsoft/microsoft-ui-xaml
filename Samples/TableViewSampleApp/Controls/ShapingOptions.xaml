<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the controls whose AutomationIds come from AutomationIdPrefix carry an x:Name:
    WinUI reports an unset AutomationId as the x:Name.
-->
<UserControl
    x:Class="TableViewSampleApp.Controls.ShapingOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Shaping">
        <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping"
                   Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
        <TextBlock Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
        <ComboBox
            x:Name="ShapingModeSelector"
            Header="Shaping mode"
            SelectedIndex="0"
            SelectionChanged="OnShapingModeChanged"
            HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Flat" Tag="flat"/>
            <ComboBoxItem Content="Grouped" Tag="grouped"/>
            <!-- Enabled once the page attaches a ParentRelation; otherwise disabled with the page's reason. -->
            <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"/>
            <ComboBoxItem Content="Grouped hierarchy" Tag="groupedHierarchy" IsEnabled="False"/>
        </ComboBox>
        <ComboBox
            x:Name="GroupKeySelector"
            Header="Group key"
            IsEnabled="False"
            AutomationProperties.HelpText="Available in the Grouped and Grouped hierarchy shaping modes."
            SelectionChanged="OnGroupKeyChanged"
            HorizontalAlignment="Stretch"/>
        <Button
            x:Name="ExpandAllButton"
            Content="Expand all"
            Click="OnExpandAllClick"
            IsEnabled="False"
            ToolTipService.ToolTip="Calls TableView.ExpandAllGroups()."
            AutomationProperties.HelpText="Available in every shaping mode except Flat."
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"/>
        <Button
            x:Name="CollapseAllButton"
            Content="Collapse all"
            Click="OnCollapseAllClick"
            IsEnabled="False"
            ToolTipService.ToolTip="Calls TableView.CollapseAllGroups()."
            AutomationProperties.HelpText="Available in every shaping mode except Flat."
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"/>
        <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                   Text="Group key needs a grouped mode; Expand all and Collapse all need any mode but Flat."/>
    </StackPanel>
</UserControl>
