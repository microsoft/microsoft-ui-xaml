<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TableViewSampleApp.Controls.SamplePresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TableViewSampleApp.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <!--
        The header sits above OuterScroller so it stays visible. The Options column is a fixed 320 px:
        auto-sizing made the table shake between pages. Narrow layouts stack the rail under the Example.
    -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- The Source button sits at the right end of the title row; ArrangeHeader wraps it under the
         title when the row is too narrow for both. -->
    <Grid x:Name="HeaderPanel" Grid.Row="0" RowSpacing="8" ColumnSpacing="12" MaxWidth="{StaticResource PageMaxContentWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="HeaderText"
            Grid.Row="0"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind Header, Mode=OneWay}"
            AutomationProperties.HeadingLevel="Level1"
            TextWrapping="Wrap"
            VerticalAlignment="Center"/>

        <!-- Links to this page's source and the control's source; shown on pages with a Snippet.
             The GitHub mark is the WinUI Gallery's GitHubIconPath; PathIcon takes the button's Foreground. -->
        <DropDownButton
            x:Name="SourceLinksButton"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="SampleSourceLinksButton"
            AutomationProperties.Name="Source"
            ToolTipService.ToolTip="Source code of this sample page and of TableView"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Height="18" AutomationProperties.AccessibilityView="Raw">
                    <PathIcon Data="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/>
                </Viewbox>
                <TextBlock Text="Source"/>
            </StackPanel>
            <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="Sample page source code"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level3"/>
                            <FontIcon
                                Glyph="&#xE946;"
                                FontSize="14"
                                ToolTipService.ToolTip="The files of this sample page on GitHub."
                                AutomationProperties.AccessibilityView="Raw"/>
                        </StackPanel>
                        <HyperlinkButton
                            x:Name="SourceXamlLink"
                            Content="XAML"
                            AutomationProperties.AutomationId="SampleSourceXamlLink"
                            AutomationProperties.HelpText="The files of this sample page on GitHub."
                            Click="OnSourceLinkClick"/>
                        <HyperlinkButton
                            x:Name="SourceCSharpLink"
                            Content="C#"
                            AutomationProperties.AutomationId="SampleSourceCSharpLink"
                            AutomationProperties.HelpText="The files of this sample page on GitHub."
                            Click="OnSourceLinkClick"/>
                        <Border
                            Height="1"
                            Margin="0,6"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            AutomationProperties.AccessibilityView="Raw"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="Control source code"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level3"/>
                            <FontIcon
                                Glyph="&#xE946;"
                                FontSize="14"
                                ToolTipService.ToolTip="The TableView control's implementation and its API spec on GitHub."
                                AutomationProperties.AccessibilityView="Raw"/>
                        </StackPanel>
                        <HyperlinkButton
                            Content="TableView"
                            Tag="https://github.com/microsoft/microsoft-ui-xaml/tree/main/controls/dev/TableView"
                            AutomationProperties.AutomationId="SampleControlSourceLink"
                            AutomationProperties.HelpText="The TableView control's implementation and its API spec on GitHub."
                            Click="OnSourceLinkClick"/>
                        <HyperlinkButton
                            Content="Spec"
                            Tag="https://github.com/microsoft/microsoft-ui-xaml/blob/main/docs/api-specs/TableView/TableView-spec.md"
                            AutomationProperties.AutomationId="SampleControlSpecLink"
                            AutomationProperties.HelpText="The TableView control's implementation and its API spec on GitHub."
                            Click="OnSourceLinkClick"/>
                    </StackPanel>
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>

        <!-- Description -->
        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="{x:Bind Description, Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            MaxWidth="1000"
            HorizontalAlignment="Left"/>
    </Grid>

    <ScrollViewer
        x:Name="OuterScroller"
        Grid.Row="1"
        VerticalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="OuterGrid" Margin="{StaticResource PageContentMargin}" RowSpacing="8" MaxWidth="{StaticResource PageMaxContentWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ExampleRow" Height="Auto" MinHeight="320"/>
            <RowDefinition x:Name="SourceRow" Height="Auto"/>
            <RowDefinition x:Name="NarrowSourceRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="OptionsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- No card frame: tables draw their own border. -->
        <!-- No x:Name on the InfoBars: WinUI reports an unset AutomationId as the x:Name. -->
        <Grid x:Name="ExampleGrid" Grid.Row="0" Grid.Column="0" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ExampleHostRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Not an InfoBar, which announces on open. Unnamed for the same AutomationId reason. -->
            <Border
                Grid.Row="0"
                MinHeight="104"
                Padding="16,14"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="&#xE946;"
                        FontSize="16"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run Text="Try it" FontWeight="SemiBold"/><Run Text="  "/><Run x:Name="TryItMessageRun"/>
                    </TextBlock>
                </Grid>
            </Border>
            <ContentControl
                x:Name="ExampleHost"
                Grid.Row="1"
                IsTabStop="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind Example, Mode=OneWay}"/>
        </Grid>

        <!-- Options rail (right in wide layouts, stacked under the example in narrow
             layouts) — collapses when Options is null. In wide mode its width is
             governed by the parent OptionsColumn (fixed 320 px) so the table never
             shakes, and RailHost bounds its height so the rail scrolls, not the page. -->
        <local:RailHost
            x:Name="OptionsRail"
            Grid.Row="0" Grid.Column="1"
            Margin="12,0,0,0"
            Visibility="Collapsed">
        <Border
            x:Name="OptionsBorder"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid x:Name="RailGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <SelectorBar
                    x:Name="RailTabs"
                    Margin="8,4,8,0"
                    AutomationProperties.AutomationId="RailTabs"
                    AutomationProperties.Name="Sample panels"
                    SelectionChanged="OnRailTabsSelectionChanged">
                    <SelectorBarItem
                        x:Name="RailOptionsTab"
                        Text="Options"
                        IsSelected="True"
                        AutomationProperties.AutomationId="RailOptionsTab"
                        AutomationProperties.Name="Options"/>
                    <SelectorBarItem
                        x:Name="RailInfoTab"
                        Text="Info"
                        AutomationProperties.AutomationId="RailInfoTab"
                        AutomationProperties.Name="Info"/>
                </SelectorBar>
                <!-- A tab stop only while the text-only Info tab is shown, so arrows can scroll it. -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    IsVerticalScrollChainingEnabled="False"
                    IsTabStop="False"
                    UseSystemFocusVisuals="True"
                    AutomationProperties.Name="Sample panel content">
                    <!-- Right padding clears the overlay scrollbar when it expands (64478783). -->
                    <Grid Padding="16,8,24,16">
                        <ContentControl
                            x:Name="OptionsHost"
                            IsTabStop="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind Options, Mode=OneWay}"/>
                        <StackPanel x:Name="InfoPanel" Spacing="12" Visibility="Collapsed">
                            <InfoBar
                                Title="What to look for"
                                Severity="Informational"
                                IsOpen="True"
                                IsClosable="False"
                                Visibility="Collapsed"/>
                            <ContentControl
                                x:Name="InfoExtrasHost"
                                IsTabStop="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Content="{x:Bind InfoExtras, Mode=OneWay}"/>
                            <local:KeyboardReference x:Name="KeyboardReferenceSection"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        </local:RailHost>

        <!-- Source expander spans both columns -->
        <Expander
            x:Name="SourceExpander"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Margin="0,4,0,0"
            MinHeight="40"
            Padding="12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="SampleSourceExpander"
            AutomationProperties.Name="Source code"
            Expanding="OnSourceExpanderExpanding"
            Collapsed="OnSourceExpanderCollapsed"
            KeyDown="OnSourceExpanderKeyDown"
            Visibility="Collapsed">
            <Expander.Header>
                <TextBlock Text="Source code"/>
            </Expander.Header>
            <ScrollViewer
                x:Name="SourceContentScroller"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled">
                <local:CodeBlock x:Name="SourceCodeBlock">
                    <local:CodeBlock.HeaderContent>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <SelectorBar
                                x:Name="SourceTabs"
                                AutomationProperties.AutomationId="SampleSourceTabs"
                                AutomationProperties.Name="Source language">
                                <SelectorBarItem
                                    x:Name="SourceXamlTab"
                                    Text="XAML"
                                    IsSelected="True"
                                    AutomationProperties.AutomationId="SampleSourceXamlTab"
                                    AutomationProperties.Name="XAML"/>
                                <SelectorBarItem
                                    x:Name="SourceCSharpTab"
                                    Text="C#"
                                    AutomationProperties.AutomationId="SampleSourceCSharpTab"
                                    AutomationProperties.Name="C#"/>
                            </SelectorBar>
                            <!-- The checked state is the announcement; the name stays the same. -->
                            <ToggleButton
                                x:Name="SourceFullScreenButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="8,4"
                                AutomationProperties.AutomationId="SampleSourceFullScreenButton"
                                AutomationProperties.Name="Full screen"
                                ToolTipService.ToolTip="Full screen"
                                Checked="OnSourceFullScreenChanged"
                                Unchecked="OnSourceFullScreenChanged">
                                <FontIcon x:Name="SourceFullScreenIcon" Glyph="&#xE740;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                            </ToggleButton>
                        </Grid>
                    </local:CodeBlock.HeaderContent>
                </local:CodeBlock>
            </ScrollViewer>
        </Expander>
    </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
