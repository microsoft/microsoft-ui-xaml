<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TableViewSampleApp.Controls.SamplePresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TableViewSampleApp.Controls"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <!--
        Sample page scaffold. The title and description sit in HeaderPanel, ABOVE the page
        ScrollViewer, so they stay on screen however far the page scrolls (expanding Source
        scrolls it to reveal the code). Below them, OuterGrid is a 3-row, 2-col grid:
            Row 0: Example      (left col)        |  Options rail card   (right col, only if Options set)
            Row 1: Source expander (spans both, wide mode) OR Options rail (narrow mode)
            Row 2: Source expander (spans both, narrow mode only — keeps it below the reparented Options rail)

        The OptionsColumn is FIXED at 320 px when Options is set in wide layouts,
        0 px otherwise. Auto-sizing here caused the right pane (and consequently
        the table) to shake on navigation between right-pane pages, because each
        page's options content has a different natural width. Fixed width = stable
        layout. Narrow layouts stack the options card below the example so portrait
        windows do not clip the demo or options content.

        Theme toggle is intentionally absent from this scaffold — the shell
        MainWindow.xaml hosts the single app-wide theme cycle button in the
        title bar (see ThemeToggleButton). A per-page theme button that flipped
        only ExampleContainer.RequestedTheme caused FilterPage to blank when
        clicked (nested RequestedTheme on TableView unbinds repeater children
        mid-realization).

        Inspired by w-ahmad/WinUI.TableView SamplePresenter — adapted to
        our existing CodeBlock + SamplePageHeader style + theme tokens.
    -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Sticky page header. Margins and Width are set in code from PageContentMargin so the text
         lines up with OuterGrid and the gap to the Example matches the two old 8 px row gaps. -->
    <Grid x:Name="HeaderPanel" Grid.Row="0" RowSpacing="8" MaxWidth="{StaticResource PageMaxContentWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title; per-page Theme button removed (see file comment). -->
        <TextBlock
            x:Name="HeaderText"
            Grid.Row="0"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind Header, Mode=OneWay}"
            AutomationProperties.HeadingLevel="Level1"
            VerticalAlignment="Center"/>

        <!-- Description -->
        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="1"
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="{x:Bind Description, Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            MaxWidth="1000"
            HorizontalAlignment="Left"/>
    </Grid>

    <ScrollViewer
        x:Name="OuterScroller"
        Grid.Row="1"
        VerticalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="OuterGrid" Margin="{StaticResource PageContentMargin}" RowSpacing="8" MaxWidth="{StaticResource PageMaxContentWidth}" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ExampleRow" Height="Auto" MinHeight="320"/>
            <RowDefinition x:Name="SourceRow" Height="Auto"/>
            <RowDefinition x:Name="NarrowSourceRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="OptionsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Example container (live demo) -->
        <Border
            x:Name="ExampleContainer"
            Grid.Row="0" Grid.Column="0"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource SubtleFillColorTransparentBrush}">
            <!-- No x:Name on the InfoBars: WinUI reports an unset AutomationId as the x:Name, which
                 would add AutomationIds the pages' inline InfoBars never had.
                 Try it (when set) above the page's Example. The host row is `*` on a stretch page,
                 Auto otherwise; RowSpacing is 0 while there is no Try it (see UpdateTryIt). -->
            <Grid x:Name="ExampleGrid" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="ExampleHostRow" Height="Auto"/>
                </Grid.RowDefinitions>
                <InfoBar
                    Grid.Row="0"
                    Title="Try it"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    MinHeight="104"
                    Visibility="Collapsed"/>
                <ContentControl
                    x:Name="ExampleHost"
                    Grid.Row="1"
                    IsTabStop="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind Example, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Options rail (right in wide layouts, stacked under the example in narrow
             layouts) — collapses when Options is null. In wide mode its width is
             governed by the parent OptionsColumn (fixed 320 px) so the table never
             shakes. -->
        <Border
            x:Name="OptionsBorder"
            Grid.Row="0" Grid.Column="1"
            Margin="12,0,0,0"
            Padding="16"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RailPanel" Spacing="12">
                    <TextBlock Text="Options" FontWeight="SemiBold" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ContentControl
                        x:Name="OptionsHost"
                        IsTabStop="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Content="{x:Bind Options, Mode=OneWay}"/>
                    <!-- What to look for (when set): always last in the rail, no heading above it. -->
                    <InfoBar
                        Title="What to look for"
                        Severity="Informational"
                        IsOpen="True"
                        IsClosable="False"
                        Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Source expander spans both columns -->
        <Expander
            x:Name="SourceExpander"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Margin="0,4,0,0"
            MinHeight="40"
            Padding="12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="SampleSourceExpander"
            AutomationProperties.Name="Source code"
            Expanding="OnSourceExpanderExpanding"
            Collapsed="OnSourceExpanderCollapsed"
            Visibility="Collapsed">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE943;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="Source" FontWeight="SemiBold"/>
                </StackPanel>
            </Expander.Header>
            <!--
                The source content is bounded and scrolls internally (MaxHeight set from
                ApplyStretchSizing). On a pinned page the Example row shrinks towards its minimum
                to make room; on a scrolling page the Example drops to its minimum, the code is
                capped to the rest of the viewport, and expanding scrolls the block into view
                (RevealSourceIfPending), so the code is never left below the window. The title
                and description are outside OuterScroller, so that scroll never hides them.
            -->
            <ScrollViewer
                x:Name="SourceContentScroller"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <local:CodeBlock
                        x:Name="SourceCodeBlock"
                        Caption="{x:Bind SourceCaption, Mode=OneWay}"
                        Code="{x:Bind SourceXaml, Mode=OneWay}"/>
                    <local:CodeBlock
                        x:Name="AdditionalSourceCodeBlock"
                        Caption="{x:Bind AdditionalSnippetCaption, Mode=OneWay}"
                        Code="{x:Bind AdditionalSourceCode, Mode=OneWay}"
                        Visibility="{x:Bind AdditionalSourceVisibility, Mode=OneWay}"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
