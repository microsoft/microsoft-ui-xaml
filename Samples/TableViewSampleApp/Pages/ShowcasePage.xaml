<?xml version="1.0" encoding="utf-8"?>
<!--
    Showcase: one people directory that combines live-updating template cells, header sort,
    column resize and visibility, selection modes, headers visibility and grouping. The page holds
    only those features: the table, its tinted templates, the Live updates, Table and Columns
    sections and the Actions. Try it / What to look for are presenter attributes; Shaping and
    Status are the shared ShapingOptions / StatusPanel controls (see Pages\SamplePageBase.cs).
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.ShowcasePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:models="using:TableViewSampleApp.Models">

    <Page.Resources>
        <!-- snippet -->
        <!-- Vibrant tints: each tinted cell binds its Border background to the row value through a
             converter, so a live update recolors only that cell. ShowcasePage.Vibrant gates them. The
             converters are registered in Converters\Converters.xaml. -->
        <DataTemplate x:Key="ShowcaseDepartmentPillTemplate" x:DataType="models:Person">
            <Border Background="{x:Bind Department, Mode=OneWay, Converter={StaticResource ShowcaseDepartmentTintConverter}}"
                    AutomationProperties.Name="{x:Bind Department, Mode=OneWay}"
                    CornerRadius="10" Padding="10,3" Margin="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{x:Bind Department, Mode=OneWay, Converter={StaticResource ShowcaseDepartmentDotConverter}}"
                             AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="{x:Bind Department, Mode=OneWay}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShowcaseSalaryTemplate" x:DataType="models:Person">
            <Border Background="{x:Bind Salary, Mode=OneWay, Converter={StaticResource ShowcaseSalaryTintConverter}}"
                    CornerRadius="4" Padding="8,2" Margin="2,2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Salary, Mode=OneWay, Converter={StaticResource SalaryTextConverter}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Border>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Showcase"
        Description="A people directory that combines the TableView features in one table. The Department pills and Salary tints are template cells bound through converters, so a live update recolors only the cells whose values changed. Click a header to sort, drag a header edge to resize (the Active column opts out with CanResize), and show or hide columns at run time with TableViewColumn.Visibility. SelectionMode switches between None and Single, HeadersVisibility hides the header row, and TableViewSource.GroupBy groups the same rows in place."
        Snippet="Showcase"
        StretchExample="True"
        TryIt="Live updates are on: watch the Salary tints and Active checkboxes change on the first rows. Click the Salary header to sort, select a row and give it a raise, and watch it move to its sorted place. Then switch Shaping to Grouped, or turn on the Shift, Office or Email column in the rail."
        WhatToLookFor="Select a row, then switch to Grouped: the control keeps the selection because the source is reshaped in place, not rebuilt. Sorted by Salary, each live update and raise re-applies the sort, so the rows stay in order; grouped, they sort within each group when the sort was applied after grouping. The template columns sort by their SortMemberPath (Department, IsActive, JoinDate, Salary), not by the control they show.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="ShowcaseTable"
                    AutomationProperties.Name="People directory"
                    ItemsSource="{x:Bind Source}"
                    AlternatingRowBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Sorted="OnPeopleTableSorted"
                    SelectionChanged="OnSelectionChanged"
                    SelectionMode="Single"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <!-- Visible by default: fits the table width at the default window size. -->
                    <tv:TableViewTemplateColumn x:Name="AvatarColumn" Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                    <tv:TableViewTextColumn x:Name="NameColumn" Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}"/>
                    <tv:TableViewTemplateColumn x:Name="DepartmentColumn" Header="Department" Width="{StaticResource ColWidthChip}" CellTemplate="{StaticResource ShowcaseDepartmentPillTemplate}" SortMemberPath="Department"/>
                    <tv:TableViewTemplateColumn x:Name="ActiveColumn" Header="Active" Width="{StaticResource ColWidthBoolean}" CellTemplate="{StaticResource ActiveCheckBoxTemplate}" SortMemberPath="IsActive" CanResize="False" HeaderToolTip="Fixed width: this column sets CanResize to False."/>
                    <tv:TableViewTemplateColumn x:Name="JoinDateColumn" Header="Join date" Width="{StaticResource ColWidthCalendarDate}" CellTemplate="{StaticResource JoinCalendarDateTemplate}" SortMemberPath="JoinDate"/>
                    <tv:TableViewTemplateColumn x:Name="SalaryColumn" Header="Salary" Width="{StaticResource ColWidthNumber}" CellTemplate="{StaticResource ShowcaseSalaryTemplate}" SortMemberPath="Salary"/>
                    <!-- Hidden by default; the Columns section turns them on. -->
                    <tv:TableViewTemplateColumn x:Name="ShiftColumn" Header="Shift" Width="{StaticResource ColWidthTimeCompact}" CellTemplate="{StaticResource ShiftTimeCompactTemplate}" SortMemberPath="ShiftStart" Visibility="Collapsed"/>
                    <tv:TableViewTemplateColumn x:Name="OfficeColumn" Header="Office" Width="{StaticResource ColWidthCombo}" CellTemplate="{StaticResource OfficeComboTemplate}" SortMemberPath="Office" Visibility="Collapsed"/>
                    <tv:TableViewTextColumn x:Name="EmailColumn" Header="Email" Width="{StaticResource ColWidthEmail}" Binding="{Binding Email}" Visibility="Collapsed"/>
                    <tv:TableViewTextColumn x:Name="RoleColumn" Header="Role" Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" Visibility="Collapsed"/>
                    <tv:TableViewTemplateColumn x:Name="DetailsColumn" Header="Details" Width="{StaticResource ColWidthAction}" CellTemplate="{StaticResource DetailsButtonTemplate}" CanSort="False" Visibility="Collapsed"/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <!-- snippet -->
                <controls:RailSection
                    IsFirst="True"
                    Header="Live updates"
                    Description="A timer changes the Salary and Active values of the first five rows. Person raises PropertyChanged, so only those cells re-run their bindings and tints. Vibrant cells turns the Department and Salary tints on or off.">
                    <ToggleSwitch x:Name="LiveToggle" AutomationProperties.AutomationId="ShowcaseLiveToggle"
                                  Header="Live updates" IsOn="True" OnContent="On" OffContent="Off" Toggled="OnLiveToggled"/>
                    <Slider x:Name="UpdateIntervalSlider" AutomationProperties.AutomationId="ShowcaseUpdateIntervalSlider"
                            Header="Update interval (ms)" Minimum="200" Maximum="2000" StepFrequency="100" Value="700"
                            ValueChanged="OnUpdateIntervalChanged"/>
                    <ToggleSwitch x:Name="VibrantToggle" AutomationProperties.AutomationId="ShowcaseVibrantToggle"
                                  Header="Vibrant cells" IsOn="True" OnContent="On" OffContent="Off" Toggled="OnVibrantToggled"/>
                </controls:RailSection>
                <!-- /snippet -->

                <controls:RailSection
                    Header="Table"
                    Description="Row count refills the same collection. SelectionMode is None or Single. HeadersVisibility hides or shows the header row.">
                    <ComboBox x:Name="RowCountSelector" AutomationProperties.AutomationId="ShowcaseRowCountSelector"
                              Header="Row count" SelectedIndex="1" SelectionChanged="OnRowCountChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="10" Tag="10"/>
                        <ComboBoxItem Content="100" Tag="100"/>
                        <ComboBoxItem Content="500" Tag="500"/>
                        <ComboBoxItem Content="1,000" Tag="1000"/>
                    </ComboBox>
                    <ComboBox x:Name="SelectionModeSelector" AutomationProperties.AutomationId="ShowcaseSelectionModeSelector"
                              Header="Selection mode" SelectedIndex="1" SelectionChanged="OnSelectionModeChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="None" Tag="None"/>
                        <ComboBoxItem Content="Single" Tag="Single"/>
                    </ComboBox>
                    <ComboBox x:Name="HeadersVisibilitySelector" AutomationProperties.AutomationId="ShowcaseHeadersVisibilitySelector"
                              Header="Headers visibility" SelectedIndex="0" SelectionChanged="OnHeadersVisibilityChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Column" Tag="Column"/>
                        <ComboBoxItem Content="None" Tag="None"/>
                    </ComboBox>
                </controls:RailSection>

                <controls:RailSection
                    Header="Columns"
                    Description="Sets TableViewColumn.Visibility. The extra columns start hidden so the table fits the window; turning them on makes it scroll horizontally.">
                    <CheckBox x:Name="ShiftColumnCheckBox" AutomationProperties.AutomationId="ShowcaseShiftColumnCheckBox"
                              Content="Shift (time picker)" Click="OnColumnCheckBoxClick"/>
                    <CheckBox x:Name="OfficeColumnCheckBox" AutomationProperties.AutomationId="ShowcaseOfficeColumnCheckBox"
                              Content="Office (combo box)" Click="OnColumnCheckBoxClick"/>
                    <CheckBox x:Name="EmailColumnCheckBox" AutomationProperties.AutomationId="ShowcaseEmailColumnCheckBox"
                              Content="Email" Click="OnColumnCheckBoxClick"/>
                    <CheckBox x:Name="RoleColumnCheckBox" AutomationProperties.AutomationId="ShowcaseRoleColumnCheckBox"
                              Content="Role" Click="OnColumnCheckBoxClick"/>
                    <CheckBox x:Name="DetailsColumnCheckBox" AutomationProperties.AutomationId="ShowcaseDetailsColumnCheckBox"
                              Content="Details (button with flyout)" Click="OnColumnCheckBoxClick"/>
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="Showcase"
                    Description="Grouped, a header sort applied after grouping orders the rows within each group (a sort applied before grouping orders the groups too), and live updates keep running. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Each action writes the Person model or the selection, then re-applies the active sort or grouping so the row moves to where it now belongs. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button x:Name="SelectFirstButton" AutomationProperties.AutomationId="ShowcaseSelectFirstButton"
                                Content="Select first row" Click="OnSelectFirstClick"
                                ToolTipService.ToolTip="Calls TableView.Select(0). Does nothing when SelectionMode is None."
                                AutomationProperties.HelpText="Calls TableView.Select(0). Does nothing when SelectionMode is None."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="ClearSelectionButton" AutomationProperties.AutomationId="ShowcaseClearSelectionButton"
                                Content="Clear selection" Click="OnClearSelectionClick"
                                ToolTipService.ToolTip="Calls TableView.DeselectAll()."
                                AutomationProperties.HelpText="Calls TableView.DeselectAll()."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="MoveGroupButton" AutomationProperties.AutomationId="ShowcaseMoveSelectedButton"
                                Content="Move selected row to the next group" Click="OnMoveSelectedGroupClick"
                                ToolTipService.ToolTip="Changes the grouped-on value (Department when flat) to the next real value, then re-applies GroupBy so the row moves to its new group."
                                AutomationProperties.HelpText="Select a row first."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="RaiseSalaryButton" AutomationProperties.AutomationId="ShowcaseRaiseSalaryButton"
                                Content="Give selected row a 10% raise" Click="OnRaiseSalaryClick"
                                ToolTipService.ToolTip="Raises Salary by 10%, up to 230,000. Sorted by Salary, the sort is re-applied and the row moves."
                                AutomationProperties.HelpText="Select a row first."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="RemoveRowButton" AutomationProperties.AutomationId="ShowcaseRemoveSelectedButton"
                                Content="Remove selected row" Click="OnRemoveSelectedClick"
                                ToolTipService.ToolTip="Removes the row from the collection; a group disappears when it loses its last row."
                                AutomationProperties.HelpText="Select a row first."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Showcase">
                    <TextBlock x:Name="SelectionText" controls:StatusPanel.Label="Selection" Text="(none)"/>
                    <TextBlock x:Name="SortText" controls:StatusPanel.Label="Sort" Text="(none)"/>
                    <TextBlock x:Name="ColumnsText" controls:StatusPanel.Label="Columns" Text="6 of 11 shown"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
