<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.FilePropertiesPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:adv="using:Microsoft.UI.Xaml.Controls.Tabular"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="Files" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Select a file from the app folder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <ListView x:Name="FileList"
                          Grid.Row="1"
                          AutomationProperties.AutomationId="FilePropertiesFileList"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnFileSelectionChanged"
                          SelectionMode="Single"
                          MinHeight="420"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="16,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="Details" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedFileText"
                               Text="Select a file to see its details"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <adv:TableView
                    x:Name="PropTable"
                    AutomationProperties.AutomationId="FilePropertiesTable"
                    SelectionMode="Single"
                    MinHeight="420"
                    VerticalAlignment="Stretch">
                    <adv:TableViewTextColumn Header="Property" Width="200" MinWidth="140" Binding="{Binding Property}"/>
                    <adv:TableViewTextColumn Header="Value" Width="*" Binding="{Binding Value}"/>
                </adv:TableView>
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="16,6">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Page>