<?xml version="1.0" encoding="utf-8"?>
<!--
    File properties scenario: the scenario's two panes (Files list and the property table) in the
    stretched row, then the rail: Filter, Shaping (starts Grouped by section), Actions, Status.
    Try it / What to look for are presenter attributes; Shaping and Status are the shared
    ShapingOptions / StatusPanel controls (see Pages\SamplePageBase.cs).
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.FilePropertiesPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:io="using:System.IO"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="File properties"
        Description="A Properties dialog for this sample's own binaries: pick a file and the table lists 22 properties read from its version resource and from the file system, grouped into Description, Origin and File sections the way the Details tab is. The table is bound to one TableViewSource over one ObservableCollection; picking another file refills the collection, and filtering, grouping, moving and removing rows all reshape that same source in place."
        Snippet="FileProperties"
        StretchExample="True"
        TryIt="The table starts grouped by section. Pick another file in the Files list and the same table refills with its properties. Select a property and choose Move selected to next section: it changes section and stays selected. Then set Filter to Dates only and watch two sections disappear."
        WhatToLookFor="Picking another file keeps the filter and the grouping, because the same source re-projects the refilled collection. A moved property stays selected in its new section, since the page restores the selection after re-applying GroupBy. Removing the last row of a section removes its header, and Match nothing leaves zero groups.">

        <controls:SamplePresenter.Example>
            <!-- The scenario's two panes: the file picker and the properties table. -->
            <Grid ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- snippet -->
                <TextBlock Text="Files" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" Width="220" VerticalAlignment="Stretch">
                    <ListView
                        x:Name="FileList"
                        AutomationProperties.AutomationId="FilePropertiesFileList"
                        AutomationProperties.Name="Files"
                        SelectionMode="Single"
                        SelectionChanged="OnFileSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="io:FileInfo">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <TextBlock Grid.Column="1" Text="Properties" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}"/>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="PropTable"
                        AutomationProperties.AutomationId="FilePropertiesTable"
                        AutomationProperties.Name="File properties"
                        ItemsSource="{x:Bind Source}"
                        SelectionMode="Single"
                        IsReadOnly="True"
                        SelectionChanged="OnPropSelectionChanged"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <!-- Property is fixed; Value takes the rest. Not Auto: an Auto column is
                             measured from the realized rows only, so it changes width while you scroll. -->
                        <tv:TableViewTextColumn Header="Property" Width="{StaticResource ColWidthPropertyName}" Binding="{Binding Property}"/>
                        <tv:TableViewTextColumn Header="Value" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding Value}"/>
                    </tv:TableView>
                </Border>
                <!-- /snippet -->
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Filter"
                    Description="TableViewSource.Filter keeps only the properties a predicate accepts, on the same source that groups them. A section whose rows are all filtered out disappears; Match nothing shows the empty result.">
                    <ComboBox
                        x:Name="FilterSelector"
                        AutomationProperties.AutomationId="FilePropertiesFilterSelector"
                        Header="Show"
                        SelectedIndex="0"
                        SelectionChanged="OnFilterChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="All properties" Tag="all"/>
                        <ComboBoxItem Content="Dates only" Tag="dates"/>
                        <ComboBoxItem Content="Version resource only" Tag="version"/>
                        <ComboBoxItem Content="Match nothing (empty result)" Tag="none"/>
                    </ComboBox>
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="FileProperties"
                    InitialMode="grouped"
                    Description="Grouped by Section is this page's natural shape, so it opens that way; Source splits the version resource from the file system. TableViewSource.GroupBy reshapes the same source in place, so sort, selection and scroll survive.">
                    <ComboBoxItem Content="Section" Tag="Section"/>
                    <ComboBoxItem Content="Source" Tag="Source"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Each action changes the one collection or a row in it, and the source re-projects without being rebuilt. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="MoveSectionButton"
                            AutomationProperties.AutomationId="FilePropertiesMoveSectionButton"
                            Content="Move selected to next section"
                            Click="OnMoveSectionClick"
                            ToolTipService.ToolTip="Rewrites the selected row's Section and re-applies GroupBy; the row moves to the next section and stays selected."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveSelectedButton"
                            AutomationProperties.AutomationId="FilePropertiesRemoveSelectedButton"
                            Content="Remove selected property"
                            Click="OnRemoveSelectedClick"
                            ToolTipService.ToolTip="Removes the row from the collection; the source drops it, and its section when it was the last row."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RestoreButton"
                            AutomationProperties.AutomationId="FilePropertiesRestoreButton"
                            Content="Re-read the file's properties"
                            Click="OnRestoreClick"
                            ToolTipService.ToolTip="Reads the selected file again and refills the collection, undoing moves and removals."
                            AutomationProperties.HelpText="Reads the selected file again and refills the collection."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="NextFileButton"
                            AutomationProperties.AutomationId="FilePropertiesNextFileButton"
                            Content="Show the next file"
                            Click="OnNextFileClick"
                            ToolTipService.ToolTip="Selects the next file in the Files list; the table keeps its filter and grouping."
                            AutomationProperties.HelpText="Selects the next file in the Files list."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="FileProperties">
                    <TextBlock x:Name="FileText" controls:StatusPanel.Label="File" Text="(none)"/>
                    <TextBlock x:Name="SectionsText" controls:StatusPanel.Label="Sections" Text="(none)"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
