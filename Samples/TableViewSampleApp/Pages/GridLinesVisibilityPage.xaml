<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.GridLinesVisibilityPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- App.xaml owns these ThemeResource keys so Light, Dark, and HighContrast
             can resolve different brushes without code-behind resource lookup. -->
        <Style x:Key="CustomBandingTableViewStyle" TargetType="tv:TableView">
            <Setter Property="RowBackground" Value="{ThemeResource SampleCustomRowBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{ThemeResource SampleCustomAlternatingRowBackgroundBrush}"/>
        </Style>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Grid lines visibility"
        Description="GridLinesVisibility property — None / Horizontal / Vertical / All — controls per-row bottom borders and per-cell right borders for WPF DataGrid parity. The same property works across flat and grouped modes, with default theme banding or custom row colors."
        SourceCaption="GridLinesVisibilityPage.xaml (excerpt)"
        SourceSnippet="GridLinesVisibility.xaml.txt"
        AdditionalSnippetCaption="GridLinesVisibilityPage.xaml.cs (excerpt)"
        AdditionalSnippet="GridLinesVisibility.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Choose which grid lines show — All, Horizontal, Vertical, or None. Switch shaping to Grouped to run the same lines through real group header bands, or switch banding to see the lines stay on-theme."
                    MinHeight="104"/>
                <Border
                    Grid.Row="1"
                    Style="{StaticResource TableHostBorderStyle}"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="DemoTable"
                        AutomationProperties.AutomationId="GridLinesDemoTable"
                        AutomationProperties.Name="People grid line visibility"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableViewTextColumn Header="First"      Width="{StaticResource ColWidthShortName}"  Binding="{Binding FirstName}"     CanSort="False"/>
                        <tv:TableViewTextColumn Header="Last"       Width="{StaticResource ColWidthShortName}"  Binding="{Binding LastName}"      CanSort="False"/>
                        <tv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}"    CanSort="False"/>
                        <tv:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding Role}"          CanSort="False"/>
                        <tv:TableViewTextColumn Header="Email"      Width="*" MinWidth="200"      Binding="{Binding Email}"         CanSort="False"/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <StackPanel Spacing="4" AutomationProperties.Name="Grid lines visibility options">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Grid lines" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <muxc:RadioButtons
                        x:Name="GridLinesVisibilityRadioButtons"
                        AutomationProperties.Name="Grid lines"
                        SelectedIndex="3"
                        SelectionChanged="OnGridLinesVisibilitySelectionChanged">
                        <RadioButton Content="None"          Tag="None"        AutomationProperties.AutomationId="GridLinesRadioNone"/>
                        <RadioButton Content="Horizontal"    Tag="Horizontal"  AutomationProperties.AutomationId="GridLinesRadioHorizontal"/>
                        <RadioButton Content="Vertical"      Tag="Vertical"    AutomationProperties.AutomationId="GridLinesRadioVertical"/>
                        <RadioButton Content="All (default)" Tag="All"         AutomationProperties.AutomationId="GridLinesRadioAll"/>
                    </muxc:RadioButtons>
                </StackPanel>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"
                           Text="Flat leaves the source unshaped. Grouped calls TableViewSource.GroupBy on the same source instance, so selection, scroll offset and group expansion survive the reshape — and the grid lines have real group header bands to run through."/>
                <ComboBox x:Name="ShapingModeSelector"
                          AutomationProperties.AutomationId="ShapingModeSelector"
                          Header="Shaping mode"
                          SelectedIndex="0"
                          SelectionChanged="OnShapingModeChanged"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Flat" Tag="flat"/>
                    <ComboBoxItem Content="Grouped" Tag="grouped"/>
                    <!-- Hierarchical rows are not available in this release. Shown disabled so the
                         shape of the feature is visible; re-enable when the control ships support
                         (TableViewSource exposes only Filter / GroupBy / Sort today). -->
                    <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                    <ComboBoxItem Content="Grouped hierarchy" Tag="groupedhierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                </ComboBox>
                <ComboBox x:Name="GroupKeyCombo" Header="Group by" IsEnabled="False" SelectedIndex="0"
                          SelectionChanged="OnGroupKeyChanged"
                          AutomationProperties.AutomationId="GroupKeyCombo"
                          AutomationProperties.Name="Group key"
                          ToolTipService.ToolTip="Available once Grouped mode is selected."
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active status" Tag="Active"/>
                </ComboBox>

                <StackPanel Spacing="4" AutomationProperties.Name="Row banding options">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Row banding" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <muxc:RadioButtons
                        x:Name="BandingRadioButtons"
                        AutomationProperties.Name="Row banding"
                        SelectedIndex="0"
                        SelectionChanged="OnBandingSelectionChanged">
                        <RadioButton Content="Default theme"
                                     x:Name="DefaultBandingRadio"
                                     AutomationProperties.AutomationId="GridLinesBandingDefaultRadio"/>
                        <RadioButton Content="Custom colors"
                                     x:Name="CustomBandingRadio"
                                     AutomationProperties.AutomationId="GridLinesBandingCustomRadio"/>
                    </muxc:RadioButtons>
                </StackPanel>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <StackPanel Spacing="8">
                    <Button x:Name="ExpandAllButton" Content="Expand all groups" Click="OnExpandAllClick" IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected." AutomationProperties.AutomationId="ExpandAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CollapseAllButton" Content="Collapse all groups" Click="OnCollapseAllClick" IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected." AutomationProperties.AutomationId="CollapseAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ReassignRowButton" Content="Move first row to another group" Click="OnReassignRowClick" IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected." AutomationProperties.AutomationId="ReassignRowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="RemoveRowButton" Content="Remove first row" Click="OnRemoveRowClick" AutomationProperties.AutomationId="RemoveRowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <muxc:InfoBar AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="GridLinesStatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Status"
                    Message="{x:Bind StatusText, Mode=OneWay}"
                    MinHeight="64"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
