<?xml version="1.0" encoding="utf-8"?>
<!-- The one page that uses Width="Auto": Auto is the lesson. -->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.ColumnLayoutPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Column layout &amp; sizing"
        Description="A TableViewColumn's Width states an intent: a fixed Pixel width, Auto (size to the realized content), or a Star share of the space left over. MinWidth and MaxWidth clamp that intent, and the read-only ActualWidth reports the width the column really got. Pick a width intent, then drag a header edge or move the sliders and watch ActualWidth follow, or refuse to. TableView.CanUserResizeColumns turns off every resize gripper at once, and TableViewColumn.CanResize turns off one."
        Snippet="ColumnLayout"
        StretchExample="True"
        TryIt="Drag the right edge of the Name header and watch Width / ActualWidth update; the Role (locked) column has CanResize off, so its edge does not move. Pick Join date in Column and drag the Width slider past 310 to see the date picker stop clipping. Then switch Width intent to Auto and scroll down: Auto columns size to the rows on screen."
        WhatToLookFor="ActualWidth is the width after the MinWidth and MaxWidth clamp, so it can differ from Width; the readout updates after layout and while you drag. A full date picker needs about 310 px, so the 200 px Join date column clips it. Auto measures only the realized rows, so scrolling can change an Auto width and Auto mode can leave an empty band on the right. Width is the lesson here, so this page scrolls horizontally in Playground and Pixel modes on purpose.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <!-- The columns are built in code for each width intent; see ColumnLayoutPage.xaml.cs. -->
                <tv:TableView
                    x:Name="WidthsTable"
                    AutomationProperties.AutomationId="ColumnLayoutTable"
                    AutomationProperties.Name="People, with columns sized by the chosen width intent"
                    ItemsSource="{x:Bind People}"
                    SelectionMode="Single"
                    VerticalAlignment="Stretch"
                    MinHeight="320"/>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection IsFirst="True" Header="Width intent">
                    <TextBlock x:Name="ModeDescription"
                               AutomationProperties.AutomationId="ColumnLayoutModeDescriptionText"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Playground: fixed Pixel widths you can change with the sliders below."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <!-- snippet -->
                    <ComboBox
                        x:Name="WidthModeSelector"
                        AutomationProperties.AutomationId="ColumnLayoutWidthModeSelector"
                        Header="Width intent"
                        SelectedIndex="0"
                        SelectionChanged="OnWidthModeChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Playground" Tag="Playground"/>
                        <ComboBoxItem Content="Auto" Tag="Auto"/>
                        <ComboBoxItem Content="Star" Tag="Star"/>
                        <ComboBoxItem Content="Pixel" Tag="Pixel"/>
                        <ComboBoxItem Content="Mixed" Tag="Mixed"/>
                    </ComboBox>
                    <!-- /snippet -->
                </controls:RailSection>

                <controls:RailSection
                    Header="Resize gates"
                    Description="TableView.CanUserResizeColumns turns the header gripper on or off for the whole table. The Role (locked) column also sets TableViewColumn.CanResize to false for itself. Setting Width from code works either way.">
                    <!-- snippet -->
                    <ToggleSwitch
                        x:Name="CanUserResizeColumnsToggle"
                        AutomationProperties.AutomationId="ColumnLayoutCanUserResizeColumnsToggle"
                        Header="Users can resize columns"
                        IsOn="True"
                        Toggled="OnCanUserResizeColumnsToggled"/>
                    <!-- /snippet -->
                </controls:RailSection>

                <controls:RailSection
                    Header="Column sizing"
                    Description="Pick a column; the sliders and the Actions below apply to it. MinWidth and MaxWidth clamp whatever Width asks for.">
                    <ComboBox
                        x:Name="ColumnSelector"
                        AutomationProperties.AutomationId="ColumnLayoutColumnSelector"
                        Header="Column"
                        SelectionChanged="OnColumnSelectorChanged"
                        HorizontalAlignment="Stretch"/>
                    <Slider x:Name="MinWidthSlider" AutomationProperties.AutomationId="ColumnLayoutMinWidthSlider"
                            Header="MinWidth" Minimum="0" Maximum="400" StepFrequency="10" Value="20"
                            ValueChanged="OnMinWidthSliderChanged" HorizontalAlignment="Stretch"/>
                    <!-- snippet -->
                    <Slider x:Name="WidthSlider" AutomationProperties.AutomationId="ColumnLayoutWidthSlider"
                            Header="Width (Pixel)" Minimum="0" Maximum="500" StepFrequency="10" Value="160"
                            ValueChanged="OnWidthSliderChanged" HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="Sets a Pixel width. Enabled only when the selected column has a Pixel width."/>
                    <!-- /snippet -->
                    <Slider x:Name="MaxWidthSlider" AutomationProperties.AutomationId="ColumnLayoutMaxWidthSlider"
                            Header="MaxWidth" Minimum="50" Maximum="500" StepFrequency="10" Value="500"
                            ValueChanged="OnMaxWidthSliderChanged" HorizontalAlignment="Stretch"/>
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               Text="The Width slider sets a Pixel width, so it is enabled only when the selected column has one; it starts at the column's ActualWidth. Auto and Star columns keep their intent until you use Force selected width to 80 px."/>
                </controls:RailSection>

                <controls:RailSection Header="Shaping">
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               AutomationProperties.AutomationId="ColumnLayoutShapingExclusionText"
                               Text="Grouping does not change column widths, so this page has no Shaping options; see Grouped rows."/>
                </controls:RailSection>

                <controls:RailSection
                    Header="Actions"
                    Description="Each action changes the selected column's Width from code, which works even when resizing is turned off. Watch the table and the Width / ActualWidth readout.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="AutosizeSelectedButton"
                            AutomationProperties.AutomationId="ColumnLayoutAutosizeSelectedButton"
                            Content="Autosize selected column"
                            Click="OnAutosizeSelectedClick"
                            ToolTipService.ToolTip="Sets the selected column's Width to Auto, so it sizes to its header and the rows on screen."
                            AutomationProperties.HelpText="Sets the selected column's Width to Auto."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="AutosizeAllButton"
                            AutomationProperties.AutomationId="ColumnLayoutAutosizeAllButton"
                            Content="Autosize all columns"
                            Click="OnAutosizeAllClick"
                            ToolTipService.ToolTip="Sets every column's Width to Auto. Wide content can leave an empty band on the right, or push the table into horizontal scrolling."
                            AutomationProperties.HelpText="Sets every column's Width to Auto."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ClampSelectedButton"
                            AutomationProperties.AutomationId="ColumnLayoutClampSelectedButton"
                            Content="Force selected width to 80 px"
                            Click="OnClampSelectedClick"
                            ToolTipService.ToolTip="Sets Width to 80. Raise MinWidth above 80 first to watch ActualWidth refuse to follow."
                            AutomationProperties.HelpText="Sets the selected column's Width to 80 pixels."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ResetWidthsButton"
                            AutomationProperties.AutomationId="ColumnLayoutResetWidthsButton"
                            Content="Reset widths for this mode"
                            Click="OnResetWidthsClick"
                            ToolTipService.ToolTip="Rebuilds the columns of the current width intent with their declared widths."
                            AutomationProperties.HelpText="Rebuilds the columns with their declared widths."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="ColumnLayout">
                    <TextBlock x:Name="SelectedColumnText" controls:StatusPanel.Label="Column" Text="(none)"/>
                    <TextBlock x:Name="WidthReadoutText" controls:StatusPanel.Label="Width / ActualWidth" Text="-"/>
                    <TextBlock x:Name="ClampText" controls:StatusPanel.Label="MinWidth / MaxWidth" Text="-"/>
                    <TextBlock x:Name="ResizeStateText" controls:StatusPanel.Label="Resize" Text="-"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</pages:SamplePageBase>
