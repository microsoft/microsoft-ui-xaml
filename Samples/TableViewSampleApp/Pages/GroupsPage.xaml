<?xml version="1.0" encoding="utf-8"?>
<!--
    Grouped rows: TableViewSource.GroupBy on one source, a custom GroupHeaderTemplate, and
    ExpandAllGroups / CollapseAllGroups. Unlike the other pages it starts Grouped, because
    grouping is its subject: ShapingOptions InitialMode="grouped".
    The page holds only the grouping behaviour: the table, its templates, the Group header section
    and the Actions. Try it / What to look for are presenter attributes; Shaping and Status are the
    shared ShapingOptions / StatusPanel controls (see Pages\SamplePageBase.cs).
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.GroupsPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:system="using:System"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:pages="using:TableViewSampleApp.Pages">

    <Page.Resources>
        <!-- snippet -->
        <!-- Left-aligned StackPanel, not a stretched Grid: the group-header ContentPresenter sizes
             the header content to its desired width, so a Grid with a `*` first column collapsed
             the count and the expansion chip to zero width. The count binds ItemCount (Int32)
             rather than ItemCountText so it is always populated. -->
        <DataTemplate x:Key="CustomGroupHeaderTemplate" x:DataType="tv:TableViewGroupInfo">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,6" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind KeyText, Mode=OneWay}"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    Text="{x:Bind ItemCount, Mode=OneWay, Converter={StaticResource GroupCountTextConverter}}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
                <Border
                    Padding="8,2"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <TextBlock
                        Text="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource GroupExpansionTextConverter}}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- /snippet -->

        <!-- Shown when every row has been removed, grouped or flat.
             MaxWidth: the row area scrolls sideways, so it measures its content at infinite width;
             without a cap the wrapping text lays out as one line wider than the table. -->
        <DataTemplate x:Key="GroupsEmptyTemplate" x:DataType="system:Object">
            <StackPanel Spacing="4" Padding="24" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No people to group" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock
                    Text="The source is empty, so the grouped projection has no groups. Choose Restore all rows to bring them back."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Grouped rows"
        Description="TableViewSource.GroupBy(keySelector, groupIdentitySelector) groups one source in place: the key selector receives each row and the identity selector each group key. GroupHeaderTemplate replaces the header content, and ExpandAllGroups and CollapseAllGroups drive every group at once. The page starts grouped by Department: change a row's Department or Active value and it moves to its new group, because the page applies GroupBy again."
        Snippet="Groups"
        StretchExample="True"
        TryIt="The table starts grouped by Department. Pick another department in a row's Department box and watch the row move to that group, then switch Group key to Active and clear a row's checkbox. Choose Collapse all, then expand one group from its header."
        WhatToLookFor="A row moves to its new group only because the page applies GroupBy again after the edit: the key selector is a delegate, so the control cannot watch the property. Group order follows the first row of each group, not the alphabet, so sorting a column reorders the groups; the Groups readout lists them in table order. Removing the last row of a group removes its header, and an empty source shows the EmptyTemplate.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="GroupsTable"
                    AutomationProperties.Name="Grouped people"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    EmptyTemplate="{StaticResource GroupsEmptyTemplate}"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <!-- The template renders a control; SortMemberPath names the value that orders the rows. -->
                    <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False" HeaderToolTip="PersonPicture: the photo when the person has one, otherwise their initials."/>
                    <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}"/>
                    <tv:TableViewTemplateColumn Header="Department" Width="{StaticResource ColWidthCombo}" CellTemplate="{StaticResource DeptComboTemplate}" SortMemberPath="Department" HeaderToolTip="The grouped-on value when the group key is Department. Picking another one moves the row to that group."/>
                    <tv:TableViewTemplateColumn Header="Active" Width="{StaticResource ColWidthBoolean}" CellTemplate="{StaticResource ActiveCheckBoxTemplate}" SortMemberPath="IsActive" HeaderToolTip="The grouped-on value when the group key is Active. Toggling it moves the row between the Active and Inactive groups."/>
                    <tv:TableViewTemplateColumn Header="Join date" Width="{StaticResource ColWidthCalendarDate}" CellTemplate="{StaticResource JoinCalendarDateTemplate}" SortMemberPath="JoinDate" HeaderToolTip="Editable date. Sorts by the JoinDate value."/>
                    <tv:TableViewTextColumn Header="Salary" Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary, Converter={StaticResource SalaryTextConverter}}" HeaderToolTip="Annual salary in whole currency units. Sorts by the number, not the text."/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Group header"
                    Description="Sets TableView.GroupHeaderTemplate. The custom template shows the key, the item count and an expansion chip bound to TableViewGroupInfo; the built-in header shows the key and count.">
                    <ComboBox
                        x:Name="HeaderTemplateSelector"
                        AutomationProperties.AutomationId="GroupsHeaderTemplateSelector"
                        Header="Group header template"
                        SelectedIndex="0"
                        SelectionChanged="OnHeaderTemplateChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Custom" Tag="custom"/>
                        <ComboBoxItem Content="Built-in" Tag="builtin"/>
                    </ComboBox>
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="Groups"
                    InitialMode="grouped"
                    Description="This page starts Grouped. Each group key buckets the people a different way, and the headers count them. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Office" Tag="Office"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Each action changes group keys or adds and removes rows, then lets the grouping catch up: rows move, groups appear and vanish, and an empty source shows the EmptyTemplate. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="MoveSelectedButton"
                            AutomationProperties.AutomationId="GroupsMoveSelectedButton"
                            Content="Move selected row to the next group"
                            Click="OnMoveSelectedClick"
                            ToolTipService.ToolTip="Changes the selected person's group-key value to the next real one (department, office, role or active state); the row moves to that group."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="MoveEveryFourthButton"
                            AutomationProperties.AutomationId="GroupsMoveEveryFourthButton"
                            Content="Move every 4th row to the next department"
                            Click="OnMoveEveryFourthClick"
                            ToolTipService.ToolTip="Moves rows 1, 5, 9 and so on to the next department. Deterministic, so the result is the same every time; grouped by Department, the counts change."
                            AutomationProperties.HelpText="Moves every 4th row to the next department."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="AddPersonButton"
                            AutomationProperties.AutomationId="GroupsAddPersonButton"
                            Content="Add a person to the first group"
                            Click="OnAddPersonClick"
                            ToolTipService.ToolTip="Adds a new hire with the first group's key; the row joins that live group and its count goes up."
                            AutomationProperties.HelpText="Adds a new hire to the first group."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveSelectedButton"
                            AutomationProperties.AutomationId="GroupsRemoveSelectedButton"
                            Content="Remove selected row"
                            Click="OnRemoveSelectedClick"
                            ToolTipService.ToolTip="Removes the selected person; if they were the last in their group, the header disappears."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveSmallestGroupButton"
                            AutomationProperties.AutomationId="GroupsRemoveSmallestGroupButton"
                            Content="Remove the smallest group"
                            Click="OnRemoveSmallestGroupClick"
                            ToolTipService.ToolTip="Removes every person in the smallest group for the current key, so that group vanishes."
                            AutomationProperties.HelpText="Removes every person in the smallest group."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="EmptyToggleButton"
                            AutomationProperties.AutomationId="GroupsEmptyToggleButton"
                            Content="Remove all rows"
                            Click="OnEmptyToggleClick"
                            ToolTipService.ToolTip="Empties the source so the grouped projection has no groups and the EmptyTemplate shows; choose it again to restore every removed row."
                            AutomationProperties.HelpText="Empties the source, or restores every removed row."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Groups">
                    <TextBlock x:Name="GroupsText" controls:StatusPanel.Label="Groups" Text="(grouping off)"/>
                    <TextBlock x:Name="ExpansionText" controls:StatusPanel.Label="Expansion" Text="(grouping off)"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
