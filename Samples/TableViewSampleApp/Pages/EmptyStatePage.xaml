<?xml version="1.0" encoding="utf-8"?>
<!--
    Empty state: TableView.EmptyTemplate, reached three ways (a null ItemsSource, a source emptied
    in place, and a filter that matches nothing), flat or grouped. Structure follows the golden
    page (CellFlyoutsPage): Try it, one stretched table, then the rail in the order Data source,
    Shaping, Actions, Status, What to look for. Generic blocks carry scaffold markers.
-->
<Page
    x:Class="TableViewSampleApp.Pages.EmptyStatePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:system="using:System">

    <Page.Resources>
        <!-- EmptyTemplate content is TEXT + SHAPES only. A FontIcon inside the
             EmptyTemplate crashes at startup (known issue), so the empty-state
             glyph is drawn with an Ellipse and Rectangles instead of a FontIcon. -->
        <DataTemplate x:Key="EmptyStateTemplate" x:DataType="system:Object">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="320"
                Spacing="12">
                <Grid Width="64" Height="64" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Ellipse
                        Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                        StrokeThickness="1"/>
                    <Rectangle
                        Width="26" Height="20"
                        RadiusX="3" RadiusY="3"
                        Fill="Transparent"
                        Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                        StrokeThickness="2"/>
                    <Rectangle
                        Width="26" Height="1.5"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
                <TextBlock
                    Text="No rows to display"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock
                    Text="There are no people to show. Choose Populated as the data source, or press Restore the rows."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Empty state"
        Description="TableView.EmptyTemplate is a DataTemplate the control centres over the row area whenever there are no rows to show. A table can be empty in three ways: ItemsSource is null, the bound source holds zero rows, or TableViewSource.Filter matches nothing. Pick each data source, remove rows one at a time, or filter to zero matches, and the same template takes over. Switch Shaping to Grouped first to see that an empty grouped set shows the template too, not an empty group band."
        SourceCaption="EmptyStatePage.xaml (excerpt)"
        SourceSnippet="EmptyState.xaml.txt"
        AdditionalSnippetCaption="EmptyStatePage.xaml.cs (excerpt)"
        AdditionalSnippet="EmptyState.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- scaffold:tryit -->
                <muxc:InfoBar
                    Grid.Row="0"
                    Title="Try it"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    MinHeight="104"
                    Message="Set Data source to Null ItemsSource, then to Zero rows: the empty template appears both times. Choose Populated, switch Shaping to Grouped, and press Filter to zero matches: every group disappears and the template takes over. Press Restore the rows to bring the people back."/>
                <!-- /scaffold -->
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="EmptyStateTable"
                        AutomationProperties.Name="People, with an empty state"
                        ItemsSource="{x:Bind Source}"
                        SelectionMode="Single"
                        EmptyTemplate="{StaticResource EmptyStateTemplate}"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                        <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}"/>
                        <tv:TableViewTemplateColumn Header="Department" Width="{StaticResource ColWidthChip}" CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"/>
                        <tv:TableViewTemplateColumn Header="Active" Width="{StaticResource ColWidthBoolean}" CellTemplate="{StaticResource ActiveCheckBoxTemplate}" SortMemberPath="IsActive"/>
                        <tv:TableViewTemplateColumn Header="Join date" Width="{StaticResource ColWidthCalendarDate}" CellTemplate="{StaticResource JoinCalendarDateTemplate}" SortMemberPath="JoinDate"/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <!-- 1. Primary feature -->
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Data source">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Data source"
                               Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Null ItemsSource sets TableView.ItemsSource to null. Zero rows keeps the TableViewSource attached and clears the collection behind it. Both show the EmptyTemplate."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <ComboBox
                        x:Name="DataSourceSelector"
                        AutomationProperties.AutomationId="EmptyStateDataSourceSelector"
                        Header="Data source"
                        SelectedIndex="0"
                        SelectionChanged="OnDataSourceChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Populated" Tag="Populated"/>
                        <ComboBoxItem Content="Null ItemsSource" Tag="Null"/>
                        <ComboBoxItem Content="Zero rows" Tag="ZeroRows"/>
                    </ComboBox>
                </StackPanel>

                <!-- scaffold:shaping -->
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Shaping">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="Grouping an empty set is legal: the projection yields no groups, and the empty template wins over an empty group band. TableViewSource.GroupBy reshapes the same source in place, so sort, selection and scroll survive."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <ComboBox
                        x:Name="ShapingModeSelector"
                        AutomationProperties.AutomationId="EmptyStateShapingModeSelector"
                        Header="Shaping mode"
                        SelectedIndex="0"
                        SelectionChanged="OnShapingModeChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Flat" Tag="flat"/>
                        <ComboBoxItem Content="Grouped" Tag="grouped"/>
                        <!-- Hierarchical rows are not available in this release. These two options stay
                             visible but disabled so the shape of the feature is discoverable. When the
                             control ships hierarchy, enable them and uncomment the matching branch in
                             ApplyShaping. -->
                        <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                      AutomationProperties.HelpText="Hierarchical rows are not available in this release."/>
                        <ComboBoxItem Content="Grouped hierarchy" Tag="groupedHierarchy" IsEnabled="False"
                                      AutomationProperties.HelpText="Hierarchical rows are not available in this release."/>
                    </ComboBox>
                    <ComboBox
                        x:Name="GroupKeySelector"
                        AutomationProperties.AutomationId="EmptyStateGroupKeySelector"
                        Header="Group key"
                        SelectedIndex="0"
                        IsEnabled="False"
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        SelectionChanged="OnGroupKeyChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Department" Tag="Department"/>
                        <ComboBoxItem Content="Active" Tag="IsActive"/>
                    </ComboBox>
                    <Button
                        x:Name="ExpandAllButton"
                        AutomationProperties.AutomationId="EmptyStateExpandAllGroupsButton"
                        Content="Expand all"
                        Click="OnExpandAllClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Calls TableView.ExpandAllGroups()."
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        x:Name="CollapseAllButton"
                        AutomationProperties.AutomationId="EmptyStateCollapseAllGroupsButton"
                        Content="Collapse all"
                        Click="OnCollapseAllClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Calls TableView.CollapseAllGroups()."
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               Text="Group key, Expand all and Collapse all need the Grouped mode. Hierarchy and Grouped hierarchy are not available in this release."/>
                </StackPanel>
                <!-- /scaffold -->

                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Actions">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="Each action empties or refills the table a different way, so you can compare how the empty template appears and goes away. Watch the table and the Last action readout. Actions that change one row need a selected row."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="RemoveAllRowsButton"
                            AutomationProperties.AutomationId="EmptyStateRemoveAllRowsButton"
                            Content="Remove every row"
                            Click="OnRemoveAllRowsClick"
                            ToolTipService.ToolTip="Clears the collection behind the attached source and switches Data source to Zero rows."
                            AutomationProperties.HelpText="Clears the collection behind the attached source and switches Data source to Zero rows."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveLastRowButton"
                            AutomationProperties.AutomationId="EmptyStateRemoveLastRowButton"
                            Content="Remove the last row"
                            Click="OnRemoveLastRowClick"
                            ToolTipService.ToolTip="Removes the last person in the collection. Removing the last member of a group removes the group; removing the last row shows the empty template."
                            AutomationProperties.HelpText="Removes the last person in the collection. Removing the last row shows the empty template."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="FilterToZeroButton"
                            AutomationProperties.AutomationId="EmptyStateFilterToZeroButton"
                            Content="Filter to zero matches"
                            Click="OnFilterToZeroClick"
                            ToolTipService.ToolTip="Calls TableViewSource.Filter with 'joined after today', which matches nobody. The collection keeps its rows, yet the empty template shows."
                            AutomationProperties.HelpText="Calls TableViewSource.Filter with a predicate that matches nobody."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="MoveSelectedRowButton"
                            AutomationProperties.AutomationId="EmptyStateMoveSelectedRowButton"
                            Content="Move selected row to the next group"
                            Click="OnMoveSelectedRowClick"
                            ToolTipService.ToolTip="Gives the selected person the next department (or flips Active when grouped by Active). Grouped, the row moves to that group."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RestoreRowsButton"
                            AutomationProperties.AutomationId="EmptyStateRestoreRowsButton"
                            Content="Restore the rows"
                            Click="OnRestoreRowsClick"
                            ToolTipService.ToolTip="Clears the filter, reloads 40 people and switches Data source back to Populated."
                            AutomationProperties.HelpText="Clears the filter, reloads 40 people and switches Data source back to Populated."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- scaffold:status -->
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Status">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Status"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <Grid Style="{StaticResource StatusGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ItemsSource" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ItemsSourceText" AutomationProperties.AutomationId="EmptyStateItemsSourceText"
                                   AutomationProperties.LiveSetting="Polite" Text="TableViewSource" TextWrapping="Wrap" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="1" Text="Empty template" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EmptyTemplateText" AutomationProperties.AutomationId="EmptyStateEmptyTemplateText"
                                   AutomationProperties.LiveSetting="Polite" Text="Hidden" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="2" Text="Rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RowsText" AutomationProperties.AutomationId="EmptyStateRowsText"
                                   AutomationProperties.LiveSetting="Polite" Text="0" TextWrapping="Wrap" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="3" Text="Shaping" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ShapingModeText" AutomationProperties.AutomationId="EmptyStateShapingModeText"
                                   AutomationProperties.LiveSetting="Polite" Text="Flat" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="4" Text="Last action" VerticalAlignment="Top" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastActionText" AutomationProperties.AutomationId="EmptyStateLastActionText"
                                   AutomationProperties.LiveSetting="Polite" Text="(none)" TextWrapping="Wrap"
                                   Style="{StaticResource StatusReadoutValueStyle}"/>
                    </Grid>
                </StackPanel>
                <!-- /scaffold -->

                <muxc:InfoBar
                    Title="What to look for"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    Message="A null ItemsSource, an emptied source and a filter that matches nothing all look the same to the user: the column headers stay and the empty template fills the row area. When grouped, groups vanish with their last member; with zero rows there is no group band at all, only the template. Filtering keeps the 40 people in the collection, so Restore brings them back without reloading."/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>