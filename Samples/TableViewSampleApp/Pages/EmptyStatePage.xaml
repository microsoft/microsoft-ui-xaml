<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.EmptyStatePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:system="using:System">

    <Page.Resources>
        <!-- EmptyTemplate content is TEXT + SHAPES only. A FontIcon inside the
             EmptyTemplate crashes at startup (known issue), so the empty-state
             glyph is drawn with a Border/Ellipse instead of a FontIcon. -->
        <DataTemplate x:Key="EmptyStateTemplate" x:DataType="system:Object">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="320"
                Spacing="12">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse
                        Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                        StrokeThickness="1"/>
                    <Rectangle
                        Width="26" Height="20"
                        RadiusX="3" RadiusY="3"
                        Fill="Transparent"
                        Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                        StrokeThickness="2"/>
                    <Rectangle
                        Width="26" Height="1.5"
                        Margin="0,0,0,0"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>
                <TextBlock
                    Text="No rows to display"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock
                    Text="The table's ItemsSource is null or empty. Load the sample data to populate the rows."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Empty state"
        Description="TableView.EmptyTemplate supplies a DataTemplate shown (centered over the row area) whenever ItemsSource is null or resolves to zero rows. Toggle the data source to clear the rows and reveal the empty state."
        SourceCaption="EmptyStatePage.xaml (excerpt)"
        SourceSnippet="EmptyState.xaml.txt"
        AdditionalSnippetCaption="EmptyStatePage.xaml.cs (excerpt)"
        AdditionalSnippet="EmptyState.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Switch the data source to clear the rows — either by nulling ItemsSource or by emptying a source that stays attached. The EmptyTemplate takes over the row area either way. Then try the same while shaping is Grouped."
                    MinHeight="104"/>
                <Border
                    Grid.Row="1"
                    Style="{StaticResource TableHostBorderStyle}"
                    Padding="0"
                    VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="DemoTable"
                        AutomationProperties.Name="Empty state people"
                        AutomationProperties.AutomationId="EmptyStateTable"
                        SelectionMode="Single"
                        EmptyTemplate="{StaticResource EmptyStateTemplate}"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableViewTextColumn Header="Name"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding FullName}"   CanSort="False"/>
                        <tv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanSort="False"/>
                        <tv:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding Role}"       CanSort="False"/>
                        <tv:TableViewTextColumn Header="Email"      Width="*" MinWidth="200"                    Binding="{Binding Email}"      CanSort="False"/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <StackPanel Spacing="4" AutomationProperties.Name="Empty state data source options">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Data source" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock
                        Text="Clear ItemsSource to show the EmptyTemplate."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <muxc:RadioButtons
                        x:Name="DataSourceRadioButtons"
                        AutomationProperties.Name="Data source"
                        SelectedIndex="0"
                        SelectionChanged="OnDataSourceSelectionChanged">
                        <RadioButton Content="Populated" Tag="Populated" AutomationProperties.AutomationId="EmptyStatePopulatedRadio"/>
                        <RadioButton Content="Empty (null ItemsSource)" Tag="Null" AutomationProperties.AutomationId="EmptyStateEmptyRadio"/>
                        <RadioButton Content="Empty (source with 0 rows)" Tag="ZeroRows" AutomationProperties.AutomationId="EmptyStateZeroRowsRadio"/>
                    </muxc:RadioButtons>
                </StackPanel>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"
                           Text="Flat leaves the source unshaped. Grouped calls TableViewSource.GroupBy on the same source instance, so selection, scroll offset and group expansion survive the reshape. Grouping an empty set is the interesting case: the empty template has to win over an empty group band."/>
                <ComboBox x:Name="ShapingModeSelector"
                          AutomationProperties.AutomationId="ShapingModeSelector"
                          Header="Shaping mode"
                          SelectedIndex="0"
                          SelectionChanged="OnShapingModeChanged"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Flat" Tag="flat"/>
                    <ComboBoxItem Content="Grouped" Tag="grouped"/>
                    <!-- Hierarchical rows are not available in this release. Shown disabled so the
                         shape of the feature is visible; re-enable when the control ships support
                         (TableViewSource exposes only Filter / GroupBy / Sort today). -->
                    <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                    <ComboBoxItem Content="Grouped hierarchy" Tag="groupedhierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                </ComboBox>
                <ComboBox x:Name="GroupKeyCombo" Header="Group by" IsEnabled="False" SelectedIndex="0"
                          SelectionChanged="OnGroupKeyChanged"
                          AutomationProperties.AutomationId="GroupKeyCombo"
                          AutomationProperties.Name="Group key"
                          ToolTipService.ToolTip="Available once Grouped mode is selected."
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active status" Tag="Active"/>
                </ComboBox>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <StackPanel Spacing="8">
                    <Button x:Name="RemoveAllRowsButton" Content="Remove every row" Click="OnRemoveAllRowsClick" AutomationProperties.AutomationId="RemoveAllRowsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="RestoreRowsButton" Content="Restore the rows" Click="OnRestoreRowsClick" IsEnabled="False" AutomationProperties.AutomationId="RestoreRowsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ExpandAllButton" Content="Expand all groups" Click="OnExpandAllClick" IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected." AutomationProperties.AutomationId="ExpandAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CollapseAllButton" Content="Collapse all groups" Click="OnCollapseAllClick" IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected." AutomationProperties.AutomationId="CollapseAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ReassignRowButton" Content="Move first row to another group" Click="OnReassignRowClick" IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected." AutomationProperties.AutomationId="ReassignRowButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <muxc:InfoBar AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="EmptyStateStatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Status"
                    Message="{x:Bind StatusText, Mode=OneWay}"
                    MinHeight="64"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
