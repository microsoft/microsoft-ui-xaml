<?xml version="1.0" encoding="utf-8"?>
<!--
    Hierarchy: TableViewSource.ParentBy(key, parentKey) over one flat list. Two tables share ONE
    ObservableCollection and declare different relations (manager vs mentor), so the same row sits at a
    different depth in each. Filter, Sort and GroupBy compose with the hierarchy, and IsLiveShaping
    reshapes both trees when a row's property changes. The Shaping section is the page's own, not
    ShapingOptions: it shapes two tables at once.
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.HierarchyPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:helpers="using:TableViewSampleApp.Helpers">

    <Page.Resources>
        <!-- GroupBy buckets only ROOTS; descendants stay under their parent. -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold"/>
                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="10" Padding="8,1">
                    <TextBlock Text="{Binding ItemCountText}" FontSize="11"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Hierarchy"
        Description="The data is one flat list of employees. TableViewSource.ParentBy(key, parentKey) tells a source how the rows relate; the rows have no children collection, level or expanded flag. Both tables share ONE ObservableCollection: the first declares the Manager relation (ManagerId), the second the Mentor relation (MentorId), so the same person appears at a different depth in each. Rows start collapsed; a null parent key makes a root and an unknown parent key makes an orphan root. Sort applies within each sibling set, Filter keeps matches plus their ancestors (expanded while the filter is active), and grouping buckets the roots while every root keeps its subtree. ParentBy is a code-behind call: a hierarchy cannot be declared in XAML in this release."
        Snippet="Hierarchy"
        ShowHierarchyKeys="True"
        StretchExample="True"
        TryIt="Expand a row with its chevron or the Right arrow; Left collapses it or moves to the parent, and * expands the whole subtree. Select a row and choose Reparent, Rename or Next department: with Live shaping on, both trees reshape in place. Right-click a row in the Manager table: managers (rows with reports) and individual contributors show different menus, and with grouping on, department headers show a third. In an individual contributor's menu, Promote is enabled only for Engineers, and Assign mentor or Remove mentor shows depending on whether the person has a mentor: the items bind to the row's Employee."
        WhatToLookFor="The same person sits at a different depth in each table. A filter keeps every match and its ancestors; the ancestors are ordinary rows (selectable, counted, announced like any row) and nothing marks them as context. Code can expand or collapse only every row at once (ExpandAllRows / CollapseAllRows): there is no per-row expand API in this release, so the chevron, the keyboard and UI Automation are the only ways to open a single row. Known control issue: under a filter, a match whose descendants also match stays collapsed (type Ada: Ada A1 stays closed), so those descendants stay hidden until you expand it.">

        <controls:SamplePresenter.Example>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Manager relation (parent key = ManagerId)" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <!-- snippet -->
                    <!-- Columns and the relation are declared in code. Per-level indent is a theme
                         resource, not a property; set it on this table's Resources to retheme it only. -->
                    <tv:TableView
                        x:Name="ManagerTable"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="HierarchyManagerTable"
                        AutomationProperties.Name="Employees by manager"
                        SelectionMode="Single"
                        SelectionChanged="OnTableSelectionChanged"
                        GridLinesVisibility="Horizontal"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableView.Resources>
                            <x:Double x:Key="TableViewRowIndentSize">24</x:Double>
                            <!-- Per-row-kind context menus: individual contributors, managers
                                 (rows with reports) and department headers (Group on). Menu items
                                 inherit the row's Employee as DataContext, so their state can bind
                                 to it: Promote is disabled unless CanPromote, and exactly one of
                                 Assign / Remove mentor shows, depending on HasMentor. -->
                            <MenuFlyout x:Key="LeafRowMenu">
                                <MenuFlyoutItem Text="Open profile" Click="OnRowMenuItemClick"/>
                                <MenuFlyoutItem Text="Promote" Click="OnPromoteClick"
                                                IsEnabled="{Binding CanPromote}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Assign mentor" Click="OnAssignMentorClick"
                                                Visibility="{Binding HasMentor, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                <MenuFlyoutItem Text="Remove mentor" Click="OnRemoveMentorClick"
                                                Visibility="{Binding HasMentor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Remove" Click="OnRowMenuItemClick"/>
                            </MenuFlyout>
                            <MenuFlyout x:Key="ManagerRowMenu">
                                <MenuFlyoutItem Text="Open profile" Click="OnRowMenuItemClick"/>
                                <MenuFlyoutItem Text="Email team" Click="OnRowMenuItemClick"/>
                            </MenuFlyout>
                            <!-- A group header's DataContext is its TableViewGroupInfo. -->
                            <MenuFlyout x:Key="DeptGroupMenu">
                                <MenuFlyoutItem Text="{Binding KeyText}" IsEnabled="False"/>
                                <MenuFlyoutItem Text="Email department" Click="OnRowMenuItemClick"/>
                            </MenuFlyout>
                        </tv:TableView.Resources>
                        <!-- TableView asks again whenever a row's hierarchy state changes, so a
                             row that gains its first report switches menus in place. -->
                        <tv:TableView.RowStyleSelector>
                            <helpers:RowKindStyleSelector>
                                <helpers:RowKindStyleSelector.LeafRow>
                                    <Style TargetType="tv:TableViewRow">
                                        <Setter Property="ContextFlyout" Value="{StaticResource LeafRowMenu}"/>
                                    </Style>
                                </helpers:RowKindStyleSelector.LeafRow>
                                <helpers:RowKindStyleSelector.ExpandableRow>
                                    <Style TargetType="tv:TableViewRow">
                                        <Setter Property="ContextFlyout" Value="{StaticResource ManagerRowMenu}"/>
                                    </Style>
                                </helpers:RowKindStyleSelector.ExpandableRow>
                                <!-- The style owns the band chrome; GroupHeaderTemplate (set in
                                     code) still owns the content. -->
                                <helpers:RowKindStyleSelector.GroupHeader>
                                    <Style TargetType="tv:TableViewGroupHeader">
                                        <Setter Property="ContextFlyout" Value="{StaticResource DeptGroupMenu}"/>
                                        <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <Setter Property="Padding" Value="8,10,16,10"/>
                                    </Style>
                                </helpers:RowKindStyleSelector.GroupHeader>
                            </helpers:RowKindStyleSelector>
                        </tv:TableView.RowStyleSelector>
                    </tv:TableView>
                    <!-- /snippet -->
                </Grid>

                <Grid Grid.Column="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mentor relation (parent key = MentorId)" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <tv:TableView
                        x:Name="MentorTable"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="HierarchyMentorTable"
                        AutomationProperties.Name="Employees by mentor"
                        SelectionMode="Single"
                        SelectionChanged="OnTableSelectionChanged"
                        GridLinesVisibility="Horizontal"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableView.Resources>
                            <x:Double x:Key="TableViewRowIndentSize">24</x:Double>
                        </tv:TableView.Resources>
                    </tv:TableView>
                </Grid>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Shaping"
                    Description="Applied to both tables. Filter matches names and keeps each match's ancestors; sort orders each sibling set; grouping buckets the roots by department.">
                    <TextBox x:Name="FilterBox" Header="Filter" PlaceholderText="Name contains..."
                             AutomationProperties.AutomationId="HierarchyFilterBox"
                             TextChanged="Filter_Changed" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="SortCombo" Header="Sort" SelectionChanged="Sort_Changed"
                              AutomationProperties.AutomationId="HierarchySortSelector"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Authored order" IsSelected="True"/>
                        <ComboBoxItem Content="Name ascending"/>
                        <ComboBoxItem Content="Name descending"/>
                        <ComboBoxItem Content="Title ascending"/>
                    </ComboBox>
                    <ToggleSwitch x:Name="GroupToggle" Header="Group roots by department"
                                  AutomationProperties.AutomationId="HierarchyGroupToggle"
                                  Toggled="Group_Toggled"/>
                    <!-- On: edits reshape the tree in place. Off: rows stay put until the next
                         reshape; Reparent replaces the item instead. -->
                    <ToggleSwitch x:Name="LiveToggle" Header="Live shaping" IsOn="True"
                                  AutomationProperties.AutomationId="HierarchyLiveShapingToggle"
                                  Toggled="Live_Toggled"/>
                </controls:RailSection>

                <controls:RailSection
                    Header="Actions"
                    Description="Add and remove edit the shared collection, so both tables follow. Reparent, Rename and Next department change one property of the selected row.">
                    <StackPanel Spacing="8">
                        <Button Content="Expand all" Click="ExpandAll_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyExpandAllButton"/>
                        <Button Content="Collapse all" Click="CollapseAll_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyCollapseAllButton"/>
                        <Button Content="Add report to selected" Click="AddReport_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyAddReportButton"/>
                        <Button Content="Add root" Click="AddRoot_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyAddRootButton"/>
                        <Button Content="Reparent selected" Click="Reparent_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyReparentButton"/>
                        <Button Content="Rename selected" Click="Rename_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyRenameButton"/>
                        <Button Content="Next department" Click="NextDept_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyNextDeptButton"/>
                        <Button Content="Remove selected" Click="Remove_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyRemoveButton"/>
                        <Button Content="Reset data" Click="Reset_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyResetButton"/>
                        <Button x:Name="PerfButton" Content="Run 100k perf probe" Click="Perf_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyPerfButton"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Hierarchy">
                    <TextBlock x:Name="SelectedText" controls:StatusPanel.Label="Selected" Text="(none)"/>
                    <TextBlock x:Name="LiveText" controls:StatusPanel.Label="Live shaping" Text="On"/>
                    <TextBlock x:Name="StatusText" controls:StatusPanel.Label="Perf probe" Text="(not run)" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
