<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder: hierarchical rows are not available in this release. The Shaping section stays
    inline because there is no table to attach ShapingOptions to.
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.HierarchyPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Hierarchy"
        Description="Placeholder. Hierarchical rows are not available in this release, so this page has no table and demonstrates nothing yet. Hierarchy is a separate shaping axis from grouping: grouping buckets rows under a computed key, while hierarchy renders a parent/child relationship that already exists in the data, with expand and collapse on each parent row. The two are expected to compose, so a grouped hierarchy (groups at the outer level, parent/child nesting inside each group) is part of the intended design. Nothing on this page calls a hierarchy API, because no such API exists in this release."
        WhatToLookFor="Open the Shaping mode list: Hierarchy and Grouped hierarchy are listed but cannot be chosen, exactly as on every table page. This page has no Actions or Last action readout because there is nothing to act on until hierarchical rows ship.">

        <controls:SamplePresenter.Example>
            <StackPanel Spacing="12">
                <muxc:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Not available in this release"
                    Message="Hierarchical rows are not available in this release. This page is a placeholder: there is no working demo here, and the options in the rail are shown disabled so the intended shape of the feature is visible without pretending it works."
                    AutomationProperties.AutomationId="HierarchyUnavailableInfoBar"/>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="What the feature will cover" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"
                    Text="Parent and child rows drawn from a relationship in the data itself, rather than from a key selector. Each parent row carries its own expand / collapse affordance, so the expanded state is per row rather than per group, and a child row keeps its own cells and selection behaviour instead of being folded into a header."/>
                <TextBlock
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"
                    Text="Expand and collapse are expected to be reachable from the keyboard on the focused parent row and to report an expand/collapse state to UI Automation, the way group headers already do today on the Grouped rows page."/>
                <TextBlock
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"
                    Text="Grouping combined with hierarchy: groups at the outer level with parent/child nesting inside each group, so the two axes compose rather than exclude each other. Until that is available, the table pages in this gallery show the grouping axis on its own."/>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Available today instead" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"
                    Text="The Grouped rows page covers the grouping axis end to end: group headers with counts, a custom group header template, and expand / collapse across all groups. Every other table page (Sorting, Filtering, Selection, Cell templating, Cell editing, Density and more) has the same Shaping section with a working Grouped mode, applied alongside that page's feature."/>
            </StackPanel>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Shaping"
                    Description="The same Shaping section every table page carries. On this page only Flat is available: there is no table to group, and hierarchical rows are not available in this release.">
                    <ComboBox
                        AutomationProperties.AutomationId="HierarchyShapingModeSelector"
                        Header="Shaping mode"
                        SelectedIndex="0"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Flat" Tag="flat"/>
                        <ComboBoxItem Content="Grouped" Tag="grouped" IsEnabled="False"
                                      AutomationProperties.HelpText="Grouping is shown on every table page; this page has no table."/>
                        <!-- Hierarchical rows are not available in this release. When the control ships
                             hierarchy, this page gets a table and these two options are enabled. -->
                        <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                      AutomationProperties.HelpText="Hierarchical rows are not available in this release."/>
                        <ComboBoxItem Content="Grouped hierarchy" Tag="groupedHierarchy" IsEnabled="False"
                                      AutomationProperties.HelpText="Hierarchical rows are not available in this release."/>
                    </ComboBox>
                    <ComboBox
                        AutomationProperties.AutomationId="HierarchyGroupKeySelector"
                        Header="Group key"
                        SelectedIndex="0"
                        IsEnabled="False"
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Department" Tag="Department"/>
                    </ComboBox>
                    <Button
                        AutomationProperties.AutomationId="HierarchyExpandAllGroupsButton"
                        Content="Expand all"
                        IsEnabled="False"
                        AutomationProperties.HelpText="Hierarchical rows are not available in this release."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        AutomationProperties.AutomationId="HierarchyCollapseAllGroupsButton"
                        Content="Collapse all"
                        IsEnabled="False"
                        AutomationProperties.HelpText="Hierarchical rows are not available in this release."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               AutomationProperties.AutomationId="HierarchyShapingCaption"
                               Text="Grouping is shown on every table page; this page has no table. Hierarchy and Grouped hierarchy are not available in this release, so Group key, Expand all and Collapse all stay disabled."/>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Hierarchy" ShowRows="False" ShowLastAction="False">
                    <TextBlock x:Name="AvailabilityText" controls:StatusPanel.Label="Availability" Text="Not available in this release"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</pages:SamplePageBase>
