<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.HierarchyPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:models="using:TableViewSampleApp.Models"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- snippet -->
        <!-- The tree is the CollectionViewSource's: a flat process list, nested by parent process id. TableView has no
             hierarchy of its own. The sort orders every sibling list; live sorting moves a process among its siblings. -->
        <CollectionViewSource x:Name="Processes" Filter="OnProcessFilter" IsLiveSortingRequested="True">
            <CollectionViewSource.HierarchyDescription>
                <PropertyHierarchyDescription ItemKeyPath="Pid" ParentKeyPath="ParentPid"/>
            </CollectionViewSource.HierarchyDescription>
            <CollectionViewSource.SortDescriptions>
                <SortDescription PropertyName="CpuPercent" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <DataTemplate x:Key="TreeProcessNameTemplate" x:DataType="models:ProcessItem">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TreeCpuTemplate" x:DataType="models:ProcessItem">
            <Border Background="{x:Bind CpuPercent, Mode=OneWay, Converter={StaticResource ProcessHeatBrushConverter}, ConverterParameter=Cpu}" Padding="8,4">
                <TextBlock Text="{x:Bind CpuDisplay, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TreeMemoryTemplate" x:DataType="models:ProcessItem">
            <Border Background="{x:Bind MemoryMB, Mode=OneWay, Converter={StaticResource ProcessHeatBrushConverter}, ConverterParameter=Memory}" Padding="8,4">
                <TextBlock Text="{x:Bind MemoryDisplay, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Hierarchy"
        Description="A Task Manager style process tree. The rows are one flat list of processes with a process id and a parent process id. The CollectionViewSource builds the tree (HierarchyDescription = PropertyHierarchyDescription with ItemKeyPath Pid and ParentKeyPath ParentPid), sorts each sibling list, filters (a match keeps its ancestors as context rows) and keeps it current as processes start, end and change. TableView only presents the view's nodes: it adds the chevrons, indentation, expansion (ExpandRow, CollapseRow, ExpandAllRows, CollapseAllRows) and the UI Automation tree pattern."
        Snippet="Hierarchy"
        StretchExample="True"
        TryIt="Expand an app with its chevron or the Right arrow; Left collapses it or moves to its parent, and * expands its whole subtree. Turn on live updates: CPU values change every second and each process moves among its siblings, keeping its children and its expansion. Type a name in Filter: matching processes show under their parents, which stay as context rows. Select an app and choose Start a child process or End the selected process."
        WhatToLookFor="The ListView in the rail is bound to the same View: it shows every process depth first, without indentation, because the view's own list is the tree in pre-order. Ending a parent process makes its children roots (their parent id no longer matches a process). Expansion is the table's, keyed by process id, so it survives sorting, filtering and Refresh().">

        <controls:SamplePresenter.Example>
            <!-- snippet -->
            <tv:TableView
                x:Name="ProcessTable"
                AutomationProperties.AutomationId="HierarchyTable"
                AutomationProperties.Name="Processes by parent process"
                SelectionMode="Single"
                VerticalAlignment="Stretch"
                MinHeight="320">
                <tv:TableViewTemplateColumn Header="Name" Width="*" MinWidth="200" CellTemplate="{StaticResource TreeProcessNameTemplate}" SortMemberPath="Name"/>
                <tv:TableViewTemplateColumn Header="PID" Width="80" SortMemberPath="Pid">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessItem">
                            <TextBlock Text="{x:Bind Pid}" Style="{StaticResource CellTextStyle}" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Status" Width="130" SortMemberPath="StatusText">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ProcessItem">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CellTextStyle}"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="CPU" Width="100" CellTemplate="{StaticResource TreeCpuTemplate}" SortMemberPath="CpuPercent"/>
                <tv:TableViewTemplateColumn Header="Memory" Width="100" CellTemplate="{StaticResource TreeMemoryTemplate}" SortMemberPath="MemoryMB"/>
            </tv:TableView>
            <!-- /snippet -->
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="View shaping"
                    Description="Every option edits the CollectionViewSource; the table follows its View.">
                    <TextBox
                        x:Name="FilterBox"
                        AutomationProperties.AutomationId="HierarchyFilterBox"
                        Header="Filter"
                        PlaceholderText="Process name contains"
                        AutomationProperties.HelpText="Shows the processes whose name matches, under their parents."
                        TextChanged="OnFilterChanged"
                        HorizontalAlignment="Stretch"/>
                    <ComboBox
                        x:Name="SortCombo"
                        AutomationProperties.AutomationId="HierarchySortSelector"
                        Header="Sort each sibling list by"
                        SelectedIndex="0"
                        SelectionChanged="OnSortChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="CPU, highest first"/>
                        <ComboBoxItem Content="Memory, highest first"/>
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Source order"/>
                    </ComboBox>
                    <ToggleSwitch
                        x:Name="LiveToggle"
                        AutomationProperties.AutomationId="HierarchyLiveToggle"
                        Header="Live updates"
                        OffContent="Off"
                        OnContent="CPU and memory change every second"
                        Toggled="OnLiveToggled"/>
                </controls:RailSection>

                <controls:RailSection
                    Header="Expansion"
                    Description="Expansion is the table's, not the view's: two tables over one view can show different rows.">
                    <StackPanel Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="HierarchyExpandAllButton"
                            Content="Expand all"
                            Click="OnExpandAllClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            AutomationProperties.AutomationId="HierarchyCollapseAllButton"
                            Content="Collapse all"
                            Click="OnCollapseAllClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            AutomationProperties.AutomationId="HierarchyRevealButton"
                            Content="Reveal the busiest child process"
                            Click="OnRevealClick"
                            ToolTipService.ToolTip="Calls ExpandRow on the child process with the highest CPU: its parent opens and it is selected."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:RailSection
                    Header="Processes"
                    Description="Each action changes the process list; the view updates the tree in place.">
                    <StackPanel Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="HierarchyStartChildButton"
                            Content="Start a child process"
                            Click="OnStartChildClick"
                            ToolTipService.ToolTip="Adds a process whose parent is the selected process (a new app when none is selected)."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            AutomationProperties.AutomationId="HierarchyEndButton"
                            Content="End the selected process"
                            Click="OnEndClick"
                            ToolTipService.ToolTip="Removes it; its child processes become roots."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            AutomationProperties.AutomationId="HierarchyResetButton"
                            Content="Reset the processes"
                            Click="OnResetClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:RailSection
                    Header="The view's own list"
                    Description="A ListView over the same View: every process, depth first.">
                    <ListView
                        x:Name="ViewList"
                        AutomationProperties.AutomationId="HierarchyViewList"
                        AutomationProperties.Name="The view's list"
                        DisplayMemberPath="Name"
                        SelectionMode="None"
                        Height="200"/>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Hierarchy">
                    <TextBlock x:Name="RootsText" controls:StatusPanel.Label="Roots" Text="0"/>
                    <TextBlock x:Name="SelectedText" controls:StatusPanel.Label="Selected" Text="(none)" TextWrapping="Wrap"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
