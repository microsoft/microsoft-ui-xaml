<?xml version="1.0" encoding="utf-8"?>
<!--
    Hierarchy: TableViewSource.ParentBy(key, parentKey) over one flat list. Two tables share ONE
    ObservableCollection and declare different relations (manager vs mentor), so the same row sits at a
    different depth in each. Filter, Sort and GroupBy compose with the hierarchy, and IsLiveShaping
    reshapes both trees when a row's property changes.
-->
<Page
    x:Class="TableViewSampleApp.Pages.HierarchyPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- Headers only ever appear at the top level: GroupBy buckets the ROOTS, and a descendant
             stays under its parent rather than being pulled out to join a bucket. -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold"/>
                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="10" Padding="8,1">
                    <TextBlock Text="{Binding ItemCountText}" FontSize="11"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Hierarchy"
        Description="The data is one flat list of employees. TableViewSource.ParentBy(key, parentKey) tells a source how the rows relate; the rows have no children collection, level or expanded flag. Both tables share ONE ObservableCollection: the first declares the Manager relation (ManagerId), the second the Mentor relation (MentorId), so the same person appears at a different depth in each. Rows start collapsed; a null parent key makes a root and an unknown parent key makes an orphan root. Sort applies within each sibling set, Filter keeps matches plus their ancestors (auto-expanded while the filter is active), and grouping buckets the roots while every root keeps its subtree."
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- scaffold:tryit -->
                <muxc:InfoBar
                    Grid.Row="0"
                    Title="Try it"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    Message="Expand a row with its chevron or the Right arrow; Left collapses it or moves to the parent, and * expands the whole subtree. Select a row and choose Reparent, Rename or Next department: with Live shaping on, both trees reshape in place."/>
                <!-- /scaffold -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Manager relation (parent key = ManagerId)" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                            <!-- Per-level indent is a theme resource, not a property; set it on this
                                 table's own Resources to retheme this table only. -->
                            <tv:TableView
                                x:Name="ManagerTable"
                                AutomationProperties.AutomationId="HierarchyManagerTable"
                                AutomationProperties.Name="Employees by manager"
                                SelectionMode="Single"
                                GridLinesVisibility="Horizontal"
                                VerticalAlignment="Stretch"
                                MinHeight="320">
                                <tv:TableView.Resources>
                                    <x:Double x:Key="TableViewRowIndentSize">24</x:Double>
                                </tv:TableView.Resources>
                            </tv:TableView>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Mentor relation (parent key = MentorId)" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                            <tv:TableView
                                x:Name="MentorTable"
                                AutomationProperties.AutomationId="HierarchyMentorTable"
                                AutomationProperties.Name="Employees by mentor"
                                SelectionMode="Single"
                                GridLinesVisibility="Horizontal"
                                VerticalAlignment="Stretch"
                                MinHeight="320">
                                <tv:TableView.Resources>
                                    <x:Double x:Key="TableViewRowIndentSize">24</x:Double>
                                </tv:TableView.Resources>
                            </tv:TableView>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Shaping">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping"
                               Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Applied to both tables. Filter matches names and keeps each match's ancestors; sort orders each sibling set; grouping buckets the roots by department."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <TextBox x:Name="FilterBox" Header="Filter" PlaceholderText="Name contains..."
                             AutomationProperties.AutomationId="HierarchyFilterBox"
                             TextChanged="Filter_Changed" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="SortCombo" Header="Sort" SelectionChanged="Sort_Changed"
                              AutomationProperties.AutomationId="HierarchySortSelector"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Authored order" IsSelected="True"/>
                        <ComboBoxItem Content="Name ascending"/>
                        <ComboBoxItem Content="Name descending"/>
                        <ComboBoxItem Content="Title ascending"/>
                    </ComboBox>
                    <ToggleSwitch x:Name="GroupToggle" Header="Group roots by department"
                                  AutomationProperties.AutomationId="HierarchyGroupToggle"
                                  Toggled="Group_Toggled"/>
                    <!-- On: both sources set IsLiveShaping, so editing a property (Reparent / Rename /
                         Next department) reshapes the tree in place. Off: the edit is applied to the
                         data but the rows stay where they were until the next reshape, so Reparent
                         falls back to replacing the item in the collection. -->
                    <ToggleSwitch x:Name="LiveToggle" Header="Live shaping" IsOn="True"
                                  AutomationProperties.AutomationId="HierarchyLiveShapingToggle"
                                  Toggled="Live_Toggled"/>
                </StackPanel>

                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Actions">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="Add and remove edit the shared collection, so both tables follow. Reparent, Rename and Next department change one property of the selected row."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8">
                        <Button Content="Expand all" Click="ExpandAll_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyExpandAllButton"/>
                        <Button Content="Collapse all" Click="CollapseAll_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyCollapseAllButton"/>
                        <Button Content="Add report to selected" Click="AddReport_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyAddReportButton"/>
                        <Button Content="Add root" Click="AddRoot_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyAddRootButton"/>
                        <Button Content="Reparent selected" Click="Reparent_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyReparentButton"/>
                        <Button Content="Rename selected" Click="Rename_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyRenameButton"/>
                        <Button Content="Next department" Click="NextDept_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyNextDeptButton"/>
                        <Button Content="Remove selected" Click="Remove_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyRemoveButton"/>
                        <Button Content="Reset data" Click="Reset_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyResetButton"/>
                        <Button x:Name="PerfButton" Content="Run 100k perf probe" Click="Perf_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="HierarchyPerfButton"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Status">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Status"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StatusText"
                               AutomationProperties.AutomationId="HierarchyStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
