<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.AboutPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSampleApp.Controls">
<ScrollViewer Padding="{StaticResource PageContentMargin}">
        <Grid RowSpacing="16" HorizontalAlignment="Left" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:SamplePageHeader
                Grid.Row="0"
                Title="About"
                Description="A samples app that ships alongside the in-development Microsoft.UI.Xaml.Controls.Tabular.TableView control and shows its model-first TableView and TableViewSource surface page by page."/>

            <Grid Grid.Row="1" RowSpacing="12" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audience" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Partner teams (File Explorer, Task Manager, and other Windows surfaces) evaluating the aligned TableView and TableViewSource API surface."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="App stack" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Text="C# 12 + .NET 8 desktop app" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="Windows App SDK (preview)"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="WinUI 3"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample source" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                    <TextBlock Text="Samples\TableViewSampleApp\" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="26 pages: Home + Settings + About + 23 feature demos"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Control source" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                    <TextBlock Text="controls\dev\TableView\ (C++/WinRT)" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="Namespace: Microsoft.UI.Xaml.Controls.Tabular"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Binary: Microsoft.UI.Xaml.Controls.Tabular.dll (parallel to Microsoft.UI.Xaml.Controls.dll)"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="API snapshot" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                    <TextBlock Text="ItemsSource is set in code-behind from TableViewSource.From(items).Filter(...).GroupBy(..., identity).Sort(...)."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Columns: TableViewTextColumn (lightweight bound text, sortable via SortMemberPath) and TableViewTemplateColumn (DataTemplate cells)."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Enums: TableViewSelectionMode { None, Single }; TableViewHeadersVisibility { None, Column }; TableViewDensity { Compact, Standard, Comfortable }; TableViewGridLinesVisibility { None, Horizontal, Vertical, All }."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Build" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="BuildLineText" AutomationProperties.AutomationId="AboutBuildLineText" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BuildCommitText" AutomationProperties.AutomationId="AboutBuildCommitText" Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BuildCommitSubjectText" AutomationProperties.AutomationId="AboutBuildCommitSubjectText" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Reporting bugs" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Spacing="6">
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Run Text="Report a bug in the public Microsoft UI XAML repository:"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReportIssueButton" Content="Report on GitHub"
                                AutomationProperties.AutomationId="AboutReportIssueButton"
                                AutomationProperties.Name="Report an issue on GitHub"
                                AutomationProperties.HelpText="Opens the public Microsoft UI XAML bug report template in a browser."
                                ToolTipService.ToolTip="Opens the public Microsoft UI XAML bug report template on GitHub."/>
                        <Button x:Name="CopyAutoFillButton"
                                AutomationProperties.AutomationId="AboutCopyAutoFillButton"
                                AutomationProperties.Name="Copy auto-fill details"
                                AutomationProperties.HelpText="Copies a Markdown block with commit, branch, build, theme, and OS details to the clipboard."
                                ToolTipService.ToolTip="Copies a Markdown block ready to paste into the GitHub issue.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock x:Name="CopyAutoFillLabel" Text="Copy auto-fill"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Auto-fill includes: commit SHA, branch, build timestamp, current theme, and OS / .NET version — everything a triager needs to reproduce."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Issues are filed at "/>
                        <Hyperlink NavigateUri="https://github.com/microsoft/microsoft-ui-xaml/issues/new?template=bug_report.yaml">
                            <Run Text="github.com/microsoft/microsoft-ui-xaml/issues/new"/>
                        </Hyperlink>
                        <Run Text=". Include the page name, repro steps, and the exception type + message if a crash."/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Theme" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Row="7" Grid.Column="1"
                           Text="Switch between Use system setting, Light and Dark with the theme button in the title bar (top-right), or choose a theme on the 'Theme &amp; settings' page. Changes apply live across every page."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>
            </Grid>

            <muxc:InfoBar
                Grid.Row="2"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Gallery coverage"
                Message="Every page is listed on the Home page and in the navigation pane."/>
        </Grid>
    </ScrollViewer>
</Page>
