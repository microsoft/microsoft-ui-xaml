<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.DensityPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Density"
        Description="TableView.Density sets the minimum row, column-header and group-header heights and the built-in padding to Small, Medium or Large. Medium is the default. SmallTableViewStyle and LargeTableViewStyle select the same presets. Template content, such as the 28 px avatar and the Department and Status chips, can make rows taller than the preset minimum. The cells here are read-only visuals."
        Snippet="Density"
        StretchExample="True"
        TryIt="Choose Small, Medium, then Large and compare the rows and column headers. Switch Shaping to Grouped and change the density again to compare the group headers too. Then select a row and move it to the next group."
        WhatToLookFor="Rows, column headers and group headers follow the density preset, with 24, 32 and 40 px minimum heights for Small, Medium and Large. Custom template content can make rows taller. Grouped, moving a row re-applies GroupBy, so the row jumps to its new group, and a group that loses its last row disappears.">

        <controls:SamplePresenter.Example>
            <!-- snippet -->
            <!-- Custom template content can make rows taller than the density minimum. -->
            <tv:TableView
                x:Name="PeopleTable"
                AutomationProperties.AutomationId="DensityTable"
                AutomationProperties.Name="People density"
                ItemsSource="{x:Bind Source}"
                Style="{StaticResource DefaultTableViewStyle}"
                SelectionMode="Single"
                VerticalAlignment="Stretch"
                MinHeight="320">
                <tv:TableViewTemplateColumn Header="Photo" Width="56" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="140" Binding="{Binding FullName}"/>
                <tv:TableViewTemplateColumn Header="Department" Width="130" CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"/>
                <tv:TableViewTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource ActiveStatusChipTemplate}" SortMemberPath="IsActive"/>
                <tv:TableViewTextColumn Header="Role" Width="200" Binding="{Binding Role}"/>
            </tv:TableView>
            <!-- /snippet -->
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Density"
                    Description="Sets TableView.Density. Each preset changes the minimum row, column-header and group-header heights and the built-in padding.">
                    <!-- snippet -->
                    <ComboBox
                        x:Name="DensitySelector"
                        AutomationProperties.AutomationId="DensitySelector"
                        Header="Density"
                        SelectedIndex="1"
                        SelectionChanged="OnDensityChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Small (24px)" Tag="Small"/>
                        <ComboBoxItem Content="Medium (32px, default)" Tag="Medium"/>
                        <ComboBoxItem Content="Large (40px)" Tag="Large"/>
                    </ComboBox>
                    <!-- /snippet -->
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="Density"
                    Description="Grouped, compare the row height with the group-header height as you change the density. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Change the rows and groups while a density is applied; new rows take the current density. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="MoveGroupButton"
                            AutomationProperties.AutomationId="DensityMoveGroupButton"
                            Content="Move selected row to the next group"
                            Click="OnMoveGroupClick"
                            ToolTipService.ToolTip="Changes the grouped-on value (Department when flat) to the next real value, then re-applies GroupBy so the row moves to its new group."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="AddPersonButton"
                            AutomationProperties.AutomationId="DensityAddPersonButton"
                            Content="Add a person to the selected row's group"
                            Click="OnAddPersonClick"
                            ToolTipService.ToolTip="Inserts a new person with the same grouped-on value below the selected row, so that group gains a member."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveRowButton"
                            AutomationProperties.AutomationId="DensityRemoveRowButton"
                            Content="Remove selected row"
                            Click="OnRemoveRowClick"
                            ToolTipService.ToolTip="Removes the selected row; a group disappears when it loses its last row."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="EmptyToggleButton"
                            AutomationProperties.AutomationId="DensityEmptyToggleButton"
                            Content="Clear all rows"
                            Click="OnToggleEmptyClick"
                            ToolTipService.ToolTip="Empties the collection, then restores it on the next click."
                            AutomationProperties.HelpText="Empties the collection, then restores it on the next click."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Density">
                    <TextBlock x:Name="DensityText" AutomationProperties.AutomationId="DensityText" controls:StatusPanel.Label="Density" Text="Medium"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
