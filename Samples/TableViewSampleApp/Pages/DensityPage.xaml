<?xml version="1.0" encoding="utf-8"?>
<!--
    Density: TableView.Density (Compact / Standard / Comfortable) switched live over text and
    read-only template cells, alongside grouping, whose headers keep a fixed height. The page holds
    only the density behaviour: the table, the Density section and the Actions. Try it / What to
    look for are presenter attributes; Shaping and Status are the shared ShapingOptions /
    StatusPanel controls (see Pages\SamplePageBase.cs).
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.DensityPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Density"
        Description="TableView.Density sets the row height and the built-in cell padding to Compact, Standard or Comfortable. Pick a preset and every row resizes at once, including the template cells: the 28 px avatar and the Department and Status chips. Group headers keep the same height in every preset, so with grouping on, the rows change and the headers do not. The cells here are read-only visuals, so nothing but the density changes their size."
        Snippet="Density"
        StretchExample="True"
        TryIt="Choose Compact, then Comfortable, and watch every row resize. Switch Shaping to Grouped and change the density again: the rows resize but the group headers keep their height. Then select a row and move it to the next group."
        WhatToLookFor="Every row takes the new height at once, and the 28 px avatar and the chips still fit in Compact. Group headers keep the same height in every preset. Grouped, moving a row re-applies GroupBy, so the row jumps to its new group, and a group that loses its last row disappears.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <!-- Density is one table-level property; the template cells take the new row height
                     with no change of their own. -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="DensityTable"
                    AutomationProperties.Name="People density"
                    ItemsSource="{x:Bind Source}"
                    Density="Standard"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                    <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}"/>
                    <tv:TableViewTemplateColumn Header="Department" Width="{StaticResource ColWidthChip}" CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"/>
                    <tv:TableViewTemplateColumn Header="Status" Width="{StaticResource ColWidthStatus}" CellTemplate="{StaticResource ActiveStatusChipTemplate}" SortMemberPath="IsActive"/>
                    <tv:TableViewTextColumn Header="Role" Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}"/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Density"
                    Description="Sets TableView.Density. Each preset changes the row height and the built-in cell padding; group headers are not affected.">
                    <!-- snippet -->
                    <ComboBox
                        x:Name="DensitySelector"
                        AutomationProperties.AutomationId="DensitySelector"
                        Header="Density"
                        SelectedIndex="1"
                        SelectionChanged="OnDensityChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Compact" Tag="Compact"/>
                        <ComboBoxItem Content="Standard (default)" Tag="Standard"/>
                        <ComboBoxItem Content="Comfortable" Tag="Comfortable"/>
                    </ComboBox>
                    <!-- /snippet -->
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="Density"
                    Description="Grouped, compare the row height with the group-header height as you change the density. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Change the rows and groups while a density is applied; new rows take the current density. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="MoveGroupButton"
                            AutomationProperties.AutomationId="DensityMoveGroupButton"
                            Content="Move selected row to the next group"
                            Click="OnMoveGroupClick"
                            ToolTipService.ToolTip="Changes the grouped-on value (Department when flat) to the next real value, then re-applies GroupBy so the row moves to its new group."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="AddPersonButton"
                            AutomationProperties.AutomationId="DensityAddPersonButton"
                            Content="Add a person to the selected row's group"
                            Click="OnAddPersonClick"
                            ToolTipService.ToolTip="Inserts a new person with the same grouped-on value below the selected row, so that group gains a member."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveRowButton"
                            AutomationProperties.AutomationId="DensityRemoveRowButton"
                            Content="Remove selected row"
                            Click="OnRemoveRowClick"
                            ToolTipService.ToolTip="Removes the selected row; a group disappears when it loses its last row."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="EmptyToggleButton"
                            AutomationProperties.AutomationId="DensityEmptyToggleButton"
                            Content="Clear all rows"
                            Click="OnToggleEmptyClick"
                            ToolTipService.ToolTip="Empties the collection, then restores it on the next click."
                            AutomationProperties.HelpText="Empties the collection, then restores it on the next click."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Density">
                    <TextBlock x:Name="DensityText" AutomationProperties.AutomationId="DensityText" controls:StatusPanel.Label="Density" Text="Standard"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
