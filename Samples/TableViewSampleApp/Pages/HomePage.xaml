<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.HomePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:system="using:System">

    <Page.Resources>
        <!-- Shortcut tiles share one size so the wrap grid lines them up. -->
        <Style x:Key="HomeShortcutButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Page.Resources>

    <ScrollViewer
        Padding="{StaticResource PageContentMargin}"
        VerticalScrollBarVisibility="Visible"
        HorizontalScrollMode="Disabled">
        <StackPanel
            Spacing="{StaticResource SectionSpacing}"
            HorizontalAlignment="Left"
            MaxWidth="{StaticResource PageMaxContentWidth}">

            <controls:SamplePageHeader
                Title="TableView"
                Description="Microsoft.UI.Xaml.Controls.Tabular.TableView is a native WinUI 3 tabular control for data-heavy desktop experiences: model-first data shaping with TableViewSource, text and template columns, sorting, filtering, grouped rows, selection, in-place cell editing, headers, grid lines, density, column layout and sizing, column lifecycle, virtualization, keyboard navigation, accessibility and right-to-left support."/>

            <muxc:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="About this gallery"
                Message="A C# WinUI 3 desktop app (.NET 8, Windows App SDK preview). 23 feature pages cover the TableView control; every one is listed below and in the navigation pane. Use the theme button in the title bar, or the Settings page, to switch between Use system setting, Light and Dark; the choice persists across launches."/>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="What's supported today" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="system:String">
                            <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="·" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <x:String>Control type — Microsoft.UI.Xaml.Controls.Tabular.TableView</x:String>
                    <x:String>Model-first source — TableViewSource.From(items) with Filter, GroupBy and Sort, reshaped in place</x:String>
                    <x:String>Columns — TableViewTextColumn for bound text and TableViewTemplateColumn for DataTemplate cells</x:String>
                    <x:String>Template cells with editors — CheckBox, date and time pickers, ComboBox and Button with a Flyout, two-way bound and reachable with Tab</x:String>
                    <x:String>Cell editing — double-click or F2 edits a cell in place, CellEditingTemplate supplies a custom editor, and TableView.IsReadOnly locks the whole table</x:String>
                    <x:String>Header-click sort via SortMemberPath, with a direction indicator</x:String>
                    <x:String>Filtering — TableViewSource.Filter(predicate)</x:String>
                    <x:String>Grouped rows with collapsible group headers</x:String>
                    <x:String>None / Single row selection</x:String>
                    <x:String>Column layout and sizing — Pixel, Auto and Star widths, MinWidth / MaxWidth clamps, and drag-to-resize grippers</x:String>
                    <x:String>Column lifecycle — add, remove and hide TableViewColumn entries at run time</x:String>
                    <x:String>HeadersVisibility — None / Column</x:String>
                    <x:String>GridLinesVisibility — None / Horizontal / Vertical / All</x:String>
                    <x:String>Density — Compact / Standard / Comfortable</x:String>
                    <x:String>Tooltips — HeaderToolTip and per-cell CellToolTipBinding</x:String>
                    <x:String>Text wrapping with variable row heights</x:String>
                    <x:String>Empty state — EmptyTemplate shown when the source has no rows</x:String>
                    <x:String>Row virtualization — realizes only the visible rows, so large datasets scroll smoothly</x:String>
                    <x:String>Keyboard navigation and UI Automation peers for tables, rows, cells and headers</x:String>
                    <x:String>RTL flow — mirrored layout and resize gripper placement</x:String>
                    <x:String>Hierarchical rows from a parent key (ParentBy), composed with filter, sort, grouping and live shaping</x:String>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Explore the samples" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="One shortcut per feature page, in navigation order."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <VariableSizedWrapGrid
                    x:Name="ShortcutGrid"
                    AutomationProperties.Name="Sample pages"
                    Orientation="Horizontal"
                    ItemWidth="240"
                    ItemHeight="44"
                    Margin="0,4,0,0">
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Showcase" Tag="Showcase" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Showcase sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Task Manager" Tag="TaskManager" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Task Manager sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="File Explorer" Tag="FileExplorer" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the File Explorer sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="File properties" Tag="FileProperties" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the File properties sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Selection" Tag="Selection" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Selection sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Sorting" Tag="Sort" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Sorting sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Filtering" Tag="Filter" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Filtering sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Keyboard navigation" Tag="KeyboardNav" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Keyboard navigation and accessibility sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Column layout &amp; sizing" Tag="ColumnLayout" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Column layout and sizing sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Column lifecycle" Tag="ColumnLifecycle" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Column lifecycle sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Headers visibility" Tag="HeadersVisibility" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Headers visibility sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Tooltips" Tag="ToolTips" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Tooltips sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Grouped rows" Tag="Groups" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Grouped rows sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Hierarchy" Tag="Hierarchy" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Hierarchy page."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Grid lines visibility" Tag="GridLinesVisibility" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Grid lines visibility sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Text wrap + row height" Tag="TextWrap" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Text wrap and row height sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Cell templating" Tag="CellTemplating" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Cell templating sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Cell editing" Tag="CellEditing" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Cell editing sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Empty state" Tag="EmptyState" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Empty state sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Density" Tag="Density" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Density sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Right-to-left layout" Tag="RightToLeft" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Right-to-left layout sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Virtualization" Tag="Virtualization" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Virtualization sample."/>
                    <Button Style="{StaticResource HomeShortcutButtonStyle}" Content="Performance" Tag="Performance" Click="OnNavigateButtonClick" AutomationProperties.HelpText="Opens the Performance sample."/>
                </VariableSizedWrapGrid>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Customers" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="First-party Windows surfaces and third-party app developers that need a native WinUI 3 tabular control. Today these experiences render tables on a mix of legacy stacks (DirectUI, ComCtl) or a partial WinUI 3 migration."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <Border Style="{StaticResource TableHostBorderStyle}" HorizontalAlignment="Left" MaxWidth="640" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header row -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer" Padding="12,8"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Current UI framework" Padding="12,8"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File Explorer" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="WinUI 3, DirectUI and ComCtl" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Task Manager" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WinUI 3, DirectUI" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="File Properties dialog" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="ComCtl" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Third-party app developers" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="N/A" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Problem statement" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Windows' own data-table surfaces are split across DirectUI, ComCtl, and partial WinUI 3 — each app hand-builds and maintains its own table, and third-party developers have no first-party WinUI 3 option at all. TableView is the single native, accessible, virtualized tabular control these customers can share instead of reinventing one each."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Accessibility &amp; input" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Keyboard navigation (arrows, Tab, Enter, Esc, Home / End, Page Up / Down), Narrator support through the TableView, row, cell and header automation peers, and None / Single row selection out of the box."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Scales to large data" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Row virtualization realizes only the rows currently in view, so tens of thousands of rows scroll smoothly without holding every off-screen row's cell controls in memory. The Virtualization page shows it live."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Report an issue" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Found a bug or have feedback on TableView? File it in the public Microsoft UI XAML repository. Include the sample page name, repro steps, and the build (the About page shows the exact commit)."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <Button x:Name="ReportIssueButton"
                    Content="Report on GitHub"
                    HorizontalAlignment="Left"
                    Click="OnReportIssueClick"
                    AutomationProperties.AutomationId="HomeReportIssueButton"
                    AutomationProperties.Name="Report an issue on GitHub"
                    AutomationProperties.HelpText="Opens the public Microsoft UI XAML bug report template to log a TableView samples issue."
                    ToolTipService.ToolTip="Opens the public Microsoft UI XAML bug report template on GitHub."/>
                <TextBlock x:Name="ReportIssueFallbackText"
                    AutomationProperties.AutomationId="HomeReportIssueFallbackText"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="Collapsed"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    Style="{StaticResource SectionDescriptionTextStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
