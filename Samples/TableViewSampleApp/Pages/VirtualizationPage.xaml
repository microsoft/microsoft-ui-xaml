<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.VirtualizationPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <!-- Navigation cache stays disabled because this page can allocate 50,000 in-memory rows. -->
    <controls:SamplePresenter
        Header="Virtualization"
        Description="Bind tens of thousands of in-memory rows — the TableView realizes only the rows in the viewport, so memory and scroll responsiveness stay flat. Pick a dataset size below."
        SourceCaption="VirtualizationPage.xaml (excerpt)"
        SourceSnippet="Virtualization.xaml.txt"
        AdditionalSnippetCaption="VirtualizationPage.xaml.cs (excerpt)"
        AdditionalSnippet="Virtualization.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Bind tens of thousands of in-memory rows and scroll fast — the TableView realizes only the viewport rows, so memory and responsiveness stay flat."
                    MinHeight="104"/>

                <!-- The virtualized TableView. A fixed min-height gives the body a
                     real viewport so only the visible rows are realized. -->
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" Padding="0" VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="VirtualizationTable"
                        AutomationProperties.Name="Virtualized people"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableViewTextColumn Header="#"          Width="{StaticResource ColWidthId}"         Binding="{Binding Id}"         CanSort="False"/>
                        <tv:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}"  Binding="{Binding FirstName}"  CanSort="False"/>
                        <tv:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}"  Binding="{Binding LastName}"   CanSort="False"/>
                        <tv:TableViewTextColumn Header="Email"      Width="{StaticResource ColWidthEmail}"      Binding="{Binding Email}"      CanSort="False"/>
                        <tv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanSort="False"/>
                        <tv:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding Role}"       CanSort="False"/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Source and dataset" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Pick an in-memory dataset size. The table only realizes the rows you can see, so scrolling stays responsive even with tens of thousands of bound rows."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>

                <ComboBox
                    x:Name="SizeSelector"
                    AutomationProperties.AutomationId="SizeSelector"
                    Header="Row count (in-memory)"
                    SelectedIndex="2"
                    SelectionChanged="OnRowCountChanged"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="100"    Tag="100"/>
                    <ComboBoxItem Content="1,000"  Tag="1000"/>
                    <ComboBoxItem Content="10,000" Tag="10000"/>
                    <ComboBoxItem Content="50,000" Tag="50000"/>
                </ComboBox>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="Group the virtualized set to check that group headers are realized alongside rows: 'Realized rows' should keep tracking the viewport, not the group count. TableViewSource.GroupBy reshapes the same source in place."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ComboBox
                    x:Name="ShapingModeSelector"
                    AutomationProperties.AutomationId="ShapingModeSelector"
                    Header="Shaping mode"
                    SelectedIndex="0"
                    SelectionChanged="OnShapingModeChanged"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Flat" Tag="flat"/>
                    <ComboBoxItem Content="Grouped" Tag="grouped"/>
                    <!-- Hierarchical rows are not available in this release. The options are shown
                         disabled so the shape of the feature is visible; re-enable when the control
                         ships hierarchy support. No hierarchy API exists on TableView or
                         TableViewSource yet — TableViewRowInfo.h only reserves room for it — so the
                         code-behind stub in ApplyGrouping is prose, not a call. -->
                    <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False" ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                    <ComboBoxItem Content="Grouped hierarchy" Tag="groupedhierarchy" IsEnabled="False" ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                </ComboBox>
                <ComboBox
                    x:Name="GroupBySelector"
                    AutomationProperties.AutomationId="GroupBySelector"
                    Header="Group by"
                    SelectedIndex="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Available once the shaping mode is Grouped."
                    SelectionChanged="OnGroupByChanged"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role"       Tag="Role"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ExpandAllButton" AutomationProperties.AutomationId="ExpandAllButton" Content="Expand all" Click="OnExpandAllClick" IsEnabled="False" ToolTipService.ToolTip="Available once the shaping mode is Grouped."/>
                    <Button x:Name="CollapseAllButton" AutomationProperties.AutomationId="CollapseAllButton" Content="Collapse all" Click="OnCollapseAllClick" IsEnabled="False" ToolTipService.ToolTip="Available once the shaping mode is Grouped."/>
                </StackPanel>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source mode" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="0" Grid.Column="1" x:Name="SourceModeText" Text="In-memory" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SourceModeText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="1" Grid.Column="1" x:Name="TotalRowsText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TotalRowsText"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Realized rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="2" Grid.Column="1" x:Name="RealizedRowsText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="RealizedRowsText"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Realized share" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="3" Grid.Column="1" x:Name="RealizedShareText" Text="0%" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="RealizedShareText"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Peak realized" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="4" Grid.Column="1" x:Name="PeakRealizedText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="PeakRealizedText"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Row height" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="5" Grid.Column="1" x:Name="RowHeightText" Text="—" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="RowHeightText"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Selected rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="6" Grid.Column="1" x:Name="SelectedRowsText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SelectedRowsText"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Columns" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="7" Grid.Column="1" x:Name="ColumnCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ColumnCountText"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Grouped by" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="8" Grid.Column="1" x:Name="GroupedByText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="GroupedByText"/>
                </Grid>

                <muxc:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="How virtualization works here"
                    Message="The TableView pools row visuals: only the rows that fit the viewport are materialized, and off-screen rows are re-bound to new data items as you scroll. Watch 'Realized rows' stay flat while 'Total rows' grows into the tens of thousands — that gap is virtualization. 'Peak realized' shows the pool never grows with the data set."/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
