<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.VirtualizationPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:adv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Virtualization"
        Description="Bind tens of thousands of in-memory rows — the TableView realizes only the rows in the viewport, so memory and scroll responsiveness stay flat. Pick a dataset size below."
        SourceCaption="VirtualizationPage.xaml (excerpt)"
        SourceSnippet="Virtualization.xaml.txt"
        AdditionalSnippetCaption="VirtualizationPage.xaml.cs (excerpt)"
        AdditionalSnippet="Virtualization.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Bind tens of thousands of in-memory rows and scroll fast — the TableView realizes only the viewport rows, so memory and responsiveness stay flat."
                    MinHeight="104"/>

                <!-- The virtualized TableView. A fixed min-height gives the body a
                     real viewport so only the visible rows are realized. -->
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" Padding="0" VerticalAlignment="Stretch">
                    <adv:TableView
                        x:Name="PeopleTable"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <adv:TableViewTextColumn Header="#"          Width="{StaticResource ColWidthId}"         Binding="{Binding Id}"         CanSort="False"/>
                        <adv:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}"  Binding="{Binding FirstName}"  CanSort="False"/>
                        <adv:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}"  Binding="{Binding LastName}"   CanSort="False"/>
                        <adv:TableViewTextColumn Header="Email"      Width="{StaticResource ColWidthEmail}"      Binding="{Binding Email}"      CanSort="False"/>
                        <adv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanSort="False"/>
                        <adv:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding Role}"       CanSort="False"/>
                    </adv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Source and dataset" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Pick an in-memory dataset size. The table only realizes the rows you can see, so scrolling stays responsive even with tens of thousands of bound rows."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>

                <ComboBox
                    x:Name="SizeSelector"
                    AutomationProperties.AutomationId="SizeSelector"
                    Header="Row count (in-memory)"
                    SelectedIndex="2"
                    SelectionChanged="OnSizeChanged"
                    HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="100"    Tag="100"/>
                    <ComboBoxItem Content="1,000"  Tag="1000"/>
                    <ComboBoxItem Content="10,000" Tag="10000"/>
                    <ComboBoxItem Content="50,000" Tag="50000"/>
                </ComboBox>

                <TextBlock Text="Actions" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <StackPanel Spacing="8">
                    <Button x:Name="AutosizeButton" AutomationProperties.AutomationId="AutosizeButton" Content="Autosize columns" Click="OnAutosizeClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="RefreshButton" AutomationProperties.AutomationId="RefreshButton" Content="Refresh counts" Click="OnRefreshClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source mode" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SourceModeText" Text="In-memory" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SourceModeText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TotalRowsText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TotalRowsText"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Selected rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedRowsText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SelectedRowsText"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Columns" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ColumnCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ColumnCountText"/>
                </Grid>

                <muxc:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="How virtualization works here"
                    Message="The TableView pools row visuals: only the rows that fit the viewport are materialized, and off-screen rows are re-bound to new data items as you scroll, so 'Total rows' can grow into the tens of thousands without a matching visual memory cost."/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
