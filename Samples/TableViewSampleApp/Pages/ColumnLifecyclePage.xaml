<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.ColumnLifecyclePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Column lifecycle"
        Description="TableView.Columns is an observable vector of TableViewColumn objects, and every change to it shows up in the table at once. Add a column, remove it, move it left or right, or hide it with TableViewColumn.Visibility and show it again. A column keeps its own width, template and sort settings wherever it goes, because the same object is moved rather than rebuilt. Template columns such as the Active checkbox and the date picker go through exactly the same path as text columns, and grouping the rows underneath does not disturb any of it."
        Snippet="ColumnLifecycle"
        StretchExample="True"
        TryIt="Tick Shift to show the hidden column, then untick Salary. Pick Department in Column and press Move right twice. Press Add Join date column: a full date picker column appears at the end and the table scrolls sideways. Switch Shaping to Grouped and repeat: the columns and the group headers do not affect each other."
        WhatToLookFor="When a column moves, its width, template and sort setting move with it. A hidden column comes back in its old place. The Active checkbox and the date and time pickers keep their values through every move, because each cell is bound to the row, not to the column's position. The default columns fit the window; after Add Join date column the table scrolls sideways on purpose.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <!-- Template columns have no Binding: SortMemberPath names the value that orders the rows. -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="ColumnLifecycleTable"
                    AutomationProperties.Name="People with dynamic columns"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <tv:TableViewTemplateColumn x:Name="ColAvatar" Header="Photo" Width="{StaticResource ColWidthAvatar}"
                                                 CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                    <tv:TableViewTextColumn x:Name="ColName" Header="Name" Width="{StaticResource ColWidthShortName}"
                                             Binding="{Binding FullName}"/>
                    <tv:TableViewTemplateColumn x:Name="ColDepartment" Header="Department" Width="{StaticResource ColWidthChip}"
                                                 CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"/>
                    <tv:TableViewTextColumn x:Name="ColRole" Header="Role" Width="*" MinWidth="{StaticResource ColMinWidthStar}"
                                             Binding="{Binding Role}"/>
                    <tv:TableViewTextColumn x:Name="ColSalary" Header="Salary" Width="{StaticResource ColWidthNumber}"
                                             Binding="{Binding Salary, Converter={StaticResource SalaryTextConverter}}"/>
                    <tv:TableViewTemplateColumn x:Name="ColActive" Header="Active" Width="{StaticResource ColWidthBoolean}"
                                                 CellTemplate="{StaticResource ActiveCheckBoxTemplate}" SortMemberPath="IsActive"
                                                 HeaderToolTip="Whether the person is currently on staff. Editable."/>
                    <!-- Starts hidden: TableViewColumn.Visibility, not removal from the vector. -->
                    <tv:TableViewTemplateColumn x:Name="ColShift" Header="Shift" Width="{StaticResource ColWidthTimeCompact}"
                                                 CellTemplate="{StaticResource ShiftTimeCompactTemplate}" SortMemberPath="ShiftStart"
                                                 Visibility="Collapsed"
                                                 HeaderToolTip="Start of the daily shift, 24-hour clock. Editable."/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Column visibility"
                    Description="Each box sets TableViewColumn.Visibility. A hidden column stays in the Columns vector, so it comes back in the same place with the same width.">
                    <CheckBox x:Name="VisAvatarCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisPhotoCheckBox" Content="Photo" Tag="0" IsChecked="True" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                    <CheckBox x:Name="VisNameCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisNameCheckBox" Content="Name" Tag="1" IsChecked="True" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                    <CheckBox x:Name="VisDepartmentCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisDepartmentCheckBox" Content="Department" Tag="2" IsChecked="True" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                    <CheckBox x:Name="VisRoleCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisRoleCheckBox" Content="Role" Tag="3" IsChecked="True" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                    <CheckBox x:Name="VisSalaryCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisSalaryCheckBox" Content="Salary" Tag="4" IsChecked="True" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                    <CheckBox x:Name="VisActiveCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisActiveCheckBox" Content="Active" Tag="5" IsChecked="True" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                    <CheckBox x:Name="VisShiftCheckBox" AutomationProperties.AutomationId="ColumnLifecycleVisShiftCheckBox" Content="Shift" Tag="6" IsChecked="False" Checked="OnColumnToggle" Unchecked="OnColumnToggle"/>
                </controls:RailSection>

                <controls:RailSection
                    Header="Column order"
                    Description="Moving a column is RemoveAt plus Insert on TableView.Columns with the same instance. Add and Remove grow and shrink the vector with a template column built in code.">
                    <ComboBox
                        x:Name="ColumnPicker"
                        AutomationProperties.AutomationId="ColumnLifecycleColumnSelector"
                        Header="Column"
                        HorizontalAlignment="Stretch"/>
                    <StackPanel Spacing="8">
                        <Button x:Name="MoveLeftButton" AutomationProperties.AutomationId="ColumnLifecycleMoveLeftButton"
                                Content="Move left" Click="OnMoveLeftClick"
                                ToolTipService.ToolTip="Moves the chosen column one place left in TableView.Columns."
                                AutomationProperties.HelpText="Moves the chosen column one place left."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="MoveRightButton" AutomationProperties.AutomationId="ColumnLifecycleMoveRightButton"
                                Content="Move right" Click="OnMoveRightClick"
                                ToolTipService.ToolTip="Moves the chosen column one place right in TableView.Columns."
                                AutomationProperties.HelpText="Moves the chosen column one place right."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="AddJoinDateColumnButton" AutomationProperties.AutomationId="ColumnLifecycleAddJoinDateColumnButton"
                                Content="Add Join date column" Click="OnAddJoinDateColumnClick"
                                ToolTipService.ToolTip="Adds a full DatePicker template column (310 px) at the end. It sorts by JoinDate."
                                AutomationProperties.HelpText="Adds a Join date column with a date picker at the end."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="RemoveJoinDateColumnButton" AutomationProperties.AutomationId="ColumnLifecycleRemoveJoinDateColumnButton"
                                Content="Remove Join date column" Click="OnRemoveJoinDateColumnClick"
                                ToolTipService.ToolTip="Removes the Join date column from TableView.Columns."
                                AutomationProperties.HelpText="Removes the Join date column."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="ResetButton" AutomationProperties.AutomationId="ColumnLifecycleResetButton"
                                Content="Reset order and visibility" Click="OnResetClick"
                                ToolTipService.ToolTip="Puts the columns back in their starting order and visibility. Shift starts hidden."
                                AutomationProperties.HelpText="Puts the columns back in their starting order and visibility."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="ColumnLifecycle"
                    Description="Grouping changes the rows, never the columns, so a column you moved or hid stays that way. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="These change the rows while the columns stay as you arranged them; grouped, rows move between groups and groups appear and disappear. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button x:Name="MoveRowButton" AutomationProperties.AutomationId="ColumnLifecycleMoveRowButton"
                                Content="Move selected row to the next group" Click="OnMoveRowClick"
                                ToolTipService.ToolTip="Gives the selected person the next department, the next role, or the other Active value, depending on the group key. Grouped, the row moves to that existing group."
                                AutomationProperties.HelpText="Select a row first."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="AddPersonButton" AutomationProperties.AutomationId="ColumnLifecycleAddPersonButton"
                                Content="Add a person to the first group" Click="OnAddPersonClick"
                                ToolTipService.ToolTip="Adds a new person with the same group value as the first row, so grouped, the first group grows by one."
                                AutomationProperties.HelpText="Adds a new person with the same group value as the first row."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="RemoveRowButton" AutomationProperties.AutomationId="ColumnLifecycleRemoveRowButton"
                                Content="Remove the first row" Click="OnRemoveRowClick"
                                ToolTipService.ToolTip="Removes the first person in the collection; a group disappears with its last member."
                                AutomationProperties.HelpText="Removes the first person in the collection."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button x:Name="RestoreRowsButton" AutomationProperties.AutomationId="ColumnLifecycleRestoreRowsButton"
                                Content="Restore rows" Click="OnRestoreRowsClick"
                                ToolTipService.ToolTip="Reloads the original 40 people. The columns are left as they are."
                                AutomationProperties.HelpText="Reloads the original 40 people."
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="ColumnLifecycle">
                    <TextBlock x:Name="ColumnOrderText" controls:StatusPanel.Label="Columns" Text="-"/>
                    <TextBlock x:Name="HiddenColumnsText" controls:StatusPanel.Label="Hidden" Text="-"/>
                    <TextBlock x:Name="GroupCountText" controls:StatusPanel.Label="Groups" Text="-"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</pages:SamplePageBase>
