<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.PerformancePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:adv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <ScrollViewer Padding="{StaticResource PageContentMargin}">
        <Grid RowSpacing="16" HorizontalAlignment="Left" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:SamplePageHeader
                Grid.Row="0"
                Title="Performance scenarios"
                Description="Repeatable timing + memory measurements for the most common TableView workloads. Hover any Run button to see exactly what is measured. Click each Run to execute; the readout shows elapsed wall-clock ms."/>

            <muxc:InfoBar
                Grid.Row="1"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Try it"
                Message="Click each Run button to time that operation; the readout shows elapsed milliseconds. Run a scenario twice and use the second number — the first includes JIT warmup."/>

            <muxc:InfoBar
                Grid.Row="2"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="How these numbers are captured">
                <muxc:InfoBar.Content>
                    <ItemsControl Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <TextBlock TextWrapping="Wrap" Text="Each scenario:"/>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">1.</Run><Run Text=" builds the data into a List&lt;T&gt; OFF the clock"/></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">2.</Run><Run Text=" forces two GC passes to settle the heap"/></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">3.</Run><Run Text=" starts Stopwatch"/></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">4.</Run><Run Text=" reassigns / repopulates the bound ObservableCollection"/></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">5.</Run><Run Text=" calls TableView.UpdateLayout() to synchronously drain measure+arrange so the elapsed window covers the user-visible 'I see the new rows' moment"/></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">6.</Run><Run Text=" stops Stopwatch"/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Text="Memory snapshots use GC.GetTotalMemory(forceFullCollection: true) for managed heap (deterministic) PLUS Process.WorkingSet64 for OS view (lazy, but reflects unmanaged growth too). Hover any Run button below for the per-scenario specifics."/>
                    </ItemsControl>
                </muxc:InfoBar.Content>
            </muxc:InfoBar>

            <Border Grid.Row="3" Style="{StaticResource TableHostBorderStyle}" Padding="16">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Scenario" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Action" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Result" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Load 10,000 rows" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="Run" Click="OnLoad10kClick" AutomationProperties.AutomationId="Load10kButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="Measures: Clear() + 10,000 Add() events on the bound ObservableCollection + TableView.UpdateLayout(). Data is generated into a List&lt;T&gt; off the clock. Two GC passes precede the Stopwatch start."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="Load10kResult" Text="—" AutomationProperties.AutomationId="Load10kResult" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Load 100,000 rows" VerticalAlignment="Center"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="Run" Click="OnLoad100kClick" AutomationProperties.AutomationId="Load100kButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="Same as Load 10K but 100,000 rows. Stresses the ItemsRepeater realization budget under heavier collection-change pressure. With virtualization, only the visible viewport realizes — most of the cost is the CollectionChanged event marshalling, not UI."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="Load100kResult" Text="—" AutomationProperties.AutomationId="Load100kResult" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sort current dataset by Name asc" VerticalAlignment="Center"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="Run" Click="OnSortClick" AutomationProperties.AutomationId="SortButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="LINQ OrderBy runs off the clock (pure C# cost — not what we are measuring). On the clock: Clear() + Add() each sorted row + UpdateLayout(). Mirrors 'user clicked a header, the sort key is already computed, now repopulate'."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SortResult" Text="—" AutomationProperties.AutomationId="SortResult" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Filter current dataset (Salary 100k+)" VerticalAlignment="Center"/>
                    <Button Grid.Row="4" Grid.Column="1" Content="Run" Click="OnFilterClick" AutomationProperties.AutomationId="FilterButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="LINQ Where runs off the clock. On the clock: Clear() + Add() each matching row + UpdateLayout(). Result shows matched/total rows so you can tell how heavy the predicate filtered."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="FilterResult" Text="—" AutomationProperties.AutomationId="FilterResult" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Clear filter (restore full dataset)" VerticalAlignment="Center"/>
                    <Button Grid.Row="5" Grid.Column="1" Content="Run" Click="OnClearFilterClick" AutomationProperties.AutomationId="ClearFilterButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="Reverses the Filter: re-binds the full dataset. Useful for comparing 'large -> small' vs 'small -> large' transition cost; the ItemsRepeater realization budget differs."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="5" Grid.Column="2" x:Name="ClearFilterResult" Text="—" AutomationProperties.AutomationId="ClearFilterResult" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Snapshot memory (delta from baseline)" VerticalAlignment="Center"/>
                    <Button Grid.Row="6" Grid.Column="1" Content="Snapshot" Click="OnSnapshotClick" AutomationProperties.AutomationId="SnapshotButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="Forces two GC passes, then reads GC.GetTotalMemory(forceFullCollection: true) for managed heap (deterministic) AND Process.WorkingSet64 for the OS view (lazy; reflects unmanaged growth like XAML composition surfaces). Delta is from the baseline captured when the page first loaded; click Re-baseline to reset."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="6" Grid.Column="2" x:Name="SnapshotResult" Text="—" AutomationProperties.AutomationId="SnapshotResult" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Re-baseline memory" VerticalAlignment="Center"/>
                    <Button Grid.Row="7" Grid.Column="1" Content="Re-baseline" Click="OnRebaselineClick" AutomationProperties.AutomationId="RebaselineButton" HorizontalAlignment="Stretch">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="Re-captures the WorkingSet + managed heap baseline. Use this AFTER you have completed a Load scenario, to measure incremental growth from subsequent operations."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="(click Snapshot to see deltas from the current baseline)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Run all (sequential)" VerticalAlignment="Center"/>
                    <Button Grid.Row="8" Grid.Column="1" Content="Run all" Click="OnRunAllClick" AutomationProperties.AutomationId="RunAllButton" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}">
                        <ToolTipService.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                Text="Runs Load 10K, Load 100K, Sort, Filter, Clear, and Snapshot in sequence on the UI thread. Each step uses its own GC settle pass. Per-row readouts show individual timings; the bottom-right summary confirms completion and which build flavor produced the numbers."/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <TextBlock Grid.Row="8" Grid.Column="2" x:Name="RunAllResult" Text="—" AutomationProperties.AutomationId="RunAllResult" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock Text="Live data preview" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="The TableView below binds to the scenario's working dataset. After Load 100K + Filter, the row count drops to the filtered subset; after Sort, the order changes visibly. Scroll fast — virtualization keeps memory flat after the load."
                    Style="{StaticResource SectionDescriptionTextStyle}"/>
                <Border Style="{StaticResource TableHostBorderStyle}">
                    <adv:TableView
                        x:Name="PerfTable"
                        AutomationProperties.AutomationId="PerfTable"
                        SelectionMode="Single"
                        Height="320">
                        <adv:TableViewTextColumn Header="Id"         Width="{StaticResource ColWidthId}"  Binding="{Binding Id}"     SortMemberPath="Id" CanSort="False"/>
                        <adv:TableViewTextColumn Header="Name"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Name}"   SortMemberPath="Name" CanSort="False"/>
                        <adv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" SortMemberPath="Department" CanSort="False"/>
                        <adv:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" SortMemberPath="Salary" CanSort="False"/>
                    </adv:TableView>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="8">
                <TextBlock Text="What this page is NOT" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="This is a partner-share triage tool, not a benchmark. For production-grade numbers use WPR / WPA traces around the ItemsRepeater and TableView ETW providers; the readouts here are wall-clock and include UI-thread layout, which is the right shape for 'is this responsive?' but the wrong shape for 'what is the per-row arrange cost?'. For per-row cost, instrument TableViewRow.MeasureOverride with an ETW event and aggregate across thousands of rows."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
