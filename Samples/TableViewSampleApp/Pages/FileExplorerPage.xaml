<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.FileExplorerPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:adv="using:Microsoft.UI.Xaml.Controls.Tabular"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,8,0">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="14"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        MinWidth="40"
                        IsEnabled="False"
                        Click="OnBackClick"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>

                <Button x:Name="UpButton"
                        Grid.Column="1"
                        MinWidth="40"
                        Click="OnUpClick"
                        ToolTipService.ToolTip="Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                </Button>

                <TextBox x:Name="AddressBar"
                         Grid.Column="2"
                         PlaceholderText="Enter a folder path"
                         IsSpellCheckEnabled="False"
                         KeyDown="OnAddressBarKeyDown"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        MinWidth="40"
                        Click="OnRefreshClick"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
            <adv:TableView
                x:Name="FileTable"
                AutomationProperties.AutomationId="FileExplorerTable"
                SelectionMode="Single"
                Sorted="OnTableSorted"
                SelectionChanged="OnSelectionChanged"
                DoubleTapped="OnRowDoubleTapped"
                MinHeight="420"
                VerticalAlignment="Stretch">
                <adv:TableViewTemplateColumn Header="Name" CellTemplate="{StaticResource NameCellTemplate}" MinWidth="260" Width="*" CanSort="True" SortMemberPath="Name"/>
                <adv:TableViewTextColumn Header="Type" Width="180" SortMemberPath="TypeDisplay" Binding="{Binding TypeDisplay}"/>
                <adv:TableViewTextColumn Header="Date modified" Width="170" SortMemberPath="DateModified" Binding="{Binding DateModifiedDisplay}"/>
                <adv:TableViewTextColumn Header="Size" Width="110" SortMemberPath="Size" Binding="{Binding SizeDisplay}"/>
            </adv:TableView>
        </Border>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16,6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SelectionText" Grid.Column="1" Text="0 selected (0 bytes)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
