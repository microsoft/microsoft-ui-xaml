<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.TextWrapPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:models="using:TableViewSampleApp.Models"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- snippet -->
        <!-- The Bio cell. Wrapping, trimming and the line limit come from the page's static
             WrapState, so every realized cell, including recycled ones, follows the rail. The
             TextBlock carries the bio as its accessible name, so the cell has a value in UIA. -->
        <DataTemplate x:Key="BioTemplate" x:DataType="models:Person">
            <TextBlock
                Text="{x:Bind Bio, Mode=OneWay}"
                TextWrapping="{x:Bind pages:TextWrapPage.WrapState.TextWrapping, Mode=OneWay}"
                TextTrimming="{x:Bind pages:TextWrapPage.WrapState.TextTrimming, Mode=OneWay}"
                MaxLines="{x:Bind pages:TextWrapPage.WrapState.MaxLines, Mode=OneWay}"
                Margin="8,6"
                VerticalAlignment="Center"
                SizeChanged="OnBioSizeChanged"
                AutomationProperties.Name="{x:Bind Bio, Mode=OneWay}"/>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Text wrap + row height"
        Description="A TableViewTemplateColumn can host a wrapping TextBlock, and TableView measures each row to its tallest cell, so rows with long bios grow while short ones stay compact. Toggle TextWrapping, narrow the Bio column or clamp the text with MaxLines, and the Status readout reports the distinct row heights that result. Grouping shows that group header bands keep their own height while the rows around them vary."
        Snippet="TextWrap"
        StretchExample="True"
        TryIt="Drag the Bio column width slider down and watch long bios wrap onto more lines and their rows grow. Pick 2 lines under Max lines to clamp them, then turn wrapping off. Select a row and use Lengthen selected bio to grow one row on its own."
        WhatToLookFor="Row heights is the list of distinct heights among the realized rows: one value means every row is the same height. With wrapping on it shows several, and narrowing the column adds taller ones. With Max lines set, no row grows past that many lines, and with NoWrap every row collapses to one height. Group header bands do not change height with the rows.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="TextWrapTable"
                    AutomationProperties.Name="People with wrapped bios"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    IsReadOnly="True"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                    <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}"/>
                    <tv:TableViewTemplateColumn x:Name="BioColumn" Header="Bio" Width="{StaticResource ColWidthWrappedText}" CellTemplate="{StaticResource BioTemplate}" SortMemberPath="Bio"/>
                    <tv:TableViewTemplateColumn Header="Department" Width="{StaticResource ColWidthChip}" CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Wrapping"
                    Description="Switches the Bio TextBlock between TextWrapping Wrap and NoWrap, and clamps wrapped text with TextBlock.MaxLines plus an ellipsis.">
                    <!-- snippet -->
                    <ToggleSwitch
                        x:Name="WrapToggle"
                        AutomationProperties.AutomationId="TextWrapToggle"
                        Header="TextWrapping"
                        IsOn="True"
                        OnContent="Wrap"
                        OffContent="NoWrap"
                        Toggled="OnWrapToggled"/>
                    <!-- Disabled by ApplyTextState while TextWrapping is NoWrap, where MaxLines is a no-op. -->
                    <ComboBox
                        x:Name="MaxLinesSelector"
                        AutomationProperties.AutomationId="TextWrapMaxLinesSelector"
                        Header="Max lines"
                        SelectedIndex="0"
                        SelectionChanged="OnMaxLinesChanged"
                        AutomationProperties.HelpText="Applies only while TextWrapping is Wrap."
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Unlimited" Tag="0"/>
                        <ComboBoxItem Content="2 lines + ellipsis" Tag="2"/>
                        <ComboBoxItem Content="3 lines + ellipsis" Tag="3"/>
                    </ComboBox>
                    <!-- /snippet -->
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               Text="Max lines applies only while TextWrapping is Wrap, so it is disabled for NoWrap: a single unwrapped line has nothing to clamp."/>
                </controls:RailSection>

                <controls:RailSection
                    Header="Bio column width"
                    Description="Sets the Bio column's Width. A narrower column wraps each bio onto more lines, so its row grows; a wider one lets rows shrink again.">
                    <!-- snippet -->
                    <Slider
                        x:Name="BioWidthSlider"
                        AutomationProperties.AutomationId="TextWrapBioWidthSlider"
                        AutomationProperties.Name="Bio column width"
                        Minimum="220"
                        Maximum="520"
                        StepFrequency="20"
                        Value="360"
                        ValueChanged="OnBioWidthChanged"/>
                    <!-- /snippet -->
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="TextWrap"
                    Description="Grouped puts fixed-height group header bands between rows whose height follows their bios. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Office" Tag="Office"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Changing a bio re-measures only the rows it touches, and scrolling realizes rows that were never measured before. Watch the table and the Row heights and Last action readouts. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="LengthenBioButton"
                            AutomationProperties.AutomationId="TextWrapLengthenBioButton"
                            Content="Lengthen selected bio"
                            Click="OnLengthenBioClick"
                            ToolTipService.ToolTip="Adds a sentence to the selected person's bio; that row grows while its neighbours keep their height."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ShortenBioButton"
                            AutomationProperties.AutomationId="TextWrapShortenBioButton"
                            Content="Shorten selected bio"
                            Click="OnShortenBioClick"
                            ToolTipService.ToolTip="Cuts the selected person's bio to its first sentence; that row shrinks."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="OneLineBiosButton"
                            AutomationProperties.AutomationId="TextWrapOneLineBiosButton"
                            Content="Set all bios to one sentence"
                            Click="OnOneLineBiosClick"
                            ToolTipService.ToolTip="Cuts every bio to its first sentence; most rows return to a single line."
                            AutomationProperties.HelpText="Cuts every bio to its first sentence; most rows return to a single line."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RestoreBiosButton"
                            AutomationProperties.AutomationId="TextWrapRestoreBiosButton"
                            Content="Restore bios"
                            Click="OnRestoreBiosClick"
                            ToolTipService.ToolTip="Puts every bio back to its original text."
                            AutomationProperties.HelpText="Puts every bio back to its original text."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ScrollToLastButton"
                            AutomationProperties.AutomationId="TextWrapScrollToLastButton"
                            Content="Scroll to last row"
                            Click="OnScrollToLastClick"
                            ToolTipService.ToolTip="Scrolls the table body to the end; the last row is fully visible at its measured height."
                            AutomationProperties.HelpText="Scrolls the table body to the end; the last row is fully visible at its measured height."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="TextWrap">
                    <TextBlock x:Name="WrappingText" controls:StatusPanel.Label="Wrapping" Text="Wrap"/>
                    <TextBlock x:Name="BioWidthText" controls:StatusPanel.Label="Bio width" Text="360 px"/>
                    <TextBlock x:Name="MaxLinesText" controls:StatusPanel.Label="Max lines" Text="Unlimited"/>
                    <TextBlock x:Name="RowHeightsText" controls:StatusPanel.Label="Row heights" Text="(measuring)" AutomationProperties.LiveSetting="Off"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
