<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.FilterPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:system="using:System"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- snippet -->
        <!-- MaxWidth: the row area measures at infinite width, so uncapped text lays out as one wide line. -->
        <DataTemplate x:Key="FilterEmptyTemplate" x:DataType="system:Object">
            <StackPanel Spacing="4" Padding="24" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No rows match the filter" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                <TextBlock
                    Text="The underlying collection is untouched. Clear the filter to bring every row back."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Filtering"
        Description="TableViewSource.Filter(predicate) narrows the rows the table shows without touching the collection, and ClearFilter() brings them back. The query and Active only form one predicate on the same source that grouping uses, so a filtered, grouped view is one projection. Retype a Role or clear an Active box and the row can leave the view, because the page applies the filter again after each edit."
        Snippet="Filter"
        StretchExample="True"
        TryIt="Type eng in Query, then switch Shaping mode to Grouped: the filter and the grouping apply together. Select a row and choose Mutate selected row out of the filter. Choose Filter to zero matches to see the EmptyTemplate, then Clear filter."
        WhatToLookFor="The predicate runs when Filter is called, not on every property change, so the page calls Filter again after an edit: the row then leaves or rejoins the view without the source being rebuilt. The control keeps the selection across a query change while the selected row still matches. Grouped, a group with no matching rows is not shown at all, and the header counts are the filtered counts.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <!-- Columns are added in code: see BuildColumns. -->
                <tv:TableView
                    x:Name="FilterTable"
                    AutomationProperties.AutomationId="FilterTable"
                    AutomationProperties.Name="Filtered people"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    SelectionChanged="OnTableSelectionChanged"
                    EmptyTemplate="{StaticResource FilterEmptyTemplate}"
                    VerticalAlignment="Stretch"
                    MinHeight="320"/>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <!-- snippet -->
                <controls:RailSection
                    IsFirst="True"
                    Header="Filter"
                    Description="The query and the Active only switch combine into one predicate handed to TableViewSource.Filter. Clearing both calls ClearFilter(); the source instance never changes.">
                    <TextBox
                        x:Name="SearchBox"
                        AutomationProperties.AutomationId="FilterQueryBox"
                        Header="Query"
                        PlaceholderText="Name, department, role or email"
                        TextChanged="OnSearchChanged"
                        HorizontalAlignment="Stretch"/>
                    <ToggleSwitch
                        x:Name="ActiveOnlyToggle"
                        AutomationProperties.AutomationId="FilterActiveOnlyToggle"
                        Header="Active only"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="OnActiveToggled"/>
                </controls:RailSection>
                <!-- /snippet -->

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="Filter"
                    Description="Grouping applies to the filtered rows, so only groups with a match appear and their counts are the filtered counts. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Each action changes the predicate or a row's values, then applies the filter again: rows leave and rejoin the view, and an empty result shows the EmptyTemplate. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="NoMatchButton"
                            AutomationProperties.AutomationId="FilterNoMatchButton"
                            Content="Filter to zero matches"
                            Click="OnNoMatchClick"
                            ToolTipService.ToolTip="Types a query no row matches, so the EmptyTemplate appears."
                            AutomationProperties.HelpText="Types a query no row matches, so the EmptyTemplate appears."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ClearFilterButton"
                            AutomationProperties.AutomationId="FilterClearFilterButton"
                            Content="Clear filter"
                            Click="OnClearFilterClick"
                            ToolTipService.ToolTip="Clears the query and Active only, then calls ClearFilter(): every row is back."
                            AutomationProperties.HelpText="Clears the query and Active only, then calls ClearFilter()."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="MutateOutButton"
                            AutomationProperties.AutomationId="FilterMutateOutButton"
                            Content="Mutate selected row out of the filter"
                            Click="OnMutateOutClick"
                            ToolTipService.ToolTip="Changes the selected person's Active state, department or role so they stop matching; the row leaves the view."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="MoveGroupButton"
                            AutomationProperties.AutomationId="FilterMoveGroupButton"
                            Content="Move selected row to another group"
                            Click="OnMoveGroupClick"
                            ToolTipService.ToolTip="Changes the selected person's group-key value to the next real one; grouped, the row moves to that group and stays selected."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Filter">
                    <TextBlock x:Name="FilterStateText" controls:StatusPanel.Label="Filter" Text="(none)"/>
                    <TextBlock x:Name="SelectedItemText" controls:StatusPanel.Label="Selected" Text="(none)"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
