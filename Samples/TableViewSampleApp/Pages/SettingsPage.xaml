<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TableViewSampleApp.Pages.SettingsPage" NavigationCacheMode="Disabled" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:TableViewSampleApp.Controls">
    <Page.Resources>
        <!--
            Note: the Tabular POC used CommunityToolkit's toolkit:SettingsCard /
            SettingsExpander. That package is not referenced by this gallery (and the
            build owns the csproj), so the SettingsCard look is reproduced below with
            the sample's own TableHostBorderStyle + a FontIcon / Header / Description /
            control grid. Same visual rhythm, no new dependency.
        -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    </Page.Resources>

    <ScrollViewer VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource PageContentMargin}">
            <StackPanel HorizontalAlignment="Left"
                        MaxWidth="{StaticResource PageMaxContentWidth}"
                        Spacing="{StaticResource SettingsCardSpacing}">

                <controls:SamplePageHeader
                    Title="Theme &amp; settings"
                    Description="Choose how the app renders. Your theme choice persists across launches in a small text file under %LocalAppData%\TableViewSampleApp."/>

                <!-- Appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextStyle}" Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2"/>
                <Border Style="{StaticResource TableHostBorderStyle}" Padding="16,12">
                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="App theme" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Select which app theme to display." Style="{StaticResource SectionDescriptionTextStyle}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  x:Name="ThemeModeCombo"
                                  MinWidth="160"
                                  AutomationProperties.AutomationId="ThemeModeCombo"
                                  AutomationProperties.Name="App theme"
                                  SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem x:Name="ThemeItemLight"
                                          AutomationProperties.AutomationId="ThemeItemLight"
                                          Content="Light"
                                          Tag="Light"/>
                            <ComboBoxItem x:Name="ThemeItemDark"
                                          AutomationProperties.AutomationId="ThemeItemDark"
                                          Content="Dark"
                                          Tag="Dark"/>
                            <ComboBoxItem x:Name="ThemeItemSystem"
                                          AutomationProperties.AutomationId="ThemeItemSystem"
                                          Content="Use system setting"
                                          Tag="Default"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Text="Windows contrast themes"
                           Style="{StaticResource SectionHeaderTextStyle}" Margin="1,24,0,6"
                           TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2"/>
                <Border Style="{StaticResource TableHostBorderStyle}" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Real contrast themes — not the app's Light / Dark"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level3"/>
                        <TextBlock Text="1. Set App theme to &quot;Use system setting&quot; above. The title-bar theme button only cycles the app's Use system setting / Light / Dark appearance; it does not enable a Windows contrast theme."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="2. Open Windows Settings (Win+I) → Accessibility → Contrast themes, choose a contrast theme, and select Apply. Make this Windows change manually; this app does not change system settings."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="3. Return to the gallery and inspect ordinary, selected, keyboard-focused, and disabled table states against the actual Windows palette. A Light / Dark pass is not a contrast-theme pass."
                                   TextWrapping="Wrap"/>
                        <Button Content="Refresh Windows state" Click="OnRefreshWindowsStateClick"
                                AutomationProperties.AutomationId="SettingsRefreshContrastState"
                                AutomationProperties.Name="Refresh Windows contrast state"
                                HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ContrastStatusText" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SettingsContrastState"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <TextBlock Text="Storage" Style="{StaticResource SectionHeaderTextStyle}" Margin="1,24,0,6" AutomationProperties.HeadingLevel="Level2"/>
                <Border x:Name="StorageCard"
                        AutomationProperties.AutomationId="StorageCard"
                        Style="{StaticResource TableHostBorderStyle}"
                        Padding="16,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Theme setting" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Persisted as plain text. Delete the file to reset to system default." Style="{StaticResource SectionDescriptionTextStyle}"/>
                            <TextBlock x:Name="StoragePathText"
                                       AutomationProperties.AutomationId="StoragePathText"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
