<?xml version="1.0" encoding="utf-8"?>
<!--
    Headers visibility: TableView.HeadersVisibility (Column / None) on a support-ticket queue, how
    the hidden header strip interacts with group headers, and sorting from code while there is no
    header to click. The page holds only that behaviour: the table, its ticket templates, the
    Headers visibility section and the Actions. Try it / What to look for are presenter
    attributes; Shaping and Status are the shared ShapingOptions / StatusPanel controls (see
    Pages\SamplePageBase.cs).
-->
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.HeadersVisibilityPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:models="using:TableViewSampleApp.Models"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:converters="using:TableViewSampleApp.Converters"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- Page-private templates: SupportTicket is not Person, so the shared Person templates do
             not apply. Each editor carries a per-row name, because with the headers hidden that
             name is the only column context a screen reader announces. -->
        <DataTemplate x:Key="AssigneeTemplate" x:DataType="models:SupportTicket">
            <PersonPicture
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsTabStop="False"
                DisplayName="{x:Bind Assignee, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind AssigneeAutomationName, Mode=OneWay}"/>
        </DataTemplate>

        <!-- The chip brushes come from Converters\TicketConverters.cs (TicketChipPalette). -->
        <DataTemplate x:Key="PriorityChipTemplate" x:DataType="models:SupportTicket">
            <Border
                CornerRadius="10"
                Padding="8,2"
                Margin="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{x:Bind converters:TicketChipPalette.PriorityTint(Priority), Mode=OneWay}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                AutomationProperties.AccessibilityView="Raw">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{x:Bind converters:TicketChipPalette.PriorityDot(Priority), Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock
                        Text="{x:Bind Priority, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Priority, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- snippet -->
        <!-- With the headers hidden, each editor's own name is the only column context a screen
             reader announces, so every editor carries a per-row accessible name. -->
        <DataTemplate x:Key="DueDateTemplate" x:DataType="models:SupportTicket">
            <CalendarDatePicker
                Date="{x:Bind DueOrNull, Mode=TwoWay}"
                DateFormat="{}{day.integer} {month.abbreviated} {year.full}"
                Margin="6,2"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind DueAutomationName, Mode=OneWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="ResolvedTemplate" x:DataType="models:SupportTicket">
            <CheckBox
                IsChecked="{x:Bind IsResolved, Mode=TwoWay}"
                MinWidth="0"
                Margin="14,2"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                AutomationProperties.Name="{x:Bind ResolvedAutomationName, Mode=OneWay}"/>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Headers visibility"
        Description="TableView.HeadersVisibility shows the column header strip (Column) or hides it (None). This page uses a support-ticket queue rather than people because its columns, a priority chip, a due date and a Resolved checkbox, are hard to read without their headers, which is the trade-off the property makes. Group headers are a separate surface, so they stay when the column headers are hidden. Sorting also keeps working: TableView.SortByColumn orders the rows from code even when there is no header to click."
        Snippet="HeadersVisibility"
        StretchExample="True"
        TryIt="Set Headers to None and try to tell what the chip, the date and the checkbox mean. Then click Sort by due date: the rows still re-order with no header to click. Switch Shaping to Grouped and hide the headers again; the group header bands stay."
        WhatToLookFor="With the headers hidden, Narrator still announces &quot;Due date for INC-1042&quot; and &quot;Resolved for INC-1042&quot;, because each editor carries its own name; plain text cells lose their column context. Group header bands and their chevrons stay, and Sort by due date still re-orders the rows while there is no header to click.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="TicketsTable"
                    AutomationProperties.AutomationId="HeadersVisibilityTable"
                    AutomationProperties.Name="Support tickets"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    IsReadOnly="True"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <!-- IsReadOnly gates the built-in text editors only; the Due and Resolved
                         template editors stay editable. -->
                    <tv:TableViewTextColumn Header="Ticket" Width="{StaticResource ColWidthId}" Binding="{Binding TicketId}" HeaderToolTip="Incident number, unique per ticket."/>
                    <tv:TableViewTemplateColumn Header="Assignee" Width="{StaticResource ColWidthNumber}" CellTemplate="{StaticResource AssigneeTemplate}" SortMemberPath="Assignee" CellToolTipBinding="{Binding Assignee}" HeaderToolTip="Initials of the person who owns the ticket. Hover for the full name."/>
                    <tv:TableViewTextColumn Header="Summary" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding Summary}" CellToolTipBinding="{Binding Summary}"/>
                    <tv:TableViewTemplateColumn Header="Priority" Width="{StaticResource ColWidthNumber}" CellTemplate="{StaticResource PriorityChipTemplate}" SortMemberPath="Priority" HeaderToolTip="Urgency: Sev 1 is the most urgent."/>
                    <tv:TableViewTemplateColumn x:Name="DueColumn" Header="Due" Width="{StaticResource ColWidthCalendarDate}" CellTemplate="{StaticResource DueDateTemplate}" SortMemberPath="Due" HeaderToolTip="Date the ticket breaches its service-level agreement. Editable."/>
                    <tv:TableViewTemplateColumn Header="Resolved" Width="{StaticResource ColWidthBooleanWide}" CellTemplate="{StaticResource ResolvedTemplate}" SortMemberPath="IsResolved" HeaderToolTip="Checked once the ticket is closed. Editable."/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Headers visibility"
                    Description="Sets TableView.HeadersVisibility. Column shows the header strip; None hides it, and with it header-click sorting, resizing and the header tooltips.">
                    <!-- snippet -->
                    <ComboBox
                        x:Name="HeadersVisibilitySelector"
                        AutomationProperties.AutomationId="HeadersVisibilityHeadersVisibilitySelector"
                        Header="Headers"
                        SelectedIndex="0"
                        SelectionChanged="OnHeadersVisibilityChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Column" Tag="Column"/>
                        <ComboBoxItem Content="None" Tag="None"/>
                    </ComboBox>
                    <!-- /snippet -->
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="HeadersVisibility"
                    Description="Grouped shows that group headers are not column headers: HeadersVisibility None leaves them in place. TableViewSource.GroupBy reshapes the same source in place, so sort, selection and scroll survive.">
                    <ComboBoxItem Content="Queue" Tag="Queue"/>
                    <ComboBoxItem Content="Priority" Tag="Priority"/>
                    <ComboBoxItem Content="Assignee" Tag="Assignee"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="These actions work the queue the way a support lead would, with the headers shown or hidden. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="SortByDueButton"
                            AutomationProperties.AutomationId="HeadersVisibilitySortByDueButton"
                            Content="Sort by due date"
                            Click="OnSortByDueClick"
                            ToolTipService.ToolTip="Calls TableView.SortByColumn on the Due column; a second click reverses the order. Works with the headers hidden."
                            AutomationProperties.HelpText="Calls TableView.SortByColumn on the Due column; a second click reverses the order. Works with the headers hidden."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ClearSortButton"
                            AutomationProperties.AutomationId="HeadersVisibilityClearSortButton"
                            Content="Clear sort"
                            Click="OnClearSortClick"
                            ToolTipService.ToolTip="Calls TableView.ClearSort; the rows return to the order they were filed in."
                            AutomationProperties.HelpText="Calls TableView.ClearSort; the rows return to the order they were filed in."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="EscalateButton"
                            AutomationProperties.AutomationId="HeadersVisibilityEscalateButton"
                            Content="Escalate selected ticket"
                            Click="OnEscalateClick"
                            ToolTipService.ToolTip="Raises the selected ticket one severity level, up to Sev 1. Grouped by Priority, the row moves to its new group."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="FileTicketButton"
                            AutomationProperties.AutomationId="HeadersVisibilityFileTicketButton"
                            Content="File a new ticket"
                            Click="OnFileTicketClick"
                            ToolTipService.ToolTip="Adds a Sev 2 ticket to the queue; grouped, it joins its queue's group."
                            AutomationProperties.HelpText="Adds a Sev 2 ticket to the queue; grouped, it joins its queue's group."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="CloseTicketButton"
                            AutomationProperties.AutomationId="HeadersVisibilityCloseTicketButton"
                            Content="Close selected ticket"
                            Click="OnCloseTicketClick"
                            ToolTipService.ToolTip="Removes the selected ticket. Grouped, its group disappears when it was the last member."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="HeadersVisibility">
                    <TextBlock x:Name="HeadersText" controls:StatusPanel.Label="Headers" Text="Column"/>
                    <TextBlock x:Name="SortText" controls:StatusPanel.Label="Sort" Text="None"/>
                    <TextBlock x:Name="ResolvedCountText" controls:StatusPanel.Label="Resolved" Text="0 of 0"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
