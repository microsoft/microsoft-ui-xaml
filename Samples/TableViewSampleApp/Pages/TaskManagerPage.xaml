<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.TaskManagerPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:models="using:TableViewSampleApp.Models"
    xmlns:local="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:RowAutomationNameConverter x:Key="RowAutomationNameConverter"/>

        <DataTemplate x:Key="NameCellTemplate" x:DataType="models:ProcessItem">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,8,0">
                <!-- No <Image Source="{x:Bind IconPath}"/> here. ProcessItem.IconPath is never
                     assigned by the sample data, and x:Bind of an EMPTY string to Image.Source
                     throws while the generated Bindings_Update runs, which aborts the rest of the
                     template's bindings - that is what left this whole column blank. Rows are
                     identified by their glyph instead. -->
                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="14" Visibility="{x:Bind HasGlyph, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatusCellTemplate" x:DataType="models:ProcessItem">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasStatusText, Mode=OneWay}"/>
                <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsEfficiencyMode, Mode=OneWay}" AutomationProperties.Name="{Binding Name, Converter={StaticResource RowAutomationNameConverter}, ConverterParameter='Efficiency mode for {0}'}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CpuCellTemplate" x:DataType="models:ProcessItem">
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border Background="{x:Bind CpuBackground, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="8,4" CornerRadius="0">
                    <TextBlock Text="{x:Bind CpuDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MemoryCellTemplate" x:DataType="models:ProcessItem">
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border Background="{x:Bind MemoryBackground, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="8,4" CornerRadius="0">
                    <TextBlock Text="{x:Bind MemoryDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiskCellTemplate" x:DataType="models:ProcessItem">
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border Background="{x:Bind DiskBackground, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="8,4" CornerRadius="0">
                    <TextBlock Text="{x:Bind DiskDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NetworkCellTemplate" x:DataType="models:ProcessItem">
            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border Background="{x:Bind NetworkBackground, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="8,4" CornerRadius="0">
                    <TextBlock Text="{x:Bind NetworkDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Task Manager"
        Description="A Task Manager-style process dashboard with template columns, sortable telemetry, live heat-map cells, search filtering, and light/dark theme support."
        SourceCaption="TaskManagerPage.xaml (excerpt)"
        SourceSnippet="TaskManager.xaml.txt"
        AdditionalSnippetCaption="TaskManagerPage.xaml.cs (excerpt)"
        AdditionalSnippet="TaskManager.cs.txt"
        StretchExample="True">
        <controls:SamplePresenter.Example>
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Processes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- The old "Grouped by category" / "Flat list" ComboBox lived here and was dead:
                         its handler ran `if (mode == 0) { }`. The real four-option Shaping selector
                         is in the Options rail and actually calls TableViewSource.GroupBy. -->
                </StackPanel>

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="1"
                                PlaceholderText="Type a name, publisher, or PID to search"
                                QueryIcon="Find"
                                TextChanged="OnSearchBoxTextChanged"
                                MinWidth="140"
                                MaxWidth="380"
                                AutomationProperties.Name="Process search"
                                Margin="12,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch x:Name="ThemeToggle"
                                  Header="Dark"
                                  OnContent=""
                                  OffContent=""
                                  Toggled="OnThemeToggled"
                                  VerticalAlignment="Center"
                                  MinWidth="0"/>
                    <Button Content="Run new task" Click="OnAddProcessClick" AutomationProperties.AutomationId="TaskManagerRunNewTaskButton" AutomationProperties.HelpText="Adds a new process row to the Apps category." ToolTipService.ToolTip="Adds a new process row to the Apps category - the add-a-row-to-a-group action."/>
                    <Button Content="End task" Click="OnEndTaskClick" AutomationProperties.AutomationId="TaskManagerEndTaskButton" AutomationProperties.HelpText="Removes the selected process from the sample process list."/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
            <tv:TableView
                x:Name="ProcessTable"
                AutomationProperties.AutomationId="TaskManagerProcessTable"
                AutomationProperties.Name="Sample processes"
                Sorted="OnProcessTableSorted"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Single"
                VerticalAlignment="Stretch"
                MinHeight="420">
                <tv:TableViewTemplateColumn Header="Name" CellTemplate="{StaticResource NameCellTemplate}" MinWidth="320" Width="400" CanSort="True" SortMemberPath="Name"/>
                <tv:TableViewTemplateColumn Header="Status" CellTemplate="{StaticResource StatusCellTemplate}" MinWidth="100" Width="130" CanSort="True" SortMemberPath="StatusText"/>
                <tv:TableViewTemplateColumn CellTemplate="{StaticResource CpuCellTemplate}" MinWidth="70" Width="90" CanSort="True" SortMemberPath="CpuPercent">
                    <tv:TableViewTemplateColumn.Header>
                        <StackPanel Spacing="0">
                            <TextBlock Text="CPU"/>
                            <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="CpuSummary" AutomationProperties.AutomationId="TaskManagerCpuSummary" Text="0%" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </tv:TableViewTemplateColumn.Header>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn CellTemplate="{StaticResource MemoryCellTemplate}" MinWidth="90" Width="120" CanSort="True" SortMemberPath="MemoryMB">
                    <tv:TableViewTemplateColumn.Header>
                        <StackPanel Spacing="0">
                            <TextBlock Text="Memory"/>
                            <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="MemorySummary" AutomationProperties.AutomationId="TaskManagerMemorySummary" Text="0%" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </tv:TableViewTemplateColumn.Header>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn CellTemplate="{StaticResource DiskCellTemplate}" MinWidth="80" Width="100" CanSort="True" SortMemberPath="DiskMBps">
                    <tv:TableViewTemplateColumn.Header>
                        <StackPanel Spacing="0">
                            <TextBlock Text="Disk"/>
                            <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="DiskSummary" AutomationProperties.AutomationId="TaskManagerDiskSummary" Text="0%" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </tv:TableViewTemplateColumn.Header>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn CellTemplate="{StaticResource NetworkCellTemplate}" MinWidth="80" Width="100" CanSort="True" SortMemberPath="NetworkMbps">
                    <tv:TableViewTemplateColumn.Header>
                        <StackPanel Spacing="0">
                            <TextBlock Text="Network"/>
                            <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="NetworkSummary" AutomationProperties.AutomationId="TaskManagerNetworkSummary" Text="0%" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </tv:TableViewTemplateColumn.Header>
                </tv:TableViewTemplateColumn>
            </tv:TableView>
        </Border>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16,6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="StatusBar" AutomationProperties.AutomationId="TaskManagerStatusBar" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Selected:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="SelectedProcessText" AutomationProperties.AutomationId="TaskManagerSelectedProcessText" Text="(none)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Flat leaves the source unshaped. Grouped calls TableViewSource.GroupBy(keySelector, groupIdentitySelector) on the SAME source instance, so selection, scroll offset and group expansion survive the reshape."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ComboBox
                    x:Name="ShapingModeSelector"
                    AutomationProperties.AutomationId="ShapingModeSelector"
                    AutomationProperties.Name="Shaping mode"
                    Header="Shaping mode"
                    SelectedIndex="0"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnShapingModeChanged">
                    <ComboBoxItem Content="Flat" Tag="flat"/>
                    <ComboBoxItem Content="Grouped" Tag="grouped"/>
                    <!-- Hierarchical rows are not available in this release. The options stay
                         VISIBLE and disabled so the full shape of the shaping axis is honest
                         signposting rather than a silent omission; re-enable them when the
                         control ships hierarchy support. -->
                    <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                    <ComboBoxItem Content="Grouped hierarchy" Tag="groupedhierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                </ComboBox>
                <ComboBox
                    x:Name="ShapingGroupKeyCombo"
                    AutomationProperties.AutomationId="TaskManagerShapingGroupKeyCombo"
                    AutomationProperties.Name="Group key"
                    Header="Group by"
                    SelectedIndex="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Available once Grouped mode is selected."
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnShapingGroupKeyChanged">
                    <ComboBoxItem Content="Category" Tag="Category"/>
                    <ComboBoxItem Content="Status" Tag="Status"/>
                </ComboBox>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="Each action mutates the live collection and re-applies the current shaping, so you can watch rows move between groups, groups empty out, and the grouped projection handle an empty set. Run new task (in the command bar) adds a row to the Apps group."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <Button x:Name="ExpandAllButton"
                            AutomationProperties.AutomationId="TaskManagerExpandAllButton"
                            Content="Expand all groups"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Available once Grouped mode is selected."
                            Click="OnExpandAllClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CollapseAllButton"
                            AutomationProperties.AutomationId="TaskManagerCollapseAllButton"
                            Content="Collapse all groups"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Available once Grouped mode is selected."
                            Click="OnCollapseAllClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="MoveCategoryButton"
                            AutomationProperties.AutomationId="TaskManagerMoveCategoryButton"
                            Content="Move selected to next category"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Select a process first."
                            Click="OnMoveSelectedCategoryClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="EmptyToggleButton"
                            AutomationProperties.AutomationId="TaskManagerEmptyToggleButton"
                            Content="Remove all rows (group an empty set)"
                            Click="OnEmptyToggleClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Applied" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="AppliedModeText" Grid.Row="0" Grid.Column="1" Text="Flat" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TaskManagerAppliedModeText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Groups" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="GroupCountText" Grid.Row="1" Grid.Column="1" Text="(n/a)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TaskManagerGroupCountText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="RowCountText" Grid.Row="2" Grid.Column="1" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TaskManagerRowCountText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Last action" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="LastActionText" Grid.Row="3" Grid.Column="1" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TaskManagerLastActionText" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="What to look for" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <muxc:InfoBar
                    AutomationProperties.AutomationId="TaskManagerWhatToLookForInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="What to look for"
                    Message="Switch to Grouped and the rows band into Apps / Background processes / Windows processes with a count on each header. Click the CPU header while grouped - the processes reorder WITHIN each band, not across them. Type into the search box while grouped and a band that loses all its rows disappears entirely."/>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
