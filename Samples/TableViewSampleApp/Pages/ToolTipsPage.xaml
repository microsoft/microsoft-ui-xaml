<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.ToolTipsPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:local="using:TableViewSampleApp.Pages"
    xmlns:models="using:TableViewSampleApp.Models">

    <Page.Resources>
        <local:RowCardConverter x:Key="RowCard"/>

        <!-- A cell whose OWN content carries an app-set tooltip. The control must never replace or
             clear this one: hovering the text shows the app's tooltip, not a control-owned one. -->
        <DataTemplate x:Key="AppToolTipCell" x:DataType="models:Person">
            <TextBlock
                Text="{x:Bind Email, Mode=OneWay}"
                Margin="8,0"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="App-owned tooltip, set in the cell template"/>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Tooltips"
        Description="Both tooltips are opt-in and both are per column. HeaderToolTip is a plain object — a header is not bound against a row, so there is nothing to defer and no binding involved. CellToolTipBinding is a Binding evaluated against each row's data item, which is why it is a CLR property rather than a dependency property: XAML has to hand the Binding over unevaluated instead of resolving it once. Set neither and no tooltip appears — the control never invents one, and never touches a tooltip the cell's own template already set."
        SourceCaption="ToolTipsPage.xaml (excerpt)"
        SourceSnippet="ToolTips.xaml.txt"
        AdditionalSnippetCaption="ToolTipsPage.xaml.cs (excerpt)"
        AdditionalSnippet="ToolTips.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Hover a Name cell for rich content built from the whole row, a Department cell to see a DIFFERENT property, and a Salary cell to see nothing at all. Then press Mutate role and hover Department again: the tooltip followed the data with no invalidation call."
                    MinHeight="104"/>

                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="ToolTipsTable"
                        AutomationProperties.Name="People with tooltips"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <!-- Rich, non-string cell tooltip built from the whole row by a converter. -->
                        <tv:TableViewTextColumn x:Name="NameColumn" Header="Name"
                                                 Binding="{Binding FullName}"
                                                 Width="{StaticResource ColWidthLongName}"
                                                 HeaderToolTip="Full name, as entered"/>
                        <!-- Cell tooltip repeats the cell's own text: right for a column that
                             truncates, and the automation peer drops the duplicate so a screen
                             reader reads it once. -->
                        <tv:TableViewTextColumn x:Name="BioColumn" Header="Bio"
                                                 Binding="{Binding Bio}"
                                                 Width="{StaticResource ColWidthWrappedText}"
                                                 CanSort="False"/>
                        <!-- Cell tooltip shows a DIFFERENT property, so it survives as help text
                             and updates in place when the underlying value changes. -->
                        <tv:TableViewTextColumn x:Name="DepartmentColumn" Header="Department"
                                                 Binding="{Binding Department}"
                                                 Width="{StaticResource ColWidthDepartment}"
                                                 HeaderToolTip="Team the person reports into"/>
                        <!-- No CellToolTipBinding at all: nothing should appear over these cells. -->
                        <tv:TableViewTextColumn x:Name="SalaryColumn" Header="Salary"
                                                 Binding="{Binding Salary}"
                                                 Width="{StaticResource ColWidthNumber}"/>
                        <tv:TableViewTemplateColumn Header="Email" Width="*" CanSort="False"
                                                     CellTemplate="{StaticResource AppToolTipCell}"/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"
                    Text="Flat leaves the source unshaped. Grouped calls TableViewSource.GroupBy on the same source instance, so selection, scroll offset and group expansion survive the reshape. Group header bands are not cells, so they never acquire a cell tooltip."/>
                <ComboBox x:Name="ShapingModeSelector"
                          AutomationProperties.AutomationId="ShapingModeSelector"
                          Header="Shaping mode"
                          SelectedIndex="0"
                          SelectionChanged="OnShapingModeChanged"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Flat" Tag="flat"/>
                    <ComboBoxItem Content="Grouped" Tag="grouped"/>
                    <!-- Hierarchical rows are not available in this release. Shown disabled so the
                         shape of the feature is visible; re-enable when the control ships support
                         (TableViewSource exposes only Filter / GroupBy / Sort today). -->
                    <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                    <ComboBoxItem Content="Grouped hierarchy" Tag="groupedhierarchy" IsEnabled="False"
                                  ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                </ComboBox>
                <ComboBox x:Name="GroupKeyCombo" Header="Group by" IsEnabled="False" SelectedIndex="0"
                          SelectionChanged="OnGroupKeyChanged"
                          AutomationProperties.AutomationId="GroupKeyCombo"
                          AutomationProperties.Name="Group key"
                          ToolTipService.ToolTip="Available once Grouped mode is selected."
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                    <ComboBoxItem Content="Active status" Tag="Active"/>
                </ComboBox>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="Clearing a binding retracts the tooltip; there is no separate remove call. Header tooltips are changed in place on one column and retracted on another, to exercise both update paths."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <Button x:Name="ToggleButton" Content="Detach cell tooltips" Click="OnToggleClick"
                            AutomationProperties.AutomationId="ToggleToolTipsButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Mutate role" Click="OnMutateClick"
                            AutomationProperties.AutomationId="MutateRoleButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Change header tooltips" Click="OnMutateHeadersClick"
                            AutomationProperties.AutomationId="MutateHeaderToolTipsButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="What is attached?" Click="OnInspectClick"
                            AutomationProperties.AutomationId="InspectToolTipsButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ExpandAllButton" Content="Expand all groups" Click="OnExpandAllClick"
                            IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected."
                            AutomationProperties.AutomationId="ExpandAllButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CollapseAllButton" Content="Collapse all groups" Click="OnCollapseAllClick"
                            IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected."
                            AutomationProperties.AutomationId="CollapseAllButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ReassignRowButton" Content="Move first row to another group" Click="OnReassignRowClick"
                            IsEnabled="False" ToolTipService.ToolTip="Available once Grouped mode is selected."
                            AutomationProperties.AutomationId="ReassignRowButton"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cell bindings" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="0" Grid.Column="1" x:Name="AttachedText" Text="attached"
                               Style="{StaticResource StatusReadoutValueStyle}"
                               AutomationProperties.AutomationId="AttachedText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Data revision" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="1" Grid.Column="1" x:Name="RevisionText" Text="0"
                               Style="{StaticResource StatusReadoutValueStyle}"
                               AutomationProperties.AutomationId="RevisionText"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Shaping" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="2" Grid.Column="1" x:Name="ShapingText" Text="Flat (no grouping)"
                               Style="{StaticResource StatusReadoutValueStyle}"
                               AutomationProperties.AutomationId="ShapingText"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Per column" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Grid.Row="3" Grid.Column="1" x:Name="InspectText" Text="(press &quot;What is attached?&quot;)"
                               Style="{StaticResource StatusReadoutValueStyle}"
                               AutomationProperties.AutomationId="InspectText"
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
