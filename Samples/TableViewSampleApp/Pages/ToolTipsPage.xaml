<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.ToolTipsPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:models="using:TableViewSampleApp.Models">

    <Page.Resources>
        <!-- snippet -->
        <!-- A cell whose OWN content carries an app-set tooltip (the e-mail address). The control
             never replaces or clears it: hovering the envelope shows the app's tooltip. -->
        <DataTemplate x:Key="EmailIconCellTemplate" x:DataType="models:Person">
            <Grid Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind Email, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind Email, Mode=OneWay}">
                <FontIcon Glyph="&#xE715;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Tooltips"
        Description="TableView has two opt-in tooltip surfaces, both set per column. TableViewColumn.HeaderToolTip is a plain object shown over the column header; a string is also reported to UI Automation as help text. TableViewColumn.CellToolTipBinding is a Binding evaluated against each row, so a cell tooltip can repeat the cell's text, show a different property, or build rich content from the whole row, and it follows the data when a value changes. Set neither and no tooltip appears: the control never invents one, and never touches a tooltip the cell template already set."
        Snippet="ToolTips"
        StretchExample="True"
        TryIt="Hover a Name cell for a card built from the whole row, a Department chip for the person's role, and a Salary cell for nothing at all. Press Give the first 10 people their next role, then hover a Department chip again: the tooltip followed the data. Turn Cell tooltips off and hover again."
        WhatToLookFor="A cell tooltip is evaluated against the row, so after an action the Department chip's tooltip shows the new role without the app refreshing anything. The Name card's binding has no Path, so it is built from the row item when the binding evaluates and does not track individual property changes. Salary has no CellToolTipBinding and stays silent. Its header tooltip repeats the header text, so UI Automation reads it once, not twice. The Email envelope's tooltip belongs to the cell template and survives Cell tooltips Off.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="ToolTipsTable"
                    AutomationProperties.Name="People with tooltips"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <!-- CellToolTipBinding is set in code (AttachCellToolTips) so it can be detached. -->
                    <tv:TableViewTemplateColumn x:Name="PhotoColumn" Header="Photo" Width="{StaticResource ColWidthAvatar}"
                                                 CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                    <tv:TableViewTextColumn x:Name="NameColumn" Header="Name" Width="{StaticResource ColWidthShortName}"
                                             Binding="{Binding FullName}"
                                             HeaderToolTip="Full name, as entered"/>
                    <tv:TableViewTextColumn x:Name="BioColumn" Header="Bio" Width="*" MinWidth="{StaticResource ColMinWidthStar}"
                                             Binding="{Binding Bio}" CanSort="False"/>
                    <tv:TableViewTemplateColumn x:Name="DepartmentColumn" Header="Department" Width="{StaticResource ColWidthChip}"
                                                 CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"
                                                 HeaderToolTip="Team the person reports into"/>
                    <!-- No CellToolTipBinding at all: nothing appears over these cells. -->
                    <tv:TableViewTextColumn x:Name="SalaryColumn" Header="Salary" Width="{StaticResource ColWidthNumber}"
                                             Binding="{Binding Salary, Converter={StaticResource SalaryTextConverter}}"
                                             HeaderToolTip="Salary"/>
                    <tv:TableViewTemplateColumn x:Name="EmailColumn" Header="Email" Width="{StaticResource ColWidthNarrow}"
                                                 CellTemplate="{StaticResource EmailIconCellTemplate}" CanSort="False"/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Cell tooltips"
                    Description="Sets TableViewColumn.CellToolTipBinding on Photo (the name), Name (a card built from the row), Bio (its own text) and Department (the role). Off sets them to null, which retracts every cell tooltip; there is no separate remove call. The Email envelope keeps its own template tooltip either way.">
                    <ToggleSwitch
                        x:Name="CellToolTipsToggle"
                        AutomationProperties.AutomationId="ToolTipsCellToolTipsToggle"
                        Header="Cell tooltips"
                        IsOn="True"
                        Toggled="OnCellToolTipsToggled"/>
                </controls:RailSection>

                <controls:RailSection
                    Header="Header tooltips"
                    Description="Sets TableViewColumn.HeaderToolTip. Original uses the strings from XAML plus a rich card on Bio. Changed in place rewrites Name's string and retracts Department's. None clears every header tooltip.">
                    <ComboBox
                        x:Name="HeaderToolTipsSelector"
                        AutomationProperties.AutomationId="ToolTipsHeaderToolTipsSelector"
                        Header="Header tooltips"
                        SelectedIndex="0"
                        SelectionChanged="OnHeaderToolTipsChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Original" Tag="original"/>
                        <ComboBoxItem Content="Changed in place" Tag="changed"/>
                        <ComboBoxItem Content="None" Tag="none"/>
                    </ComboBox>
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="ToolTips"
                    Description="Grouping leaves the columns alone, so every tooltip survives it, and group header bands are not cells, so they never get a cell tooltip. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Each action changes the data behind a tooltip; hover the cell afterwards and the tooltip shows the new value with no invalidation call. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="NextRoleButton"
                            AutomationProperties.AutomationId="ToolTipsNextRoleButton"
                            Content="Give the first 10 people their next role"
                            Click="OnNextRoleClick"
                            ToolTipService.ToolTip="Sets Role to the next real role on the first 10 rows. Hover their Department chips: the tooltip shows the new role."
                            AutomationProperties.HelpText="Sets Role to the next real role on the first 10 rows."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="LongBioButton"
                            AutomationProperties.AutomationId="ToolTipsLongBioButton"
                            Content="Give the selected row a long bio"
                            Click="OnLongBioClick"
                            ToolTipService.ToolTip="Writes a bio longer than the Bio column, so the cell truncates and its tooltip shows the full text."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ChangeDepartmentButton"
                            AutomationProperties.AutomationId="ToolTipsChangeDepartmentButton"
                            Content="Move selected row to the next department"
                            Click="OnChangeDepartmentClick"
                            ToolTipService.ToolTip="Gives the selected person the next department. Grouped by Department, the row moves to that group and keeps its tooltips."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="ToolTips">
                    <TextBlock x:Name="CellToolTipsText" controls:StatusPanel.Label="Cell tooltips" Text="Attached"/>
                    <TextBlock x:Name="PerColumnText" controls:StatusPanel.Label="Per column" Text="(none)"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
