<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.SelectionPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Selection"
        Description="TableView.SelectionMode is None or Single in this release. Selection from code is index-based: Select(index) and DeselectAll() change it, and SelectedItem, SelectedIndex and the SelectionChanged event report it. Group headers take display indexes too, so the last row's index is larger than the row count when the table is grouped. Select a row, then group, insert above it or remove it, and watch the Status readouts follow the item."
        Snippet="Selection"
        StretchExample="True"
        TryIt="Click a row, then switch Shaping to Grouped: the same person stays selected while SelectedIndex moves past the group headers. Click Select last, Insert a row above the selection and Remove the selected row, and read SelectionChanged fires and Last action after each one."
        WhatToLookFor="Selection follows the item, not the index: grouping, inserting above and moving to another group keep the same person selected while SelectedIndex changes. Removing the selected row clears the selection instead of moving it to a neighbour, and so does Collapse all. Check whether using an editor inside a row, such as the Active checkbox or the Office list, also selects that row: Last action names the edited person and the selected one.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="SelectionTable"
                    AutomationProperties.Name="People selection"
                    SelectionMode="Single"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False"/>
                    <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}"/>
                    <tv:TableViewTemplateColumn Header="Department" Width="{StaticResource ColWidthChip}" CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department"/>
                    <tv:TableViewTemplateColumn Header="Active" Width="{StaticResource ColWidthBoolean}" CellTemplate="{StaticResource ActiveCheckBoxTemplate}" SortMemberPath="IsActive"/>
                    <tv:TableViewTemplateColumn Header="Office" Width="{StaticResource ColWidthCombo}" CellTemplate="{StaticResource OfficeComboTemplate}" SortMemberPath="Office"/>
                    <tv:TableViewTemplateColumn Header="Details" Width="{StaticResource ColWidthAction}" CellTemplate="{StaticResource DetailsButtonTemplate}" CanSort="False"/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <!-- snippet -->
                <controls:RailSection
                    IsFirst="True"
                    Header="Selection mode"
                    Description="Sets TableView.SelectionMode. Single selects one row by click, by keyboard or from code; None turns selection off.">
                    <ComboBox
                        x:Name="SelectionModeSelector"
                        AutomationProperties.AutomationId="SelectionSelectionModeSelector"
                        Header="Selection mode"
                        SelectedIndex="1"
                        SelectionChanged="OnSelectionModeChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="None" Tag="None"/>
                        <ComboBoxItem Content="Single" Tag="Single"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               Text="Select first and Select last need the Single mode."/>
                </controls:RailSection>
                <!-- /snippet -->

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="Selection"
                    Description="Grouping keeps the selected person selected; only SelectedIndex changes, because the group headers above it take indexes. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Office" Tag="Office"/>
                    <ComboBoxItem Content="Active" Tag="IsActive"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="These actions drive selection from code and change the rows around it. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="SelectFirstButton"
                            AutomationProperties.AutomationId="SelectionSelectFirstButton"
                            Content="Select first"
                            Click="OnSelectFirstClick"
                            ToolTipService.ToolTip="Calls Select(index) with the first display index that holds a row, skipping group headers."
                            AutomationProperties.HelpText="Calls Select(index) with the first display index that holds a row. Needs the Single selection mode."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="SelectLastButton"
                            AutomationProperties.AutomationId="SelectionSelectLastButton"
                            Content="Select last"
                            Click="OnSelectLastClick"
                            ToolTipService.ToolTip="Calls Select(index) with the last display index that holds a row, so it also works when grouped."
                            AutomationProperties.HelpText="Calls Select(index) with the last display index that holds a row. Needs the Single selection mode."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ClearSelectionButton"
                            AutomationProperties.AutomationId="SelectionClearSelectionButton"
                            Content="Clear selection"
                            Click="OnClearSelectionClick"
                            ToolTipService.ToolTip="Calls DeselectAll()."
                            AutomationProperties.HelpText="Calls DeselectAll()."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="MoveGroupButton"
                            AutomationProperties.AutomationId="SelectionMoveGroupButton"
                            Content="Move selected row to the next group"
                            Click="OnMoveGroupClick"
                            ToolTipService.ToolTip="Changes the selected person's grouped-on value (next department, next office, or Active flipped) and re-applies GroupBy. The selection follows the person."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="InsertAboveButton"
                            AutomationProperties.AutomationId="SelectionInsertAboveButton"
                            Content="Insert a row above the selection"
                            Click="OnInsertAboveClick"
                            ToolTipService.ToolTip="Inserts a new person into the source just before the selected one. Selection stays on the same person and should raise no SelectionChanged."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="RemoveSelectedButton"
                            AutomationProperties.AutomationId="SelectionRemoveSelectedButton"
                            Content="Remove the selected row"
                            Click="OnRemoveSelectedClick"
                            ToolTipService.ToolTip="Removes the selected person from the source. Selection should clear rather than move to a neighbour."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="Selection">
                    <TextBlock x:Name="SelectedItemText" controls:StatusPanel.Label="SelectedItem" Text="(none)"/>
                    <TextBlock x:Name="SelectedIndexText" controls:StatusPanel.Label="SelectedIndex" Text="-1 (none)"/>
                    <TextBlock x:Name="ChangeCountText" controls:StatusPanel.Label="SelectionChanged fires" Text="0"/>
                    <TextBlock x:Name="SelectionDeltaText" AutomationProperties.AutomationId="SelectionDeltaText"
                               controls:StatusPanel.Label="Last delta" Text="(no SelectionChanged yet)"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
