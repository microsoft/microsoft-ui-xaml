<?xml version="1.0" encoding="utf-8"?>
<!--
    Cell templating: the golden reference page (FIX-PLAN §2, WP0 item 0.10). Every other feature
    page copies its structure: Try it, one stretched table, then the rail in the order
    Primary feature, Shaping, Actions, Status, What to look for. The generic blocks are marked
    with scaffold comments so they can later be extracted unchanged (FIX-PLAN §1.6 R4).
    The cell templates come from Templates\PersonCellTemplates.xaml; this page declares none.
-->
<Page
    x:Class="TableViewSampleApp.Pages.CellTemplatingPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <controls:SamplePresenter
        Header="Cell templating"
        Description="TableViewTemplateColumn renders each cell from a DataTemplate: a read-only visual such as the Department chip, or an editor such as a CheckBox, a date or time picker, a ComboBox or a Button with a Flyout. Each editor is two-way bound to its Person row, so an edit survives scrolling and sorting. From the keyboard, arrow to the cell and press Enter to reach its editor; Esc returns to the cell. Sorting a template column uses its SortMemberPath, the value behind the control. The Join date editor option swaps that column's CellTemplate at run time."
        SourceCaption="CellTemplatingPage.xaml (excerpt)"
        SourceSnippet="CellTemplating.xaml.txt"
        AdditionalSnippetCaption="CellTemplatingPage.xaml.cs (excerpt)"
        AdditionalSnippet="CellTemplating.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- scaffold:tryit -->
                <muxc:InfoBar
                    Grid.Row="0"
                    Title="Try it"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    MinHeight="104"
                    Message="Arrow to a row's Active cell, press Enter to reach the checkbox and press Space, then open its Join date, Shift, Office or Details editor. Scroll the row out of view and back: the value you set is still there. Click the Join date header to sort by the date value, then switch the Join date editor in the rail."/>
                <!-- /scaffold -->
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="CellTemplatingTable"
                        AutomationProperties.Name="People with templated cells"
                        ItemsSource="{x:Bind Source}"
                        SelectionMode="Single"
                        IsReadOnly="False"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <!-- The template renders a control; SortMemberPath names the value that orders the rows. -->
                        <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False" HeaderToolTip="PersonPicture: the photo when the person has one, otherwise their initials."/>
                        <tv:TableViewTextColumn Header="Name" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding FullName}" IsReadOnly="True" HeaderToolTip="Read-only text column. Takes the width the other columns leave."/>
                        <tv:TableViewTemplateColumn Header="Department" Width="{StaticResource ColWidthChip}" CellTemplate="{StaticResource DepartmentChipTemplate}" SortMemberPath="Department" HeaderToolTip="Read-only chip template: a tinted badge with a colour dot and the department name."/>
                        <tv:TableViewTemplateColumn Header="Active" Width="{StaticResource ColWidthBoolean}" CellTemplate="{StaticResource ActiveCheckBoxTemplate}" SortMemberPath="IsActive" HeaderToolTip="Editable CheckBox. Arrow to the cell, press Enter, then Space."/>
                        <tv:TableViewTemplateColumn x:Name="JoinDateColumn" Header="Join date" Width="{StaticResource ColWidthCalendarDate}" CellTemplate="{StaticResource JoinCalendarDateTemplate}" SortMemberPath="JoinDate" HeaderToolTip="Editable date. Sorts by the JoinDate value, not by the text the picker shows."/>
                        <tv:TableViewTemplateColumn Header="Shift" Width="{StaticResource ColWidthTimeCompact}" CellTemplate="{StaticResource ShiftTimeCompactTemplate}" SortMemberPath="ShiftStart" HeaderToolTip="Start of the daily shift, 24-hour clock. Editable TimePicker; sorts by the TimeSpan."/>
                        <tv:TableViewTemplateColumn Header="Office" Width="{StaticResource ColWidthCombo}" CellTemplate="{StaticResource OfficeComboTemplate}" SortMemberPath="Office" HeaderToolTip="Editable ComboBox constrained to the office list."/>
                        <tv:TableViewTemplateColumn Header="Details" Width="{StaticResource ColWidthAction}" CellTemplate="{StaticResource DetailsButtonTemplate}" CanSort="False" HeaderToolTip="Opens a Flyout anchored to the invoking cell."/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <!-- 1. Primary feature -->
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Join date editor">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Join date editor"
                               Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Sets TableViewTemplateColumn.CellTemplate on the Join date column; the visible rows regenerate their cells. The compact CalendarDatePicker fits a 170 px column, the full DatePicker needs 310 px."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <ComboBox
                        x:Name="JoinDateEditorSelector"
                        AutomationProperties.AutomationId="CellTemplatingJoinDateEditorSelector"
                        Header="Join date editor"
                        SelectedIndex="0"
                        SelectionChanged="OnJoinDateEditorChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Calendar date picker (compact)" Tag="calendar"/>
                        <ComboBoxItem Content="Date picker (full)" Tag="datepicker"/>
                    </ComboBox>
                </StackPanel>

                <!-- scaffold:shaping -->
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Shaping">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="Grouping re-realizes the templated cells from the pool, and every editor keeps its value. TableViewSource.GroupBy reshapes the same source in place, so sort, selection and scroll survive."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <ComboBox
                        x:Name="ShapingModeSelector"
                        AutomationProperties.AutomationId="CellTemplatingShapingModeSelector"
                        Header="Shaping mode"
                        SelectedIndex="0"
                        SelectionChanged="OnShapingModeChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Flat" Tag="flat"/>
                        <ComboBoxItem Content="Grouped" Tag="grouped"/>
                        <!-- Hierarchical rows are not available in this release. These two options stay
                             visible but disabled so the shape of the feature is discoverable. When the
                             control ships hierarchy, enable them and uncomment the matching branch in
                             ApplyShaping. -->
                        <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False"
                                      AutomationProperties.HelpText="Hierarchical rows are not available in this release."/>
                        <ComboBoxItem Content="Grouped hierarchy" Tag="groupedHierarchy" IsEnabled="False"
                                      AutomationProperties.HelpText="Hierarchical rows are not available in this release."/>
                    </ComboBox>
                    <ComboBox
                        x:Name="GroupKeySelector"
                        AutomationProperties.AutomationId="CellTemplatingGroupKeySelector"
                        Header="Group key"
                        SelectedIndex="0"
                        IsEnabled="False"
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        SelectionChanged="OnGroupKeyChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Department" Tag="Department"/>
                        <ComboBoxItem Content="Office" Tag="Office"/>
                        <ComboBoxItem Content="Active" Tag="IsActive"/>
                    </ComboBox>
                    <Button
                        x:Name="ExpandAllButton"
                        AutomationProperties.AutomationId="CellTemplatingExpandAllGroupsButton"
                        Content="Expand all"
                        Click="OnExpandAllClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Calls TableView.ExpandAllGroups()."
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        x:Name="CollapseAllButton"
                        AutomationProperties.AutomationId="CellTemplatingCollapseAllGroupsButton"
                        Content="Collapse all"
                        Click="OnCollapseAllClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Calls TableView.CollapseAllGroups()."
                        AutomationProperties.HelpText="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               Text="Group key, Expand all and Collapse all need the Grouped mode. Hierarchy and Grouped hierarchy are not available in this release."/>
                </StackPanel>
                <!-- /scaffold -->

                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Actions">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock Text="Each action writes the Person model, and the templates follow through their two-way bindings, including rows scrolled out of view. Watch the table and the Last action readout. Actions that change one row need a selected row."
                               Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="CheckAllActiveButton"
                            AutomationProperties.AutomationId="CellTemplatingCheckAllActiveButton"
                            Content="Check all Active"
                            Click="OnCheckAllActiveClick"
                            ToolTipService.ToolTip="Sets IsActive on every row; every Active checkbox checks, including recycled rows."
                            AutomationProperties.HelpText="Sets IsActive on every row; every Active checkbox checks, including recycled rows."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="UncheckAllActiveButton"
                            AutomationProperties.AutomationId="CellTemplatingUncheckAllActiveButton"
                            Content="Uncheck all Active"
                            Click="OnUncheckAllActiveClick"
                            ToolTipService.ToolTip="Clears IsActive on every row; scroll a recycled row back to confirm it re-binds."
                            AutomationProperties.HelpText="Clears IsActive on every row; scroll a recycled row back to confirm it re-binds."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ChangeDepartmentButton"
                            AutomationProperties.AutomationId="CellTemplatingChangeDepartmentButton"
                            Content="Change selected row's department"
                            Click="OnChangeDepartmentClick"
                            ToolTipService.ToolTip="Moves the selected person to the next department. The chip re-tints; grouped by Department, the row moves to that group."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="OpenDetailsButton"
                            AutomationProperties.AutomationId="CellTemplatingOpenDetailsButton"
                            Content="Open selected row's details"
                            Click="OnOpenDetailsClick"
                            ToolTipService.ToolTip="Opens the Details flyout of the selected row, anchored to its cell."
                            AutomationProperties.HelpText="Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- scaffold:status -->
                <StackPanel Style="{StaticResource RailSectionStyle}" AutomationProperties.Name="Status">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Status"
                               Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <Grid Style="{StaticResource StatusGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Active" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActiveCountText" AutomationProperties.AutomationId="CellTemplatingActiveCountText"
                                   AutomationProperties.LiveSetting="Polite" Text="0 of 0" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="1" Text="Rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RowsText" AutomationProperties.AutomationId="CellTemplatingRowsText"
                                   AutomationProperties.LiveSetting="Polite" Text="0" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="2" Text="Shaping" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ShapingModeText" AutomationProperties.AutomationId="CellTemplatingShapingModeText"
                                   AutomationProperties.LiveSetting="Polite" Text="Flat" Style="{StaticResource StatusReadoutValueStyle}"/>
                        <TextBlock Grid.Row="3" Text="Last action" VerticalAlignment="Top" Style="{StaticResource StatusReadoutLabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastActionText" AutomationProperties.AutomationId="CellTemplatingLastActionText"
                                   AutomationProperties.LiveSetting="Polite" Text="(none)" TextWrapping="Wrap"
                                   Style="{StaticResource StatusReadoutValueStyle}"/>
                    </Grid>
                </StackPanel>
                <!-- /scaffold -->

                <muxc:InfoBar
                    Title="What to look for"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    Message="Scrolling recycles the chip, checkbox and picker elements, yet each row shows its own value again, because every editor is bound to the model rather than to the element. Template columns sort by SortMemberPath (JoinDate, ShiftStart, Office), not by the text a control displays. This page shows the full editor catalogue, so the table is wider than the window and scrolls horizontally on purpose."/>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
