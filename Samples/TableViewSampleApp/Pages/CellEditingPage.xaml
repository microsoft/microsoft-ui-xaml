<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.CellEditingPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:local="using:TableViewSampleApp.Pages">

    <controls:SamplePresenter
        Header="Cell editing"
        Description="Built-in in-place editing of TableViewTextColumn cells, and the table-level read-only gate that governs it. TableView.IsReadOnly is a single switch for the whole table: with IsReadOnly = false, double-tap a cell (or press F2 on the focused row) to edit it in place — Enter or Tab commits the edit back to the bound model, Esc cancels. Set IsReadOnly = true and every cell locks at once; no per-column or per-cell opt-out is involved, and no editable TextBox template cells are needed because the plain text columns become editable on their own. Every committed edit writes straight to the Person model (INotifyPropertyChanged), shown live in the edit log. Grouping is enabled here too, because committing an edit inside a grouped projection is a distinct code path worth exercising."
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Double-tap any Name / Role / Department / Email cell (or select a row and press F2) to edit it. Enter or Tab commits, Esc cancels. Flip IsReadOnly on and every cell in the table locks at once — it is a table-level gate, not a per-column one. Group the rows and edit inside a group to exercise editing over a grouped projection. Requires a Tabular control build that includes in-place editing."
                    MinHeight="104"/>
                <Border
                    Grid.Row="1"
                    Style="{StaticResource TableHostBorderStyle}"
                    Padding="0"
                    VerticalAlignment="Stretch">
                    <tv:TableView
                        x:Name="DemoTable"
                        AutomationProperties.Name="Editable people"
                        AutomationProperties.AutomationId="CellEditingTable"
                        SelectionMode="Single"
                        SelectionChanged="OnTableSelectionChanged"
                        IsReadOnly="False"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <tv:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" SortMemberPath="FirstName"/>
                        <tv:TableViewTextColumn Header="Last name" Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" SortMemberPath="LastName"/>
                        <tv:TableViewTextColumn Header="Role" Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" SortMemberPath="Role"/>
                        <tv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthShortName}" Binding="{Binding Department}" SortMemberPath="Department"/>
                        <tv:TableViewTextColumn Header="Email" Width="*" MinWidth="200" Binding="{Binding Email}" SortMemberPath="Email"/>
                    </tv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <StackPanel Spacing="4" AutomationProperties.Name="Editing options">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Editing" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock
                        Text="IsReadOnly is a table-level gate: one switch locks or unlocks in-place editing for every text column at once."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <ToggleSwitch
                        x:Name="ReadOnlyToggle"
                        Header="IsReadOnly"
                        OnContent="On (whole table locked)"
                        OffContent="Off (whole table editable)"
                        Toggled="OnReadOnlyToggled"
                        AutomationProperties.AutomationId="CellEditingReadOnlyToggle"/>
                </StackPanel>

                <StackPanel Spacing="4" AutomationProperties.Name="Shaping options">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Shaping" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock
                        Text="TableViewSource.GroupBy reshapes the same source in place, so an edit committed inside a group lands on the same Person instance the flat view shows. Hierarchy is a separate shaping axis and is not available in this release."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <ComboBox
                        x:Name="ShapingModeSelector"
                        AutomationProperties.AutomationId="ShapingModeSelector"
                        Header="Shaping mode"
                        SelectedIndex="0"
                        SelectionChanged="OnShapingModeChanged"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Flat" Tag="flat"/>
                        <ComboBoxItem Content="Grouped" Tag="grouped"/>
                        <!-- Hierarchical rows are not available in this release. The options stay
                             visible but disabled so the shape of the feature is discoverable;
                             re-enable them when the control ships hierarchy support, and uncomment
                             the matching branch in ApplyGrouping. -->
                        <ComboBoxItem Content="Hierarchy" Tag="hierarchy" IsEnabled="False" ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                        <ComboBoxItem Content="Grouped hierarchy" Tag="groupedhierarchy" IsEnabled="False" ToolTipService.ToolTip="Hierarchical rows are not available in this release."/>
                    </ComboBox>
                    <ComboBox
                        x:Name="GroupKeySelector"
                        AutomationProperties.AutomationId="CellEditingGroupKeySelector"
                        Header="Group key"
                        SelectedIndex="0"
                        SelectionChanged="OnGroupKeyChanged"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Department" Tag="Department"/>
                        <ComboBoxItem Content="Role" Tag="Role"/>
                    </ComboBox>
                    <Button
                        x:Name="ExpandAllButton"
                        AutomationProperties.AutomationId="CellEditingExpandAllGroupsButton"
                        Content="Expand all"
                        Click="OnExpandAllGroupsClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        x:Name="CollapseAllButton"
                        AutomationProperties.AutomationId="CellEditingCollapseAllGroupsButton"
                        Content="Collapse all"
                        Click="OnCollapseAllGroupsClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Available in the Grouped shaping mode."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="4" AutomationProperties.Name="Actions">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Actions" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock
                        Text="Editing operations driven from outside the table, including the case the gallery otherwise never reaches: editing the value the table is currently grouped on."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <Button
                        x:Name="EditGroupedValueButton"
                        Content="Edit the grouped-on value of the selected row"
                        Click="OnEditGroupedValueClick"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Select a row first."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.AutomationId="CellEditingEditGroupedValueButton"
                        AutomationProperties.HelpText="Commits a model edit to the property the table is grouped on, so the row re-groups and the edit is recorded in the log."/>
                    <Button
                        x:Name="CommitEditButton"
                        Content="Commit the open edit"
                        Click="OnCommitEditClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.AutomationId="CellEditingCommitEditButton"
                        AutomationProperties.HelpText="Calls TableView.CommitEdit and reports what it returned."/>
                    <Button
                        x:Name="CancelEditButton"
                        Content="Cancel the open edit"
                        Click="OnCancelEditClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.AutomationId="CellEditingCancelEditButton"
                        AutomationProperties.HelpText="Calls TableView.CancelEdit and reports what it returned. Esc inside the editor does the same."/>
                    <Button
                        x:Name="ClearLogButton"
                        Content="Clear the edit log"
                        Click="OnClearLogClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.AutomationId="CellEditingClearLogButton"/>
                </StackPanel>

                <StackPanel Spacing="4" AutomationProperties.Name="Edit log">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Text="Edit log" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock
                        Text="Each committed edit writes to the bound Person model and is recorded here (newest first)."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinHeight="140"
                        MaxHeight="240">
                        <ListView
                            x:Name="EditLogList"
                            AutomationProperties.AutomationId="CellEditingEditLog"
                            AutomationProperties.Name="Edit log"
                            ItemsSource="{x:Bind EditLog}"
                            SelectionMode="None"
                            IsHitTestVisible="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </StackPanel>

                <muxc:InfoBar AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="CellEditingStatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Status"
                    Message="{x:Bind StatusText, Mode=OneWay}"
                    MinHeight="64"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
