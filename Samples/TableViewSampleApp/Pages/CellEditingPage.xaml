<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.Pages.CellEditingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:adv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls"
    xmlns:local="using:TableViewSampleApp.Pages">

    <controls:SamplePresenter
        Header="Cell editing"
        Description="Built-in in-place editing of TableViewTextColumn cells. Set TableView.IsReadOnly = false, then double-tap a cell (or press F2 on the focused row) to edit it in place; Enter or Tab commits the edit back to the bound model, Esc cancels. This is the framework editing path — unlike the Density &amp; read-only page, no editable TextBox template cells are needed: the plain text columns become editable on their own. Every committed edit writes straight to the Person model (INotifyPropertyChanged), shown live in the edit log."
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Double-tap any Name / Role / Department / Email cell (or select a row and press F2) to edit it. Enter or Tab commits, Esc cancels. Flip Read-only on to lock every cell. Requires a Tabular control build that includes in-place editing."
                    MinHeight="104"/>
                <Border
                    Grid.Row="1"
                    Style="{StaticResource TableHostBorderStyle}"
                    Padding="0"
                    VerticalAlignment="Stretch">
                    <adv:TableView
                        x:Name="DemoTable"
                        SelectionMode="Single"
                        IsReadOnly="False"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <adv:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" SortMemberPath="FirstName"/>
                        <adv:TableViewTextColumn Header="Last name" Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" SortMemberPath="LastName"/>
                        <adv:TableViewTextColumn Header="Role" Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" SortMemberPath="Role"/>
                        <adv:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthShortName}" Binding="{Binding Department}" SortMemberPath="Department"/>
                        <adv:TableViewTextColumn Header="Email" Width="*" MinWidth="200" Binding="{Binding Email}" SortMemberPath="Email"/>
                    </adv:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <StackPanel Spacing="4" AutomationProperties.Name="Editing options">
                    <TextBlock Text="Editing" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock
                        Text="Toggle table-level IsReadOnly to lock or unlock in-place editing of the text columns."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <ToggleSwitch
                        x:Name="ReadOnlyToggle"
                        Header="IsReadOnly"
                        OnContent="On (cells locked)"
                        OffContent="Off (cells editable)"
                        Toggled="OnReadOnlyToggled"
                        AutomationProperties.AutomationId="CellEditingReadOnlyToggle"/>
                </StackPanel>

                <StackPanel Spacing="4" AutomationProperties.Name="Edit log">
                    <TextBlock Text="Edit log" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                    <TextBlock
                        Text="Each committed edit writes to the bound Person model and is recorded here (newest first)."
                        Style="{StaticResource SectionDescriptionTextStyle}"
                        TextWrapping="Wrap"/>
                    <Border
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinHeight="140"
                        MaxHeight="240">
                        <ListView
                            x:Name="EditLogList"
                            AutomationProperties.AutomationId="CellEditingEditLog"
                            ItemsSource="{x:Bind EditLog}"
                            SelectionMode="None"
                            IsHitTestVisible="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </StackPanel>

                <muxc:InfoBar
                    AutomationProperties.AutomationId="CellEditingStatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Status"
                    Message="{x:Bind StatusText, Mode=OneWay}"
                    MinHeight="64"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
