<?xml version="1.0" encoding="utf-8"?>
<pages:SamplePageBase
    x:Class="TableViewSampleApp.Pages.CellEditingPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:models="using:TableViewSampleApp.Models"
    xmlns:pages="using:TableViewSampleApp.Pages"
    xmlns:controls="using:TableViewSampleApp.Controls">

    <Page.Resources>
        <!-- snippet -->
        <!-- Display cell of the Department column. -->
        <DataTemplate x:Key="DepartmentTextTemplate" x:DataType="models:Person">
            <TextBlock Text="{x:Bind Department, Mode=OneWay}" Margin="12,0,8,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <!-- Editor of the Department column, shown only while the cell is in edit mode. It uses a
             classic {Binding} with UpdateSourceTrigger=Explicit, and no x:DataType: the control
             commits by calling UpdateSource on the editor's binding expressions, which it can find
             only on a {Binding}. Esc therefore discards the choice without touching the model.
             The items are the PersonData.Departments values. -->
        <DataTemplate x:Key="DepartmentEditingTemplate">
            <ComboBox SelectedItem="{Binding Department, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                      AutomationProperties.Name="Department"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0">
                <x:String>Design</x:String>
                <x:String>Engineering</x:String>
                <x:String>Finance</x:String>
                <x:String>HR</x:String>
                <x:String>Marketing</x:String>
                <x:String>Operations</x:String>
                <x:String>Product</x:String>
                <x:String>Sales</x:String>
            </ComboBox>
        </DataTemplate>
        <!-- /snippet -->
    </Page.Resources>

    <controls:SamplePresenter
        Header="Cell editing"
        Description="TableView edits a cell in place: double-click it or press F2, then press Enter or Tab to commit or Esc to cancel. TableView.IsReadOnly is the table-wide gate; it starts False on this page, and turning it on stops in-place editing in every column at once. Text columns get a built-in TextBox editor, and the Department column shows how a TableViewTemplateColumn supplies its own editor through CellEditingTemplate, here a ComboBox. A committed edit writes to the Person model, so the edit log updates and, when the table is grouped on the edited value, the row moves to its new group."
        Snippet="CellEditing"
        StretchExample="True"
        TryIt="Double-click a Role cell, or click it and press F2, type a new value and press Enter. Press F2 on a Department cell to pick from a list, then press Esc to cancel. Group by Department and change a row's department: the row moves to its new group. Then turn on IsReadOnly and try again."
        WhatToLookFor="Grouped by Department, a committed department edit moves the row to its new group, because the page re-applies GroupBy after the model write. Esc, or Cancel, closes the editor without writing, so the edit log does not change. With IsReadOnly on, F2 and double-click do nothing and the Commit and Cancel buttons stay disabled.">

        <controls:SamplePresenter.Example>
            <Border Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                <!-- snippet -->
                <tv:TableView
                    x:Name="PeopleTable"
                    AutomationProperties.AutomationId="CellEditingTable"
                    AutomationProperties.Name="Editable people"
                    ItemsSource="{x:Bind Source}"
                    SelectionMode="Single"
                    IsReadOnly="False"
                    SelectionChanged="OnSelectionChanged"
                    BeginningEdit="OnBeginningEdit"
                    CellEditEnding="OnCellEditEnding"
                    VerticalAlignment="Stretch"
                    MinHeight="320">
                    <tv:TableViewTemplateColumn Header="Photo" Width="{StaticResource ColWidthAvatar}" CellTemplate="{StaticResource AvatarTemplate}" CanSort="False" HeaderToolTip="A CellTemplate with no CellEditingTemplate, so this column is never editable."/>
                    <tv:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}"/>
                    <tv:TableViewTextColumn Header="Last name" Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}"/>
                    <tv:TableViewTextColumn Header="Role" Width="*" MinWidth="{StaticResource ColMinWidthStar}" Binding="{Binding Role}"/>
                    <tv:TableViewTemplateColumn
                        Header="Department"
                        Width="{StaticResource ColWidthCombo}"
                        CellTemplate="{StaticResource DepartmentTextTemplate}"
                        CellEditingTemplate="{StaticResource DepartmentEditingTemplate}"
                        SortMemberPath="Department"
                        HeaderToolTip="Text when displayed; a ComboBox from CellEditingTemplate while editing."/>
                </tv:TableView>
                <!-- /snippet -->
            </Border>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <controls:RailSection
                    IsFirst="True"
                    Header="Editing"
                    Description="TableView.IsReadOnly locks or unlocks in-place editing for every column at once. Columns without an editor, such as Photo, are never editable.">
                    <!-- snippet -->
                    <ToggleSwitch
                        x:Name="ReadOnlyToggle"
                        AutomationProperties.AutomationId="CellEditingReadOnlyToggle"
                        Header="IsReadOnly"
                        OnContent="On (every cell locked)"
                        OffContent="Off (cells editable)"
                        Toggled="OnReadOnlyToggled"/>
                    <!-- /snippet -->
                    <TextBlock Style="{StaticResource RailCaptionTextStyle}"
                               Text="Press F2 to edit, Enter to commit, Esc to cancel."/>
                </controls:RailSection>

                <controls:ShapingOptions
                    x:Name="Shaping"
                    AutomationIdPrefix="CellEditing"
                    Description="Grouped, an edit to the grouped-on value moves the row to its new group. TableViewSource.GroupBy reshapes the same source in place rather than rebuilding it, so the control can keep the sort, the selection and the scroll position.">
                    <ComboBoxItem Content="Department" Tag="Department"/>
                    <ComboBoxItem Content="Role" Tag="Role"/>
                </controls:ShapingOptions>

                <controls:RailSection
                    Header="Actions"
                    Description="Commit and Cancel call TableView.CommitEdit and CancelEdit on the open editor; they are enabled only while a cell is in edit mode and do not take focus from it. Watch the table and the Last action readout. Actions that change one row need a selected row.">
                    <StackPanel Spacing="8">
                        <!-- snippet -->
                        <!-- AllowFocusOnInteraction="False": clicking the button leaves the editor open and focused. -->
                        <Button
                            x:Name="CommitEditButton"
                            AutomationProperties.AutomationId="CellEditingCommitEditButton"
                            Content="Commit the open edit"
                            Click="OnCommitEditClick"
                            IsEnabled="False"
                            AllowFocusOnInteraction="False"
                            ToolTipService.ToolTip="Calls TableView.CommitEdit(): the editor's value is written to the model."
                            AutomationProperties.HelpText="Available while a cell is in edit mode. Press F2 on a cell first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="CancelEditButton"
                            AutomationProperties.AutomationId="CellEditingCancelEditButton"
                            Content="Cancel the open edit"
                            Click="OnCancelEditClick"
                            IsEnabled="False"
                            AllowFocusOnInteraction="False"
                            ToolTipService.ToolTip="Calls TableView.CancelEdit(): the editor closes and the model keeps its old value, as Esc does."
                            AutomationProperties.HelpText="Available while a cell is in edit mode. Press F2 on a cell first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <!-- /snippet -->
                        <Button
                            x:Name="EditGroupedValueButton"
                            AutomationProperties.AutomationId="CellEditingEditGroupedValueButton"
                            Content="Change the selected row's group"
                            Click="OnEditGroupedValueClick"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Writes the next Department or Role to the selected row, then re-applies GroupBy so the row moves to its new group."
                            AutomationProperties.HelpText="Available in the Grouped shaping mode. Select a row first."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                        <Button
                            x:Name="ClearLogButton"
                            AutomationProperties.AutomationId="CellEditingClearLogButton"
                            Content="Clear the edit log"
                            Click="OnClearLogClick"
                            ToolTipService.ToolTip="Empties the edit log. The model keeps its edited values."
                            AutomationProperties.HelpText="Empties the edit log. The model keeps its edited values."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </controls:RailSection>

                <controls:RailSection
                    Header="Edit log"
                    Description="Every value written to the Person model, newest first.">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4" MinHeight="96" MaxHeight="200">
                        <ListView
                            x:Name="EditLogList"
                            AutomationProperties.AutomationId="CellEditingEditLog"
                            AutomationProperties.Name="Edit log"
                            ItemsSource="{x:Bind EditLog}"
                            SelectionMode="None"
                            IsHitTestVisible="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </controls:RailSection>

                <controls:StatusPanel x:Name="Status" AutomationIdPrefix="CellEditing">
                    <TextBlock x:Name="ReadOnlyText" controls:StatusPanel.Label="Read-only" Text="No"/>
                    <TextBlock x:Name="OpenEditText" controls:StatusPanel.Label="Open edit" Text="(none)"/>
                    <TextBlock x:Name="EditsCommittedText" controls:StatusPanel.Label="Edits committed" Text="0"/>
                </controls:StatusPanel>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</pages:SamplePageBase>
