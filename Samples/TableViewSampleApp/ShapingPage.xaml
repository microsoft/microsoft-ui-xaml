<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.ShapingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:controls="using:TableViewSampleApp.Controls"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CollapseAccel_Invoked"/>
        <KeyboardAccelerator Key="E" Modifiers="Control,Shift" Invoked="ExpandAccel_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- GroupHeaderTemplate binds the TableViewGroupInfo projection the control hands the
             header: Key / ItemCount for raw values, KeyText / ItemCountText for the
             culture-formatted strings the built-in template uses. The expander glyph is owned by
             the control's TableViewGroupHeader template, not by this content template. -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold"/>
                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="10" Padding="8,1">
                    <TextBlock Text="{Binding ItemCountText}" FontSize="12" Opacity="0.8"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Filtering, sorting and grouping" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="Filter and GroupBy are stages declared on ONE TableViewSource, so they compose — filter narrows the rows, group buckets what survives. Sort has two front-ends and they converge rather than stack: 'via TableView' calls SortByColumn, which owns the header chevron; 'via TableViewSource' calls the fluent Sort verb, which has no column to light up. Whichever runs last wins and clears the other, so exactly one sort is ever in force — switch the dropdown after sorting, or click a header while sorted via the source, to watch the chevron follow. Selection re-anchors to the same item across a reshape, so select a row and then filter or sort to watch it follow."/>
        </StackPanel>

        <!-- Filter. Label and field stay together; the rest wraps in a narrow window. -->
        <controls:WrapPanel Grid.Row="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="FilterLabel" Text="Filter:" VerticalAlignment="Center" Width="52"/>
                <TextBox x:Name="FilterBox" Width="220" PlaceholderText="name, role or city"
                         AutomationProperties.LabeledBy="{Binding ElementName=FilterLabel}"
                         TextChanged="Filter_Changed"/>
            </StackPanel>
            <CheckBox x:Name="HighScoresOnly" Content="Score &#8805; 50" Checked="Filter_Toggled" Unchecked="Filter_Toggled"/>
            <Button x:Name="ClearFilterButton" Content="Clear filter" Click="ClearFilter_Click"/>
        </controls:WrapPanel>

        <!-- Group -->
        <controls:WrapPanel Grid.Row="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="GroupLabel" Text="Group:" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="GroupCombo" Width="160" SelectionChanged="Group_Changed"
                          AutomationProperties.LabeledBy="{Binding ElementName=GroupLabel}">
                    <ComboBoxItem Content="None" IsSelected="True"/>
                    <ComboBoxItem Content="Role"/>
                    <ComboBoxItem Content="City"/>
                    <ComboBoxItem Content="Score band"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="ExpandAllButton" Content="Expand all" Click="ExpandAll_Click"/>
            <Button x:Name="CollapseAllButton" Content="Collapse all" Click="CollapseAll_Click"/>
            <CheckBox x:Name="CustomHeaderToggle" Content="Custom GroupHeaderTemplate" IsChecked="True"
                      Checked="GroupHeaderTemplate_Toggled" Unchecked="GroupHeaderTemplate_Toggled"/>
        </controls:WrapPanel>

        <!-- Sort. A wrap panel keeps one line in a wide window and wraps in a narrow (portrait) one. -->
        <controls:WrapPanel Grid.Row="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="SortLabel" Text="Sort:" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="SortCombo" Width="160" SelectionChanged="Sort_Changed"
                          AutomationProperties.LabeledBy="{Binding ElementName=SortLabel}">
                    <ComboBoxItem Content="None" IsSelected="True"/>
                    <ComboBoxItem Content="Name"/>
                    <ComboBoxItem Content="Role"/>
                    <ComboBoxItem Content="City"/>
                    <ComboBoxItem Content="Score"/>
                    <ComboBoxItem Content="Joined"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="SortDirectionLabel" Text="Direction:" VerticalAlignment="Center"/>
                <ComboBox x:Name="DirectionCombo" Width="140" SelectionChanged="Sort_Changed"
                          AutomationProperties.LabeledBy="{Binding ElementName=SortDirectionLabel}">
                    <ComboBoxItem Content="Ascending" IsSelected="True"/>
                    <ComboBoxItem Content="Descending"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="SortApiLabel" Text="Sort API:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ViaCombo" Width="230" SelectionChanged="Sort_Changed"
                          AutomationProperties.LabeledBy="{Binding ElementName=SortApiLabel}">
                    <ComboBoxItem Content="via TableView" IsSelected="True"/>
                    <ComboBoxItem Content="via source (path)"/>
                    <ComboBoxItem Content="via source (key)"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="HeaderSortToggle" Content="Click-to-sort headers" IsChecked="True"
                      Checked="HeaderSort_Toggled" Unchecked="HeaderSort_Toggled"/>
            <Button Content="Clear sort" Click="ClearSort_Click"/>
        </controls:WrapPanel>

        <!-- Sort cycle: what a header click walks through, per column. Only reachable when
             click-to-sort is on. The hint and the diagnostics wrap instead of sharing a grid row:
             side by side, a narrow window squeezed the hint to a zero-width column whose wrapped
             text pushed the table off screen. -->
        <StackPanel Grid.Row="4" Spacing="8">
            <controls:WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="CycleLabel" Text="Cycle:" VerticalAlignment="Center" Width="52"/>
                    <ComboBox x:Name="CycleCombo" Width="260" SelectionChanged="SortCycle_Changed"
                              AutomationProperties.LabeledBy="{Binding ElementName=CycleLabel}">
                        <ComboBoxItem Content="As authored" IsSelected="True"/>
                        <ComboBoxItem Content="AscendingDescending"/>
                        <ComboBoxItem Content="AscendingDescendingNone"/>
                        <ComboBoxItem Content="DescendingAscending"/>
                        <ComboBoxItem Content="DescendingAscendingNone"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="CycleHint" VerticalAlignment="Center" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
            </controls:WrapPanel>

            <!-- Diagnostic: detaches and re-attaches the TableView so it goes Unloaded -> Loaded with
                 the same ItemsSource. That is the "repump" path - the rows pipeline re-runs against an
                 unchanged ItemsSourceView, which is when subscription order is at risk of inverting. -->
            <controls:WrapPanel>
                <Button x:Name="RepumpButton" Content="Repump (unload/reload)" Click="Repump_Click"/>
                <Button x:Name="AddItemButton" Content="Add item" Click="AddItem_Click"/>
                <Button x:Name="ClearSelLogButton" Content="Clear sel log" Click="ClearSelLog_Click"/>
                <CheckBox x:Name="BandingToggle" Content="Banding" Checked="Banding_Changed" Unchecked="Banding_Changed"/>
                <Button x:Name="DumpBandingButton" Content="Dump banding" Click="DumpBanding_Click"/>
            </controls:WrapPanel>
        </StackPanel>

        <Border x:Name="TableHost" Grid.Row="5" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <tv:TableView x:Name="Table" SelectionMode="Single"
                          AutomationProperties.Name="Filter sort and group records"
                          AutomationProperties.AutomationId="ShapingTable"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
</Page>
