<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.HierarchyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Page.Resources>
        <!-- Headers only ever appear at the top level: GroupBy buckets the ROOTS, and a descendant
             stays under its parent rather than being pulled out to join a bucket. -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold"/>
                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="10" Padding="8,1">
                    <TextBlock Text="{Binding ItemCountText}" FontSize="11"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Hierarchical rows (flat parent keys)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="The data is one flat list of employees. WithParent(key, parentKey) tells a TableViewSource how the rows relate; the rows themselves have no children collection, level or expanded flag. Both tables below share ONE ObservableCollection: the left declares the Manager relation (ManagerId), the right the Mentor relation (MentorId), so the same person appears at a different depth in each. Rows start collapsed; a null parent key makes a root and an unknown parent key makes an orphan root. Sort applies within each sibling set, Filter keeps matches plus their ancestors (auto-expanded while the filter is active), and 'Group roots by Dept' buckets the roots while every root keeps its subtree. Add and remove edit the shared collection and both tables follow."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Expand all" Click="ExpandAll_Click"/>
            <Button Content="Collapse all" Click="CollapseAll_Click"/>
            <Button Content="Add report" Click="AddReport_Click"/>
            <Button Content="Add root" Click="AddRoot_Click"/>
            <Button Content="Reparent selected" Click="Reparent_Click"/>
            <Button Content="Remove selected" Click="Remove_Click"/>
            <Button Content="Reset data" Click="Reset_Click"/>
            <Button x:Name="PerfButton" Content="100k perf" Click="Perf_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" Width="200" PlaceholderText="name contains…"
                     TextChanged="Filter_Changed"/>
            <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <ComboBox x:Name="SortCombo" Width="190" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Authored order" IsSelected="True"/>
                <ComboBoxItem Content="Name ascending"/>
                <ComboBoxItem Content="Name descending"/>
                <ComboBoxItem Content="Title ascending"/>
            </ComboBox>
            <ToggleSwitch x:Name="GroupToggle" OnContent="Group roots by Dept" OffContent="Group roots by Dept"
                          Toggled="Group_Toggled"/>
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Manager relation (parent key = ManagerId)" FontWeight="SemiBold"/>
                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <!-- Per-level indent is a theme resource, not a property; set it on this table's own
                         Resources to retheme this table only. -->
                    <tv:TableView x:Name="ManagerTable" SelectionMode="Single" GridLinesVisibility="Horizontal">
                        <tv:TableView.Resources>
                            <x:Double x:Key="TableViewRowIndentSize">24</x:Double>
                        </tv:TableView.Resources>
                    </tv:TableView>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Mentor relation (parent key = MentorId)" FontWeight="SemiBold"/>
                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <tv:TableView x:Name="MentorTable" SelectionMode="Single" GridLinesVisibility="Horizontal">
                        <tv:TableView.Resources>
                            <x:Double x:Key="TableViewRowIndentSize">24</x:Double>
                        </tv:TableView.Resources>
                    </tv:TableView>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
</Page>
