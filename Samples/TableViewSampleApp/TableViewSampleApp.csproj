<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SamplesTargetFrameworkMoniker)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TableViewSampleApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64;ARM64EC</Platforms>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
    <!-- .NET has no arm64ec RID: ARM64EC hosts run x64 managed code, so map it to win-x64 (as the packaged ChartApp/TableViewApp C# samples do). -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64EC'">win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained Condition="'$(Platform)' == 'ARM64EC'">true</WindowsAppSDKSelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageName>TableViewSampleApp</AppxPackageName>
    <Configurations>Debug;Release;Debug_test</Configurations>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Program.cs provides the entry point (see DisableXamlGeneratedMain sample for the pattern). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(TableViewSampleEnableVerificationLogs)' == 'true'">$(DefineConstants);TABLEVIEW_SAMPLE_VERIFY</DefineConstants>
    <!-- TableView is [MUX_PREVIEW] and surfaces as CS8305 ("for evaluation purposes only"). -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\avatar1.png" />
    <Content Include="Assets\avatar2.png" />
    <Content Include="Assets\avatar3.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Source snippets shown in each page's Source expander. Embedded rather than loose content so
       CodeBlock can resolve them by name with no file I/O and no deployment step. Pages that carry
       // <snippet> markers get theirs from tools\Update-Snippets.ps1 (see _CheckTableViewSnippets). -->
  <ItemGroup>
    <EmbeddedResource Include="Snippets\*.txt">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- <X>Page.Status.cs (the page's readouts) nests under <X>Page.xaml.cs. -->
  <ItemGroup>
    <Compile Update="Pages\*Page.Status.cs" DependentUpon="$([System.String]::Copy('%(Filename)').Replace('.Status', '.xaml.cs'))" />
  </ItemGroup>

  <!-- BuildInfo.g.cs is generated under obj\ so local builds do not rewrite tracked source. The
       script rewrites the file only when its content (other than the build time) changed, so an
       unchanged tree keeps CoreCompile incremental. Design-time builds reuse the last file. -->
  <Target Name="_GenerateBuildInfo" BeforeTargets="XamlPreCompile;CoreCompile">
    <PropertyGroup>
      <_TableViewSampleBuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_TableViewSampleBuildInfoFile>
    </PropertyGroup>
    <Exec Condition="'$(DesignTimeBuild)' != 'true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Generate-BuildInfo.ps1&quot; -OutFile &quot;$(_TableViewSampleBuildInfoFile)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;"
          EnvironmentVariables="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup Condition="Exists('$(_TableViewSampleBuildInfoFile)')">
      <Compile Include="$(_TableViewSampleBuildInfoFile)" Link="BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Snippets generated from // <snippet> regions must match their page, and every snippet a page
       names must exist (tools\Update-Snippets.ps1 -Check). Incremental: it runs only when a source,
       snippet or the tool changed since the last clean check, never in design-time builds. A stale
       snippet is an ERROR in CI (ContinuousIntegrationBuild / TF_BUILD, or
       TableViewSampleStrictSnippets=true) and a WARNING locally, so F5 keeps working until you run
       tools\Update-Snippets.ps1. -->
  <PropertyGroup>
    <TableViewSampleStrictSnippets Condition="'$(TableViewSampleStrictSnippets)' == '' and ('$(ContinuousIntegrationBuild)' == 'true' or '$(TF_BUILD)' != '')">true</TableViewSampleStrictSnippets>
  </PropertyGroup>
  <ItemGroup>
    <_TableViewSampleSnippetInput Include="**\*.cs;**\*.xaml;Snippets\*.txt;tools\Update-Snippets.ps1" Exclude="bin\**;obj\**" />
  </ItemGroup>
  <Target Name="_CheckTableViewSnippets"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_TableViewSampleSnippetInput)"
          Outputs="$(IntermediateOutputPath)TableViewSampleSnippets.checked">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Update-Snippets.ps1&quot; -Check -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_TableViewSampleSnippetsExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_TableViewSampleSnippetsOutput" />
    </Exec>
    <PropertyGroup>
      <_TableViewSampleSnippetsMessage>@(_TableViewSampleSnippetsOutput, ' ')</_TableViewSampleSnippetsMessage>
    </PropertyGroup>
    <Error Condition="'$(_TableViewSampleSnippetsExitCode)' != '0' and '$(TableViewSampleStrictSnippets)' == 'true'"
           Code="TVSNIP001"
           Text="$(_TableViewSampleSnippetsMessage)" />
    <Warning Condition="'$(_TableViewSampleSnippetsExitCode)' != '0' and '$(TableViewSampleStrictSnippets)' != 'true'"
             Code="TVSNIP001"
             Text="$(_TableViewSampleSnippetsMessage) (A warning locally; CI fails on this.)" />
    <!-- Stamp only a clean check, so a stale snippet is reported again on the next build. -->
    <Touch Condition="'$(_TableViewSampleSnippetsExitCode)' == '0'"
           Files="$(IntermediateOutputPath)TableViewSampleSnippets.checked"
           AlwaysCreate="true" />
  </Target>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
