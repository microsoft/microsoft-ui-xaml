<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.LiveShapingSelfCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Scripted checks for TableViewSource.IsLiveSorting / IsLiveFiltering / IsLiveGrouping. Each case builds its own source and table below, changes item PROPERTIES (not the collection), lets the posted reshape run, and compares the realized rows. Flat rows print their name; tree rows print name + level + '-' expanded / '+' collapsed; group headers print [key]. 'Constraint.*' cases pin behaviour that differs from WPF's per-property live shaping."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="RunButton" Content="Run checks" Click="Run_Click"/>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Text="not run"/>
        </StackPanel>

        <ListView x:Name="Results" Grid.Row="2"/>

        <!-- Each case hosts its TableView here. Tall enough that every row realizes. -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Border x:Name="Host" Height="600"/>
        </ScrollViewer>
    </Grid>
</Page>
