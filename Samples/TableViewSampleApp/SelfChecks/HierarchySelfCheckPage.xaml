<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSampleApp.SelfChecks.HierarchySelfCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="RunButton" Content="Run checks" Click="Run_Click"/>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Text="not run"/>
        </StackPanel>

        <ListView x:Name="Results" Grid.Row="1"/>

        <!-- Each case hosts its TableView here. Tall enough that every row realizes. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border x:Name="Host" Height="1200"/>
        </ScrollViewer>
    </Grid>
</Page>
