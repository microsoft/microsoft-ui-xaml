<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TableViewSampleApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TableViewSampleApp"
    xmlns:converters="using:TableViewSampleApp.Converters"
    xmlns:templates="using:TableViewSampleApp.Templates">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Tabular ships its own theme resources, exactly as MUXC ships
                     XamlControlsResources, and they now reach a consuming app through the package.
                     TableView's column-header style resolves SortIndicatorForeground out of this
                     dictionary, so activation fails without the merge. This replaces the three
                     ms-appx theme XAMLs the sample used to compile out of the control source tree
                     back when the split-binary resources were not deployed. -->
                <TabularControlsResources xmlns="using:Microsoft.UI.Xaml.Controls.Tabular" />
                <!-- Shared Person cell templates and their converters (Templates\PersonCellTemplates.xaml).
                     Pages reference the keys with {StaticResource}; they never fork them. -->
                <templates:PersonCellTemplates />
                <!-- Every other converter key a page template uses (Converters\Converters.xaml). -->
                <converters:SampleConverters />
            </ResourceDictionary.MergedDictionaries>


            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SampleCustomRowBackgroundBrush" Color="{ThemeResource LayerFillColorDefault}"/>
                    <SolidColorBrush x:Key="SampleCustomAlternatingRowBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorSecondary}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SampleCustomRowBackgroundBrush" Color="{ThemeResource LayerFillColorDefault}"/>
                    <SolidColorBrush x:Key="SampleCustomAlternatingRowBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorSecondary}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SampleCustomRowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <!-- Sample-owned optional row banding only. Under High Contrast the
                         banding collapses to the system window colour so it never fights
                         the user's chosen contrast pair. Do not override TableView/Tabular
                         provider or theme resources in the app. -->
                    <SolidColorBrush x:Key="SampleCustomAlternatingRowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Thickness x:Key="PageContentMargin">24,12,24,16</Thickness>
            <x:Double x:Key="PageMaxContentWidth">1200</x:Double>
            <x:Double x:Key="SectionSpacing">22</x:Double>
            <x:Double x:Key="SectionInnerSpacing">6</x:Double>
            <!--
                Column width tokens. Columns use these, never literals and never Auto (ColumnLayout is the
                one exception, because Auto is its lesson). Each table has exactly one Width="*"
                column with MinWidth="{StaticResource ColMinWidthStar}". Budget: the fixed widths
                plus the star MinWidth fit 690 px, the usable table width at 1440x753 with the
                nav pane expanded (exempt: CellTemplating, Sort, ColumnLayout, ColumnLifecycle after "Add").
            -->
            <x:Double x:Key="ColMinWidthStar">140</x:Double>
            <x:Double x:Key="ColWidthShortName">160</x:Double>
            <x:Double x:Key="ColWidthLongName">200</x:Double>
            <x:Double x:Key="ColWidthEmail">220</x:Double>
            <x:Double x:Key="ColWidthDepartment">140</x:Double>
            <x:Double x:Key="ColWidthType">140</x:Double>
            <x:Double x:Key="ColWidthDate">110</x:Double>
            <!-- Full DatePicker: its own MinWidth is ~296 plus a 6 px margin each side. -->
            <x:Double x:Key="ColWidthDatePicker">310</x:Double>
            <!-- Full TimePicker: its own MinWidth is ~242 plus margins. -->
            <x:Double x:Key="ColWidthTimePicker">256</x:Double>
            <!-- ShiftTimeCompactTemplate (24 h, MinWidth 0, PickerSizing.FitToWidth): hh:mm fully
                 visible at this width. Without FitToWidth the picker's inner button stays 242 px
                 and the minutes are clipped. -->
            <x:Double x:Key="ColWidthTimeCompact">150</x:Double>
            <!-- CalendarDatePicker, the default date editor (JoinCalendarDateTemplate). -->
            <x:Double x:Key="ColWidthCalendarDate">170</x:Double>
            <x:Double x:Key="ColWidthStatus">120</x:Double>
            <x:Double x:Key="ColWidthNumber">100</x:Double>
            <!-- CheckBox column. A sortable header reserves 8 + 8 px padding and the 16 px sort
                 indicator, so "Active" (about 40 px at 14 px SemiBold) and "Seeded" need 84. -->
            <x:Double x:Key="ColWidthBoolean">84</x:Double>
            <!-- CheckBox column with a longer header, e.g. "Resolved" (about 57 px). -->
            <x:Double x:Key="ColWidthBooleanWide">96</x:Double>
            <!-- PersonPicture 28 px plus padding (AvatarTemplate). -->
            <x:Double x:Key="ColWidthAvatar">56</x:Double>
            <!-- Department / Country / Standing / Priority chips: "Engineering" plus dot fits. -->
            <x:Double x:Key="ColWidthChip">130</x:Double>
            <!-- Department / Office ComboBox: "Engineering" / "Singapore" not truncated. -->
            <x:Double x:Key="ColWidthCombo">150</x:Double>
            <!-- Details button (DetailsButtonTemplate). -->
            <x:Double x:Key="ColWidthAction">96</x:Double>
            <!-- TaskManager CPU / Memory / Disk / Network. -->
            <x:Double x:Key="ColWidthMetric">80</x:Double>
            <!-- FileExplorer Date modified. -->
            <x:Double x:Key="ColWidthDateTime">150</x:Double>
            <!-- FileProperties Property. -->
            <x:Double x:Key="ColWidthPropertyName">170</x:Double>
            <!-- Sort: Group column, stat columns, narrow stat columns. -->
            <x:Double x:Key="ColWidthNarrow">74</x:Double>
            <x:Double x:Key="ColWidthStat">52</x:Double>
            <x:Double x:Key="ColWidthStatNarrow">48</x:Double>
            <x:Double x:Key="ColWidthId">80</x:Double>
            <x:Double x:Key="ColWidthLocation">140</x:Double>
            <x:Double x:Key="ColWidthNotes">220</x:Double>
            <x:Double x:Key="ColWidthWrappedText">360</x:Double>

            <!--
                Chromeless section pattern: section header in bold body
                text + caption-sized description below + inline controls/content
                directly on the page background. Tables get a thin TableHostBorder.

                Keep these flat (no BasedOn) so they resolve before the merged
                theme resource dictionary in any code path.
            -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style x:Key="SectionDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="TableHostBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style x:Key="StatusReadoutLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="StatusReadoutValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!-- Canonical rail: one StackPanel per section, a caption under the
                 Shaping controls, and the Status grid. -->
            <Style x:Key="RailSectionStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="4"/>
            </Style>
            <Style x:Key="RailCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style x:Key="StatusGridStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12"/>
                <Setter Property="RowSpacing" Value="4"/>
            </Style>
            <Style x:Key="InlineActionsRowStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Spacing" Value="8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AppStatusBarBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="16,4"/>
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            </Style>
            <Style x:Key="AppStatusBarTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
