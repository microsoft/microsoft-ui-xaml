<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.0.1" />
  <!-- CLI benchmark host for TableView hierarchy variants. Speaks the protocol of the external
       perf harness (run-all.ps1 / sampler.py): one process per matrix cell, an L2 metrics CSV
       (emit option), a ready-file on first render (ready-file option), then exit. See README.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SamplesTargetFrameworkMoniker)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HierarchyBench</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &gt;= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- TableView is [MUX_PREVIEW] and surfaces as CS8305. -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
    <!-- Hierarchy API exposed by the WinUI package being measured: KeyBy (KeyBy + ParentBy(parent)),
         ParentKey2 (ParentBy(key, parent)) or Children (WithChildren). -->
    <HierarchyApi Condition="'$(HierarchyApi)' == ''">KeyBy</HierarchyApi>
    <DefineConstants Condition="'$(HierarchyApi)' == 'KeyBy'">$(DefineConstants);HIERARCHY_API_KEYBY</DefineConstants>
    <DefineConstants Condition="'$(HierarchyApi)' == 'ParentKey2'">$(DefineConstants);HIERARCHY_API_PARENTKEY2</DefineConstants>
    <DefineConstants Condition="'$(HierarchyApi)' == 'Children'">$(DefineConstants);HIERARCHY_API_CHILDREN</DefineConstants>
    <!-- perf\ holds the harness scripts and the standalone OSS comparator bench; not part of this app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);perf\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
</Project>
