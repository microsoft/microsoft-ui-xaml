<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUICsIslandsSampleApp.WinUIContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                x:Name="GenerationText"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                HorizontalAlignment="Center"
                Text="This content is compiled C# XAML hosted by DesktopWindowXamlSource." />
            <NumberBox
                x:Name="ValueNumberBox"
                Header="MUXC NumberBox"
                Value="1" />
            <Button
                HorizontalAlignment="Center"
                Click="IncrementButton_Click"
                Content="Increment value" />
            <!--
            Windows Community Toolkit controls do not successfully recover from shutting down WinUI.
            They need to release their custom DPs on process shutdown and re-register them on startup.

            <toolkit:SettingsCard
                Description="This managed Toolkit control is recreated with each WinUI generation."
                Header="Toolkit sample option">
                <ToggleSwitch
                    AutomationProperties.Name="Toolkit sample toggle" />
            </toolkit:SettingsCard>
            -->
        </StackPanel>
    </Grid>
</UserControl>
