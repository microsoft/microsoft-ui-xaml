<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExceptionContextLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Issue 11253 - Exception Context Lab">
    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12" Loaded="OnLoaded">
            <TextBlock Text="What happens after an async exception?" Style="{StaticResource TitleTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="RuntimeText" AutomationProperties.AutomationId="RuntimeLabel" TextWrapping="Wrap" />
            <TextBlock Text="The BEFORE app can terminate after loading an Expander when e.Handled is left false. The AFTER app should remain responsive in this scenario."
                       TextWrapping="Wrap" />
            <Border Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="OutcomeText" Text="Ready. A test throw may terminate the BEFORE app."
                               AutomationProperties.AutomationId="Outcome"
                               Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaseText" AutomationProperties.AutomationId="CaseState" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExceptionText" Text="UnhandledException calls: 0"
                               AutomationProperties.AutomationId="ExceptionEvents" TextWrapping="Wrap" />
                    <TextBlock x:Name="HeartbeatText" AutomationProperties.AutomationId="Heartbeat" />
                    <TextBlock x:Name="PingText" Text="UI checks: 0" AutomationProperties.AutomationId="UiChecks" />
                </StackPanel>
            </Border>
            <Button x:Name="LoadButton" Content="1. Load and expand Expander" Click="OnLoadExpander"
                    AutomationProperties.AutomationId="LoadExpander" />
            <ContentControl x:Name="ExpanderHost" HorizontalContentAlignment="Stretch" />
            <CheckBox x:Name="HandledBox" Content="Set e.Handled = true (control case)" Click="OnHandledChanged"
                      AutomationProperties.AutomationId="MarkHandled" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ThrowButton" Content="2. Throw async void exception" Click="OnThrow"
                        AutomationProperties.AutomationId="ThrowAsync" />
                <Button Content="3. Check UI response" Click="OnCheckUi" AutomationProperties.AutomationId="CheckUi" />
            </StackPanel>
            <TextBlock Text="Close and reopen for each fresh-process case. Removing an Expander would not undo its class initialization. Test without an Expander, with an Expander, and with e.Handled = true."
                       TextWrapping="Wrap" />
            <TextBlock Text="The handler writes sessions.log in this package's LocalState before returning. A recorded handler call does not mean the process survived. No exception is caught around the test throw."
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
