<Page
    x:Class="RecyclePoolSampleApp.Pages.SharedPoolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:RecyclePoolSampleApp.Common"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <DataTemplate x:Key="SharedTemplate">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,4">
                <TextBlock Text="{Binding Label}" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="Shared pool" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap"
                       Text="RecyclePool.SetPoolInstance attaches a pool to a DataTemplate, so every factory built on that template can find the same pool with GetPoolInstance. Both repeaters below share one pool: elements scrolled out of the left list are reused by the right one, and the owner affinity rule decides whether an element has to be reparented." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderThickness="1" CornerRadius="4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Repeater 1" Margin="10,8,10,0"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ScrollViewer x:Name="Scroller1" Grid.Row="1" Padding="8">
                        <muxc:ItemsRepeater x:Name="Repeater1">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Repeater 2" Margin="10,8,10,0"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ScrollViewer x:Name="Scroller2" Grid.Row="1" Padding="8">
                        <muxc:ItemsRepeater x:Name="Repeater2">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Scroll both" Click="OnScrollBoth" />
                    <Button Content="Reset counters" Click="OnResetCounters" />
                </StackPanel>
                <Button Content="GetPoolInstance(template)" Click="OnGetPoolInstance"
                        HorizontalAlignment="Stretch" />

                <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                           FontFamily="Consolas"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Factory state (shared)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StateText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Attached property" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="AttachedText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
