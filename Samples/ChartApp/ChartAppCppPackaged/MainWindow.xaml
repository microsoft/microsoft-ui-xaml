<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChartAppCppPackaged.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Microsoft.UI.Xaml.Controls.Charts"
    Title="Charts engineering sample">
    <!-- Keep themed backgrounds below the element whose RequestedTheme changes. -->
    <Grid x:Name="RootGrid" SizeChanged="OnLayoutSizeChanged">
        <Grid.Resources>
            <Style x:Key="ScenarioCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="EditorText" TargetType="TextBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="EditorChoice" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="EditorNumber" TargetType="NumberBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="EditorRow" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="RowSpacing" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid x:Name="ThemeRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <NavigationView x:Name="ScenarioNavigation" PaneTitle="Charts" OpenPaneLength="224"
                            PaneDisplayMode="Auto" CompactModeThresholdWidth="840" ExpandedModeThresholdWidth="1100"
                            IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                            SelectionChanged="OnScenarioSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavLine" Content="Line" Tag="line">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavArea" Content="Area" Tag="area">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavBar" Content="Bar" Tag="bar">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem x:Name="NavDateTime" Content="Date &amp; time" Tag="datetime">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavAxes" Content="Axes &amp; ordering" Tag="axes">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Sort" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavPresentation" Content="Labels &amp; markers" Tag="presentation">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavLive" Content="Live data" Tag="live">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ScenarioHeader" Margin="16,16,16,12" MaxWidth="1200" HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ScenarioHeading" Text="Line charts" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ScenarioDescription" Text="Compare monthly profit and expenses. Explore the legend and series defaults." Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="C++/WinRT | Packaged | Synthetic data" FontSize="12" Style="{StaticResource SecondaryText}" />
                        <ComboBox x:Name="ThemeChoice" Grid.Column="1" Width="184" SelectedIndex="0"
                                  AutomationProperties.Name="Theme" SelectionChanged="OnThemeChoiceChanged">
                            <ComboBoxItem Content="System theme" />
                            <ComboBoxItem Content="Light theme" />
                            <ComboBoxItem Content="Dark theme" />
                        </ComboBox>
                    </Grid>
                    <ScrollViewer x:Name="ScenarioScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" SizeChanged="OnViewportSizeChanged"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                        <StackPanel x:Name="ScenarioContent" Padding="16,0,16,16" Spacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
                            <Grid x:Name="LineScenario" ColumnSpacing="16" SizeChanged="OnWorkspaceSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource ScenarioCard}" VerticalAlignment="Top">
                                    <charts:Chart x:Name="MarkupChart" Height="240" FontSize="14" ShowLegend="True" LegendTitle="Monthly totals"
                                                  AutomationProperties.Name="Monthly profit and expenses, line chart"
                                                  AutomationProperties.HelpText="Six months of values are listed on the Live data page. Profit uses markers; expenses use a dashed line.">
                                        <charts:Chart.Data>
                                            <charts:Samples x:Name="Month" />
                                            <charts:Samples x:Name="Profit" />
                                            <charts:Samples x:Name="Expenses" />
                                        </charts:Chart.Data>
                                        <charts:LineSeries x:Name="ProfitSeries" Title="Monthly profit" StrokeThickness="3" ShowDataMarkers="True"
                                                           XValues="{x:Bind Month, Mode=OneTime}" YValues="{x:Bind Profit, Mode=OneTime}" />
                                        <charts:LineSeries x:Name="ExpensesSeries" Title="Monthly expenses" StrokeThickness="2" StrokeDashStyle="Dash" ShowDataLabels="True"
                                                           XValues="{x:Bind Month, Mode=OneTime}" YValues="{x:Bind Expenses, Mode=OneTime}" />
                                    </charts:Chart>
                                </Border>
                                <ScrollViewer x:Name="LineEditorScroll" Grid.Column="1" VerticalAlignment="Top" Padding="0,0,8,0"
                                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                    <StackPanel Spacing="12">
                                        <Border x:Name="SeriesEditorPanel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Legend and series" Style="{StaticResource SectionHeading}" />
                                                <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                    <ComboBox x:Name="PresentationSeriesComboBox" Header="Series" SelectionChanged="OnPresentationSeriesChanged" Style="{StaticResource EditorChoice}" />
                                                    <CheckBox x:Name="LineVisibleCheckBox" Content="Visible" IsChecked="True" VerticalAlignment="Bottom" Click="OnLineVisibleClick" />
                                                </Grid>
                                                <Grid x:Name="LineSeriesActions" Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                    <Button x:Name="LineAddSeriesButton" Content="Add series" Click="OnLineAddSeriesClick" />
                                                    <Button x:Name="LineRemoveSeriesButton" Content="Remove selected" Click="OnLineRemoveSeriesClick" />
                                                </Grid>
                                                <Grid x:Name="LineStyleEditors" Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                    <ComboBox x:Name="LineWeightChoice" Header="Line weight" SelectionChanged="OnLineChoiceChanged" Style="{StaticResource EditorChoice}">
                                                        <ComboBoxItem Content="Fine" /><ComboBoxItem Content="Thin" /><ComboBoxItem Content="Standard" /><ComboBoxItem Content="Bold" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="LineStyleChoice" Header="Line style" SelectionChanged="OnLineChoiceChanged" Style="{StaticResource EditorChoice}">
                                                        <ComboBoxItem Content="Solid" /><ComboBoxItem Content="Dash" /><ComboBoxItem Content="Dot" /><ComboBoxItem Content="Dash / dot" /><ComboBoxItem Content="Dash / dot / dot" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="LineColorChoice" Header="Stroke color" SelectionChanged="OnLineChoiceChanged" Style="{StaticResource EditorChoice}">
                                                        <ComboBoxItem Content="Original" /><ComboBoxItem Content="Blue" /><ComboBoxItem Content="Teal" /><ComboBoxItem Content="Amber" /><ComboBoxItem Content="Purple" /><ComboBoxItem Content="Rose" /><ComboBoxItem Content="Slate" /><ComboBoxItem Content="Green" /><ComboBoxItem Content="Orange" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="LineMarkerChoice" Header="Marker shape" SelectionChanged="OnLineChoiceChanged" Style="{StaticResource EditorChoice}">
                                                        <ComboBoxItem Content="None" /><ComboBoxItem Content="Square" /><ComboBoxItem Content="Diamond" /><ComboBoxItem Content="Triangle" /><ComboBoxItem Content="X" /><ComboBoxItem Content="Asterisk" /><ComboBoxItem Content="Short dash" /><ComboBoxItem Content="Long dash" /><ComboBoxItem Content="Circle" /><ComboBoxItem Content="Plus" />
                                                    </ComboBox>
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="LegendTitleTextBox" Header="Legend title" Text="Monthly totals" Style="{StaticResource EditorText}" />
                                                    <Button x:Name="ApplyLegendTitleButton" Grid.Column="1" Content="Apply title" VerticalAlignment="Bottom" Click="OnApplyLegendTitleClick" />
                                                </Grid>
                                                <Grid Style="{StaticResource EditorRow}" Tag="Choices" SizeChanged="OnEditorSizeChanged">
                                                    <CheckBox x:Name="ShowDataLabelsCheckBox" Content="Default labels" Click="OnShowDataLabelsClick" />
                                                    <CheckBox x:Name="ShowDataMarkersCheckBox" Content="Default markers" IsChecked="True" Click="OnShowDataMarkersClick" />
                                                    <CheckBox x:Name="LegendVisibilityCheckBox" Content="Show legend" IsChecked="True" Click="OnLegendVisibilityClick" />
                                                    <Button x:Name="LineResetButton" Content="Reset line example" Click="OnLineResetClick" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PresentationEditorPanel" Visibility="Collapsed">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Point overrides" VerticalAlignment="Center" Style="{StaticResource SectionHeading}" />
                                                    <Button x:Name="ClearOverridesButton" Grid.Column="1" Content="Clear overrides" Click="OnClearOverridesClick" />
                                                </Grid>
                                                <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                    <NumberBox x:Name="OverrideIndexNumberBox" Header="Point index (0-5)" Style="{StaticResource EditorNumber}"
                                                               Minimum="0" Maximum="5" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                                               AutomationProperties.HelpText="Overrides remain attached to their original point index."
                                                               ToolTipService.ToolTip="Overrides remain attached to their original point index."
                                                               ValidationMode="Disabled" ValueChanged="OnOverrideIndexChanged" LostFocus="OnOverrideIndexLostFocus" />
                                                    <StackPanel>
                                                        <CheckBox x:Name="DataLabelBrushCheckBox" AutomationProperties.Name="Blue label brush" Click="OnDataLabelBrushClick">
                                                            <TextBlock Text="Blue label brush" TextWrapping="Wrap" />
                                                        </CheckBox>
                                                        <CheckBox x:Name="DataMarkerBrushCheckBox" AutomationProperties.Name="Orange marker brush" Click="OnDataMarkerBrushClick">
                                                            <TextBlock Text="Orange marker brush" TextWrapping="Wrap" />
                                                        </CheckBox>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                    <StackPanel Spacing="8">
                                                        <TextBox x:Name="LabelOverrideTextBox" Header="Label override" Style="{StaticResource EditorText}" />
                                                        <CheckBox x:Name="LabelOverrideBrushCheckBox" Content="Green brush" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Button x:Name="ApplyLabelButton" Content="Apply" AutomationProperties.Name="Apply label" Click="OnApplyLabelOverrideClick" />
                                                            <Button x:Name="RemoveLabelButton" Grid.Column="1" Content="Remove" AutomationProperties.Name="Remove label" Click="OnRemoveLabelOverrideClick" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Spacing="8">
                                                        <ComboBox x:Name="MarkerShapeComboBox" Header="Marker shape" SelectedIndex="8" Style="{StaticResource EditorChoice}">
                                                            <ComboBoxItem Content="None" /><ComboBoxItem Content="Square" />
                                                            <ComboBoxItem Content="Diamond" /><ComboBoxItem Content="Triangle" />
                                                            <ComboBoxItem Content="X" /><ComboBoxItem Content="Asterisk" />
                                                            <ComboBoxItem Content="ShortDash" /><ComboBoxItem Content="LongDash" />
                                                            <ComboBoxItem Content="Circle" /><ComboBoxItem Content="Plus" />
                                                        </ComboBox>
                                                        <CheckBox x:Name="MarkerOverrideBrushCheckBox" Content="Purple brush" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Button x:Name="ApplyMarkerButton" Content="Apply" AutomationProperties.Name="Apply marker" Click="OnApplyMarkerOverrideClick" />
                                                            <Button x:Name="RemoveMarkerButton" Grid.Column="1" Content="Remove" AutomationProperties.Name="Remove marker" Click="OnRemoveMarkerOverrideClick" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="AxisSeriesWarning" Visibility="Collapsed" Text="Monthly profit was removed. Return to Line and choose Reset line example to restore the axes demo." Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                                        <Border x:Name="AxesEditorPanel" Visibility="Collapsed">
                                            <ContentControl x:Name="AxisControls" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Axes of Monthly profit" Style="{StaticResource SectionHeading}" />
                                                    <TextBlock Text="Clear any number for Auto. Spacing must be positive; minimum must be less than maximum. Expenses keeps automatic axes." Style="{StaticResource SecondaryText}" />
                                                    <Grid Style="{StaticResource EditorRow}" Tag="Bounds" SizeChanged="OnEditorSizeChanged" AutomationProperties.Name="Linear Y axis bounds">
                                                        <NumberBox x:Name="LinearMinBox" Header="Minimum" Style="{StaticResource EditorNumber}" PlaceholderText="Auto" ValidationMode="Disabled" SpinButtonPlacementMode="Compact" ValueChanged="OnLinearMinChanged" LostFocus="OnAxisNumberLostFocus" />
                                                        <NumberBox x:Name="LinearMaxBox" Header="Maximum" Style="{StaticResource EditorNumber}" PlaceholderText="Auto" ValidationMode="Disabled" SpinButtonPlacementMode="Compact" ValueChanged="OnLinearMaxChanged" LostFocus="OnAxisNumberLostFocus" />
                                                        <NumberBox x:Name="LinearSpacingBox" Header="Spacing" Style="{StaticResource EditorNumber}" PlaceholderText="Auto" ValidationMode="Disabled" SpinButtonPlacementMode="Compact" ValueChanged="OnLinearSpacingChanged" LostFocus="OnAxisNumberLostFocus" />
                                                    </Grid>
                                                    <TextBlock Text="Category X axis" FontWeight="SemiBold" />
                                                    <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                        <ComboBox x:Name="SortKeyBox" Header="Sort key" SelectedIndex="0" SelectionChanged="OnSortKeyChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>Index</x:String><x:String>Value</x:String>
                                                        </ComboBox>
                                                        <ComboBox x:Name="SortOrderBox" Header="Sort order" SelectedIndex="0" SelectionChanged="OnSortOrderChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>Ascending</x:String><x:String>Descending</x:String>
                                                        </ComboBox>
                                                    </Grid>
                                                    <TextBlock Text="Appearance of both explicit axes" FontWeight="SemiBold" />
                                                    <Grid Style="{StaticResource EditorRow}" Tag="Choices" SizeChanged="OnEditorSizeChanged">
                                                        <CheckBox x:Name="AxisVisibleCheck" Content="Visible" IsChecked="True" Click="OnAxisVisibleChanged" />
                                                        <CheckBox x:Name="TickLabelsCheck" Content="Tick labels" IsChecked="True" Click="OnTickLabelsChanged" />
                                                        <CheckBox x:Name="TickMarksCheck" Content="Tick marks" Click="OnTickMarksChanged" />
                                                    </Grid>
                                                    <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                                        <ComboBox x:Name="GridLinesBox" Header="Grid lines" SelectedIndex="0" SelectionChanged="OnGridLinesChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>None</x:String><x:String>Major</x:String><x:String>Minor</x:String>
                                                        </ComboBox>
                                                        <ComboBox x:Name="GridLineBrushBox" Header="Major grid" SelectedIndex="0" SelectionChanged="OnGridLineBrushChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                                        </ComboBox>
                                                        <ComboBox x:Name="TickBrushBox" Header="Ticks" SelectedIndex="0" SelectionChanged="OnTickBrushChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                                        </ComboBox>
                                                        <ComboBox x:Name="TickLabelBrushBox" Header="Tick labels" SelectedIndex="0" SelectionChanged="OnTickLabelBrushChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                                        </ComboBox>
                                                        <ComboBox x:Name="AxisLineBrushBox" Header="Axis line" SelectedIndex="0" SelectionChanged="OnAxisLineBrushChanged" Style="{StaticResource EditorChoice}">
                                                            <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                                        </ComboBox>
                                                    </Grid>
                                                </StackPanel>
                                            </ContentControl>
                                        </Border>
                                        <TextBlock x:Name="PresentationKnobStatusText" Text="Choose settings and apply an override." Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                                        <Expander Header="Current data" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <TextBlock Text="{Binding Text, ElementName=DataText}" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="AreaScenario" ColumnSpacing="16" Visibility="Collapsed" SizeChanged="OnWorkspaceSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource ScenarioCard}" VerticalAlignment="Top">
                                    <charts:Chart x:Name="AreaMarkupChart" Height="240" FontSize="14" ShowLegend="True" AutomationProperties.Name="Monthly area chart">
                                        <charts:Chart.Data><charts:Samples x:Name="AreaMonth" /><charts:Samples x:Name="AreaValues" /></charts:Chart.Data>
                                        <charts:AreaSeries x:Name="MarkupAreaSeries" Title="Monthly area" Fill="#604F6BED" Stroke="#FF3047B8" StrokeThickness="2"
                                                           XValues="{x:Bind AreaMonth, Mode=OneTime}" YValues="{x:Bind AreaValues, Mode=OneTime}" />
                                    </charts:Chart>
                                </Border>
                                <ScrollViewer x:Name="AreaEditorScroll" Grid.Column="1" VerticalAlignment="Top" Padding="0,0,8,0"
                                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Area options" Style="{StaticResource SectionHeading}" />
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <ComboBox x:Name="AreaSeriesChoice" Header="Series" SelectionChanged="OnAreaSeriesChanged" Style="{StaticResource EditorChoice}" />
                                            <CheckBox x:Name="AreaVisibleCheckBox" Content="Visible" IsChecked="True" VerticalAlignment="Bottom" Click="OnAreaVisibleClick" />
                                        </Grid>
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <Button x:Name="AreaAddSeriesButton" Content="Add series" Click="OnAreaAddSeriesClick" />
                                            <Button x:Name="AreaRemoveSeriesButton" Content="Remove selected" Click="OnAreaRemoveSeriesClick" />
                                        </Grid>
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <ComboBox x:Name="AreaColorChoice" Header="Series color" SelectedIndex="0" SelectionChanged="OnAreaChoiceChanged" Style="{StaticResource EditorChoice}">
                                                <ComboBoxItem Content="Original" /><ComboBoxItem Content="Blue" /><ComboBoxItem Content="Teal" /><ComboBoxItem Content="Amber" /><ComboBoxItem Content="Purple" /><ComboBoxItem Content="Rose" /><ComboBoxItem Content="Slate" /><ComboBoxItem Content="Green" /><ComboBoxItem Content="Orange" />
                                            </ComboBox>
                                            <ComboBox x:Name="AreaFillChoice" Header="Area fill" SelectedIndex="0" SelectionChanged="OnAreaChoiceChanged" Style="{StaticResource EditorChoice}">
                                                <ComboBoxItem Content="Soft fill" /><ComboBoxItem Content="Strong fill" /><ComboBoxItem Content="Outline only" />
                                            </ComboBox>
                                            <ComboBox x:Name="AreaMarkerChoice" Header="Marker shape" SelectionChanged="OnAreaMarkerChanged" Style="{StaticResource EditorChoice}">
                                                <ComboBoxItem Content="None" /><ComboBoxItem Content="Square" /><ComboBoxItem Content="Diamond" /><ComboBoxItem Content="Triangle" /><ComboBoxItem Content="X" /><ComboBoxItem Content="Asterisk" /><ComboBoxItem Content="Short dash" /><ComboBoxItem Content="Long dash" /><ComboBoxItem Content="Circle" /><ComboBoxItem Content="Plus" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource EditorRow}" Tag="Choices" SizeChanged="OnEditorSizeChanged">
                                            <CheckBox x:Name="AreaValuesCheckBox" Content="Value labels" IsChecked="False" Click="OnAreaValuesClick" />
                                            <CheckBox x:Name="AreaMarkersCheckBox" Content="Point markers" IsChecked="False" Click="OnAreaMarkersClick" />
                                            <CheckBox x:Name="AreaLegendCheckBox" Content="Legend" IsChecked="True" Click="OnAreaLegendClick" />
                                        </Grid>
                                        <Button x:Name="AreaResetButton" Content="Reset area example" Click="OnAreaResetClick" />
                                        <TextBlock x:Name="AreaStatusText" Text="Choose options for the area example." Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                                        <Expander x:Name="AreaDataExpander" Header="Current data" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <TextBlock x:Name="AreaDataText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="BarScenario" ColumnSpacing="16" Visibility="Collapsed" SizeChanged="OnWorkspaceSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource ScenarioCard}" VerticalAlignment="Top">
                                    <charts:Chart x:Name="BarMarkupChart" Height="240" FontSize="14" ShowLegend="True" AutomationProperties.Name="Monthly bar chart">
                                        <charts:Chart.Data><charts:Samples x:Name="BarMonth" /><charts:Samples x:Name="BarValues" /></charts:Chart.Data>
                                        <charts:BarSeries x:Name="MarkupBarSeries" Title="Monthly bars" Orientation="Horizontal" Fill="#FF0F6CBD" Stroke="#FF073B66" StrokeThickness="1.5"
                                                          XValues="{x:Bind BarMonth, Mode=OneTime}" YValues="{x:Bind BarValues, Mode=OneTime}" />
                                    </charts:Chart>
                                </Border>
                                <ScrollViewer x:Name="BarEditorScroll" Grid.Column="1" VerticalAlignment="Top" Padding="0,0,8,0"
                                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Bar options" Style="{StaticResource SectionHeading}" />
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <ComboBox x:Name="BarSeriesChoice" Header="Series" SelectionChanged="OnBarSeriesChanged" Style="{StaticResource EditorChoice}" />
                                            <CheckBox x:Name="BarVisibleCheckBox" Content="Visible" IsChecked="True" VerticalAlignment="Bottom" Click="OnBarVisibleClick" />
                                        </Grid>
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <Button x:Name="BarAddSeriesButton" Content="Add series" Click="OnBarAddSeriesClick" />
                                            <Button x:Name="BarRemoveSeriesButton" Content="Remove selected" Click="OnBarRemoveSeriesClick" />
                                        </Grid>
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <ComboBox x:Name="BarColorChoice" Header="Series color" SelectedIndex="0" SelectionChanged="OnBarColorChanged" Style="{StaticResource EditorChoice}">
                                                <ComboBoxItem Content="Original" /><ComboBoxItem Content="Blue" /><ComboBoxItem Content="Teal" /><ComboBoxItem Content="Amber" /><ComboBoxItem Content="Purple" /><ComboBoxItem Content="Rose" /><ComboBoxItem Content="Slate" /><ComboBoxItem Content="Green" /><ComboBoxItem Content="Orange" />
                                            </ComboBox>
                                            <ComboBox x:Name="BarOrientationChoice" Header="Orientation" SelectionChanged="OnBarOrientationChanged" Style="{StaticResource EditorChoice}">
                                                <ComboBoxItem Content="Horizontal bars" /><ComboBoxItem Content="Vertical columns" />
                                            </ComboBox>
                                            <ComboBox x:Name="BarMarkerChoice" Header="Marker shape" SelectionChanged="OnBarMarkerChanged" Style="{StaticResource EditorChoice}">
                                                <ComboBoxItem Content="None" /><ComboBoxItem Content="Square" /><ComboBoxItem Content="Diamond" /><ComboBoxItem Content="Triangle" /><ComboBoxItem Content="X" /><ComboBoxItem Content="Asterisk" /><ComboBoxItem Content="Short dash" /><ComboBoxItem Content="Long dash" /><ComboBoxItem Content="Circle" /><ComboBoxItem Content="Plus" />
                                            </ComboBox>
                                            <Button x:Name="BarOrientationButton" Content="Toggle orientation" VerticalAlignment="Bottom"
                                                    AutomationProperties.Name="Toggle connected bar orientation"
                                                    AutomationProperties.HelpText="Change orientation while keeping the series connected to its explicit axes."
                                                    Click="OnToggleBarOrientationClick" />
                                        </Grid>
                                        <TextBlock x:Name="BarOrientationText" Text="Orientation: Horizontal" Style="{StaticResource SecondaryText}" />
                                        <Grid Style="{StaticResource EditorRow}" Tag="Choices" SizeChanged="OnEditorSizeChanged">
                                            <CheckBox x:Name="BarValuesCheckBox" Content="Value labels" IsChecked="False" Click="OnBarValuesClick" />
                                            <CheckBox x:Name="BarMarkersCheckBox" Content="Point markers" IsChecked="False" Click="OnBarMarkersClick" />
                                            <CheckBox x:Name="BarLegendCheckBox" Content="Legend" IsChecked="True" Click="OnBarLegendClick" />
                                        </Grid>
                                        <Button x:Name="BarResetButton" Content="Reset bar example" Click="OnBarResetClick" />
                                        <TextBlock x:Name="BarStatusText" Text="Choose options for the bar example." Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                                        <Expander x:Name="BarDataExpander" Header="Current data" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <TextBlock x:Name="BarDataText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="DateTimeScenario" ColumnSpacing="16" RowSpacing="12" Visibility="Collapsed" SizeChanged="OnDateLayoutSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="DailyDateCard" Style="{StaticResource ScenarioCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Daily values | 75 days" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="1 Jan - 15 Mar 2024; daily values and target." Style="{StaticResource SecondaryText}" />
                                        <Border x:Name="DtChartHostA" Height="240" MaxWidth="600" />
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <ComboBox x:Name="DtIntervalTypeBoxA" Header="Date interval" SelectedIndex="0" SelectionChanged="OnDtIntervalTypeAChanged" Style="{StaticResource EditorChoice}">
                                                <x:String>Auto</x:String><x:String>Day</x:String><x:String>Week</x:String><x:String>Month</x:String><x:String>Year</x:String>
                                            </ComboBox>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox x:Name="DtLabelFormatBoxA" Header="Label format" PlaceholderText="Default (shortdate)" Style="{StaticResource EditorText}" />
                                                <Button x:Name="ApplyDailyFormatButton" Grid.Column="1" Content="Apply" AutomationProperties.Name="Apply daily label format" VerticalAlignment="Bottom" Click="OnDtLabelFormatAApply" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="DtWarningA" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <Expander Header="Daily data" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <TextBlock x:Name="DtDataTextA" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MonthlyDateCard" Grid.Row="1" Style="{StaticResource ScenarioCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Monthly values | 3 years" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="Jan 2022 - Dec 2024; monthly values and target." Style="{StaticResource SecondaryText}" />
                                        <Border x:Name="DtChartHostB" Height="240" MaxWidth="400" />
                                        <Grid Style="{StaticResource EditorRow}" SizeChanged="OnEditorSizeChanged">
                                            <ComboBox x:Name="DtIntervalTypeBoxB" Header="Date interval" SelectedIndex="0" SelectionChanged="OnDtIntervalTypeBChanged" Style="{StaticResource EditorChoice}">
                                                <x:String>Auto</x:String><x:String>Day</x:String><x:String>Week</x:String><x:String>Month</x:String><x:String>Year</x:String>
                                            </ComboBox>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox x:Name="DtLabelFormatBoxB" Header="Label format" PlaceholderText="Default (shortdate)" Style="{StaticResource EditorText}" />
                                                <Button x:Name="ApplyMonthlyFormatButton" Grid.Column="1" Content="Apply" AutomationProperties.Name="Apply monthly label format" VerticalAlignment="Bottom" Click="OnDtLabelFormatBApply" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="DtWarningB" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <Expander Header="Monthly data" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <TextBlock x:Name="DtDataTextB" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="DateFormatHelp" Grid.Row="2" Text="Label format uses Windows DateTimeFormatter templates, for example day month.abbreviated or month year. Empty uses shortdate. Unsupported templates can fall back to platform date labels." Style="{StaticResource SecondaryText}" />
                            </Grid>

                            <Grid x:Name="LiveScenario" ColumnSpacing="16" Visibility="Collapsed" SizeChanged="OnWorkspaceSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource ScenarioCard}" VerticalAlignment="Top">
                                    <Border x:Name="CodeChartHost" Height="240" />
                                </Border>
                                <ScrollViewer x:Name="LiveEditorScroll" Grid.Column="1" VerticalAlignment="Top" Padding="0,0,8,0"
                                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Live updates" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="One value in each of three observable vectors updates each second, including the monthly lines. Sources are populated after the series is connected." Style="{StaticResource SecondaryText}" />
                                        <Button x:Name="UpdatesButton" Content="Pause updates" Click="OnToggleUpdatesClick" />
                                        <Button x:Name="SecondaryButton" Click="OnToggleSecondaryClick" AutomationProperties.Name="Toggle secondary UI thread">
                                            <TextBlock Text="Toggle secondary UI thread" TextWrapping="Wrap" />
                                        </Button>
                                        <TextBlock Text="The secondary chart and data use an independent UI thread." Style="{StaticResource SecondaryText}" />
                                        <Expander x:Name="LiveDataExpander" Header="Current data" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <TextBlock x:Name="DataText" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.Name="Current primary chart data" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16,8">
                        <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
