<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChartAppCppPackaged.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Microsoft.UI.Xaml.Controls.Charts"
    Title="Charts engineering sample">
    <!-- Keep themed backgrounds below the element whose RequestedTheme changes. -->
    <Grid x:Name="RootGrid">
        <Grid x:Name="ThemeRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" MinWidth="340" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <TextBlock Text="Charts engineering sample" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Explore observable data, series presentation, axes and dates. All data is synthetic. Readable data accompanies each chart." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LightButton" Content="Light" Click="OnLightClick" />
                        <Button x:Name="DarkButton" Content="Dark" Click="OnDarkClick" />
                        <Button x:Name="SystemButton" Content="System" Click="OnSystemClick" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Button x:Name="UpdatesButton" Content="Pause updates" Click="OnToggleUpdatesClick" />
                        <Button x:Name="SecondaryButton" Content="Toggle secondary UI thread" Click="OnToggleSecondaryClick" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Primary data updates once per second." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Pivot>
                        <PivotItem Header="Charts">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Line chart from markup" FontSize="20" FontWeight="SemiBold" />
                                <charts:Chart x:Name="MarkupChart" Height="280" ShowLegend="True" LegendTitle="Monthly totals"
                                              AutomationProperties.Name="Monthly profit and expenses, line chart"
                                              AutomationProperties.HelpText="Six months of data are listed under Current data. Profit uses markers; expenses use a dashed line.">
                                    <charts:Chart.Data>
                                        <charts:Samples x:Name="Month" />
                                        <charts:Samples x:Name="Profit" />
                                        <charts:Samples x:Name="Expenses" />
                                    </charts:Chart.Data>
                                    <charts:LineSeries x:Name="ProfitSeries" Title="Monthly profit" StrokeThickness="3" ShowDataMarkers="True"
                                                       XValues="{x:Bind Month, Mode=OneTime}" YValues="{x:Bind Profit, Mode=OneTime}" />
                                    <charts:LineSeries x:Name="ExpensesSeries" Title="Monthly expenses" StrokeThickness="2" StrokeDashStyle="Dash" ShowDataLabels="True"
                                                       XValues="{x:Bind Month, Mode=OneTime}" YValues="{x:Bind Expenses, Mode=OneTime}" />
                                </charts:Chart>
                                <TextBlock Text="Presentation knobs" FontSize="20" FontWeight="SemiBold" />
                                <CheckBox x:Name="LegendVisibilityCheckBox" Content="Show legend" IsChecked="True" Click="OnLegendVisibilityClick" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="LegendTitleTextBox" Header="Legend title" Width="220" Text="Monthly totals" />
                                    <Button Content="Apply title" VerticalAlignment="Bottom" Click="OnApplyLegendTitleClick" />
                                </StackPanel>
                                <ComboBox x:Name="PresentationSeriesComboBox" Header="Series" SelectedIndex="0" SelectionChanged="OnPresentationSeriesChanged">
                                    <ComboBoxItem Content="Monthly profit" /><ComboBoxItem Content="Monthly expenses" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox x:Name="ShowDataLabelsCheckBox" Content="Default labels" Click="OnShowDataLabelsClick" />
                                    <CheckBox x:Name="ShowDataMarkersCheckBox" Content="Default markers" IsChecked="True" Click="OnShowDataMarkersClick" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox x:Name="DataLabelBrushCheckBox" Content="Blue label brush" Click="OnDataLabelBrushClick" />
                                    <CheckBox x:Name="DataMarkerBrushCheckBox" Content="Orange marker brush" Click="OnDataMarkerBrushClick" />
                                </StackPanel>
                                <NumberBox x:Name="OverrideIndexNumberBox" Header="Point index (0–5)" Width="160" HorizontalAlignment="Left"
                                           Minimum="0" Maximum="5" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                           ValidationMode="Disabled" ValueChanged="OnOverrideIndexChanged" LostFocus="OnOverrideIndexLostFocus" />
                                <TextBox x:Name="LabelOverrideTextBox" Header="Label override" MaxWidth="340" HorizontalAlignment="Left" MinWidth="220" />
                                <CheckBox x:Name="LabelOverrideBrushCheckBox" Content="Green brush" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Apply label" Click="OnApplyLabelOverrideClick" />
                                    <Button Content="Remove label" Click="OnRemoveLabelOverrideClick" />
                                </StackPanel>
                                <ComboBox x:Name="MarkerShapeComboBox" Header="Marker shape" SelectedIndex="8">
                                    <ComboBoxItem Content="None" /><ComboBoxItem Content="Square" />
                                    <ComboBoxItem Content="Diamond" /><ComboBoxItem Content="Triangle" />
                                    <ComboBoxItem Content="X" /><ComboBoxItem Content="Asterisk" />
                                    <ComboBoxItem Content="ShortDash" /><ComboBoxItem Content="LongDash" />
                                    <ComboBoxItem Content="Circle" /><ComboBoxItem Content="Plus" />
                                </ComboBox>
                                <CheckBox x:Name="MarkerOverrideBrushCheckBox" Content="Purple brush" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Apply marker" Click="OnApplyMarkerOverrideClick" />
                                    <Button Content="Remove marker" Click="OnRemoveMarkerOverrideClick" />
                                </StackPanel>
                                <Button Content="Clear overrides" Click="OnClearOverridesClick" />
                                <TextBlock x:Name="PresentationKnobStatusText" Text="Choose settings and apply an override." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Axis controls — explicit axes of Monthly profit (first series)" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Expenses retains automatic axes. Clear a number to restore Auto; spacing must be positive and minimum must be less than maximum." TextWrapping="Wrap" />
                                <TextBlock Text="LinearAxis Y" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="LinearMinBox" Header="Minimum" Width="100" PlaceholderText="Auto" ValidationMode="Disabled" SpinButtonPlacementMode="Compact" ValueChanged="OnLinearMinChanged" LostFocus="OnAxisNumberLostFocus" />
                                    <NumberBox x:Name="LinearMaxBox" Header="Maximum" Width="100" PlaceholderText="Auto" ValidationMode="Disabled" SpinButtonPlacementMode="Compact" ValueChanged="OnLinearMaxChanged" LostFocus="OnAxisNumberLostFocus" />
                                    <NumberBox x:Name="LinearSpacingBox" Header="Spacing" Width="100" PlaceholderText="Auto" ValidationMode="Disabled" SpinButtonPlacementMode="Compact" ValueChanged="OnLinearSpacingChanged" LostFocus="OnAxisNumberLostFocus" />
                                </StackPanel>
                                <TextBlock Text="CategoryAxis X" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="SortKeyBox" Header="SortKey" SelectedIndex="0" SelectionChanged="OnSortKeyChanged">
                                        <x:String>Index</x:String><x:String>Value</x:String>
                                    </ComboBox>
                                    <ComboBox x:Name="SortOrderBox" Header="SortOrder" SelectedIndex="0" SelectionChanged="OnSortOrderChanged">
                                        <x:String>Ascending</x:String><x:String>Descending</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Presentation (both explicit axes)" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox x:Name="AxisVisibleCheck" Content="Visible" IsChecked="True" Click="OnAxisVisibleChanged" />
                                    <CheckBox x:Name="TickLabelsCheck" Content="Tick labels" IsChecked="True" Click="OnTickLabelsChanged" />
                                    <CheckBox x:Name="TickMarksCheck" Content="Tick marks" Click="OnTickMarksChanged" />
                                </StackPanel>
                                <ComboBox x:Name="GridLinesBox" Header="Grid lines" SelectedIndex="0" SelectionChanged="OnGridLinesChanged">
                                    <x:String>None</x:String><x:String>Major</x:String><x:String>Minor</x:String>
                                </ComboBox>
                                <TextBlock Text="Brush overrides (both explicit axes)" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="GridLineBrushBox" Header="Major grid" SelectedIndex="0" SelectionChanged="OnGridLineBrushChanged">
                                        <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                    </ComboBox>
                                    <ComboBox x:Name="TickBrushBox" Header="Ticks" SelectedIndex="0" SelectionChanged="OnTickBrushChanged">
                                        <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="TickLabelBrushBox" Header="Tick labels" SelectedIndex="0" SelectionChanged="OnTickLabelBrushChanged">
                                        <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                    </ComboBox>
                                    <ComboBox x:Name="AxisLineBrushBox" Header="Axis line" SelectedIndex="0" SelectionChanged="OnAxisLineBrushChanged">
                                        <x:String>Theme</x:String><x:String>Red</x:String><x:String>Blue</x:String><x:String>Green</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Area chart from markup" FontSize="20" FontWeight="SemiBold" />
                                <charts:Chart x:Name="AreaMarkupChart" Height="220" ShowLegend="True" AutomationProperties.Name="Monthly area, January through June: 8, 18, 14, 29, 24, 37">
                                    <charts:Chart.Data><charts:Samples x:Name="AreaMonth" /><charts:Samples x:Name="AreaValues" /></charts:Chart.Data>
                                    <charts:AreaSeries x:Name="MarkupAreaSeries" Title="Monthly area" Fill="#604F6BED" Stroke="#FF3047B8" StrokeThickness="2"
                                                       XValues="{x:Bind AreaMonth, Mode=OneTime}" YValues="{x:Bind AreaValues, Mode=OneTime}" />
                                </charts:Chart>
                                <TextBlock Text="Area, Jan–Jun: 8, 18, 14, 29, 24, 37." TextWrapping="Wrap" />
                                <TextBlock Text="Bar chart from markup" FontSize="20" FontWeight="SemiBold" />
                                <charts:Chart x:Name="BarMarkupChart" Height="220" ShowLegend="True" AutomationProperties.Name="Monthly bars, January through June: 12, 20, 17, 31, 26, 39">
                                    <charts:Chart.Data><charts:Samples x:Name="BarMonth" /><charts:Samples x:Name="BarValues" /></charts:Chart.Data>
                                    <charts:BarSeries x:Name="MarkupBarSeries" Title="Monthly bars" Orientation="Horizontal" Fill="#FF0F6CBD" Stroke="#FF073B66" StrokeThickness="1.5"
                                                      XValues="{x:Bind BarMonth, Mode=OneTime}" YValues="{x:Bind BarValues, Mode=OneTime}" />
                                </charts:Chart>
                                <TextBlock Text="Bars, Jan–Jun: 12, 20, 17, 31, 26, 39." TextWrapping="Wrap" />
                                <Button Content="Toggle connected bar orientation" Click="OnToggleBarOrientationClick" />
                                <TextBlock Text="Line chart from code" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="The series is connected before its sources are populated. A value in each of three observable vectors changes once per second." TextWrapping="Wrap" />
                                <Border x:Name="CodeChartHost" Height="240" />
                                <TextBlock Text="Current data" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="DataText" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.Name="Current primary chart data" />
                            </StackPanel>
                        </PivotItem>
                        <PivotItem Header="DateTime">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Short range (75 days): Day · Week · Month" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border x:Name="DtChartHostA" Height="360" />
                                <ComboBox x:Name="DtIntervalTypeBoxA" Header="IntervalType" SelectedIndex="0" SelectionChanged="OnDtIntervalTypeAChanged">
                                    <x:String>Auto</x:String><x:String>Day</x:String><x:String>Week</x:String><x:String>Month</x:String><x:String>Year</x:String>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="DtLabelFormatBoxA" Header="LabelFormat" Width="240" PlaceholderText="Default (shortdate)" />
                                    <Button Content="Apply" VerticalAlignment="Bottom" Click="OnDtLabelFormatAApply" />
                                </StackPanel>
                                <TextBlock x:Name="DtWarningA" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <Expander Header="Daily data — 1 January to 15 March 2024">
                                    <TextBlock x:Name="DtDataTextA" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Expander>
                                <TextBlock Text="Long range (3 years, monthly): Month · Year" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border x:Name="DtChartHostB" Height="360" />
                                <ComboBox x:Name="DtIntervalTypeBoxB" Header="IntervalType" SelectedIndex="0" SelectionChanged="OnDtIntervalTypeBChanged">
                                    <x:String>Auto</x:String><x:String>Day</x:String><x:String>Week</x:String><x:String>Month</x:String><x:String>Year</x:String>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="DtLabelFormatBoxB" Header="LabelFormat" Width="240" PlaceholderText="Default (shortdate)" />
                                    <Button Content="Apply" VerticalAlignment="Bottom" Click="OnDtLabelFormatBApply" />
                                </StackPanel>
                                <TextBlock x:Name="DtWarningB" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="LabelFormat uses Windows DateTimeFormatter templates, for example day month.abbreviated or month year. Empty uses shortdate. Unsupported templates can fall back to platform date labels." TextWrapping="Wrap" />
                                <Expander Header="Monthly data — January 2022 to December 2024">
                                    <TextBlock x:Name="DtDataTextB" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Expander>
                            </StackPanel>
                        </PivotItem>
                    </Pivot>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
