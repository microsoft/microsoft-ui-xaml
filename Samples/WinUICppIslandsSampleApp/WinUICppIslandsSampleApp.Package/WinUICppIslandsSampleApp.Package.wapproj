<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <GenerateAppxPackageOnBuild>True</GenerateAppxPackageOnBuild>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <DebuggerType>NativeOnly</DebuggerType>
    <BackgroundTaskDebugEngines>NativeOnly</BackgroundTaskDebugEngines>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>590b9371-8d59-451e-8422-8567ea878a73</ProjectGuid>
    <TargetPlatformVersion>$(WindowsSdkTargetPlatformVersion)</TargetPlatformVersion>
    <TargetPlatformMinVersion>$(WindowsAppSdkTargetPlatformVersion)</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxPackageName>WinUICppIslandsSampleApp</AppxPackageName>
    <AppxBundleNameForOutput>WinUICppIslandsSampleApp</AppxBundleNameForOutput>
    <AppxBundlePlatforms>$(Platform)</AppxBundlePlatforms>
    <AppxBundle>Never</AppxBundle>
    <EntryPointProjectUniqueName>..\WinUICppIslandsSampleApp\WinUICppIslandsSampleApp.vcxproj</EntryPointProjectUniqueName>
    <PackageCertificateKeyFile>$(ProjectRoot)\build\WinUITest.pfx</PackageCertificateKeyFile>
  </PropertyGroup>
  <PropertyGroup>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\SplashScreen.scale-200.png" />
    <Content Include="Images\LockScreenLogo.scale-200.png" />
    <Content Include="Images\Square150x150Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\Wide310x150Logo.scale-200.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- These entries exist solely to force the AppxManifest generator to recognize
         that these languages are supported by the packaged app; the automatic supported
         language detection apparently doesn't consider what languages are supported by the
         unpackaged app. -->
    <Content Include="Images\Placeholder.language-es-ES.png" />
    <Content Include="Images\Placeholder.language-en-US.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinUICppIslandsSampleApp\WinUICppIslandsSampleApp.vcxproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WinUIVersion)" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <!-- Register the WinUI binaries shipped in this self-contained package instead of
       relying on activatable-class registrations from an installed runtime package. -->
  <PropertyGroup>
    <WinUIClassRegistrationsFile>$(NugetPackageDirectory)\Microsoft.WindowsAppSDK.WinUI.$(WinUIVersion)\buildTransitive\native\LiftedWinRTClassRegistrations.xml</WinUIClassRegistrationsFile>
    <WinUIAppxFragment>$(IntermediateOutputPath)WinUIClassRegistrations.appxfragment</WinUIAppxFragment>
  </PropertyGroup>
  <Target Name="InsertWinUIActivatableClassEntries"
          AfterTargets="WinAppSdkInsertActivatableClassEntries"
          BeforeTargets="_GenerateAppxPackageRecipeFile;_WireUpCoreRuntime"
          Condition="Exists('$(WinUIClassRegistrationsFile)')"
          Inputs="$(MSBuildProjectFullPath);$(WinUIClassRegistrationsFile);$(FinalAppxManifestName)"
          Outputs="$(FinalAppxManifestName).winui.incremental">
    <PropertyGroup>
      <AppxManifestNamespaces>
        <Namespace Prefix="ns" Uri="http://schemas.microsoft.com/appx/manifest/foundation/windows10" />
      </AppxManifestNamespaces>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(FinalAppxManifestName)"
             Query="/ns:Package/ns:Extensions/ns:Extension/ns:InProcessServer/ns:ActivatableClass[@ActivatableClassId='Microsoft.UI.Xaml.XamlTypeInfo.XamlControlsXamlMetaDataProvider']"
             Namespaces="$(AppxManifestNamespaces)">
      <Output TaskParameter="Result" ItemName="ExistingWinUIClassRegistration" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(WinUIClassRegistrationsFile)"
             Query="/ns:Data/ns:Extension[ns:InProcessServer/ns:Path='Microsoft.UI.Xaml.dll' or ns:InProcessServer/ns:Path='Microsoft.UI.Xaml.Controls.dll' or ns:InProcessServer/ns:Path='Microsoft.UI.Xaml.Controls.Tabular.dll']"
             Namespaces="$(AppxManifestNamespaces)"
             Condition="'@(ExistingWinUIClassRegistration)' == ''">
      <Output TaskParameter="Result" ItemName="WinUIClassRegistration" />
    </XmlPeek>
    <PropertyGroup Condition="'@(ExistingWinUIClassRegistration)' == ''">
      <WinUIClassRegistrationFragment>
        %3C?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?%3E
        %3CFragment xmlns=&quot;http://schemas.microsoft.com/appx/manifest/foundation/windows10&quot;%3E
        %3CExtensions%3E
        @(WinUIClassRegistration->'%(Identity)','&#x0d;&#x0a;')
        %3C/Extensions%3E
        %3C/Fragment%3E
      </WinUIClassRegistrationFragment>
    </PropertyGroup>
    <WriteLinesToFile File="$(WinUIAppxFragment)"
                      Lines="$(WinUIClassRegistrationFragment)"
                      Overwrite="true"
                      Condition="'@(ExistingWinUIClassRegistration)' == ''" />
    <WinAppSdkInsertActivatableClassEntries
        FullPathToAppxManifest="$(FinalAppxManifestName)"
        FullPathToAppxFragment="$(WinUIAppxFragment)"
        ExcludeWebView2ActivatableClassEntries="false"
        Condition="'@(ExistingWinUIClassRegistration)' == ''" />
    <Touch Files="$(FinalAppxManifestName).winui.incremental" AlwaysCreate="true" />
  </Target>
</Project>