<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CompositionSwitcherSample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Composition switcher animation">

    <Grid Background="#202020" Loaded="OnRootLoaded">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                x:Name="engineText"
                HorizontalAlignment="Center"
                FontSize="20"
                Foreground="White" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="#B0FFFFFF"
                Text="The square is a Microsoft.UI.Composition SpriteVisual." />
            <Border
                Width="560"
                Height="220"
                Background="#303030"
                BorderBrush="#707070"
                BorderThickness="1"
                CornerRadius="4">
                <Grid x:Name="animationHost" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
