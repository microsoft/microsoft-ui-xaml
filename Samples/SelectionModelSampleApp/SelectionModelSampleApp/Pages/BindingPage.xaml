<Page
    x:Class="SelectionModelSampleApp.Pages.BindingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:SelectionModelSampleApp.Common"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <!-- SelectionModel can be declared in markup and shared as a resource. -->
        <muxc:SelectionModel x:Key="SharedSelectionModel" x:Name="SharedSelectionModel" />
        <common:SelectionStateToBrushConverter x:Key="StateToBrush" />
        <common:SelectionStateToGlyphConverter x:Key="StateToGlyph" />
    </Page.Resources>

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="Declaring SelectionModel in XAML" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap"
                       Text="SelectionModel is a resource here. SelectedItem is not a dependency property, but the model implements ICustomPropertyProvider and INotifyPropertyChanged, so {Binding SelectedItem} still updates live." />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer Padding="8">
                <muxc:ItemsRepeater x:Name="Repeater" ElementPrepared="OnElementPrepared">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:UniformGridLayout MinItemWidth="88" MinItemHeight="72"
                                                MinRowSpacing="8" MinColumnSpacing="8" />
                    </muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsSelected, Converter={StaticResource StateToBrush}}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8">
                                <Grid>
                                    <TextBlock Text="{Binding Label}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"
                                              Glyph="{Binding IsSelected, Converter={StaticResource StateToGlyph}}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="12">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bound to SelectedItem" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock FontSize="24"
                                   Text="{Binding SelectedItem, Source={StaticResource SharedSelectionModel}}" />
                    </StackPanel>
                </Border>

                <ToggleSwitch x:Name="SingleSelectSwitch" Header="SingleSelect" IsOn="True"
                              OffContent="false" OnContent="true"
                              Toggled="OnSingleSelectToggled" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Model state" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StateText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="PropertyChanged log" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
