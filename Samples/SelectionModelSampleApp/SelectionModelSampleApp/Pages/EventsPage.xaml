<Page
    x:Class="SelectionModelSampleApp.Pages.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:SelectionModelSampleApp.Common">

    <Page.Resources>
        <common:SelectionStateToBrushConverter x:Key="StateToBrush" />
    </Page.Resources>

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="SelectionChanged and ChildrenRequested" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap"
                       Text="The data items here are not collections, so the model raises ChildrenRequested to ask the app for the children of a node. SelectionChanged carries no data - the handler reads the state back off the model." />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer Padding="12">
                <ItemsControl x:Name="RootControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <Border Background="{Binding IsSelected, Converter={StaticResource StateToBrush}}"
                                        CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Children}" Margin="24,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <Border Background="{Binding IsSelected, Converter={StaticResource StateToBrush}}"
                                                        CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding Name}" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Children}" Margin="24,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding IsSelected, Converter={StaticResource StateToBrush}}"
                                                                    CornerRadius="4" Padding="8,2" Margin="0,0,0,3">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="8">
                <TextBlock Text="Path to select (dot separated)" />
                <TextBox x:Name="PathBox" Text="1.0.2" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="SelectAt(path)" Click="OnSelectAt" />
                    <Button Content="DeselectAt(path)" Click="OnDeselectAt" />
                    <Button Content="ClearSelection()" Click="OnClearSelection" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Select same path again" Click="OnSelectAt" />
                    <Button Content="Clear log" Click="OnClearLog" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Model state" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StateText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Event log" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
