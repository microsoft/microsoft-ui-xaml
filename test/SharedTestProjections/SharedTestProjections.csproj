<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WindowsAppSdkTargetFrameworkMoniker_v3)</TargetFramework>
    <WindowsSdkPackageVersion>$(WindowsAppSdkWindowsSdkPackageVersion_v3)</WindowsSdkPackageVersion>
    <Platforms>x86;x64;ARM64;ARM64EC</Platforms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BinplaceOutputAssemblies>false</BinplaceOutputAssemblies>
    <PublishAot>false</PublishAot>
    <!-- The .1 TFM otherwise enables SDK interop generation even during the 2.x pass. -->
    <CsWinRTGenerateInteropAssembly>false</CsWinRTGenerateInteropAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseCsWinRT3)' == 'true'">
    <!-- Executable shape enables the package's root-link generator; TAEF never executes Main. -->
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <CsWinRTGenerateInteropAssembly>true</CsWinRTGenerateInteropAssembly>
    <CsWinRTBuildForNativeConsumer>true</CsWinRTBuildForNativeConsumer>
    <CsWinRTEmitEntryPointInitializer>false</CsWinRTEmitEntryPointInitializer>
    <CsWinRTLoadComponentsInDefaultALC>true</CsWinRTLoadComponentsInDefaultALC>
    <CsWinRTWindowsMetadata />
    <_IncludeDxamlTests Condition="'$(Platform)' == 'x86' or '$(Platform)' == 'Win32' or '$(Platform)' == 'x64'">true</_IncludeDxamlTests>
    <UseWPF Condition="'$(_IncludeDxamlTests)' == 'true'">true</UseWPF>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCsWinRT3)' == 'true'">
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(MicrosoftCsWinRTv3PackageVersion)" />
    <Compile Include="SharedTestRoot.cs" />
    <RuntimeHostConfigurationOption Include="System.Runtime.InteropServices.TypeMappingEntryAssembly" Value="$(AssemblyName)" />
    <ProjectReference Include="$(ProjectRoot)controls\test\MUXControls.Test\MUXControls.Test.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCsWinRT3)' == 'true' and '$(_IncludeDxamlTests)' == 'true'">
    <ProjectReference Include="$(ProjectRoot)dxaml\test\managed\**\Microsoft.UI.Xaml.Tests.Managed.*.csproj"
                      Exclude="$(ProjectRoot)dxaml\test\managed\common\Microsoft.UI.Xaml.Tests.Managed.Common.csproj;$(ProjectRoot)dxaml\test\managed\PGOTests\*.csproj" />
    <ProjectReference Include="$(ProjectRoot)dxaml\test\infra\Win32Hosting\WPF\HostingHelpers\Private.Infrastructure.Hosting.HostingHelpers.csproj" />
    <ProjectReference Include="$(ProjectRoot)src\projection\private\Microsoft.WinUI.csproj" SetTargetFramework="TargetFramework=$(WinUIProjectionConsumerTFM)" />
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection">
      <HintPath>$(LiftedMRTPackagePath)\ref\$(TargetFramework)\Microsoft.Windows.ApplicationModel.Resources.Projection.dll</HintPath>
      <CsWinRTInputs>$(LiftedMRTWinmdPath)\Microsoft.Windows.ApplicationModel.Resources.winmd</CsWinRTInputs>
    </Reference>
  </ItemGroup>

  <Import Project="SharedInteropIncremental.targets" />

  <Target Name="BinplaceSharedTestProjections" AfterTargets="AddBinplaceItems" BeforeTargets="Binplace"
          Condition="'$(UseCsWinRT3)' == 'true'">
    <Copy SourceFiles="$(OutDir)$(TargetName).runtimeconfig.json" DestinationFiles="$(OutDir)WinRT.Host.runtimeconfig.json" SkipUnchangedFiles="true" />
    <ItemGroup>
      <BinplaceItem Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).runtimeconfig.json;$(OutDir)WinRT.*.dll;$(OutDir)WinRT.Host.runtimeconfig.json">
        <Destination>$(TestBinplaceDestinationPath)\SharedTestProjections</Destination>
      </BinplaceItem>
    </ItemGroup>
  </Target>
</Project>
