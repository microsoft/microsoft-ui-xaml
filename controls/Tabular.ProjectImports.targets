<!--
  Imports for the parallel Microsoft.UI.Xaml.Controls.Tabular.dll ("TabularControls").
  Scoped subset of ProjectImports.targets: the TableView control plus the shared helper
  infra it requires. TableView is hosted ONLY in the Tabular winmd (it is not added to
  MUXC's controls\ProjectImports.targets), which avoids duplicate-type collisions when the
  Tabular DLL references the MUXC winmd for ItemsRepeater / ScrollView / ScrollPresenter
  (which stay in MUXC).
  See docs/design-notes/TabularControls/TableView-dev-spec.md.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Common/Generated/inc carry shared headers TableView + peers include directly. -->
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MUXCProjectRoot)dev\Common;$(MUXCProjectRoot)dev\Generated;$(MUXCProjectRoot)dev\inc</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!--
    Swap in the Tabular-renamed metadata IDL: it produces XamlControlsTabularXamlMetaDataProvider +
    TabularControlsResources instead of MUXC's XamlControlsXamlMetaDataProvider + XamlControlsResources,
    avoiding duplicate-runtimeclass collisions. MIDL also references MUXC's unmerged winmd (below) so
    the shared CustomAttributes resolve from there instead of being redeclared here — redeclaring them
    caused MDM2009 duplicate-type once both winmds merged into public metadata. Must be the FIRST
    @(Midl) entry so its MUX_* macros are visible to every control IDL merged after it. -->
  <ItemGroup>
    <Midl Remove="$(MUXCProjectRoot)idl\Microsoft.UI.Xaml.Controls.idl" />
    <Midl Include="$(MSBuildThisFileDirectory)dev\dll-tabular\Microsoft.UI.Xaml.Controls.Tabular.idl" />
    <Reference Include="$(XamlBuildOutputRoot)\controls\dev\dll\Unmerged\Microsoft.UI.Xaml.Controls.g.winmd" />
  </ItemGroup>
  <ImportGroup>
    <!-- Shared helper infra (no Midl/runtimeclasses; safe to compile into the Tabular DLL as well as MUXC) -->
    <Import Project="$(MSBuildThisFileDirectory)dev\DllHost\DllHost.vcxitems" Label="Shared" />
    <Import Project="$(MSBuildThisFileDirectory)dev\Telemetry\Telemetry.vcxitems" Label="Shared" />
    <Import Project="$(MSBuildThisFileDirectory)dev\ResourceHelper\ResourceHelper.vcxitems" Label="Shared" />
    <Import Project="$(MSBuildThisFileDirectory)dev\ResizeGripper\ResizeGripper.vcxitems" Label="Shared" />
    <!-- Tabular shaping stack, imported bottom-up: layer 1 (shape descriptions + pipeline),
         layer 2 (the projection), then layer 3 (the grouping model and its adapter). Live
         shaping arrives in a later change. -->
    <Import Project="$(MSBuildThisFileDirectory)dev\TabularShaping\TabularShaping.vcxitems" Label="Shared" />
    <Import Project="$(MSBuildThisFileDirectory)dev\ShapedItemsSource\ShapedItemsSource.vcxitems" Label="Shared" />
    <Import Project="$(MSBuildThisFileDirectory)dev\GroupedSourceAdapter\GroupedSourceAdapter.vcxitems" Label="Shared" />
    <Import Project="$(MSBuildThisFileDirectory)dev\SortIndicator\SortIndicator.vcxitems" Label="Shared" />
    <!-- TableView control (hosted only in the Tabular binary) -->
    <Import Project="$(MSBuildThisFileDirectory)dev\TableView\TableView.vcxitems" Label="Shared" />
  </ImportGroup>
  <!--
    GridCoordinateHelper: an internal C++ helper (used only by TableView's row keyboard
    navigation). Compiled directly here; not projected into the winmd.
  -->
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)dev\Common\GridCoordinateHelper.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)dev\Common\GridCoordinateHelper.cpp" />
  </ItemGroup>
  <!-- TabularSurface* surface tokens consumed by TableView.xaml. Listed explicitly because no imported
       vcxitems carries it; pages owned by an imported vcxitems arrive with that import. -->
  <ItemGroup>
    <Page Include="$(MSBuildThisFileDirectory)dev\CommonStyles\TabularSurfaces_themeresources.xaml">
      <Type>ThemeResources</Type>
      <Priority>2</Priority>
    </Page>
  </ItemGroup>
</Project>
