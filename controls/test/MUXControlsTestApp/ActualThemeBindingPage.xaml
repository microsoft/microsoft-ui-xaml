<Page
    x:Class="MUXControlsTestApp.ActualThemeBindingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ThemeSource" RequestedTheme="Light">
        <Grid x:Name="BoundTheme" RequestedTheme="{x:Bind ThemeSource.ActualTheme, Mode=OneWay}" />
    </Grid>
</Page>
