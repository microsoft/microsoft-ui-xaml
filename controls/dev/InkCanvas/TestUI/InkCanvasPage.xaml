<local:TestPage
    x:Class="MUXControlsTestApp.InkCanvasPage"
    x:Name="InkCanvasTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- InkToolbar drives the InkCanvas.InkPresenter (pen / eraser / colors). -->
        <controls:InkToolbar x:Name="TestInkToolbar" AutomationProperties.Name="TestInkToolbar"
                             Grid.Row="0" TargetInkCanvas="{x:Bind TestInkCanvas}" Margin="0,0,0,8" />

        <TextBlock x:Name="StatusText" AutomationProperties.Name="StatusText" Grid.Row="1"
                   Margin="0,0,0,4" Text="Draw with mouse, pen, or touch — the InkCanvas inks by default." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <Button x:Name="ListenForUnprocessedInputButton" AutomationProperties.AutomationId="ListenForUnprocessedInputButton"
                    Content="Read UnprocessedInput args" Click="OnListenForUnprocessedInputClick" />
            <TextBlock x:Name="UnprocessedInputStatus" AutomationProperties.AutomationId="UnprocessedInputStatus" Text="0,0,0,0" />
        </StackPanel>

        <!-- CoreWetStrokeUpdateSource: counts starting,continuing,stopping,completed,canceled. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <Button x:Name="ListenForWetStrokesButton" AutomationProperties.AutomationId="ListenForWetStrokesButton"
                    Content="Listen for wet strokes" Click="OnListenForWetStrokesClick" />
            <Button x:Name="CancelWetStrokesButton" AutomationProperties.AutomationId="CancelWetStrokesButton"
                    Content="Cancel wet strokes" Click="OnCancelWetStrokesClick" />
            <TextBlock x:Name="WetStrokeStatus" AutomationProperties.AutomationId="WetStrokeStatus" Text="0,0,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- InkCanvas self-inks out of the box: no app code needed for wet ink. -->
        <Border Grid.Row="4" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
            <controls:InkCanvas x:Name="TestInkCanvas" AutomationProperties.Name="TestInkCanvas" />
        </Border>
    </Grid>
</local:TestPage>
