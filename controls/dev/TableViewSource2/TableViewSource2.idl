namespace MU_XC_NAMESPACE
{

// Compares two items: negative when x sorts before y, zero when equal, positive when after.
[MUX_PREVIEW]
[webhosthidden]
delegate Int32 TableViewComparer2(Object x, Object y);

// Returns an item's child collection (any collection type From accepts), or null for a leaf.
[MUX_PREVIEW]
[webhosthidden]
delegate Object TableViewChildrenSelector2(Object item);

// Scaffold for the shaping redesign (docs/design-notes/TabularControls/Shaping-Architecture-Redesign.md).
// Mirrors TableViewSource's public verb surface so the two can be compared side by side; every verb
// is a stub until the new engine lands. Reuses v1's TableViewPredicate, TableViewKeySelector and
// SortDirection; only TableViewComparer2 and TableViewChildrenSelector2 are new.
[MUX_PREVIEW]
[webhosthidden]
runtimeclass TableViewSource2
{
    // Accepts the same collection interfaces as TableViewSource.From. Throws E_INVALIDARG when
    // items is null.
    static TableViewSource2 From(Object items);

    // Replaces any existing filter; ClearFilter removes it.
    TableViewSource2 Filter(TableViewPredicate predicate);

    // Groups by key. groupDirection orders the groups by key (None = order of first appearance in
    // the filtered source); Sort orders only the rows inside each group, never the groups.
    TableViewSource2 GroupBy(TableViewKeySelector keySelector, SortDirection groupDirection);

    // Each Sort call appends a lower-priority level after the existing ones, unless it matches an
    // existing level, which it then replaces in place: a path matches by string, a key selector or
    // comparer only when the same delegate object is passed again. Direction None removes the
    // matching level. ClearSort removes all levels.
    [method_name("SortByPath")]
    TableViewSource2 Sort(String sortMemberPath, SortDirection direction);

    [default_overload] [method_name("Sort")]
    TableViewSource2 Sort(TableViewKeySelector keySelector, SortDirection direction);

    // Sorts by comparing whole items. The comparer defines the full order of its level, so it
    // takes no direction.
    [method_name("SortWithComparer")]
    TableViewSource2 Sort(TableViewComparer2 comparer);

    // Hierarchy over a flat source: keySelector returns each item's unique key, parentKeySelector
    // its parent's key (null for a root).
    TableViewSource2 ParentBy(TableViewKeySelector keySelector, TableViewKeySelector parentKeySelector);

    // Hierarchy over a nested source: childrenSelector returns each item's child collection.
    TableViewSource2 ChildrenBy(TableViewChildrenSelector2 childrenSelector);

    TableViewSource2 ClearFilter();
    TableViewSource2 ClearGroupBy();
    TableViewSource2 ClearSort();

    // Removes the hierarchy declared by ParentBy or ChildrenBy.
    TableViewSource2 ClearHierarchy();

    // Re-reads the source and rebuilds the projection. Needed for sources that do not raise
    // change notifications. Inside a DeferRefresh it is recorded and done once when the outermost
    // handle closes.
    void Refresh();

    // Batches verbs: while a returned handle is open, Filter, GroupBy, Sort, the hierarchy verbs,
    // their Clear* forms and Refresh only record what they declare, and source collection changes
    // are held. Closing the outermost handle (Dispose in C#) applies everything as one reshape and
    // one Reset. Handles nest; an inner Close does nothing, and closing a handle twice is a no-op.
    // An exception from app code during the reshape is thrown from that Close.
    Windows.Foundation.IClosable DeferRefresh();

    // When true, a PropertyChanged on an item re-applies the active filter, sort, group and
    // hierarchy to it. Defaults to false: property edits leave rows in place until the next
    // collection change, verb or Refresh.
    Boolean IsLiveShaping{ get; set; };
}

}
