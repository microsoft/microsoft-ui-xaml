<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    TableViewSource2: scaffold for the shaping redesign
    (docs/design-notes/TabularControls/Shaping-Architecture-Redesign.md).

    Reuses TableViewPredicate and TableViewKeySelector (TableViewSource.idl) and SortDirection
    (TabularShaping/SortDirection.idl); declares only TableViewComparer2 and
    TableViewChildrenSelector2.
    Imported under the same feature condition as TableView.
  -->
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{3F8C2A71-5D4E-4B9A-8E26-C1A7D05B94E3}</ItemsProjectGuid>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\ShapingEngine.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\FenwickTree.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\ShapedTree.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\ShapeState.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Shaping\IShapingOwner.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Shaping\IShapedExpansion.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Shaping\ShapingManager.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Source\CollectionAccessor2.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Source\SourceHierarchy.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Source\SourceRecord.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Source\SourceTable.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Spec\PathEvaluator.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Spec\ShapeDelegates.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Spec\ShapeSpec.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)TableViewSource2.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\GroupExpansion.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)View\ShapedCollectionView.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)View\ShapedRowMetadata.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)View\ShapedRowQueries.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\Generated\TableViewSource2.properties.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)TableViewSource2.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Source\CollectionAccessor2.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Source\SourceRecord.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Source\SourceTable.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\FenwickTree.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\GroupExpansion.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\ShapeState.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\ShapedTree.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\ShapingEngine.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="$(MSBuildThisFileDirectory)TableViewSource2.idl" />
  </ItemGroup>
</Project>
