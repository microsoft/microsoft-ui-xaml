<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:privatecontrols="using:Microsoft.UI.Private.Controls">

    <Style TargetType="privatecontrols:SortIndicator">
        <!-- Themed, not inherited, matching Expander's ExpanderChevronForeground: a ThemeResource
             re-resolves on theme/HC changes by itself. A host can still set Foreground and win. -->
        <Setter Property="Foreground" Value="{ThemeResource SortIndicatorForeground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{ThemeResource SortIndicatorSize}" />
        <Setter Property="Height" Value="{ThemeResource SortIndicatorSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- DirectionStates needs NoSort/Ascending/Descending. -->
                <ControlTemplate TargetType="privatecontrols:SortIndicator">
                    <Grid x:Name="LayoutRoot" Visibility="Collapsed">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DirectionStates">
                                <VisualState x:Name="NoSort">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Ascending">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Descending">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                        <Setter Target="GlyphFlip.ScaleY" Value="-1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Preserve the 16px SVG viewport of Fluent System Icons' Arrow Sort Up/Down Lines. -->
                        <Viewbox Width="{ThemeResource SortIndicatorGlyphSize}"
                                 Height="{ThemeResource SortIndicatorGlyphSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="16" Height="16" FlowDirection="LeftToRight"
                                    RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="GlyphFlip" />
                                </Canvas.RenderTransform>
                                <Path x:Name="GlyphIcon"
                                      Data="M13 14.5C13 14.7761 12.7761 15 12.5 15C12.2239 15 12 14.7761 12 14.5V2.70711L10.8536 3.85355C10.6583 4.04882 10.3417 4.04882 10.1464 3.85355C9.95118 3.65829 9.95118 3.34171 10.1464 3.14645L12.1464 1.14645C12.3417 0.951185 12.6583 0.951185 12.8536 1.14645L14.8536 3.14645C15.0488 3.34171 15.0488 3.65829 14.8536 3.85355C14.6583 4.04882 14.3417 4.04882 14.1464 3.85355L13 2.70711V14.5ZM2.5 13C2.22386 13 2 12.7761 2 12.5C2 12.2239 2.22386 12 2.5 12H9.5C9.77614 12 10 12.2239 10 12.5C10 12.7761 9.77614 13 9.5 13H2.5ZM4.5 10C4.22386 10 4 9.77614 4 9.5C4 9.22386 4.22386 9 4.5 9H9.5C9.77614 9 10 9.22386 10 9.5C10 9.77614 9.77614 10 9.5 10H4.5ZM6 6.5C6 6.77614 6.22386 7 6.5 7H9.5C9.77614 7 10 6.77614 10 6.5C10 6.22386 9.77614 6 9.5 6H6.5C6.22386 6 6 6.22386 6 6.5Z"
                                      Fill="{TemplateBinding Foreground}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
