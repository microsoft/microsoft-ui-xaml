<!--
    Tabular Surfaces — shared theming tokens for any control that paints tabular UI
    (rows, headers, gridlines, cells, selection, focus). Authored as a framework
    primitive so future controls (TableView, DataGrid, list-of-rows, etc.) consume
    a single named-token surface instead of inventing their own brushes.

    Token namespace: TabularSurface*
        Row*           - row-level surfaces (background, hover, selected, foreground)
        Header*        - column-header surfaces
        GridLine*      - row/column separator brushes

    IMPORTANT — why literal SolidColorBrush per theme instead of <StaticResource>
    aliases to TextFillColor*Brush / SubtleFillColor*Brush / etc.:

    The aliased pattern (`<StaticResource ResourceKey="TextFillColorPrimaryBrush" />`)
    works ONLY when this file is consumed via the dll's master themeresources.xaml
    (produced by BatchMergeXaml + bundled in Microsoft.UI.Xaml.Controls.dll). In that
    context every alias resolves against the same compiled XBF blob.

    Consuming apps merge this file directly via
       <ResourceDictionary Source="ms-appx:///TabularSurfaces_themeresources.xaml" />
    because XamlControlsResources does NOT deploy the dll's master themeresources to
    the consumer's package. When merged that way, the StaticResource aliases must
    cross-reference into ANOTHER merged dictionary (XamlControlsResources's theme
    dicts) at runtime — which the XAML resolver does NOT do reliably for keys nested
    inside ThemeDictionaries blocks of a sibling MergedDictionary. The result was
    silent fallbacks (Light-theme black brushes used in Dark theme → dark-on-dark
    body cells + header text, hard to read).

    Fix is to inline the WinUI Fluent color values per theme so the brushes are
    self-contained. The hex values mirror controls/dev/CommonStyles/Common_themeresources_any.xaml
    exactly so the visual identity stays in sync with the rest of WinUI. If the
    Fluent design system tweaks a token, refresh the corresponding hex here.

    HighContrast block continues to use {ThemeResource SystemColor*} which is a
    re-resolving markup extension and works correctly across MergedDictionary
    boundaries.
-->
<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">

            <!-- Row backgrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundBrush" Color="#00FFFFFF" />                          <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundAlternatingBrush" Color="#0AFFFFFF" />              <!-- SubtleFillColorTertiary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPointerOverBrush" Color="#0FFFFFFF" />               <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPressedBrush" Color="#0AFFFFFF" />                   <!-- SubtleFillColorTertiary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedBrush" Color="#0FFFFFFF" />                  <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPointerOverBrush" Color="#0AFFFFFF" />       <!-- SubtleFillColorTertiary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPressedBrush" Color="#0FFFFFFF" />           <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedDisabledBrush" Color="#0FFFFFFF" />          <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundDisabledBrush" Color="#00FFFFFF" />                  <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorBrush" Color="{ThemeResource SystemAccentColorLight2}" /> <!-- AccentFillColorDefault (Dark) -->
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorDisabledBrush" Color="#28FFFFFF" />             <!-- AccentFillColorDisabled -->

            <!-- Row foregrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundBrush" Color="#FFFFFF" />                            <!-- TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedBrush" Color="#FFFFFF" />                    <!-- TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPointerOverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPressedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPointerOverBrush" Color="#FFFFFF" />                  <!-- TextFillColorPrimary (subtle pointer-over fill keeps primary text) -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPressedBrush" Color="#FFFFFF" />                     <!-- TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundDisabledBrush" Color="#5DFFFFFF" />                  <!-- TextFillColorDisabled -->

            <!-- Header surfaces -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundBrush" Color="#00FFFFFF" />                       <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundBrush" Color="#C5FFFFFF" />                       <!-- TextFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderSeparatorBrush" Color="#15FFFFFF" />                        <!-- DividerStrokeColorDefault -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundPointerOverBrush" Color="#0FFFFFFF" />            <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundPressedBrush" Color="#0AFFFFFF" />                <!-- SubtleFillColorTertiary -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundSortableBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderSortableBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderPointerOverBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderPressedBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundPointerOverBrush" Color="#C5FFFFFF" />             <!-- TextFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundPressedBrush" Color="#C5FFFFFF" />                 <!-- TextFillColorSecondary -->

            <!-- Group-header row surfaces (P2.8 grouped rows) -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundBrush" Color="#00FFFFFF" />                <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundPointerOverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundPressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderPointerOverBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderPressedBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderForegroundBrush" Color="#FFFFFF" />                    <!-- TextFillColorPrimary -->
            <x:Double x:Key="TabularSurfaceGroupHeaderCountOpacity">0.77</x:Double>                                       <!-- TextFillColorSecondary over TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBorderBrush" Color="#15FFFFFF" />                    <!-- DividerStrokeColorDefault -->
            <Thickness x:Key="TabularSurfaceGroupHeaderBorderThickness">0,0,0,1</Thickness>

            <!-- Grid lines -->
            <SolidColorBrush x:Key="TabularSurfaceGridLineBrush" Color="#15FFFFFF" />                               <!-- DividerStrokeColorDefault -->
            <SolidColorBrush x:Key="TabularSurfaceOuterBorderBrush" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">

            <!-- Light theme = Default. Same key set as Default (above) but with the
                 WinUI Fluent Light-theme color values inlined per the IMPORTANT note
                 at the top of this file. -->

            <!-- Row backgrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundBrush" Color="#00FFFFFF" />                          <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundAlternatingBrush" Color="#06000000" />              <!-- SubtleFillColorTertiary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPointerOverBrush" Color="#09000000" />               <!-- SubtleFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPressedBrush" Color="#06000000" />                   <!-- SubtleFillColorTertiary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedBrush" Color="#09000000" />                  <!-- SubtleFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPointerOverBrush" Color="#06000000" />       <!-- SubtleFillColorTertiary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPressedBrush" Color="#09000000" />           <!-- SubtleFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedDisabledBrush" Color="#09000000" />          <!-- SubtleFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundDisabledBrush" Color="#00FFFFFF" />                  <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorBrush" Color="{ThemeResource SystemAccentColorDark1}" /> <!-- AccentFillColorDefault (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorDisabledBrush" Color="#37000000" />             <!-- AccentFillColorDisabled (Light) -->

            <!-- Row foregrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundBrush" Color="#E4000000" />                          <!-- TextFillColorPrimary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedBrush" Color="#E4000000" />                  <!-- TextFillColorPrimary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPointerOverBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPressedBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPointerOverBrush" Color="#E4000000" />              <!-- TextFillColorPrimary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPressedBrush" Color="#E4000000" />                 <!-- TextFillColorPrimary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundDisabledBrush" Color="#5C000000" />                  <!-- TextFillColorDisabled (Light) -->

            <!-- Header surfaces -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundBrush" Color="#00FFFFFF" />                       <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundBrush" Color="#9E000000" />                       <!-- TextFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderSeparatorBrush" Color="#0F000000" />                        <!-- DividerStrokeColorDefault (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundPointerOverBrush" Color="#09000000" />            <!-- SubtleFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundPressedBrush" Color="#06000000" />                <!-- SubtleFillColorTertiary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundSortableBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderSortableBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderPointerOverBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderPressedBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundPointerOverBrush" Color="#9E000000" />            <!-- TextFillColorSecondary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundPressedBrush" Color="#9E000000" />                <!-- TextFillColorSecondary (Light) -->

            <!-- Group header surfaces (parity with Default theme) -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundBrush" Color="#00FFFFFF" />                <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundPointerOverBrush" Color="#09000000" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundPressedBrush" Color="#06000000" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderPointerOverBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderPressedBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderForegroundBrush" Color="#E4000000" />                  <!-- TextFillColorPrimary (Light) -->
            <x:Double x:Key="TabularSurfaceGroupHeaderCountOpacity">0.7</x:Double>                                        <!-- TextFillColorSecondary over TextFillColorPrimary (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBorderBrush" Color="#0F000000" />                    <!-- DividerStrokeColorDefault (Light) -->
            <Thickness x:Key="TabularSurfaceGroupHeaderBorderThickness">0,0,0,1</Thickness>

            <!-- Grid lines -->
            <SolidColorBrush x:Key="TabularSurfaceGridLineBrush" Color="#0F000000" />                               <!-- DividerStrokeColorDefault (Light) -->
            <SolidColorBrush x:Key="TabularSurfaceOuterBorderBrush" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- §1.13 audit 2026-05-21: all brushes use ThemeResource System*Color tokens. -->

            <!-- Row backgrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundAlternatingBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedDisabledBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundDisabledBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <!-- Row foregrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <!-- Header surfaces -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundSortableBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderSortableBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderBorderPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <!-- Group-header row surfaces (P2.8 grouped rows) -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderInteractionBorderPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <x:Double x:Key="TabularSurfaceGroupHeaderCountOpacity">1.0</x:Double>
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Thickness x:Key="TabularSurfaceGroupHeaderBorderThickness">0,1,0,1</Thickness>

            <!-- Grid lines -->
            <SolidColorBrush x:Key="TabularSurfaceGridLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TabularSurfaceOuterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
