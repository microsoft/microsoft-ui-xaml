<local:TestPage
    x:Class="MUXControlsTestApp.ListViewKeyboardScrollingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp">
    <local:TestPage.Resources>
        <DataTemplate x:Key="KeyboardScrollGroupHeader">
            <Border Height="50" Background="LightGray">
                <TextBlock Text="Group" />
            </Border>
        </DataTemplate>
    </local:TestPage.Resources>
    <StackPanel x:Name="KeyboardScrollingRoot" Spacing="8">
        <TextBlock Text="Reset, then use arrow, Page Up/Down, or Home/End keys. Extended selection enables Ctrl/Shift combinations. Diagnostics report work for the last key. Layout probing deliberately invalidates an unrelated control."
                   TextWrapping="Wrap" MaxWidth="1000" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <ComboBox x:Name="CacheLength" Header="Cache length" SelectedIndex="0" SelectionChanged="CacheLength_SelectionChanged">
                <ComboBoxItem>0</ComboBoxItem>
                <ComboBoxItem>2</ComboBoxItem>
            </ComboBox>
            <CheckBox x:Name="VerticalScrolling" Content="Vertical scrolling" />
            <CheckBox x:Name="LargeFocusMargin" Content="40-pixel focus margin" />
            <CheckBox x:Name="GroupedItems" Content="Grouped items with sticky headers" />
            <CheckBox x:Name="PartialViewport" Content="Partial item at viewport edge" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="DisableStickyHeaders" Content="Non-sticky group headers" />
            <CheckBox x:Name="ScaleItems" Content="Half-size items (render transform)" />
            <CheckBox x:Name="VaryHeaderHeights" Content="50/80/110-pixel group headers" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="DisableFocusScrolling" Content="Disable focus scrolling" />
            <CheckBox x:Name="DisableFocusScrollingDuringFocus" Content="Disable scrolling in GettingFocus" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="CancelFocusChanges" Content="Cancel focus changes at the viewport edge" />
            <CheckBox x:Name="RedirectFocusChanges" Content="Redirect focus at the viewport edge" />
            <CheckBox x:Name="ProbeLayout" Content="Probe synchronous layout" />
            <CheckBox x:Name="ExtendedSelection" Content="Extended selection" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="FocusEntryPosition" Header="Item 11 position for focus entry" SelectedIndex="0">
                <ComboBoxItem>Leading</ComboBoxItem>
                <ComboBoxItem>Trailing</ComboBoxItem>
                <ComboBoxItem>Before</ComboBoxItem>
                <ComboBoxItem>After</ComboBoxItem>
                <ComboBoxItem>Partial</ComboBoxItem>
            </ComboBox>
            <Button x:Name="PrepareFocusEntryBefore" Content="Select item 11, focus before list" Click="PrepareFocusEntry_Click" VerticalAlignment="Bottom" />
            <Button x:Name="PrepareFocusEntryAfter" Content="Select item 11, focus after list" Click="PrepareFocusEntry_Click" VerticalAlignment="Bottom" />
            <CheckBox x:Name="ScrollAwayOnSelectionChanged" Content="Scroll to the end in SelectionChanged" VerticalAlignment="Bottom" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ResetKeyboardScrolling" Content="Reset keyboard scrolling" Click="ResetKeyboardScrolling_Click" />
            <Button x:Name="PublicScrollIntoView" Content="Scroll item 11 into view" Click="PublicScrollIntoView_Click" />
            <Button x:Name="RedirectFocusTarget" Content="Focus redirection target" />
        </StackPanel>
        <ScrollViewer x:Name="KeyboardScrollingOuterScroller" Width="650" Height="320" HorizontalAlignment="Left"
                      HorizontalScrollMode="Disabled" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
            <ListView x:Name="KeyboardScrollingList" Width="600" Height="150" HorizontalAlignment="Left"
                      Padding="0" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ShowsScrollingPlaceholders="False"
                      PreviewKeyDown="KeyboardScrollingList_PreviewKeyDown">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1"
                                       ItemWidth="200" ItemHeight="100" CacheLength="0"
                                       GroupPadding="0"
                                       AreStickyGroupHeadersEnabled="True" GroupHeaderPlacement="Top" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </ScrollViewer>
        <Button x:Name="AfterListFocusTarget" Content="Tab navigation target" />
        <local:KeyboardScrollingLayoutProbe x:Name="LayoutProbe" Width="1" Height="1" HorizontalAlignment="Left" />
        <TextBlock Text="Offset / offset changes / offset at key return / selected index / focused index / focus kind / offset when an item got focus" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock x:Name="KeyboardScrollOffset" Text="0" />
            <TextBlock x:Name="KeyboardScrollChanges" Text="0" />
            <TextBlock x:Name="KeyboardScrollOffsetAtKeyDown" Text="0" />
            <TextBlock x:Name="KeyboardScrollSelectedIndex" Text="0" />
            <TextBlock x:Name="KeyboardScrollFocusedIndex" Text="0" />
            <TextBlock x:Name="KeyboardScrollFocusedKind" Text="Item" />
            <TextBlock x:Name="KeyboardScrollOffsetAtFocus" Text="" />
            <TextBlock x:Name="KeyboardScrollOffsetHistory" Text="" />
        </StackPanel>
        <TextBlock Text="List requests / ancestor requests / ViewChanging / ViewChanged / selection changes / focus changes / synchronous probe measures / prepared containers / last container realized at reset / focused top / offset changes at key return / selected count / keys processed / prepared indices / focus sequence" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock x:Name="KeyboardScrollBringRequests" Text="0" />
            <TextBlock x:Name="KeyboardScrollAncestorRequests" Text="0" />
            <TextBlock x:Name="KeyboardScrollViewChangingEvents" Text="0" />
            <TextBlock x:Name="KeyboardScrollViewChangedEvents" Text="0" />
            <TextBlock x:Name="KeyboardScrollSelectionChanges" Text="0" />
            <TextBlock x:Name="KeyboardScrollFocusChanges" Text="0" />
            <TextBlock x:Name="KeyboardScrollLayoutAtKeyDown" Text="0" />
            <TextBlock x:Name="KeyboardScrollPreparedContainers" Text="0" />
            <TextBlock x:Name="KeyboardScrollLastContainerRealized" Text="False" />
            <TextBlock x:Name="KeyboardScrollFocusedTop" Text="0" />
            <TextBlock x:Name="KeyboardScrollChangesAtKeyDown" Text="0" />
            <TextBlock x:Name="KeyboardScrollSelectedCount" Text="0" />
            <TextBlock x:Name="KeyboardScrollKeysProcessed" Text="0" />
            <TextBlock x:Name="KeyboardScrollPreparedIndices" Text="" />
            <TextBlock x:Name="KeyboardScrollFocusSequence" Text="" />
        </StackPanel>
    </StackPanel>
</local:TestPage>
