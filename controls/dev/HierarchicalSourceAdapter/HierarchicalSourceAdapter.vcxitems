<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{5509C902-E64E-4C7F-BB93-F414702D5E19}</ItemsProjectGuid>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>%(PreprocessorDefinitions);HIERARCHICALSOURCEADAPTER_INCLUDED</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchicalSourceAdapter.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchicalSourceAdapter4.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchyContract4.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchyStructureCache4.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchicalSourceAdapter5.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchyContract5.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchyStructureCache5.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)HierarchyIndex5.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)HierarchicalSourceAdapter.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)HierarchicalSourceAdapter4.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)HierarchyStructureCache4.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)HierarchicalSourceAdapter5.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)HierarchyStructureCache5.cpp" />
  </ItemGroup>
</Project>
