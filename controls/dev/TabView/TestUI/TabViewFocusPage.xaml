<local:TestPage
    x:Class="MUXControlsTestApp.TabViewFocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Margin="12" Spacing="12">
        <Button AutomationProperties.Name="SelectThirdTabButton"
                Content="Select tab 2" Click="SelectThirdTabButton_Click" />
        <TabView x:Name="Tabs" Width="600" HorizontalAlignment="Left"
                 IsAddTabButtonVisible="False">
            <TabViewItem AutomationProperties.Name="FocusTab0" Header="Tab 0" IsClosable="False" />
            <TabViewItem AutomationProperties.Name="FocusTab1" Header="Tab 1" IsClosable="False" />
            <TabViewItem AutomationProperties.Name="FocusTab2" Header="Tab 2" IsClosable="False" />
        </TabView>
    </StackPanel>
</local:TestPage>
