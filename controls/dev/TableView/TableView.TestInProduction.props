<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Scoped to Tabular and the explicit real-TiP TableView validation consumers. -->
  <PropertyGroup>
    <TableViewTIPPackagesConfigContents>$([System.IO.File]::ReadAllText('$(ProjectRoot)build\packages.TestInProduction.config'))</TableViewTIPPackagesConfigContents>
    <TestInProductionPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(TableViewTIPPackagesConfigContents), 'Microsoft.Windows.TestInProduction.*?version="(.*?)"').Groups[1].Value)</TestInProductionPackageVersion>
    <TestInProductionPkgDirectory>$(NugetPackageDirectory)\Microsoft.Windows.TestInProduction.$(TestInProductionPackageVersion)</TestInProductionPkgDirectory>
    <TestInProductionTargetsFile>$(TestInProductionPkgDirectory)\build\native\Microsoft.Windows.TestInProduction.targets</TestInProductionTargetsFile>
    <TestInProductionIsReal>false</TestInProductionIsReal>
    <TestInProductionIsReal Condition="'$(UseTestInProductionStub)' != 'true' and Exists('$(TestInProductionTargetsFile)')">true</TestInProductionIsReal>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestInProductionIsReal)' != 'true'">
    <TableViewPublicPackagesConfigContents>$([System.IO.File]::ReadAllText('$(ProjectRoot)packages.config'))</TableViewPublicPackagesConfigContents>
    <TestInProductionPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($(TableViewPublicPackagesConfigContents), 'Microsoft.Internal.Windows.TestInProduction.*?version="(.*?)"').Groups[1].Value)</TestInProductionPackageVersion>
    <TestInProductionPkgDirectory>$(NugetPackageDirectory)\Microsoft.Internal.Windows.TestInProduction.$(TestInProductionPackageVersion)</TestInProductionPkgDirectory>
    <TestInProductionTargetsFile>$(TestInProductionPkgDirectory)\build\native\Microsoft.Internal.Windows.TestInProduction.targets</TestInProductionTargetsFile>
  </PropertyGroup>
  <Target Name="RequireTableViewRealTestInProductionLibrary" BeforeTargets="PrepareForBuild" Condition="'$(RequireRealTestInProduction)' == 'true'">
    <Error Condition="'$(TestInProductionIsReal)' != 'true' or !Exists('$(TestInProductionTargetsFile)')"
           Text="TableView real-TiP validation requires the production targets declared in build\packages.TestInProduction.config. Restore that package and do not select UseTestInProductionStub." />
  </Target>
</Project>
