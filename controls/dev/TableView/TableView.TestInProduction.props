<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\Telemetry\Muxc.TestInProduction.props" />
  <!-- Names used by the Tabular project's TiP guard. -->
  <PropertyGroup>
    <TableViewTIPPackagesConfig>$(MuxcTIPPackagesConfig)</TableViewTIPPackagesConfig>
    <TableViewTIPProductionVersion>$(MuxcTIPProductionVersion)</TableViewTIPProductionVersion>
    <TableViewTIPProductionTargetsFile>$(MuxcTIPProductionTargetsFile)</TableViewTIPProductionTargetsFile>
  </PropertyGroup>
</Project>
