<local:TestPage
    x:Class="MUXControlsTestApp.TableViewVirtualizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:TestPage.Resources>
        <!-- No PART_BodyScroller or PART_HeaderScroller: the app's ScrollViewer is the only scroller. -->
        <ControlTemplate x:Key="ScrollerlessTableTemplate" TargetType="controls:TableView">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="PART_HeaderRow">
                    <controls:TableViewCellsPanel x:Name="PART_HeaderHost" HorizontalAlignment="Left" />
                </Border>
                <ItemsRepeater x:Name="PART_RowsRepeater" Grid.Row="1">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </ControlTemplate>
    </local:TestPage.Resources>

    <!-- Stays inside the 1024px lab frame; the button below is invoked through UIA only. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="8" Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Focus-neutral: nothing can move focus onto it, so an editor open in the table keeps focus while
             the source mutates underneath it. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Remove First Item (focus-neutral)"
                    AutomationProperties.Name="RemoveFirstItemButton"
                    AutomationProperties.AutomationId="RemoveFirstItemButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnRemoveFirstItemClick" />
            <Button Content="Show Scrollerless Table (focus-neutral)"
                    AutomationProperties.Name="ShowScrollerlessTableButton"
                    AutomationProperties.AutomationId="ShowScrollerlessTableButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnShowScrollerlessTableClick" />
        </StackPanel>

        <!-- Format documented on TableViewVirtualizationPageFacts.Readout. -->
        <TextBox x:Name="VirtualizationReadout"
                 Grid.Row="1"
                 AutomationProperties.Name="VirtualizationReadout"
                 AutomationProperties.AutomationId="VirtualizationReadout"
                 HorizontalAlignment="Left"
                 Width="900"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 IsTabStop="False"
                 Text="" />

        <!-- 2000 items in a 360px-tall table, so only a viewport of rows (plus cache) is realized. -->
        <controls:TableView x:Name="LargeEditableTable"
                            Grid.Row="2"
                            AutomationProperties.Name="LargeEditableTable"
                            AutomationProperties.AutomationId="LargeEditableTable"
                            Height="360"
                            Width="520"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsReadOnly="False"
                            SelectionMode="Single">
            <controls:TableViewTextColumn Header="Name" Width="200" Binding="{Binding Name}" />
            <controls:TableViewTextColumn Header="Quantity" Width="120" Binding="{Binding Quantity}" />
            <controls:TableViewTextColumn Header="Code" Width="160" IsReadOnly="True" Binding="{Binding Code}" />
        </controls:TableView>

        <!-- Collapsed until ShowScrollerlessTableButton; beside LargeEditableTable, inside the lab frame. -->
        <StackPanel x:Name="ScrollerlessHost"
                    Grid.Row="2"
                    Margin="536,0,0,0"
                    Width="360"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="4"
                    Visibility="Collapsed">
            <ScrollViewer x:Name="ScrollerlessAppScroller" Height="300">
                <controls:TableView x:Name="ScrollerlessTable"
                                    AutomationProperties.Name="ScrollerlessTable"
                                    AutomationProperties.AutomationId="ScrollerlessTable"
                                    Template="{StaticResource ScrollerlessTableTemplate}"
                                    SelectionMode="Single">
                    <controls:TableViewTextColumn Header="Name" Width="160" Binding="{Binding Name}" />
                    <controls:TableViewTextColumn Header="Code" Width="160" Binding="{Binding Code}" />
                </controls:TableView>
            </ScrollViewer>
            <!-- Format documented on TableViewVirtualizationPageFacts.ScrollerlessReadout. -->
            <TextBox x:Name="ScrollerlessReadout"
                     AutomationProperties.Name="ScrollerlessReadout"
                     AutomationProperties.AutomationId="ScrollerlessReadout"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Text="" />
        </StackPanel>
    </Grid>
</local:TestPage>
