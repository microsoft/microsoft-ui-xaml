<local:TestPage
    x:Class="MUXControlsTestApp.TableViewPage"
    x:Name="TableViewTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:TestPage.Resources>
        <DataTemplate x:Key="AgeTextCellTemplate">
            <TextBlock Text="{Binding Age}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="CityTextCellTemplate">
            <TextBlock Text="{Binding City}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="DeptTextCellTemplate">
            <TextBlock Text="{Binding Dept}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="IdTextCellTemplate">
            <TextBlock Text="{Binding Id}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="NameTextCellTemplate">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="ScoreTextCellTemplate">
            <TextBlock Text="{Binding Score}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </local:TestPage.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="8" Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ORDER MATTERS: the lab frame clips the page at 1024px, so anything past ~940px is off-window, where
             UIA Invoke still works but a physical click misses. Physically-clicked controls go first, UIA-driven
             ones last. Keep one row: the grouped tests need all 12 containers realized. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Dummy Button" AutomationProperties.Name="DummyButton" AutomationProperties.AutomationId="DummyButton" />
            <Button Content="Trailing Button" AutomationProperties.Name="TrailingButton" AutomationProperties.AutomationId="TrailingButton" />
            <Button Content="Expand All Groups"
                    AutomationProperties.Name="ExpandAllGroupsButton"
                    AutomationProperties.AutomationId="ExpandAllGroupsButton"
                    Click="OnExpandAllGroupsClick" />
            <Button Content="Collapse All Groups"
                    AutomationProperties.Name="CollapseAllGroupsButton"
                    AutomationProperties.AutomationId="CollapseAllGroupsButton"
                    Click="OnCollapseAllGroupsClick" />
            <Button Content="Delayed Unload"
                    AutomationProperties.Name="DelayedUnloadButton"
                    AutomationProperties.AutomationId="DelayedUnloadButton"
                    Click="OnDelayedUnloadClick" />
            <CheckBox Content="Inactive cells"
                      AutomationProperties.Name="InactiveCellsCheckBox"
                      AutomationProperties.AutomationId="InactiveCellsCheckBox"
                      IsChecked="False"
                      Checked="OnInactiveCellsToggled"
                      Unchecked="OnInactiveCellsToggled" />
            <CheckBox Content="CanUserSortColumns"
                      AutomationProperties.Name="CanUserSortColumnsCheckBox"
                      AutomationProperties.AutomationId="CanUserSortColumnsCheckBox"
                      IsChecked="True"
                      Checked="OnCanUserSortColumnsToggled"
                      Unchecked="OnCanUserSortColumnsToggled" />
            <Button Content="Add Column"
                    AutomationProperties.Name="AddColumnButton"
                    AutomationProperties.AutomationId="AddColumnButton"
                    Click="OnAddColumnClick" />
            <Button Content="Remove Column"
                    AutomationProperties.Name="RemoveColumnButton"
                    AutomationProperties.AutomationId="RemoveColumnButton"
                    Click="OnRemoveColumnClick" />
            <Button Content="Toggle Score Pin"
                    AutomationProperties.Name="ToggleScorePinButton"
                    AutomationProperties.AutomationId="ToggleScorePinButton"
                    Click="OnToggleScorePinClick" />
            <Button Content="Toggle Flow Direction"
                    AutomationProperties.Name="ToggleBasicFlowDirectionButton"
                    AutomationProperties.AutomationId="ToggleBasicFlowDirectionButton"
                    Click="OnToggleBasicFlowDirectionClick" />
            <Button Content="Filter Source"
                    AutomationProperties.Name="FilterSourceButton"
                    AutomationProperties.AutomationId="FilterSourceButton"
                    Click="OnFilterSourceClick" />
            <Button Content="Clear Filter"
                    AutomationProperties.Name="ClearFilterButton"
                    AutomationProperties.AutomationId="ClearFilterButton"
                    Click="OnClearFilterClick" />
            <ComboBox AutomationProperties.Name="SelectionModeComboBox"
                      AutomationProperties.AutomationId="SelectionModeComboBox"
                      SelectedIndex="1"
                      SelectionChanged="OnSelectionModeChanged">
                <ComboBoxItem Content="None" AutomationProperties.Name="SelectionModeNone" />
                <ComboBoxItem Content="Single" AutomationProperties.Name="SelectionModeSingle" />
            </ComboBox>
            <ComboBox AutomationProperties.Name="SortCycleComboBox"
                      AutomationProperties.AutomationId="SortCycleComboBox"
                      SelectedIndex="0"
                      SelectionChanged="OnSortCycleChanged">
                <ComboBoxItem Content="AscendingDescending" AutomationProperties.Name="SortCycleAscendingDescending" />
                <ComboBoxItem Content="AscendingDescendingNone" AutomationProperties.Name="SortCycleAscendingDescendingNone" />
                <ComboBoxItem Content="DescendingAscending" AutomationProperties.Name="SortCycleDescendingAscending" />
                <ComboBoxItem Content="DescendingAscendingNone" AutomationProperties.Name="SortCycleDescendingAscendingNone" />
            </ComboBox>
            <!-- Focus-neutral re-shape triggers (UIA Invoke only, so last). Nothing can move focus onto them,
                 so the re-shape runs with focus where the test left it. -->
            <Button Content="Sort Basic By Age (focus-neutral)"
                    AutomationProperties.Name="FocusNeutralSortBasicByAgeButton"
                    AutomationProperties.AutomationId="FocusNeutralSortBasicByAgeButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnFocusNeutralSortBasicByAgeClick" />
            <Button Content="Filter to one grouped row"
                    AutomationProperties.Name="SingleGroupedRowFilterButton"
                    AutomationProperties.AutomationId="SingleGroupedRowFilterButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnSingleGroupedRowFilterClick" />
            <Button Content="Select scrolling row 3 (focus-neutral)"
                    AutomationProperties.Name="SelectScrollingRow3Button"
                    AutomationProperties.AutomationId="SelectScrollingRow3Button"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnSelectScrollingRow3Click" />
            <Button Content="Filter Source (focus-neutral)"
                    AutomationProperties.Name="FocusNeutralFilterSourceButton"
                    AutomationProperties.AutomationId="FocusNeutralFilterSourceButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnFilterSourceClick" />
            <Button Content="Disable Focused Row (focus-neutral)"
                    AutomationProperties.Name="DisableFocusedRowButton"
                    AutomationProperties.AutomationId="DisableFocusedRowButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnDisableFocusedRowClick" />
            <!-- Mid-gesture teardown triggers for the resize capture tests (UIA Invoke only): each acts 1.5s
                 after the click, while the test holds a pointer drag open. -->
            <Button Content="Delayed Gripper Capture Loss"
                    AutomationProperties.Name="DelayedGripperCaptureLossButton"
                    AutomationProperties.AutomationId="DelayedGripperCaptureLossButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnDelayedGripperCaptureLossClick" />
            <Button Content="Delayed Disable"
                    AutomationProperties.Name="DelayedDisableButton"
                    AutomationProperties.AutomationId="DelayedDisableButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnDelayedDisableClick" />
            <!-- Header tooltip reentrancy triggers (UIA Invoke only): app code on the Name header's ToolTip
                 runs while TableView detaches or re-attaches it. -->
            <Button Content="Pin Name On Header ToolTip Detach"
                    AutomationProperties.Name="PinNameOnHeaderToolTipDetachButton"
                    AutomationProperties.AutomationId="PinNameOnHeaderToolTipDetachButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnPinNameOnHeaderToolTipDetachClick" />
            <Button Content="Pin Name, Rebuild On Header ToolTip Attach"
                    AutomationProperties.Name="PinNameRebuildOnHeaderToolTipAttachButton"
                    AutomationProperties.AutomationId="PinNameRebuildOnHeaderToolTipAttachButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnPinNameRebuildOnHeaderToolTipAttachClick" />
            <Button x:Name="navigateToTouch"
                    Content="Touch Page"
                    AutomationProperties.Name="navigateToTouch"
                    AutomationProperties.AutomationId="navigateToTouch"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False" />
            <Button x:Name="navigateToVirtualization"
                    Content="Virtualization"
                    AutomationProperties.Name="navigateToVirtualization"
                    AutomationProperties.AutomationId="navigateToVirtualization"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False" />
            <CheckBox Content="CanUserResizeColumns"
                      AutomationProperties.Name="CanUserResizeColumnsCheckBox"
                      AutomationProperties.AutomationId="CanUserResizeColumnsCheckBox"
                      IsChecked="True"
                      IsTabStop="False"
                      Checked="OnCanUserResizeColumnsToggled"
                      Unchecked="OnCanUserResizeColumnsToggled" />
            <CheckBox Content="Hide column headers"
                      AutomationProperties.Name="HideColumnHeadersCheckBox"
                      AutomationProperties.AutomationId="HideColumnHeadersCheckBox"
                      IsTabStop="False"
                      Checked="OnHideColumnHeadersToggled"
                      Unchecked="OnHideColumnHeadersToggled" />
            <CheckBox Content="Empty basic table"
                      AutomationProperties.Name="EmptyBasicCheckBox"
                      AutomationProperties.AutomationId="EmptyBasicCheckBox"
                      IsTabStop="False"
                      Checked="OnEmptyBasicToggled"
                      Unchecked="OnEmptyBasicToggled" />
            <CheckBox Content="Scroll fixtures"
                      AutomationProperties.Name="ScrollFixturesCheckBox"
                      AutomationProperties.AutomationId="ScrollFixturesCheckBox"
                      IsTabStop="False"
                      Checked="OnScrollFixturesToggled"
                      Unchecked="OnScrollFixturesToggled" />
            <CheckBox Content="ScrollCity menu"
                      AutomationProperties.Name="ScrollCityMenuCheckBox"
                      AutomationProperties.AutomationId="ScrollCityMenuCheckBox"
                      IsTabStop="False"
                      Checked="OnScrollCityMenuToggled"
                      Unchecked="OnScrollCityMenuToggled" />
            <Button Content="Scroll scrolling body right (focus-neutral)"
                    AutomationProperties.Name="ScrollScrollingBodyButton"
                    AutomationProperties.AutomationId="ScrollScrollingBodyButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnScrollScrollingBodyClick" />
            <Button Content="Toggle Name CanResize"
                    AutomationProperties.Name="ToggleNameCanResizeButton"
                    AutomationProperties.AutomationId="ToggleNameCanResizeButton"
                    Click="OnToggleNameCanResizeClick" />
            <!-- Fit-on-double-click setups (UIA Invoke only). -->
            <Button Content="Age Auto, Score and Template Star"
                    AutomationProperties.Name="SetAgeAutoScoreStarButton"
                    AutomationProperties.AutomationId="SetAgeAutoScoreStarButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnSetAgeAutoScoreStarClick" />
            <Button Content="Report Basic Column Widths"
                    AutomationProperties.Name="ReportBasicColumnWidthsButton"
                    AutomationProperties.AutomationId="ReportBasicColumnWidthsButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnReportBasicColumnWidthsClick" />
            <Button Content="Scale Basic Table Vertically"
                    AutomationProperties.Name="ScaleBasicTableVerticallyButton"
                    AutomationProperties.AutomationId="ScaleBasicTableVerticallyButton"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    Click="OnScaleBasicTableVerticallyClick" />
        </StackPanel>

        <!-- No Pivot here on purpose: hosting these TableViews in a Pivot asserts in
             Microsoft.UI.Xaml.Phone.dll (0xC0000420) on the SECOND navigation to this page, which
             crashed every other interaction test. Visibility-toggled hosts, driven by the GoTo*
             buttons below, give the same one-table-at-a-time surface without the Pivot. -->
        <Grid Grid.Row="1">

            <Grid x:Name="BasicTableHost" Visibility="Visible">
                <controls:TableView x:Name="BasicTableView"
                                    AutomationProperties.Name="BasicTableView"
                                    AutomationProperties.AutomationId="BasicTableView"
                                    CanUserSortColumns="True"
                                    CanUserResizeColumns="True"
                                    SelectionMode="Single">
                    <controls:TableView.EmptyTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add a person"
                                        AutomationProperties.Name="EmptyStateButton"
                                        AutomationProperties.AutomationId="EmptyStateButton" />
                                <Button Content="Import"
                                        AutomationProperties.Name="EmptyStateImportButton"
                                        AutomationProperties.AutomationId="EmptyStateImportButton" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:TableView.EmptyTemplate>
                    <controls:TableViewTemplateColumn x:Name="NameColumn"
                                                      Header="Name"
                                                      Width="160"
                                                      MinWidth="60"
                                                      CanUserSort="True"
                                                      SortMemberPath="Name"
                                                      CellToolTipBinding="{Binding Name}"
                                                      HeaderToolTip="The person's name"
                                                      CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn x:Name="AgeColumn"
                                                      Header="Age"
                                                      Width="100"
                                                      CanUserSort="True"
                                                      SortMemberPath="Age"
                                                      CellTemplate="{StaticResource AgeTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="ReadOnlyCity"
                                                      Width="160"
                                                      CanUserSort="False"
                                                      SortMemberPath="City"
                                                      CellTemplate="{StaticResource CityTextCellTemplate}" />
                    <controls:TableViewTemplateColumn x:Name="ScoreColumn"
                                                      Header="Score"
                                                      Width="100"
                                                      CanUserSort="True"
                                                      SortMemberPath="Score"
                                                      CellTemplate="{StaticResource ScoreTextCellTemplate}" />
                    <controls:TableViewTemplateColumn x:Name="TemplateColumn" Header="Template" Width="200">
                        <controls:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TableViewTestPerson">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                           AutomationProperties.Name="TemplateCellText"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </controls:TableViewTemplateColumn.CellTemplate>
                    </controls:TableViewTemplateColumn>
                    <controls:TableViewTemplateColumn Header="Action" Width="120">
                        <controls:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TableViewTestPerson">
                                <Button Content="Open"
                                        AutomationProperties.Name="RowActionButton"
                                        VerticalAlignment="Center" />
                            </DataTemplate>
                        </controls:TableViewTemplateColumn.CellTemplate>
                    </controls:TableViewTemplateColumn>
                </controls:TableView>
            </Grid>

            <Grid x:Name="RtlTableHost" Visibility="Collapsed">
                <controls:TableView x:Name="RtlTableView"
                                    AutomationProperties.Name="RtlTableView"
                                    AutomationProperties.AutomationId="RtlTableView"
                                    FlowDirection="RightToLeft"
                                    Height="300"
                                    Width="520"
                                    HorizontalAlignment="Left"
                                    CanUserSortColumns="True"
                                    CanUserResizeColumns="True"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="RtlName"
                                                      Width="180"
                                                      MinWidth="60"
                                                      SortMemberPath="Name"
                                                      CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="RtlCity" Width="220" CanUserSort="False" SortMemberPath="City" CellTemplate="{StaticResource CityTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="RtlAge" Width="220" SortMemberPath="Age" CellTemplate="{StaticResource AgeTextCellTemplate}" />
                </controls:TableView>
            </Grid>

            <Grid x:Name="GroupedTableHost" Visibility="Collapsed">
                <controls:TableView x:Name="GroupedTableView"
                                    AutomationProperties.Name="GroupedTableView"
                                    AutomationProperties.AutomationId="GroupedTableView"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="GroupedName" Width="200" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="GroupedCity" Width="160" SortMemberPath="City" CellTemplate="{StaticResource CityTextCellTemplate}" />
                </controls:TableView>
            </Grid>

            <!-- Fixed container heights and a body 3.5 containers tall; see TableViewTestPageFacts.GroupedPagingContainerHeight.
                 Height is 3.5 * 40 plus the table's 1px border. -->
            <Grid x:Name="GroupedPagingTableHost" Visibility="Collapsed">
                <Grid.Resources>
                    <Style TargetType="controls:TableViewRow">
                        <Setter Property="Height" Value="40" />
                    </Style>
                    <Style TargetType="controls:TableViewGroupHeader">
                        <Setter Property="Height" Value="40" />
                    </Style>
                </Grid.Resources>
                <controls:TableView x:Name="GroupedPagingTableView"
                                    AutomationProperties.Name="GroupedPagingTableView"
                                    AutomationProperties.AutomationId="GroupedPagingTableView"
                                    HeadersVisibility="None"
                                    Height="142"
                                    Width="320"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="PagerName" Width="200" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
                </controls:TableView>
            </Grid>

            <Grid x:Name="ScrollingTableHost" Visibility="Collapsed">
                <StackPanel Orientation="Vertical" Spacing="4">
                <controls:TableView x:Name="ScrollingTableView"
                                    AutomationProperties.Name="ScrollingTableView"
                                    AutomationProperties.AutomationId="ScrollingTableView"
                                    Height="300"
                                    Width="520"
                                    HorizontalAlignment="Left"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="FrozenName"
                                                      Width="180"
                                                      FrozenEdge="Leading"
                                                      CellToolTipBinding="{Binding City}"
                                                      SortMemberPath="Name"
                                                      CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="ScrollCity" Width="220" SortMemberPath="City" CellTemplate="{StaticResource CityTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="ScrollAge" Width="220" SortMemberPath="Age" CellTemplate="{StaticResource AgeTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="ScrollId" Width="220" SortMemberPath="Id" CellTemplate="{StaticResource IdTextCellTemplate}" />
                </controls:TableView>
                <!-- Publishes PART_BodyScroller's offsets and the frozen band's rendered geometry for
                     out-of-process tests. See ReportScrollOffsets in the code-behind. -->
                <TextBlock x:Name="ScrollOffsetTextBlock"
                           AutomationProperties.Name="ScrollOffsetTextBlock"
                           AutomationProperties.AutomationId="ScrollOffsetTextBlock"
                           IsTabStop="False"
                           Width="520"
                           TextWrapping="Wrap"
                           Text="&lt;not resolved&gt;" />
                </StackPanel>
            </Grid>

            <!-- Hierarchical rows: the same ParentBy(Id, ManagerId) fixture shown left-to-right and
                 right-to-left. ResetHierarchy rebuilds both sources, so each test starts all collapsed. -->
            <Grid x:Name="HierarchyTableHost" Visibility="Collapsed" RowSpacing="4" ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Reset"
                            AutomationProperties.Name="ResetHierarchy"
                            AutomationProperties.AutomationId="ResetHierarchy"
                            Click="OnResetHierarchyClick" />
                </StackPanel>

                <!-- Format documented on TableViewTestPageFacts.HierarchyReadout. -->
                <TextBox x:Name="HierarchyReadout"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         AutomationProperties.Name="HierarchyReadout"
                         AutomationProperties.AutomationId="HierarchyReadout"
                         HorizontalAlignment="Left"
                         Width="840"
                         IsReadOnly="True"
                         IsTabStop="False"
                         Text="" />

                <controls:TableView x:Name="HierarchyTable"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    AutomationProperties.Name="HierarchyTable"
                                    AutomationProperties.AutomationId="HierarchyTable"
                                    ItemKeyPath="Id"
                                    ParentKeyPath="ManagerId"
                                    Height="320"
                                    Width="400"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="Name" Width="160" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="Dept" Width="100" SortMemberPath="Dept" CellTemplate="{StaticResource DeptTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="Score" Width="100" SortMemberPath="Score" CellTemplate="{StaticResource ScoreTextCellTemplate}" />
                </controls:TableView>

                <controls:TableView x:Name="HierarchyRtlTable"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    AutomationProperties.Name="HierarchyRtlTable"
                                    AutomationProperties.AutomationId="HierarchyRtlTable"
                                    ItemKeyPath="Id"
                                    ParentKeyPath="ManagerId"
                                    FlowDirection="RightToLeft"
                                    Height="320"
                                    Width="400"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="RtlName" Width="160" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="RtlDept" Width="100" SortMemberPath="Dept" CellTemplate="{StaticResource DeptTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="RtlScore" Width="100" SortMemberPath="Score" CellTemplate="{StaticResource ScoreTextCellTemplate}" />
                </controls:TableView>
            </Grid>

            <!-- Context menus: one menu per resolution level, laid out as TableViewTestPageFacts describes. Each
                 menu's Opening/Closed handlers write ContextMenuReadout. -->
            <Grid x:Name="ContextMenuTableHost" Visibility="Collapsed" RowSpacing="4">
                <Grid.Resources>
                    <MenuFlyout x:Key="CellMenu">
                        <MenuFlyoutItem Text="Cell menu" AutomationProperties.AutomationId="CellMenuItem" />
                    </MenuFlyout>
                    <MenuFlyout x:Key="HeaderMenu">
                        <MenuFlyoutItem Text="Header menu" AutomationProperties.AutomationId="HeaderMenuItem" />
                    </MenuFlyout>
                    <MenuFlyout x:Key="TemplateMenu">
                        <MenuFlyoutItem Text="Template menu" AutomationProperties.AutomationId="TemplateMenuItem" />
                    </MenuFlyout>
                    <MenuFlyout x:Key="RowMenu">
                        <MenuFlyoutItem Text="Row menu" AutomationProperties.AutomationId="RowMenuItem" />
                    </MenuFlyout>
                    <MenuFlyout x:Key="RowTemplateMenu">
                        <MenuFlyoutItem Text="Row template menu" AutomationProperties.AutomationId="RowTemplateMenuItem" />
                    </MenuFlyout>
                    <MenuFlyout x:Key="TableMenu">
                        <MenuFlyoutItem Text="Table menu" AutomationProperties.AutomationId="TableMenuItem" />
                    </MenuFlyout>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Reset"
                            AutomationProperties.Name="ResetContextMenu"
                            AutomationProperties.AutomationId="ResetContextMenu"
                            Click="OnResetContextMenuClick" />
                    <Button Content="Grouped"
                            AutomationProperties.Name="GroupContextMenuTable"
                            AutomationProperties.AutomationId="GroupContextMenuTable"
                            Click="OnGroupContextMenuTableClick" />
                    <Button Content="Right to left"
                            AutomationProperties.Name="MirrorContextMenuTable"
                            AutomationProperties.AutomationId="MirrorContextMenuTable"
                            Click="OnMirrorContextMenuTableClick" />
                    <Button Content="Row template menu"
                            AutomationProperties.Name="AttachRowTemplateMenu"
                            AutomationProperties.AutomationId="AttachRowTemplateMenu"
                            Click="OnAttachRowTemplateMenuClick" />
                </StackPanel>

                <!-- Format documented on TableViewTestPageFacts.ContextMenuReadout. -->
                <TextBox x:Name="ContextMenuReadout"
                         Grid.Row="1"
                         AutomationProperties.Name="ContextMenuReadout"
                         AutomationProperties.AutomationId="ContextMenuReadout"
                         HorizontalAlignment="Left"
                         Width="840"
                         IsReadOnly="True"
                         IsTabStop="False"
                         Text="" />

                <controls:TableView x:Name="ContextMenuTable"
                                    Grid.Row="2"
                                    AutomationProperties.Name="ContextMenuTable"
                                    AutomationProperties.AutomationId="ContextMenuTable"
                                    Height="400"
                                    Width="600"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SelectionMode="Single"
                                    ContextFlyout="{StaticResource TableMenu}">
                    <controls:TableView.Resources>
                        <Style TargetType="controls:TableViewRow">
                            <Setter Property="ContextFlyout" Value="{StaticResource RowMenu}" />
                        </Style>
                    </controls:TableView.Resources>
                    <controls:TableViewTemplateColumn Header="Name"
                                                      Width="160"
                                                      CellContextFlyout="{StaticResource CellMenu}"
                                                      HeaderContextFlyout="{StaticResource HeaderMenu}"
                                                      SortMemberPath="Name"
                                                      CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="City" Width="160">
                        <controls:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TableViewTestPerson">
                                <Grid Background="Transparent" ContextFlyout="{StaticResource TemplateMenu}"
                                      Loaded="OnContextMenuTemplateLoaded">
                                    <TextBlock Text="{x:Bind City, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </controls:TableViewTemplateColumn.CellTemplate>
                    </controls:TableViewTemplateColumn>
                    <controls:TableViewTemplateColumn Header="Age" Width="100" SortMemberPath="Age" CellTemplate="{StaticResource AgeTextCellTemplate}" />
                </controls:TableView>
            </Grid>

            <!-- Body cells that host controls: row-level Up from the first row must reach the header band. -->
            <Grid x:Name="CellControlsTableHost" Visibility="Collapsed">
                <controls:TableView x:Name="CellControlsTableView"
                                    AutomationProperties.Name="CellControlsTableView"
                                    AutomationProperties.AutomationId="CellControlsTableView"
                                    Height="300"
                                    Width="640"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SelectionMode="Single">
                    <controls:TableViewTemplateColumn Header="ControlsName" Width="160" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
                    <controls:TableViewTemplateColumn Header="ControlsActive" Width="84">
                        <controls:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TableViewTestPerson">
                                <CheckBox IsChecked="True" MinWidth="0" HorizontalAlignment="Center" AutomationProperties.Name="CellActiveCheckBox" AutomationProperties.AutomationId="CellActiveCheckBox" />
                            </DataTemplate>
                        </controls:TableViewTemplateColumn.CellTemplate>
                    </controls:TableViewTemplateColumn>
                    <controls:TableViewTemplateColumn Header="ControlsCity" Width="150">
                        <controls:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TableViewTestPerson">
                                <ComboBox SelectedIndex="0"
                                          MinWidth="0"
                                          Margin="6,2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="CellCityComboBox"
                                          AutomationProperties.AutomationId="CellCityComboBox">
                                    <x:String>Redmond</x:String>
                                    <x:String>Seattle</x:String>
                                </ComboBox>
                            </DataTemplate>
                        </controls:TableViewTemplateColumn.CellTemplate>
                    </controls:TableViewTemplateColumn>
                    <controls:TableViewTemplateColumn Header="ControlsDetails" Width="96">
                        <controls:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TableViewTestPerson">
                                <Button Content="Details" Margin="6,2" HorizontalAlignment="Stretch" AutomationProperties.Name="CellDetailsButton" AutomationProperties.AutomationId="CellDetailsButton" />
                            </DataTemplate>
                        </controls:TableViewTemplateColumn.CellTemplate>
                    </controls:TableViewTemplateColumn>
                </controls:TableView>
                <Button Content="Toggle headers"
                        Margin="0,310,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="ToggleCellControlsHeadersButton"
                        AutomationProperties.AutomationId="ToggleCellControlsHeadersButton"
                        Click="OnToggleCellControlsHeadersClick" />
            </Grid>

        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="AfterTableButton"
                    Content="After Table Button"
                    AutomationProperties.Name="AfterTableButton"
                    AutomationProperties.AutomationId="AfterTableButton" />
            <Button Content="Basic"
                    AutomationProperties.Name="GoToBasicButton"
                    AutomationProperties.AutomationId="GoToBasicButton"
                    Click="OnGoToBasicClick" />
            <Button Content="Rtl"
                    AutomationProperties.Name="GoToRtlButton"
                    AutomationProperties.AutomationId="GoToRtlButton"
                    Click="OnGoToRtlClick" />
            <Button Content="Grouped"
                    AutomationProperties.Name="GoToGroupedButton"
                    AutomationProperties.AutomationId="GoToGroupedButton"
                    Click="OnGoToGroupedClick" />
            <Button Content="Scrolling"
                    AutomationProperties.Name="GoToScrollingButton"
                    AutomationProperties.AutomationId="GoToScrollingButton"
                    Click="OnGoToScrollingClick" />
            <Button Content="Hierarchy"
                    AutomationProperties.Name="GoToHierarchyButton"
                    AutomationProperties.AutomationId="GoToHierarchyButton"
                    Click="OnGoToHierarchyClick" />
            <Button Content="Grouped Paging"
                    AutomationProperties.Name="GoToGroupedPagingButton"
                    AutomationProperties.AutomationId="GoToGroupedPagingButton"
                    Click="OnGoToGroupedPagingClick" />
            <Button Content="ContextMenu"
                    AutomationProperties.Name="GoToContextMenuButton"
                    AutomationProperties.AutomationId="GoToContextMenuButton"
                    Click="OnGoToContextMenuClick" />
            <Button Content="CellControls"
                    AutomationProperties.Name="GoToCellControlsButton"
                    AutomationProperties.AutomationId="GoToCellControlsButton"
                    Click="OnGoToCellControlsClick" />
            <TextBlock x:Name="StatusTextBlock"
                       AutomationProperties.Name="StatusTextBlock"
                       AutomationProperties.AutomationId="StatusTextBlock"
                       VerticalAlignment="Center"
                       Text="Ready" />
            <Button Content="Hook Row States"
                    AutomationProperties.Name="HookRowStatesButton"
                    AutomationProperties.AutomationId="HookRowStatesButton"
                    Click="OnHookRowStatesClick" />
            <!-- Append-only log of the first realized row's CommonStates transitions. A log, not a live read:
                 any interaction that read the state would itself move the pointer off the row. -->
            <TextBox x:Name="RowStateLogTextBlock"
                     AutomationProperties.Name="RowStateLogTextBlock"
                     AutomationProperties.AutomationId="RowStateLogTextBlock"
                     VerticalAlignment="Center"
                     Width="200"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Text="" />
            <Button Content="Hook Group Headers"
                    AutomationProperties.Name="HookGroupHeadersButton"
                    AutomationProperties.AutomationId="HookGroupHeadersButton"
                    Click="OnHookGroupHeadersClick" />
            <!-- Append-only log of the FIRST realized group header's CommonStates transitions, for the same
                 reason as RowStateLogTextBlock: reading the state live would require moving the pointer. -->
            <TextBox x:Name="GroupHeaderStateLogTextBlock"
                     AutomationProperties.Name="GroupHeaderStateLogTextBlock"
                     AutomationProperties.AutomationId="GroupHeaderStateLogTextBlock"
                     VerticalAlignment="Center"
                     Width="200"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Text="" />
            <!-- One entry per TableView.GroupExpanding ("E:<key>;") or GroupCollapsed ("C:<key>;") on the
                 grouped table. Entry count = number of times the events were raised, which is what makes
                 "exactly once per activation" assertable. -->
            <TextBox x:Name="GroupToggleReportTextBlock"
                     AutomationProperties.Name="GroupToggleReportTextBlock"
                     AutomationProperties.AutomationId="GroupToggleReportTextBlock"
                     VerticalAlignment="Center"
                     Width="240"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Text="" />
        </StackPanel>
    </Grid>
</local:TestPage>
