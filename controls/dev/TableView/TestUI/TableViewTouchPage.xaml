<local:TestPage
    x:Class="MUXControlsTestApp.TableViewTouchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Everything stays left of ~940px: the lab frame clips at 1024px and clipped controls miss touch input. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:TableView x:Name="TouchBasicTableView"
                            Grid.Column="0"
                            AutomationProperties.Name="TouchBasicTableView"
                            AutomationProperties.AutomationId="TouchBasicTableView"
                            Height="320"
                            Width="240"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            SelectionMode="Single">
            <controls:TableViewTextColumn Header="TouchName" Width="130" Binding="{Binding Name}" />
            <controls:TableViewTextColumn Header="TouchAge" Width="90" Binding="{Binding Age}" />
        </controls:TableView>

        <controls:TableView x:Name="TouchGroupedTableView"
                            Grid.Column="1"
                            AutomationProperties.Name="TouchGroupedTableView"
                            AutomationProperties.AutomationId="TouchGroupedTableView"
                            Height="440"
                            Width="240"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            SelectionMode="Single">
            <controls:TableViewTextColumn Header="TouchGroupedName" Width="130" Binding="{Binding Name}" />
            <controls:TableViewTextColumn Header="TouchGroupedCity" Width="90" Binding="{Binding City}" />
        </controls:TableView>

        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4" VerticalAlignment="Top">
            <controls:TableView x:Name="TouchScrollingTableView"
                                AutomationProperties.Name="TouchScrollingTableView"
                                AutomationProperties.AutomationId="TouchScrollingTableView"
                                Height="300"
                                Width="360"
                                HorizontalAlignment="Left"
                                SelectionMode="Single">
                <controls:TableViewTextColumn Header="TouchScrollName" Width="160" Binding="{Binding Name}" />
                <controls:TableViewTextColumn Header="TouchScrollCity" Width="160" Binding="{Binding City}" />
                <controls:TableViewTextColumn Header="TouchScrollAge" Width="160" Binding="{Binding Age}" />
                <controls:TableViewTextColumn Header="TouchScrollId" Width="160" Binding="{Binding Id}" />
            </controls:TableView>
            <!-- "H=<h>;V=<v>;HeaderH=<h>" from PART_BodyScroller / PART_HeaderScroller; see ReportScrollOffsets. -->
            <TextBlock x:Name="TouchScrollOffsetTextBlock"
                       AutomationProperties.Name="TouchScrollOffsetTextBlock"
                       AutomationProperties.AutomationId="TouchScrollOffsetTextBlock"
                       IsTabStop="False"
                       Width="360"
                       TextWrapping="Wrap"
                       Text="&lt;not resolved&gt;" />
        </StackPanel>
    </Grid>
</local:TestPage>
