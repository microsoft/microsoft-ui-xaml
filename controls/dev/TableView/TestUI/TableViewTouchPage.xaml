<local:TestPage
    x:Class="MUXControlsTestApp.TableViewTouchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:TestPage.Resources>
        <DataTemplate x:Key="AgeTextCellTemplate">
            <TextBlock Text="{Binding Age}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="CityTextCellTemplate">
            <TextBlock Text="{Binding City}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="IdTextCellTemplate">
            <TextBlock Text="{Binding Id}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="NameTextCellTemplate">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="8,4,8,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </local:TestPage.Resources>

    <!-- Everything stays left of ~940px: the lab frame clips at 1024px and clipped controls miss touch input. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:TableView x:Name="TouchBasicTableView"
                            Grid.Column="0"
                            AutomationProperties.Name="TouchBasicTableView"
                            AutomationProperties.AutomationId="TouchBasicTableView"
                            Height="320"
                            Width="240"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            SelectionMode="Single">
            <controls:TableViewTemplateColumn Header="TouchName" Width="130" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
            <controls:TableViewTemplateColumn Header="TouchAge" Width="90" SortMemberPath="Age" CellTemplate="{StaticResource AgeTextCellTemplate}" />
        </controls:TableView>

        <controls:TableView x:Name="TouchGroupedTableView"
                            Grid.Column="1"
                            AutomationProperties.Name="TouchGroupedTableView"
                            AutomationProperties.AutomationId="TouchGroupedTableView"
                            Height="440"
                            Width="240"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            SelectionMode="Single">
            <controls:TableViewTemplateColumn Header="TouchGroupedName" Width="130" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
            <controls:TableViewTemplateColumn Header="TouchGroupedCity" Width="90" SortMemberPath="City" CellTemplate="{StaticResource CityTextCellTemplate}" />
        </controls:TableView>

        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4" VerticalAlignment="Top">
            <controls:TableView x:Name="TouchScrollingTableView"
                                AutomationProperties.Name="TouchScrollingTableView"
                                AutomationProperties.AutomationId="TouchScrollingTableView"
                                Height="300"
                                Width="360"
                                HorizontalAlignment="Left"
                                SelectionMode="Single">
                <controls:TableViewTemplateColumn Header="TouchScrollName" Width="160" SortMemberPath="Name" CellTemplate="{StaticResource NameTextCellTemplate}" />
                <controls:TableViewTemplateColumn Header="TouchScrollCity" Width="160" SortMemberPath="City" CellTemplate="{StaticResource CityTextCellTemplate}" />
                <controls:TableViewTemplateColumn Header="TouchScrollAge" Width="160" SortMemberPath="Age" CellTemplate="{StaticResource AgeTextCellTemplate}" />
                <controls:TableViewTemplateColumn Header="TouchScrollId" Width="160" SortMemberPath="Id" CellTemplate="{StaticResource IdTextCellTemplate}" />
            </controls:TableView>
            <!-- "H=<h>;V=<v>;HeaderH=<h>" from PART_BodyScroller / PART_HeaderScroller; see ReportScrollOffsets. -->
            <TextBlock x:Name="TouchScrollOffsetTextBlock"
                       AutomationProperties.Name="TouchScrollOffsetTextBlock"
                       AutomationProperties.AutomationId="TouchScrollOffsetTextBlock"
                       IsTabStop="False"
                       Width="360"
                       TextWrapping="Wrap"
                       Text="&lt;not resolved&gt;" />
        </StackPanel>
    </Grid>
</local:TestPage>
