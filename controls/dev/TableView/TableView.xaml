<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <x:Double x:Key="TableViewRowMinHeight">40</x:Double>
    <Thickness x:Key="TableViewHeaderCellPadding">8,4,8,4</Thickness>
    <!-- Mirrored: TableView_themeresources.xaml is not emitted for the Tabular binary. -->
    <x:Double x:Key="TableViewResizeGripperWidth">8</x:Double>
        
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundPointerOverBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundPressedBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundDisabledBrush" Color="{ThemeResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPointerOverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPressedBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundDisabledBrush" Color="Transparent" />
    <!-- Last-resort selection fallbacks for hosts that do not merge
         CommonStyles/TabularSurfaces_themeresources.xaml, which is the canonical source. -->
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPointerOverBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPressedBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPointerOverBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPressedBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorBrush" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="TabularSurfaceGridLineBrush" Color="{ThemeResource DividerStrokeColorDefault}" />

    <!-- TableView default style. Header cells stack horizontally (one per
         column); the body is an ItemsRepeater of TableViewRow, each building its cells from
         the owning TableView's Columns. -->
    <Style TargetType="controls:TableView">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource TabularSurfaceRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TabularSurfaceRowForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceGridLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="PART_HeaderRow"
                                    Grid.Row="0"
                                    Background="{ThemeResource TabularSurfaceHeaderBackgroundBrush}"
                                    BorderBrush="{ThemeResource TabularSurfaceGridLineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <ScrollViewer x:Name="PART_HeaderScroller"
                                                  HorizontalScrollMode="Disabled"
                                                  VerticalScrollMode="Disabled"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <controls:TableViewCellsPanel x:Name="PART_HeaderHost" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="PART_BodyScroller"
                                          Grid.Row="1"
                                          HorizontalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          VerticalContentAlignment="Stretch">
                                
                                <Grid x:Name="PART_BodyContent" Background="Transparent">
                                    <!-- Vertical StackLayout ignores horizontal cache length; keep only the effective cache axis. -->
                                    <ItemsRepeater x:Name="PART_RowsRepeater"
                                                   VerticalCacheLength="2.0">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" />
                                        </ItemsRepeater.Layout>
                                        <!-- No ItemTemplate here: it is assigned in code to a
                                             TableViewRowTemplateSelector that maps the row's
                                             TableViewRowKind to a TableViewGroupHeader or TableViewRow
                                             container template. ItemsRepeater accepts a
                                             DataTemplateSelector and gives each selected template its
                                             own recycle pool. -->
                                    </ItemsRepeater>
                                    <!-- Empty-state overlay. The control (C++ UpdateEmptyState) shows
                                         this ONLY when EmptyTemplate is set AND the effective row source
                                         is empty; otherwise it stays Collapsed and inert (zero behavior
                                         change for TableViews that don't set EmptyTemplate). Centered. -->
                                    <ContentControl x:Name="PART_EmptyStatePresenter"
                                                    Visibility="Collapsed"
                                                    IsTabStop="False"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:TableViewRow">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />        
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />        
        <Setter Property="Background" Value="{ThemeResource TabularSurfaceRowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceGridLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableViewRow">
                    <Border x:Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <!-- Disabled state takes the Disabled background brush. PART_RootBorder is a
                                     Border (no Foreground), so disabled text-color routing is deferred. -->
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <!-- Selected states live in this SAME group rather than a second one:
                                     they animate the same PART_RootBorder.Background, and two groups
                                     would make the result depend on GoToState call order. One group
                                     whose names encode both dimensions is the pattern TreeViewItem
                                     and ItemContainer use. -->
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundSelectedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundSelectedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundSelectedPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundSelectedPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundSelectedPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundSelectedPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <!-- A disabled row keeps the accent strip so its selected state stays
                                     legible, but drops the selected fill for the disabled one. -->
                                <VisualState x:Name="SelectedDisabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid>
                            <!-- Cell host. TableViewRow populates PART_CellsHost with one cell wrapper
                                 per TableViewColumn, in Columns order, laid out left-to-right.
                                 The presenter exists so the Selected* states have something with a
                                 Foreground to animate: PART_RootBorder is a Border and has none, and
                                 cell text inherits Foreground down from here. Without it the selected
                                 foreground brushes are unreachable, which is only cosmetic in
                                 light/dark (the selected fill is ~4% alpha) but makes a selected row
                                 illegible in High Contrast, where the fill is the opaque
                                 SystemColorHighlightColor. -->
                            <ContentPresenter x:Name="PART_CellForegroundPresenter"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch">
                                <controls:TableViewCellsPanel x:Name="PART_CellsHost" />
                            </ContentPresenter>

                            <!-- Fluent selection indicator: overlays the leading edge, Opacity 0 by
                                 default; the Selected* states animate it to 1. Not hit-testable, so it
                                 cannot steal a press from the cell underneath it. -->
                            <Rectangle x:Name="PART_SelectionIndicator"
                                       Width="3"
                                       Height="16"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{ThemeResource TabularSurfaceSelectionIndicatorBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       Opacity="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        TableViewGroupHeader. The ControlTemplate owns the band chrome and the chevron
        (PART_ExpanderGutter / PART_ExpanderIcon); PART_ContentPresenter is the only
        app-customizable region, showing ContentTemplate over the TableViewGroupInfo Content.

        ContentTemplate always resolves: the default Style seeds it, and
        TableView.GroupHeaderTemplate overrides it as a local value that ClearValue reverts. So
        there is no default-vs-custom branch, and an app template cannot drop the expander or
        the band. Expansion, enabled and pointer state are VisualStates, so the chevron glyph
        is declared here rather than assigned from C++.
    -->
    <x:Double x:Key="TableViewGroupExpanderSize">24</x:Double>
    <Thickness x:Key="TableViewGroupHeaderPadding">8,6,16,6</Thickness>

    <DataTemplate x:Key="TableViewDefaultGroupHeaderContentTemplate">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding KeyText, Mode=OneWay}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <!-- Inherits Foreground so it follows the PointerOver / Pressed / Disabled states
                 exactly like the key text; a local brush would win over the state setters. -->
            <TextBlock Text="{Binding ItemCountText, Mode=OneWay}"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="controls:TableViewGroupHeader">
        <Setter Property="Background" Value="{ThemeResource TabularSurfaceGroupHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TabularSurfaceGroupHeaderForegroundBrush}" />
        <Setter Property="Padding" Value="{ThemeResource TableViewGroupHeaderPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- Focusable so keyboard users can expand/collapse: TableViewGroupHeader::OnKeyDown
             handles Enter/Space (toggle) and Right/Left (expand/collapse), matching TreeViewItem. -->
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="ContentTemplate" Value="{StaticResource TableViewDefaultGroupHeaderContentTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableViewGroupHeader">
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.Background" Value="{ThemeResource TabularSurfaceRowBackgroundPointerOverBrush}" />
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPointerOverBrush}" />
                                        <Setter Target="PART_ExpanderIcon.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.Background" Value="{ThemeResource TabularSurfaceRowBackgroundPressedBrush}" />
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPressedBrush}" />
                                        <Setter Target="PART_ExpanderIcon.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                        <Setter Target="PART_ExpanderIcon.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderIcon.Glyph" Value="&#xE76C;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderIcon.Glyph" Value="&#xE70D;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpandabilityStates">
                                <VisualState x:Name="Expandable" />
                                <VisualState x:Name="NotExpandable">
                                    <!-- Only the chevron hides; PART_ExpanderGutter keeps its width so
                                         content stays aligned across expandable and non-expandable groups. -->
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- The chevron is a pure visual. The whole band is the toggle target
                                 (TableViewGroupHeader::OnPointerReleased), matching ListView /
                                 TreeView, so there is no nested Button to inflate, focus or name. -->
                            <Border x:Name="PART_ExpanderGutter"
                                    Grid.Column="0"
                                    Width="{ThemeResource TableViewGroupExpanderSize}">
                                <FontIcon x:Name="PART_ExpanderIcon"
                                          FontSize="12"
                                          Foreground="{TemplateBinding Foreground}"
                                          MirroredWhenRightToLeft="True"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
