namespace MU_XC_NAMESPACE
{

[MUX_PREVIEW]
[webhosthidden]
delegate Boolean TableViewPredicate(Object item);

[MUX_PREVIEW]
[webhosthidden]
delegate Object TableViewKeySelector(Object item);

// Stable string identity for a group key (GroupBy overload). Row identity is not app-supplied:
// the projection derives it from each item's object identity.
[MUX_PREVIEW]
[webhosthidden]
delegate String TableViewIdentitySelector(Object item);

[MUX_PREVIEW]
[webhosthidden]
// Sealed deliberately: TableView drives the concrete implementation, so an override of a shaping
// verb would be bypassed. Unsealing later is compatible; sealing later is not.
runtimeclass TableViewSource
{
    // Whole class:
    //  * Null items, predicate, or keySelector throws E_INVALIDARG. (Note this differs from
    //    TableView's command surface, which no-ops on bad input.) The optional
    //    groupIdentitySelector may be null and selects the built-in value-type group identity.
    //  * UI-thread affinity, like any XAML items source. The underlying collection must also
    //    raise its change notifications on that thread; raising them from a background thread
    //    is not supported. The verbs hold no lock.
    //  * Rows are identified by their item's OBJECT identity, with one exception: under ParentBy
    //    the app-supplied node key (keySelector) is the row identity. So selection and focus
    //    re-anchor across a reshape; for a flat or grouped source NOT across an item being
    //    re-created (a hierarchical row re-anchors on its key), and the same object in two rows
    //    fails fast at materialization.

    // Accepts the same collection interfaces as ItemsSourceView: IVector<Object> (so also
    // IObservableVector<Object>), IBindableVector, IIterable<Object>, or IBindableIterable.
    // Anything else throws E_INVALIDARG. The projection is populated by the time From returns.
    static TableViewSource From(Object items);

    // Use ClearFilter() to remove an existing filter rather than passing a pass-everything one.
    TableViewSource Filter(TableViewPredicate predicate);

    // keySelector: required, non-null (throws E_INVALIDARG when null; use ClearGroupBy() to
    // remove grouping). Overload metadata is frozen at v1 — without it MIDL bakes GroupBy2 into
    // the ABI.
    //
    // Grouping FAILS FAST. When a group's identity cannot be resolved, the call that builds the
    // projection throws E_INVALIDARG; the projection is never silently flattened, because a
    // grouping request that quietly renders ungrouped is a bug an app ships without noticing.
    // An identity is unresolvable when:
    //   * the key is null, or is a reference type and no groupIdentitySelector was supplied;
    //   * the key is the EMPTY STRING, or a supplied groupIdentitySelector returns the empty
    //     string. String is a supported key type, but "" is not a usable identity, so an app
    //     grouping on a property that can be null/blank must coalesce it to a real bucket label
    //     (e.g. "(none)") itself;
    //   * a supplied groupIdentitySelector throws;
    //   * two logically-different keys resolve to the same identity string and no
    //     groupIdentitySelector was supplied to declare that collapse intentional.
    [default_overload] [method_name("GroupBy")]
    TableViewSource GroupBy(TableViewKeySelector keySelector);

    // groupIdentitySelector is OPTIONAL: null selects the built-in value-type group identity
    // (String/Int32/Int64/Guid/Boolean/enum); a reference-type group key with no selector fails
    // fast at projection time, as does an empty identity from either source (see above).
    [method_name("GroupByWithIdentity")]
    TableViewSource GroupBy(TableViewKeySelector keySelector, TableViewIdentitySelector groupIdentitySelector);

    // SortDirection.None removes that key's sort axis rather than seeding a stage, so sorting
    // every axis to None leaves the source unsorted. When several axes are active the FIRST one
    // declared is the primary sort and each later axis breaks ties within the previous, matching
    // WPF DataGrid's SortDescriptions order; re-sorting an existing axis keeps its position.
    //
    // Both overloads are LAST WRITER WINS against TableView's own sort: declaring a sort here
    // replaces the control's axis rather than stacking behind it, so the rows are ordered by this
    // axis alone. What differs is what the headers can say about it.
    //
    // sortMemberPath names the property this axis sorts on and is the preferred form. The path is
    // evaluated by the same binding-based evaluator a column uses for its SortMemberPath, so a
    // path that displays also sorts (dotted paths and indexers included), and a bound TableView
    // can match the path to a column and light that column's sort indicator. Re-sorting the same
    // path replaces that axis in place rather than adding a second one.
    // Throws E_INVALIDARG when sortMemberPath is empty.
    // Overload metadata is frozen at v1 — without it MIDL bakes Sort2 into the ABI.
    [method_name("SortByPath")]
    TableViewSource Sort(String sortMemberPath, SortDirection direction);

    // keySelector form: for keys no property path expresses — computed, multi-field, normalized,
    // or the identity of a primitive collection. The axis is ANONYMOUS: nothing names a property,
    // so a bound TableView cannot attribute it to a column and clears every sort indicator
    // instead of leaving one describing a sort that is no longer primary. Prefer the
    // sortMemberPath overload whenever the key is a property.
    [default_overload] [method_name("Sort")]
    TableViewSource Sort(TableViewKeySelector keySelector, SortDirection direction);

    TableViewSource ClearFilter();
    TableViewSource ClearGroupBy();
    TableViewSource ClearSort();

    // Declares a self-referencing parent/child relation over the flat source.
    // keySelector: unique identity of each item; null or an empty string throws E_INVALIDARG.
    // parentKeySelector: key of the parent, or null / empty string for a root.
    // Items whose parent key matches no item are shown as roots. Duplicate keys, null or empty
    // keys, self-parent and cycles raise E_INVALIDARG naming the key; the previous projection stays
    // intact. A throwing selector is treated as having returned null.
    //
    // Both selectors are required, non-null (throws E_INVALIDARG when null; use ClearParentBy() to
    // remove). Value-typed keys -- strings, numbers, Boolean, Char16, Guid, DateTime, TimeSpan,
    // Point, Size, Rect and WinRT enums -- are compared by value, type included (an Int32 key never
    // matches an Int64 one, nor an enum of another type); a fresh box per call is fine. Any other
    // object is compared by reference identity, so both selectors must return the same instance.
    // That includes an enum declared in app code that is not a WinRT type (e.g. a plain C# enum):
    // it reaches the control as an opaque object, so convert it to its integer value first.
    // The node key is the row identity for hierarchical rows (selection, focus and expansion
    // follow it).
    //
    // Error contract beyond the call itself:
    //  * After ParentBy throws, the relation REMAINS declared: every later reshape (another verb,
    //    or a source collection change) re-validates and throws again until the data is fixed or
    //    ClearParentBy() is called.
    //  * Invalid data arriving through a source collection change (e.g. list.Add of a duplicate
    //    key) makes the control throw E_INVALIDARG from its collection-changed handler. Whether
    //    that surfaces from the app's own mutation call depends on how the collection raises its
    //    events (C++/WinRT observable vectors swallow handler exceptions). Either way the
    //    collection keeps the item and the previous projection stays on screen.
    //
    // Every visible row is a real data row, and a row with children can be expanded to reveal them
    // indented beneath it. Rows start COLLAPSED; use TableView.ExpandAllRows() to start expanded.
    // Expansion state is kept per key and survives sort, filter and source changes. Re-declaring
    // ParentBy replaces the previous relation (last writer wins) and resets expansion state;
    // ClearParentBy() resets it too.
    //
    // Sort applies within each sibling set. Filter keeps each match plus all of its ancestors; while
    // a filter is active those ancestors are shown expanded so the matches are reachable. Expanding
    // or collapsing such an ancestor lasts only while that filter is active; changing or clearing
    // the filter restores the expansion state the rows had before.
    //
    // Grouping COMPOSES with hierarchy: GroupBy applies to the ROOTS, so the top level is bucketed
    // under headers and each root still expands into its own subtree beneath its header.
    //
    // The relation is re-evaluated on every collection change of the source and on every reshape
    // (Sort / Filter / GroupBy and their Clear verbs). A property change on an item's key or parent
    // key is not observed unless live shaping is on (any of IsLiveSorting / IsLiveFiltering /
    // IsLiveGrouping), in which case it reparents on the next dispatcher turn; otherwise it takes
    // effect at the next reshape, or replace the item to reparent it immediately. A live reparent
    // that makes the data invalid (duplicate key, cycle) keeps the previous projection; the next
    // verb or collection change re-validates and throws.
    // UI-thread affinity applies as for the rest of this class.
    TableViewSource ParentBy(TableViewKeySelector keySelector, TableViewKeySelector parentKeySelector);

    // Removes the relation and shows the source flat again. Resets expansion state.
    TableViewSource ClearParentBy();

    // Live shaping is opt-in and subscribes to source item property changes. Changes coalesce: all
    // property changes in one dispatcher turn cost one reshape. Under ParentBy, turning on any of
    // these also tracks each item's key and parent key (see ParentBy).
    Boolean IsLiveSorting{ get; set; };
    Boolean IsLiveFiltering{ get; set; };
    Boolean IsLiveGrouping{ get; set; };

}

}
