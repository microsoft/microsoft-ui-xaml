<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Declare Light + Default (Dark) + HighContrast explicitly: once any merged theme
             dictionary defines "Light", XAML treats "Default" as Dark (not a Light fallback),
             so omitting "Light" would drop these tokens from the Light theme. -->
        <ResourceDictionary x:Key="Light">
            <!-- TableView metric tokens (incl. header ResizeGripper width) only. TabularSurface* brushes live in
                 CommonStyles/TabularSurfaces_themeresources.xaml; mirroring them here causes a
                 duplicate-key build failure when the theme-XBF pages merge. -->
            <x:Double x:Key="TableViewRowMinHeight">40</x:Double>
            <x:Double x:Key="TableViewHeaderFontSize">14</x:Double>
            <x:Double x:Key="TableViewHeaderFontSizeExtraCompact">14</x:Double>
            <FontWeight x:Key="TableViewHeaderFontWeight">Normal</FontWeight>
            <Thickness x:Key="TableViewFocusVisualMargin">0</Thickness>
            <Thickness x:Key="TableViewRowFocusVisualMargin">0,-1,0,-1</Thickness>
            <Thickness x:Key="TableViewHeaderFlyoutButtonFocusVisualMargin">-1</Thickness>
            <Thickness x:Key="TableViewHeaderInteractionBorderThickness">0</Thickness>
            <!-- The header's bottom edge and internal column edges meet gridlines. -->
            <CornerRadius x:Key="TableViewHeaderLeftCornerRadius">4,0,0,0</CornerRadius>
            <CornerRadius x:Key="TableViewHeaderRightCornerRadius">0,4,0,0</CornerRadius>
            <CornerRadius x:Key="TableViewHeaderSingleCornerRadius">4,4,0,0</CornerRadius>
            <x:Double x:Key="TableViewCellFontSize">14</x:Double>
            <x:Double x:Key="TableViewCellFontSizeExtraCompact">14</x:Double>
            <x:Double x:Key="TableViewResizeGripperWidth">8</x:Double>

            <!-- Header/cell chrome metrics as theme tokens (tunable without code edits). -->
            <Thickness x:Key="TableViewHeaderCellPadding">12,10,12,10</Thickness>
            <x:Double x:Key="TableViewRowMinHeightCompact">32</x:Double>
            <x:Double x:Key="TableViewRowMinHeightExtraCompact">24</x:Double>
            <Thickness x:Key="TableViewCellPadding">12,10,12,10</Thickness>
            <Thickness x:Key="TableViewCellPaddingCompact">12,6,12,6</Thickness>
            <Thickness x:Key="TableViewCellPaddingExtraCompact">12,2,12,2</Thickness>
            <Thickness x:Key="TableViewHeaderCellPaddingCompact">12,6,12,6</Thickness>
            <Thickness x:Key="TableViewHeaderCellPaddingExtraCompact">12,2,12,2</Thickness>
            <Thickness x:Key="TableViewHeaderTextPadding">12,9,12,11</Thickness>
            <Thickness x:Key="TableViewHeaderTextPaddingCompact">12,5,12,7</Thickness>
            <Thickness x:Key="TableViewHeaderTextPaddingExtraCompact">12,1,12,3</Thickness>
            <Thickness x:Key="TableViewCellTextPadding">12,9,12,11</Thickness>
            <Thickness x:Key="TableViewCellTextPaddingCompact">12,5,12,7</Thickness>
            <Thickness x:Key="TableViewCellTextPaddingExtraCompact">12,1,12,3</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPadding">0,9,0,11</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPaddingCompact">0,5,0,7</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPaddingExtraCompact">0,1,0,3</Thickness>
            <x:Double x:Key="TableViewGroupHeaderMinHeight">40</x:Double>
            <x:Double x:Key="TableViewGroupHeaderMinHeightCompact">32</x:Double>
            <x:Double x:Key="TableViewGroupHeaderMinHeightExtraCompact">24</x:Double>
            <Thickness x:Key="TableViewGroupHeaderPadding">4,10,12,10</Thickness>
            <Thickness x:Key="TableViewGroupHeaderPaddingCompact">4,6,12,6</Thickness>
            <Thickness x:Key="TableViewGroupHeaderPaddingExtraCompact">4,2,12,2</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <!-- TabularSurface* brushes intentionally omitted; see the Light dictionary note. -->
            <x:Double x:Key="TableViewRowMinHeight">40</x:Double>
            <x:Double x:Key="TableViewHeaderFontSize">14</x:Double>
            <x:Double x:Key="TableViewHeaderFontSizeExtraCompact">14</x:Double>
            <FontWeight x:Key="TableViewHeaderFontWeight">Normal</FontWeight>
            <Thickness x:Key="TableViewFocusVisualMargin">0</Thickness>
            <Thickness x:Key="TableViewRowFocusVisualMargin">0,-1,0,-1</Thickness>
            <Thickness x:Key="TableViewHeaderFlyoutButtonFocusVisualMargin">-1</Thickness>
            <Thickness x:Key="TableViewHeaderInteractionBorderThickness">0</Thickness>
            <CornerRadius x:Key="TableViewHeaderLeftCornerRadius">4,0,0,0</CornerRadius>
            <CornerRadius x:Key="TableViewHeaderRightCornerRadius">0,4,0,0</CornerRadius>
            <CornerRadius x:Key="TableViewHeaderSingleCornerRadius">4,4,0,0</CornerRadius>
            <x:Double x:Key="TableViewCellFontSize">14</x:Double>
            <x:Double x:Key="TableViewCellFontSizeExtraCompact">14</x:Double>
            <x:Double x:Key="TableViewResizeGripperWidth">8</x:Double>
            <Thickness x:Key="TableViewHeaderCellPadding">12,10,12,10</Thickness>
            <x:Double x:Key="TableViewRowMinHeightCompact">32</x:Double>
            <x:Double x:Key="TableViewRowMinHeightExtraCompact">24</x:Double>
            <Thickness x:Key="TableViewCellPadding">12,10,12,10</Thickness>
            <Thickness x:Key="TableViewCellPaddingCompact">12,6,12,6</Thickness>
            <Thickness x:Key="TableViewCellPaddingExtraCompact">12,2,12,2</Thickness>
            <Thickness x:Key="TableViewHeaderCellPaddingCompact">12,6,12,6</Thickness>
            <Thickness x:Key="TableViewHeaderCellPaddingExtraCompact">12,2,12,2</Thickness>
            <Thickness x:Key="TableViewHeaderTextPadding">12,9,12,11</Thickness>
            <Thickness x:Key="TableViewHeaderTextPaddingCompact">12,5,12,7</Thickness>
            <Thickness x:Key="TableViewHeaderTextPaddingExtraCompact">12,1,12,3</Thickness>
            <Thickness x:Key="TableViewCellTextPadding">12,9,12,11</Thickness>
            <Thickness x:Key="TableViewCellTextPaddingCompact">12,5,12,7</Thickness>
            <Thickness x:Key="TableViewCellTextPaddingExtraCompact">12,1,12,3</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPadding">0,9,0,11</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPaddingCompact">0,5,0,7</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPaddingExtraCompact">0,1,0,3</Thickness>
            <x:Double x:Key="TableViewGroupHeaderMinHeight">40</x:Double>
            <x:Double x:Key="TableViewGroupHeaderMinHeightCompact">32</x:Double>
            <x:Double x:Key="TableViewGroupHeaderMinHeightExtraCompact">24</x:Double>
            <Thickness x:Key="TableViewGroupHeaderPadding">4,10,12,10</Thickness>
            <Thickness x:Key="TableViewGroupHeaderPaddingCompact">4,6,12,6</Thickness>
            <Thickness x:Key="TableViewGroupHeaderPaddingExtraCompact">4,2,12,2</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!-- TabularSurface* brushes intentionally omitted; see the Light dictionary note. The
                 canonical HighContrast System*Color brushes live in TabularSurfaces_themeresources.xaml. -->
            <x:Double x:Key="TableViewRowMinHeight">40</x:Double>
            <x:Double x:Key="TableViewHeaderFontSize">14</x:Double>
            <x:Double x:Key="TableViewHeaderFontSizeExtraCompact">14</x:Double>
            <FontWeight x:Key="TableViewHeaderFontWeight">Normal</FontWeight>
            <Thickness x:Key="TableViewFocusVisualMargin">0</Thickness>
            <Thickness x:Key="TableViewRowFocusVisualMargin">0,-1,0,-1</Thickness>
            <Thickness x:Key="TableViewHeaderFlyoutButtonFocusVisualMargin">0</Thickness>
            <Thickness x:Key="TableViewHeaderInteractionBorderThickness">1</Thickness>
            <CornerRadius x:Key="TableViewHeaderLeftCornerRadius">4,0,0,0</CornerRadius>
            <CornerRadius x:Key="TableViewHeaderRightCornerRadius">0,4,0,0</CornerRadius>
            <CornerRadius x:Key="TableViewHeaderSingleCornerRadius">4,4,0,0</CornerRadius>
            <x:Double x:Key="TableViewCellFontSize">14</x:Double>
            <x:Double x:Key="TableViewCellFontSizeExtraCompact">14</x:Double>
            <x:Double x:Key="TableViewResizeGripperWidth">8</x:Double>
            <Thickness x:Key="TableViewHeaderCellPadding">12,10,12,10</Thickness>
            <x:Double x:Key="TableViewRowMinHeightCompact">32</x:Double>
            <x:Double x:Key="TableViewRowMinHeightExtraCompact">24</x:Double>
            <Thickness x:Key="TableViewCellPadding">12,10,12,10</Thickness>
            <Thickness x:Key="TableViewCellPaddingCompact">12,6,12,6</Thickness>
            <Thickness x:Key="TableViewCellPaddingExtraCompact">12,2,12,2</Thickness>
            <Thickness x:Key="TableViewHeaderCellPaddingCompact">12,6,12,6</Thickness>
            <Thickness x:Key="TableViewHeaderCellPaddingExtraCompact">12,2,12,2</Thickness>
            <Thickness x:Key="TableViewHeaderTextPadding">12,9,12,11</Thickness>
            <Thickness x:Key="TableViewHeaderTextPaddingCompact">12,5,12,7</Thickness>
            <Thickness x:Key="TableViewHeaderTextPaddingExtraCompact">12,1,12,3</Thickness>
            <Thickness x:Key="TableViewCellTextPadding">12,9,12,11</Thickness>
            <Thickness x:Key="TableViewCellTextPaddingCompact">12,5,12,7</Thickness>
            <Thickness x:Key="TableViewCellTextPaddingExtraCompact">12,1,12,3</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPadding">0,9,0,11</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPaddingCompact">0,5,0,7</Thickness>
            <Thickness x:Key="TableViewGroupHeaderTextPaddingExtraCompact">0,1,0,3</Thickness>
            <x:Double x:Key="TableViewGroupHeaderMinHeight">40</x:Double>
            <x:Double x:Key="TableViewGroupHeaderMinHeightCompact">32</x:Double>
            <x:Double x:Key="TableViewGroupHeaderMinHeightExtraCompact">24</x:Double>
            <Thickness x:Key="TableViewGroupHeaderPadding">4,10,12,10</Thickness>
            <Thickness x:Key="TableViewGroupHeaderPaddingCompact">4,6,12,6</Thickness>
            <Thickness x:Key="TableViewGroupHeaderPaddingExtraCompact">4,2,12,2</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="BandedTableViewStyle" TargetType="tabular:TableView">
        <Setter Property="AlternatingRowBackground" Value="{ThemeResource TabularSurfaceRowBackgroundAlternatingBrush}" />
    </Style>

    <Style x:Key="BorderlessTableViewStyle" TargetType="tabular:TableView">
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceBorderlessOuterBorderBrush}" />
    </Style>

    <Style x:Key="StrongTableViewColumnHeaderStyle" TargetType="tabular:TableViewColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="StrongTableViewGroupHeaderStyle" TargetType="tabular:TableViewGroupHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
