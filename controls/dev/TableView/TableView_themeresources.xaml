<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Thickness x:Key="TableViewHeaderInteractionBorderThickness">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Thickness x:Key="TableViewHeaderInteractionBorderThickness">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Thickness x:Key="TableViewHeaderInteractionBorderThickness">1</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- TabularSurface* brushes live in CommonStyles/TabularSurfaces_themeresources.xaml. -->
    <!-- Typography -->
    <x:Double x:Key="TableViewCellFontSize">14</x:Double>
    <x:Double x:Key="TableViewCellFontSizeSmall">14</x:Double>
    <x:Double x:Key="TableViewHeaderFontSize">14</x:Double>
    <x:Double x:Key="TableViewHeaderFontSizeSmall">14</x:Double>
    <FontWeight x:Key="TableViewHeaderFontWeight">Normal</FontWeight>

    <!-- Focus and header chrome -->
    <Thickness x:Key="TableViewFocusVisualMargin">0</Thickness>
    <Thickness x:Key="TableViewRowFocusVisualMargin">0,-1,0,-1</Thickness>
    <x:Double x:Key="TableViewResizeGripperWidth">8</x:Double>
    <!-- The header's bottom edge and internal column edges meet gridlines. -->
    <CornerRadius x:Key="TableViewHeaderLeftCornerRadius">4,0,0,0</CornerRadius>
    <CornerRadius x:Key="TableViewHeaderRightCornerRadius">0,4,0,0</CornerRadius>
    <CornerRadius x:Key="TableViewHeaderSingleCornerRadius">4,4,0,0</CornerRadius>

    <!-- Row and cell density metrics -->
    <x:Double x:Key="TableViewRowMinHeightSmall">24</x:Double>
    <x:Double x:Key="TableViewRowMinHeightMedium">32</x:Double>
    <x:Double x:Key="TableViewRowMinHeightLarge">40</x:Double>

    <Thickness x:Key="TableViewCellPaddingSmall">12,2,12,2</Thickness>
    <Thickness x:Key="TableViewCellPaddingMedium">12,6,12,6</Thickness>
    <Thickness x:Key="TableViewCellPaddingLarge">12,10,12,10</Thickness>

    <Thickness x:Key="TableViewCellTextPaddingSmall">12,1,12,3</Thickness>
    <Thickness x:Key="TableViewCellTextPaddingMedium">12,5,12,7</Thickness>
    <Thickness x:Key="TableViewCellTextPaddingLarge">12,9,12,11</Thickness>

    <!-- Column-header density metrics -->
    <Thickness x:Key="TableViewHeaderCellPaddingSmall">12,2,12,2</Thickness>
    <Thickness x:Key="TableViewHeaderCellPaddingMedium">12,6,12,6</Thickness>
    <Thickness x:Key="TableViewHeaderCellPaddingLarge">12,10,12,10</Thickness>

    <Thickness x:Key="TableViewHeaderTextPaddingSmall">12,1,12,3</Thickness>
    <Thickness x:Key="TableViewHeaderTextPaddingMedium">12,5,12,7</Thickness>
    <Thickness x:Key="TableViewHeaderTextPaddingLarge">12,9,12,11</Thickness>

    <!-- Group-header density metrics -->
    <x:Double x:Key="TableViewGroupHeaderMinHeightSmall">24</x:Double>
    <x:Double x:Key="TableViewGroupHeaderMinHeightMedium">32</x:Double>
    <x:Double x:Key="TableViewGroupHeaderMinHeightLarge">40</x:Double>

    <Thickness x:Key="TableViewGroupHeaderPaddingSmall">4,2,12,2</Thickness>
    <Thickness x:Key="TableViewGroupHeaderPaddingMedium">4,6,12,6</Thickness>
    <Thickness x:Key="TableViewGroupHeaderPaddingLarge">4,10,12,10</Thickness>

    <Thickness x:Key="TableViewGroupHeaderTextPaddingSmall">0,1,0,3</Thickness>
    <Thickness x:Key="TableViewGroupHeaderTextPaddingMedium">0,5,0,7</Thickness>
    <Thickness x:Key="TableViewGroupHeaderTextPaddingLarge">0,9,0,11</Thickness>

    <Style x:Key="DefaultTableViewStyle" TargetType="tabular:TableView">
        <Setter Property="Density" Value="Medium" />
    </Style>

    <Style x:Key="SmallTableViewStyle" TargetType="tabular:TableView" BasedOn="{StaticResource DefaultTableViewStyle}">
        <Setter Property="Density" Value="Small" />
    </Style>

    <Style x:Key="LargeTableViewStyle" TargetType="tabular:TableView" BasedOn="{StaticResource DefaultTableViewStyle}">
        <Setter Property="Density" Value="Large" />
    </Style>

    <Style x:Key="BandedTableViewStyle" TargetType="tabular:TableView">
        <Setter Property="AlternatingRowBackground" Value="{ThemeResource TabularSurfaceRowBackgroundAlternatingBrush}" />
    </Style>

    <Style x:Key="BorderlessTableViewStyle" TargetType="tabular:TableView">
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceBorderlessOuterBorderBrush}" />
    </Style>

    <Style x:Key="StrongTableViewColumnHeaderStyle" TargetType="tabular:TableViewColumnHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="StrongTableViewGroupHeaderStyle" TargetType="tabular:TableViewGroupHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
