<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:privatecontrols="using:Microsoft.UI.Private.Controls">

    <Style TargetType="privatecontrols:ResizeGripper">
        <!-- A pointer affordance by default: a host that wants it focusable sets IsTabStop="True"
             and the gripper handles its own arrow keys. TableView keeps focus on the header cell,
             where the column commands live. -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <!-- A Border with a null Background does not hit-test; being a pointer target is the point. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ResizeGripperSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="privatecontrols:ResizeGripper">
                    <!-- The separator is the whole visual: it tells the user this edge is draggable
                         before any press. Owned here rather than by the host so every consumer gets
                         it, and so it can be restyled through ResizeGripperSeparatorBrush and
                         ResizeGripperSeparatorThickness. -->
                    <!-- One Border: the Transparent Background keeps the whole gripper a pointer
                         target, and the border is the separator. Normal and Disabled hide it by
                         clearing the brush, so leaving them restores the templated BorderBrush. -->
                    <Border x:Name="Separator"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Separator.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver" />
                                <!-- Same weight as PointerOver: the pointer is still over the
                                     gripper during a drag, and a change mid-gesture reads as a glitch. -->
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Separator.BorderBrush" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="OrientationStates">
                                <VisualState x:Name="Horizontal">
                                    <VisualState.Setters>
                                        <Setter Target="Separator.BorderThickness" Value="{ThemeResource ResizeGripperSeparatorThickness}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Vertical">
                                    <VisualState.Setters>
                                        <Setter Target="Separator.BorderThickness" Value="{ThemeResource ResizeGripperSeparatorThicknessVertical}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
