<Page
    x:Class="Microsoft.UI.Xaml.Tests.MUXControls.ApiTests.NavigationViewPhasedTemplatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Microsoft.UI.Xaml.Tests.MUXControls.ApiTests">
    <Page.Resources>
        <DataTemplate x:Key="UnphasedItem" x:DataType="local:NavigationViewChildrenData">
            <NavigationViewItem Icon="Home" Content="{x:Bind Content}" MenuItemsSource="{x:Bind Children}" />
        </DataTemplate>
        <DataTemplate x:Key="PhasedItem" x:DataType="local:NavigationViewChildrenData">
            <NavigationViewItem x:Phase="1" Icon="Home" Content="{x:Bind Content}" MenuItemsSource="{x:Bind Children}" />
        </DataTemplate>
        <DataTemplate x:Key="LatePhasedItem" x:DataType="local:NavigationViewChildrenData">
            <NavigationViewItem x:Phase="3" Icon="Home" MenuItemsSource="{x:Bind Children}">
                <TextBlock x:Phase="1" Text="{x:Bind Content}" />
            </NavigationViewItem>
        </DataTemplate>
    </Page.Resources>
</Page>
