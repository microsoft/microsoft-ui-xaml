<local:TestPage
    x:Class="MUXControlsTestApp.NavigationViewPointerFocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp">
    <ScrollViewer AutomationProperties.Name="Input root ScrollViewer" IsTabStop="True" Width="640" Height="480"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <Grid Width="640" Height="480">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="TopMode" AutomationProperties.Name="Top mode" Content="Top mode" />
            <TextBlock x:Name="PointerPressedCount" AutomationProperties.Name="Pointer pressed count"
                       Text="0" HorizontalAlignment="Right" />
            <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="False">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="First item" AutomationProperties.Name="First item" />
                    <NavigationViewItem Content="Second item" AutomationProperties.Name="Second item" />
                </NavigationView.MenuItems>
            </NavigationView>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24" Spacing="12">
                <ToggleSwitch x:Name="FocusToggle" AutomationProperties.Name="Focus toggle"
                              Width="44" MinWidth="0" OnContent="" OffContent="" />
                <TextBlock x:Name="ToggleState" AutomationProperties.Name="Toggle state"
                           Text="{Binding IsOn, ElementName=FocusToggle}" />
                <Button x:Name="OtherButton" AutomationProperties.Name="Other button" Content="Other button" />
                <TextBlock x:Name="CaptureTarget" AutomationProperties.Name="Capture target"
                           Text="Capture target" HorizontalAlignment="Left" />
                <TextBlock x:Name="CaptureSucceeded" AutomationProperties.Name="Capture succeeded" Text="False" />
                <ScrollViewer x:Name="FocusScrollViewer" AutomationProperties.Name="Focusable ScrollViewer"
                              IsTabStop="True" Width="180" Height="100">
                    <TextBlock Text="Scrollable content" Height="600" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:TestPage>
