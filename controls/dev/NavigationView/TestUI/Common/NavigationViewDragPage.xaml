<local:TestPage
    x:Class="MUXControlsTestApp.NavigationViewDragPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox x:Name="TopMode" Content="Top mode" Click="TopMode_Click"/>
            <CheckBox x:Name="Draggable" Content="CanDrag" IsChecked="True" Click="Draggable_Click"/>
            <CheckBox x:Name="CancelDrag" Content="Cancel drag start" IsChecked="True"/>
            <CheckBox x:Name="RetemplateOnPress" Content="Retemplate on press"/>
            <Button x:Name="Snapshot" Content="Read state" Click="Snapshot_Click"/>
            <CheckBox x:Name="DeferDragStart" Content="Defer drag start"/>
        </StackPanel>
        <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Left"
                        IsPaneOpen="True" OpenPaneLength="220" IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed" ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DragItem" Content="Drag item" CanDrag="True"/>
                <NavigationViewItem Content="Parent" IsExpanded="True">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="NestedDragItem" Content="Nested drag item" CanDrag="True"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Button x:Name="DropTarget" Content="Drop target" AllowDrop="True" Background="LightGreen"
                    Height="120" Margin="24" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"/>
        </NavigationView>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="DragCount" Text="0"/>
            <TextBlock x:Name="DragSource" Text="None"/>
            <TextBlock x:Name="InvocationCount" Text="0"/>
            <TextBlock x:Name="DroppedText" Text="None"/>
            <TextBlock x:Name="CompletionResult" Text="None"/>
            <TextBlock x:Name="CaptureCount" Text="0"/>
            <TextBlock x:Name="PressedStates" Text="Not read"/>
            <TextBlock x:Name="RetemplateCount" Text="0"/>
            <TextBlock x:Name="LastPointerDevice" Text="None"/>
            <TextBlock x:Name="LastPressPointerId" Text="0"/>
            <TextBlock x:Name="LastHoverPointerId" Text="0"/>
            <TextBlock x:Name="LastHoverDevice" Text="None"/>
            <TextBlock x:Name="DragStartPointerOver" Text="Not read"/>
            <TextBlock x:Name="DragStartAnchor" Text="Not read"/>
            <TextBlock x:Name="HoverMoveCount" Text="0"/>
            <TextBlock x:Name="ItemPointerOver" Text="Not read"/>
            <TextBlock x:Name="ItemWidth" Text="0"/>
            <TextBlock x:Name="ItemRasterizationScale" Text="0"/>
            <TextBlock x:Name="PressCaptureOwner" Text="None"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DisableDragItem" Content="Disable item" Click="DisableDragItem_Click"/>
                <Button x:Name="EnableDragItem" Content="Enable item" Click="EnableDragItem_Click"/>
                <Button x:Name="FocusDragItem" Content="Focus item" Click="FocusDragItem_Click"/>
                <Button x:Name="DetachDragItem" Content="Remove item" Click="DetachDragItem_Click"/>
                <Button x:Name="AttachDragItem" Content="Restore item" Click="AttachDragItem_Click"/>
            </StackPanel>
            <Button x:Name="CompleteDragDeferral" Content="Complete drag deferral" IsEnabled="False"
                    Click="CompleteDragDeferral_Click"/>
        </StackPanel>
    </Grid>
</local:TestPage>
