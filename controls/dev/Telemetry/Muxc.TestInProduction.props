<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Selects the production TiP (Test in Production) library when it is restored, else the public stub. eng\folderpaths.props
       tests an unversioned package folder, which packages.config restores do not create. Imported by the MUXC dlls that run TiP tests. -->
  <PropertyGroup>
    <MuxcTIPPackagesConfig>$(ProjectRoot)build\packages.TestInProduction.config</MuxcTIPPackagesConfig>
    <MuxcTIPPackagesConfigContents Condition="Exists('$(MuxcTIPPackagesConfig)')">$([System.IO.File]::ReadAllText('$(MuxcTIPPackagesConfig)'))</MuxcTIPPackagesConfigContents>
    <TestInProductionPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(MuxcTIPPackagesConfigContents)', 'Microsoft.Windows.TestInProduction.*?version="(.*?)"').Groups[1].Value)</TestInProductionPackageVersion>
    <TestInProductionPkgDirectory>$(NugetPackageDirectory)\Microsoft.Windows.TestInProduction.$(TestInProductionPackageVersion)</TestInProductionPkgDirectory>
    <TestInProductionTargetsFile>$(TestInProductionPkgDirectory)\build\native\Microsoft.Windows.TestInProduction.targets</TestInProductionTargetsFile>
    <!-- Kept for the internal pipeline build error, which fires after the stub has replaced the selection below. -->
    <MuxcTIPProductionVersion>$(TestInProductionPackageVersion)</MuxcTIPProductionVersion>
    <MuxcTIPProductionTargetsFile>$(TestInProductionTargetsFile)</MuxcTIPProductionTargetsFile>
    <TestInProductionIsReal>false</TestInProductionIsReal>
    <TestInProductionIsReal Condition="'$(UseTestInProductionStub)' != 'true' and '$(TestInProductionPackageVersion)' != '' and Exists('$(TestInProductionTargetsFile)')">true</TestInProductionIsReal>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestInProductionIsReal)' != 'true'">
    <MuxcPublicPackagesConfig>$(ProjectRoot)packages.config</MuxcPublicPackagesConfig>
    <MuxcPublicPackagesConfigContents Condition="Exists('$(MuxcPublicPackagesConfig)')">$([System.IO.File]::ReadAllText('$(MuxcPublicPackagesConfig)'))</MuxcPublicPackagesConfigContents>
    <TestInProductionPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(MuxcPublicPackagesConfigContents)', 'Microsoft.Internal.Windows.TestInProduction.*?version="(.*?)"').Groups[1].Value)</TestInProductionPackageVersion>
    <TestInProductionPkgDirectory>$(NugetPackageDirectory)\Microsoft.Internal.Windows.TestInProduction.$(TestInProductionPackageVersion)</TestInProductionPkgDirectory>
    <TestInProductionTargetsFile>$(TestInProductionPkgDirectory)\build\native\Microsoft.Internal.Windows.TestInProduction.targets</TestInProductionTargetsFile>
  </PropertyGroup>
</Project>
