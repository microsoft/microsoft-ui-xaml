<local:TestPage
    x:Class="MUXControlsTestApp.ChartsPage"
    x:Name="ChartsTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MUXControlsTestApp"
    xmlns:charts="using:Microsoft.UI.Xaml.Controls.Charts">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddPointButton" Content="Add point" Click="AddPointButton_Click" />
            <Button x:Name="RemoveSeriesButton" Content="Remove series" Click="RemoveSeriesButton_Click" />
            <Button x:Name="ToggleLegendButton" Content="Toggle legend" Click="ToggleLegendButton_Click" />
            <Button x:Name="ToggleThemeButton" Content="Toggle theme" Click="ToggleThemeButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1" />

        <charts:Chart x:Name="TestChart" Grid.Row="2"
                      AutomationProperties.Name="TestChart"
                      RequestedTheme="Light"
                      ShowLegend="True"
                      LegendTitle="Series" />
    </Grid>
</local:TestPage>
