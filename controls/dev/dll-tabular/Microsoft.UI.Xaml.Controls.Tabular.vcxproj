<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)Microsoft.UI.Xaml.Common.props" />
  <PropertyGroup Label="Globals">
    <_NoWinAPIFamilyApp>true</_NoWinAPIFamilyApp>
    <ProjectGuid>{C0A0F121-3A2D-4B61-9D5E-8E6B1F4D5B33}</ProjectGuid>
    <Keyword>DynamicLibrary</Keyword>
    <TargetName>$(MUXTabularTargetName)</TargetName>
    <ProjectPriFileName>$(MUXTabularTargetName).pri</ProjectPriFileName>
    <RootNamespace>$(MUXNamespace)</RootNamespace>
    <MUXControlsFrameworkPackageName>Microsoft.UI.Xaml.Controls.Tabular</MUXControlsFrameworkPackageName>
    <MUXControlsFrameworkPackageName Condition="'$(Configuration)'=='Debug'">Microsoft.UI.Xaml.Controls.Tabular.Debug</MUXControlsFrameworkPackageName>
    <!-- We only need XamlCompiler to provide us with XBF -->
    <XamlCodeGenerationControlFlags>NoPageCodeGen;NoTypeInfoCodeGen</XamlCodeGenerationControlFlags>
    <!-- Tabular has no PGO profile yet, so keep missing-profile verification non-fatal. -->
    <PGOVerifyFailureTreatedAsError>false</PGOVerifyFailureTreatedAsError>
    <!-- Theme XBFs live under Tabular's own PRI root; sharing MUXC's collides on merge (PRI277). -->
    <TabularBinaryEmitsThemeResources>true</TabularBinaryEmitsThemeResources>
    <!-- Load-bearing: sets the PRI path the control's ms-appx:/// default-style URI resolves
         (see TabularControlsResources.cpp). Change one and you must change the other. -->
    <AppxPrependPriInitialPath>true</AppxPrependPriInitialPath>
    <AppxPriInitialPath>$(MUXTabularTargetName)</AppxPriInitialPath>
  </PropertyGroup>
  <Import Project="$(ProjectRoot)\perf\pgo\Microsoft.WinUI.PGO.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MUXCProjectRoot)MidlShared.props" />
  <Import Project="$(MUXCProjectRoot)Tabular.ProjectImports.targets" />
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Lightup\Microsoft.UI.Xaml.Controls.Lightup.vcxproj" />
    <!-- Ordering only: XamlCompile consumes MergedWinMD's output on disk. Not a cycle, because
         MergedWinMD depends on Tabular's idl project, never this one. -->
    <ProjectReference Include="$(ProjectRoot)MergedWinMD\MergedWinMD.vcxproj" ReferenceOutputAssembly="false" />
    <!-- Ordering only: EnsureMuxcComponentWinMDBuilt needs MUXC's component winmd on disk, and
         MergedWinMD sequences only MUXC's idl project, not the DLL that emits it. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\dll\Microsoft.UI.Xaml.Controls.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <SharedPage Include="@(Page)" />
  </ItemGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <Import Project="$(MSBuildThisFileDirectory)Microsoft.UI.Xaml.Common.targets" />
  <!-- Give C++/WinRT MUXC's unmerged winmd for shared/future type projections; do not feed it to MIDL. -->
  <PropertyGroup>
    <CppWinRTParameters>$(CppWinRTParameters) -reference "$(XamlBuildOutputRoot)\controls\dev\dll\Unmerged\Microsoft.UI.Xaml.Controls.g.winmd"</CppWinRTParameters>
  </PropertyGroup>
  <!-- Fail clearly when single-project builds run before MUXC produced the component winmd Tabular's
       C++/WinRT projection consumes. The XamlCompile winmd (MergedWinMD's public output) no longer
       needs a disk probe here: the ProjectReference above makes MSBuild build it first. -->
  <Target Name="EnsureMuxcComponentWinMDBuilt" BeforeTargets="CppWinRTMakeComponentProjection;ClCompile">
    <Error Condition="!Exists('$(XamlBuildOutputRoot)\controls\dev\dll\Unmerged\Microsoft.UI.Xaml.Controls.g.winmd')"
           Text="Microsoft.UI.Xaml.Controls.Tabular consumes MUXC's component winmd (dev\dll\Unmerged\Microsoft.UI.Xaml.Controls.g.winmd, used by C++/WinRT), which has not been built. Build the in-box controls DLL first (e.g. 'controls\Build.cmd product'), then build Tabular." />
  </Target>
  <ItemDefinitionGroup>
    <Link>
      <ModuleDefinitionFile>Microsoft.UI.Xaml.Controls.Tabular.def</ModuleDefinitionFile>
    </Link>
    <ClCompile>
      <AdditionalOptions>/ZH:SHA_256 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MUXProjectRoot)dxaml\xcp\inc;$(TempDir)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MUXProjectRoot)dxaml\xcp\inc;$(TempDir)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <None Include="Microsoft.UI.Xaml.Controls.Tabular.def" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Microsoft.UI.Xaml.Controls.Tabular.rc" />
  </ItemGroup>
  <!-- For the purposes of code coverage, we need to know where the intermediates directory is,
       since we need to re-link Microsoft.UI.Xaml.Controls.dll for code coverage.
       We can't get it from any environment variable, so let's write it to a text file as a workaround.
       We'll also output the MSVC tools directory for the same reason. -->
  <Target Name="AfterBuild" Condition="(!Exists('$(OutDir)IntermediateDirectoryLocation.txt') Or !Exists('$(OutDir)VCToolsInstallDirectoryLocation.txt'))">
    <WriteLinesToFile File="$(OutDir)IntermediateDirectoryLocation.txt" Lines="$(IntermediateOutputPath)" Overwrite="true" Encoding="Ascii" />
    <WriteLinesToFile File="$(OutDir)VCToolsInstallDirectoryLocation.txt" Lines="$(VCToolsInstallDir)" Overwrite="true" Encoding="Ascii" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)IntermediateDirectoryLocation.txt" />
      <FileWrites Include="$(OutDir)VCToolsInstallDirectoryLocation.txt" />
    </ItemGroup>
  </Target>
  <!-- Since we're not generating a WinMD file, we need to populate this manually. -->
  <Target Name="CppWinRTSetXamlLocalAssembly">
    <PropertyGroup>
      <LocalAssembly>$(IntermediateOutputPath)Unmerged\$(MUXTabularTargetName).g.winmd</LocalAssembly>
    </PropertyGroup>
  </Target>
  <Target Name="XamlLightupConfigSources" BeforeTargets="SelectCustomBuild">
    <ItemGroup>
      <XamlLightup Include="@(ClCompile->HasMetadata('XamlLightup'))" />
      <ClCompile Remove="@(XamlLightup)" />
      <ClCompile Include="@(XamlLightup)">
        <!-- Compile without PCH to permit latest UAP contract for light-up code.
            In future, if we add more lightup sources, we can generate a light-up PCH. -->
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <PrecompiledHeaderFile />
        <PrecompiledHeaderOutputFile />
        <!-- Pull C++/WinRT projection headers from Microsoft.UI.Xaml.Controls.Lightup -->
        <AdditionalIncludeDirectories>$(GeneratedFilesDir)..\..\lightup\generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
        <!-- Latest Windows SDK headers have some analysis incompatibilities - address later -->
        <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
        <EnablePREfast>false</EnablePREfast>
        <PREfastAdditionalOptions />
        <PREfastAdditionalPlugins />
        <PREfastLog />
        <PREfastRulesetFile />
        <PREfastProjectDirectory />
        <PREfastRulesetDirectories />
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
