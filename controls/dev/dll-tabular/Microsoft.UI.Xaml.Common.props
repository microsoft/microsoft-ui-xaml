<!--
  Tabular builds with MUXC's settings plus a two-define delta, so this file imports the MUXC
  property sheet instead of copying it. The copy it replaced had drifted to a verbatim duplicate
  of controls\dev\dll\Microsoft.UI.Xaml.Common.props with ten extra lines, which meant every MUXC
  build-setting change had to be mirrored by hand or the two binaries silently diverged.

  Imported by file-relative path, not $(MUXCProjectRoot): the Tabular vcxproj imports this file as
  its very first import, before environment.props has defined that property.

  The MUXC sheet is safe to import from this directory - its only non-property paths are
  GetPathOfFileAbove(environment.props), which resolves from the MUXC sheet's own location, and
  ScriptPath="..\..\tools\", which is project-relative and identical for both sibling projects.
-->
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\dll\Microsoft.UI.Xaml.Common.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Mark Tabular so shared headers skip MUXC-only projections not used by this binary. -->
      <PreprocessorDefinitions>MUXCONTROLS_TABULAR;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Define TABULAR_BINARY_EMITS_THEME_RESOURCES only when Tabular ships its own themes. -->
  <ItemDefinitionGroup Condition="'$(TabularBinaryEmitsThemeResources)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>TABULAR_BINARY_EMITS_THEME_RESOURCES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
