<!--
  Tabular builds with MUXC's settings plus a two-define delta, so this imports the MUXC sheet
  rather than copying it. Imported by file-relative path, not $(MUXCProjectRoot): the Tabular
  vcxproj imports this as its first import, before environment.props defines that property.
-->
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\dll\Microsoft.UI.Xaml.Common.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Mark Tabular so shared headers skip MUXC-only projections not used by this binary. -->
      <PreprocessorDefinitions>MUXCONTROLS_TABULAR;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Define TABULAR_BINARY_EMITS_THEME_RESOURCES only when Tabular ships its own themes. -->
  <ItemDefinitionGroup Condition="'$(TabularBinaryEmitsThemeResources)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>TABULAR_BINARY_EMITS_THEME_RESOURCES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
