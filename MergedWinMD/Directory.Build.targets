<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- We need to ensure that we've built MIDL for our project references before we attempt to use them in this project.
       So we'll do that manually to guarantee that ordering. -->
  <Target Name="BuildMidlProjectReferences" DependsOnTargets="BuildGenerateSourcesTraverse" AfterTargets="Rebuild" BeforeTargets="Build;_Midl;GetCppWinRTDirectWinMDReferences;_ComposedMetadata;CoreCompile" />

  <Target Name="UseCurrentUniversalApiContractForSystemCompositionMerge"
          AfterTargets="_GatherComposedMetadataInputs"
          BeforeTargets="_IsolateCollidingReferenceWinMDs;_ComposedMetadata">
    <PropertyGroup>
      <_CurrentUniversalApiContract>$(WindowsSdkDir)References\$(WindowsTargetPlatformVersion)\Windows.Foundation.UniversalApiContract.winmd</_CurrentUniversalApiContract>
      <_SystemContractStagingDir>$(IntDir)mdmerge-system-contracts\</_SystemContractStagingDir>
    </PropertyGroup>
    <ItemGroup>
      <_SystemContractWinMDs Include="$(SDKReferencesPath)\*.winmd"
                             Exclude="$(SDKReferencesPath)\Windows.Foundation.UniversalApiContract.winmd" />
      <_SystemContractWinMDs Include="$(_CurrentUniversalApiContract)" />
    </ItemGroup>
    <MakeDir Directories="$(_SystemContractStagingDir)" />
    <Copy SourceFiles="@(_SystemContractWinMDs)"
          DestinationFolder="$(_SystemContractStagingDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_WinMdReferenceDirectories Remove="$(SDKReferencesPath)" />
      <_WinMdReferenceDirectories Include="$(_SystemContractStagingDir)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <BinplaceItem Include="$(OutputWinmds)"/>
  </ItemGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Building in Visual Studio causes it to call targets on dependent projects that may not exist.
       Adding dummy targets to those projects makes Visual Studio happy. -->
  <Target Name="ResolveNuGetPackageAssets" />
</Project>
